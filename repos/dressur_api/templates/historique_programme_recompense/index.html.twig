{% extends 'baseAdmin.html.twig' %}

{% block title %}Historique Programme Recompense{% endblock %}

{% block body %}
	<div class="">
		<div class="row mb-3 align-items-center">
			<div class="col-md-6">
				<p class="h4 me-3">Historique Programme Récompense</p>
			</div>
			<div class="col-md-6 text-end">
				<a href="{{ path('app_historique_programme_recompense_new') }}" class="btn btn-primary">Create new</a>
			</div>
		</div>
	</div>
	
	<div class="table-responsive">
		<table class="data-table table table-bordered table-striped">
			<thead>
				<tr>
					<th>Actions</th>
					<th>Id</th>
					<th>User</th>
					<th>Nbr Vue</th>
					<th>Nbr Partage</th>
					<th>Récompense</th>
					<th>Status</th>
					<th>Référence</th>
					<th>Créé le</th>
					<th>Modifié le</th>
				</tr>
			</thead>
			<tbody>
				{% for historique in historique_programme_recompenses %}
					<tr>
						<td>
							{% include "historique_programme_recompense/_delete_form.html.twig" with {'historique_programme_recompense': historique} %}
						</td>

						<td>{{ historique.id }}</td>

						<!-- USER -->
						<td>
							{% if historique.user %}
								<span class="badge bg-primary">
									{{ historique.user.pseudo }}
								</span>
							{% else %}
								<span class="badge bg-danger">
									Aucun user
								</span>
							{% endif %}
						</td>

						<td>{{ historique.nbrVue }}</td>
						<td>{{ historique.nbrPartage }}</td>
						<td>{{ historique.recompense }}</td>

						<td class="text-center">
							{% set status = historique.status %}

							{% if status == 'en_attente' %}
								<span class="badge bg-warning">En attente</span>

							{% elseif status == 'en_cours' %}
								<span class="badge bg-info">En cours</span>

							{% elseif status == 'approuver' %}
								<span class="badge bg-success">Approuvé</span>

							{% elseif status == 'terminer' %}
								<span class="badge bg-primary">Terminé</span>

							{% elseif status == 'echouer' %}
								<span class="badge bg-dark">Échoué</span>

							{% elseif status == 'refuser' %}
								<span class="badge bg-danger">Refusé</span>

							{% else %}
								<span class="badge bg-secondary">{{ status }}</span>
							{% endif %}
						</td>


						<td>{{ historique.referenceParticipation }}</td>
						<td>{{ historique.createdAt ? historique.createdAt|date('Y-m-d H:i:s') : '' }}</td>
						<td>{{ historique.updatedAt ? historique.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="10" class="text-center">
							Aucun enregistrement trouvé
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}
