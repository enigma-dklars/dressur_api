{% extends 'basePrivate.html.twig' %}

{% block title %}Accepter Sans Suite{% endblock %}

{% block body %}
<div class="row g-3">
    {% for promoaffaire in accepterSansSuite %}
        <div class="col-md-4">
            <div class="card mb-0 h-100">
                {% if promoaffaire.statusNumber == 0 %}{% set bg_badge = "bg-danger" %}{% endif %}
                {% if promoaffaire.statusNumber == 1 %}{% set bg_badge = "bg-warning" %}{% endif %}
                {% if promoaffaire.statusNumber == 2 %}{% set bg_badge = "bg-warning" %}{% endif %}
                {% if promoaffaire.statusNumber == 3 %}{% set bg_badge = "bg-success" %}{% endif %}
                {% if promoaffaire.statusNumber == 4 %}{% set bg_badge = "bg-success" %}{% endif %}
                <img src="/promotion/{{promoaffaire.image}}" alt="" class="card-img-top">
                <div class="card-body">
                    <p class="mb-2">
                        Poster Par : {{promoaffaire.username}}
                    </p>
                    <span class="badge {{bg_badge}} text-white mb-1">{{promoaffaire.status}}</span>
                    {% if promoaffaire.statusNumber == 0 %}
                        <p>
                            Motif : {{promoaffaire.motif}}
                        </p>
                        <span class="text-success small">
                            Tenez compte du motif de refus pour soumettre une nouvelle demande. Merci...
                        </span>
                    {% else %}
                        <div class="d-flex justify-content-between mb-1">
                            <div>
                                Impressions : <strong>{{promoaffaire.nombreImpression}}</strong>
                            </div>
                            <div>
                                Vues : <strong>{{promoaffaire.nombreDeVues}}</strong>
                            </div>
                        </div>                        
                        {% if promoaffaire.typePromotionAffaire == "produit_service" %} <div class="actu-small-description mb-1"> {{promoaffaire.description}} </div> {% endif %}
                        {% if promoaffaire.typePromotionAffaire == "offre_emploi" %} <div class="actu-small-description mb-1"> {{promoaffaire.annotherInfo.description_poste}} </div> {% endif %}
                        {% if promoaffaire.typePromotionAffaire == "dmd_emploi" %} <div class="actu-small-description mb-1"> {{promoaffaire.annotherInfo.description_profil_demandeur}} </div> {% endif %}
                    {% endif %}
                    
                    <div class="{% if promoaffaire.statusNumber == 2 %}d-flex justify-content-between{% else %}text-end{% endif %} mt-2">
                        {% if promoaffaire.statusNumber == 2 %}
                            {# <button class="btn btn-sm btn-warning text-white" data-bs-toggle="modal" data-bs-target="#modal_payerpromoaffaire_{{promoaffaire.id}}"><i class="fas fa-credit-card me-1"></i> Payer Fcfa</button> #}
                            <button class="btn btn-sm btn-warning text-white" data-bs-toggle="modal" data-bs-target="#modal_payer_bonus_promoaffaire_{{promoaffaire.id}}"><i class="fas fa-credit-card me-1"></i> Payer Bonus</button>
                        {% endif %}
                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modal_promoaffaire_{{promoaffaire.id}}"><i class="fas fa-info me-2"></i>Détails</button>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="modal_payer_bonus_promoaffaire_{{promoaffaire.id}}" tabindex="-1" style="display: none;" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5>Démarer la promotion affaire Gratuitement</h5>
                        </div>
                        <div class="modal-body">
                            <div class="col-12">
                                <div class="mt-0 msgError" id="msgError-{{promoaffaire.id}}" style="display: none;"></div>
                            </div>
                            <div hidden>
                                <input type="text" id="idPromoAffaire-{{promoaffaire.id}}" value="{{promoaffaire.id}}">
                            </div>
                            <div class="mb-2">
                                <label for="formulBoost">Formule de Boost</label>
                                <select id="formulBosst" class="form-select getInfoBoost-{{promoaffaire.id}} formulBoost-{{promoaffaire.id}}">
                                    <option value="" selected disabled>Choissisez une Formule de Boost</option>
                                    {% for formulBoost in listeFormulBoost %}
                                        <option value="{{formulBoost.id}}">{{formulBoost.label}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Fermer</button>
                            <button type="button" class="btn btn-primary btn-sm validePromoAffaireByAdmin" payerpromoaffaire="{{promoaffaire.id}}" id="validePromoAffaireByAdmin-{{promoaffaire.id}}">BOOSTER</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="modal_payerpromoaffaire_{{promoaffaire.id}}" tabindex="-1" style="display: none;" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5>Démarer la promotion affaire</h5>
                        </div>
                        <div class="modal-body">
                            <div class="col-12">
                                <div class="mt-0 msgError msgError-{{promoaffaire.id}}" id="msgError-{{promoaffaire.id}}" style="display: none;"></div>
                            </div>
                            <div hidden>
                                <input type="text" id="idPromoAffaire-{{promoaffaire.id}}" value="{{promoaffaire.id}}">
                            </div>
                            <div class="mb-2">
                                <label for="formulBoost">Formule de Boost</label>
                                <select id="formulBosst" class="form-select getInfoBoostPayant-{{promoaffaire.id}} formulBoostPayant-{{promoaffaire.id}}">
                                    <option value="" selected disabled>Choissisez une Formule de Boost</option>
                                    {% for formulBoost in listeFormulBoost %}
                                        <option value="{{formulBoost.id}}">{{formulBoost.label}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="mb-2">
                                <label for="moyen-paiement">Moyen de paiement mobile ou par carte</label>
                                <select id="moyen-paiement-{{promoaffaire.id}}" class="form-select getInfo getInfoBoostPayant-{{promoaffaire.id}} moyenPaiementPayant-{{promoaffaire.id}}">
                                    <option value="" disabled selected>Choisisez le Moyen de paiement mobile ou par carte</option>
                                    {% for uneMethodePaiement in listeMethodePaiements %}
                                        <option value="{{uneMethodePaiement.value}}">{{uneMethodePaiement.titre}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div>
                                <label for="numero-paiement">Indicatif + Numéro de Paiement</label>
                                <input type="text" class="form-control getInfo getInfoBoostPayant-{{promoaffaire.id}} numeroPaiementPayant-{{promoaffaire.id}}" id="numero-paiement-{{promoaffaire.id}}">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Fermer</button>
                            <button type="button" class="btn btn-primary btn-sm payerpromoaffaire" payerpromoaffaire="{{promoaffaire.id}}" id="payerpromoaffaire-{{promoaffaire.id}}">PAYER et BOOSTER</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="modal_promoaffaire_{{promoaffaire.id}}" tabindex="-1" style="display: none;" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-body p-0">
                            <img src="/promotion/{{promoaffaire.image}}" alt="" class="card-img-top mb-3">
                            <p class="px-3">
                                Formule de promotion : {{promoaffaire.formulePromotion}} Fcfa
                            </p>
                            <p class="px-3">
                                Date de début : {{promoaffaire.dateDebut}}
                            </p>
                            <p class="px-3">
                                Date de fin : {{promoaffaire.dateExp}}
                            </p>
                            <p class="px-3">
                                {{promoaffaire.description|nl2br}}
                            </p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info text-center fw-semibold fs-6">
            Aucune Promotion Affaire trouvé.
        </div>
    {% endfor %}
</div>
{% endblock %}
