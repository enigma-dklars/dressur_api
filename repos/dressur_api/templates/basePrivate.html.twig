    {# ── Bandeau statut : JS ────────────────────────────────────────────── #}
    <script>
    (function () {
        'use strict';

        var DS_UID      = '{{ user.uid|e('js') }}';
        var SESSION_KEY = 'dsStatusBannerClosed';
        var banner      = document.getElementById('ds-status-banner');
        var bannerText  = document.getElementById('ds-banner-text');
        var bannerAct   = document.getElementById('ds-banner-actions');
        var bannerClose = document.getElementById('ds-banner-close');

        if (!banner || !DS_UID || DS_UID === '') return;

        function buildActions(html) {
            bannerAct.innerHTML = html;
        }

        function showBanner(type, text, actionsHtml) {
            var stored = JSON.parse(sessionStorage.getItem(SESSION_KEY) || '{}');
            if (stored[type]) return;

            banner.className = 'ds-banner-visible ds-banner-' + type;
            bannerText.textContent = text;
            buildActions(actionsHtml);

            // Décaler le contenu de la page pour éviter qu'il passe sous le bandeau
            var h = banner.offsetHeight;
            document.querySelector('.wrapper') && (document.querySelector('.wrapper').style.marginTop = h + 'px');
        }

        bannerClose.addEventListener('click', function () {
            // Détecter le type actif et le stocker en session
            var type = banner.dataset.bannerType || 'generic';
            var stored = JSON.parse(sessionStorage.getItem(SESSION_KEY) || '{}');
            stored[type] = true;
            sessionStorage.setItem(SESSION_KEY, JSON.stringify(stored));
            banner.className = '';
            banner.style.display = 'none';
            document.querySelector('.wrapper') && (document.querySelector('.wrapper').style.marginTop = '');
        });

        // Délégation pour les boutons du bandeau
        bannerAct.addEventListener('click', function (e) {
            var t = e.target.closest('[data-ds-action]');
            if (!t) return;
            var action = t.dataset.dsAction;
            if (action === 'vcf') {
                window.location.href = '/export_vcf';
            } else if (action === 'contacts') {
                window.location.href = '/contact';
            } else if (action === 'boost-list') {
                window.location.href = '/listeboostcontact';
            } else if (action === 'new-boost') {
                window.location.href = '/newboostcontact';
            }
        });

        // Fetch des données utilisateur au chargement
        fetch('/api/getUserInfo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'uid=' + encodeURIComponent(DS_UID)
        })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
            if (!data || data.error) return;

            var nbContacts  = parseInt(data.nombreContactDispo) || 0;
            var boostActif  = data.boostActif || null;

            // Priorité 1 : contacts disponibles
            if (nbContacts > 0) {
                banner.dataset.bannerType = 'contacts';
                var stored = JSON.parse(sessionStorage.getItem(SESSION_KEY) || '{}');
                // Si nouvelle valeur par rapport à la session, effacer le flag pour réafficher
                var prevN = parseInt(sessionStorage.getItem('dsContactsDispo') || '0');
                if (prevN !== nbContacts) {
                    stored['contacts'] = false;
                    sessionStorage.setItem(SESSION_KEY, JSON.stringify(stored));
                }
                sessionStorage.setItem('dsContactsDispo', nbContacts);
                showBanner('green',
                    '📥 Vous avez ' + nbContacts + ' contact(s) Dressur disponibles à importer',
                    '<button class="ds-banner-btn-main" data-ds-action="vcf">Télécharger VCF</button>' +
                    '<button class="ds-banner-btn-sec" data-ds-action="contacts">Voir la liste</button>'
                );
                return;
            }

            if (!boostActif) return;

            var typeBoost      = boostActif.typeBoost || '';
            var nbObtenus      = parseInt(boostActif.nbContactsObtenus) || 0;
            var nbMax          = parseInt(boostActif.nbContactsMax) || 0;
            var estExpire      = boostActif.estExpire === true || boostActif.estExpire === 1;

            // Priorité 3 : boost expiré (durée ou quota atteint)
            if (estExpire) {
                banner.dataset.bannerType = 'expire';
                showBanner('orange',
                    '🔴 Votre boost est terminé — Relancez pour continuer à recevoir des contacts',
                    '<button class="ds-banner-btn-main" data-ds-action="new-boost">Faire un nouveau boost</button>'
                );
                return;
            }

            // Priorité 2 : boost quota actif non atteint
            if (typeBoost === 'quota' && !estExpire) {
                banner.dataset.bannerType = 'quota';
                showBanner('blue',
                    '🔵 Boost actif — ' + nbObtenus + '/' + nbMax + ' contacts reçus',
                    '<button class="ds-banner-btn-main" data-ds-action="boost-list">Voir mon boost</button>'
                );
                return;
            }
        })
        .catch(function () { /* silencieux */ });
    })();
    </script>

    {# ── Modal interrupt contacts disponibles ──────────────────────────── #}
    <style>
    @keyframes dsInterruptFadeIn {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    #ds-interrupt-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0,0,0,0.75);
        align-items: center;
        justify-content: center;
        padding: 16px;
    }
    #ds-interrupt-backdrop.ds-interrupt-visible {
        display: flex;
    }
    #ds-interrupt-box {
        background: #fff;
        border-radius: 16px;
        padding: 32px 28px 24px;
        max-width: 480px;
        width: 100%;
        text-align: center;
        box-shadow: 0 8px 40px rgba(0,0,0,0.28);
