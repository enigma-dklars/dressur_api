    function validateProduitServiceForm() {
        const errors = [];

        if (!currentFormuleData.id) {
            errors.push('Veuillez choisir une formule.');
        }
        if (!$('#descriptionPromo').val().trim()) {
            errors.push('Veuillez entrer une description.');
        }
        if (!selectedImage) {
            errors.push('Veuillez sélectionner une image.');
        }
        const waVal = ($('#whatsappContact').val() || '').trim();
        if (!waVal || !/^\+\d{11,}$/.test(waVal)) {
            errors.push('Le numéro WhatsApp de contact doit commencer par + suivi d\'au moins 11 chiffres.');
            $('#whatsappContact').addClass('is-invalid');
        } else {
            $('#whatsappContact').removeClass('is-invalid');
        }
        if (!$('#paymentMethod').val()) {
            errors.push('Veuillez choisir un moyen de paiement.');
        }
        if (!$('#paymentNumber').val().trim()) {
            errors.push('Veuillez entrer un numéro de paiement.');
        }
        if ($('#boostFacebook').is(':checked')) {
            const boostFbAmount = parseInt($('#boostFacebookAmount').val()) || 0;
            if (boostFbAmount < 700) {
                errors.push('Le montant minimum pour le boost Facebook est de 700 FCFA.');
            }
        }

        return errors;
    }

    $(document).on('submit', '#produitServiceForm', async function(e) {
        e.preventDefault();

        const errors = validateProduitServiceForm();
        if (errors.length > 0) {
            showAlert('Attention !!!', errors.join('<br>'), 'warning');
            return;
        }

        // Désactiver le bouton et afficher le spinner
        const $submitBtn = $('#submitProduitService');
        $submitBtn.prop('disabled', true);
        $('#submitSpinner').show();
        $('#submitText').text('Traitement en cours...');

        try {
            const formData = new FormData();
            formData.append('idFormulePromoAffaire', currentFormuleData.id);
            formData.append('text', $('#descriptionPromo').val());
            formData.append('uid', getUID());
            formData.append('image', selectedImage);
            formData.append('paymentMethod', $('#paymentMethod').val());
            formData.append('tel', $('#paymentNumber').val());
            formData.append('inProgrammeRecompense', $('#participateReward').is(':checked'));
            formData.append('rewardBudget', $('#rewardBudget').val());
            formData.append('publishOnDressurStatus', $('#publishDressurStatus').is(':checked'));
            formData.append('boostFacebook', $('#boostFacebook').is(':checked') ? '1' : '0');
            formData.append('montantBoostFacebook', $('#boostFacebookAmount').val() || '0');
            formData.append('whatsappContact', $('#whatsappContact').val().trim());
            formData.append('source', 'web');

            const response = await fetch(`${API_BASE_URL}/addProduitService`, {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (response.ok && !data.error) {
                showAlert('Succès', 'Votre promotion a été enregistrée avec succès. Elle sera publiée après paiement et accord d\'un administrateur.', 'success');
                
                // Réinitialiser le formulaire
                $('#produitServiceForm')[0].reset();
                $('#imagePreview').html('');
                selectedImage = null;
                currentFormuleData = { id: 0, prix: 0, jours: 0, titre: '' };
                updatePricingSummary();
                updateSubmitButtonsState();
            } else {
                showAlert(data.titre || 'Erreur', data.message || 'Une erreur est survenue.', 'danger');
            }
        } catch (error) {
            console.error('Erreur:', error);
            showAlert('Erreur', 'Une erreur est survenue lors de l\'envoi. Veuillez réessayer.', 'danger');
        } finally {
            $submitBtn.prop('disabled', false);
            $('#submitSpinner').hide();
            $('#submitText').text('VALIDER ET PAYER');
            updateSubmitButtonsState();
        }
    });

