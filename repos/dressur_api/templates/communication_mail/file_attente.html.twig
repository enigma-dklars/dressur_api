{% extends 'baseAdmin.html.twig' %}

{% block title %}Communication Mail — File d'attente{% endblock %}

{% block body %}

<style>
@keyframes badge-pop {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.35); }
    100% { transform: scale(1); }
}
.badge-pop { animation: badge-pop .35s ease; }
</style>

<div class="d-flex align-items-center mb-3">
    <h4 class="mb-0">
        <i class="fas fa-list me-2 text-primary"></i>File d'attente d'envoi
        <span id="badge-attente"
              class="badge bg-warning text-dark ms-2"
              style="font-size:.65rem;vertical-align:middle;">
            {{ entries|filter(e => e.statut == 'en_attente')|length }} en attente
        </span>
    </h4>
    <div class="ms-auto d-flex gap-2">
        {% if entries|length > 0 %}
        <button type="button" class="btn btn-sm btn-danger" id="btn-delete-all"
                data-total="{{ entries|length }}">
            <i class="fas fa-trash-alt me-1"></i>Tout supprimer
            <span class="badge bg-light text-danger ms-1">{{ entries|length }}</span>
        </button>
        {% endif %}
        <a href="{{ path('app_communication_mail_portal') }}" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Retour au portail
        </a>
    </div>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="card mb-3 border-primary">
    <div class="card-body py-2 px-3 d-flex align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2">
            <span id="batch-spinner" class="spinner-border spinner-border-sm text-primary d-none" role="status"></span>
            <span id="batch-status" class="small text-muted">En attente du prochain envoi…</span>
        </div>
        <div class="ms-auto d-flex align-items-center gap-2">
            <span class="small text-muted">Prochain envoi dans <strong id="countdown">1:00</strong></span>
            <button type="button" class="btn btn-sm btn-primary" id="btn-send-now">
                <i class="fas fa-paper-plane me-1"></i>Envoyer maintenant
            </button>
        </div>
    </div>
    <div id="batch-log" class="px-3 pb-2" style="display:none;max-height:120px;overflow-y:auto;font-size:0.8rem;"></div>
</div>

{% if entries|length > 0 %}
<form id="form-delete-multiple" method="post"
      action="{{ path('app_communication_mail_file_attente_delete_multiple') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete_multiple_file_attente') }}">

    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-select-all">
            <i class="fas fa-check-square me-1"></i>Tout sélectionner
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-deselect-all">
            <i class="fas fa-square me-1"></i>Tout désélectionner
        </button>
        <button type="button" class="btn btn-sm btn-danger ms-auto" id="btn-delete-selected" disabled>
            <i class="fas fa-trash me-1"></i>Supprimer la sélection
            <span class="badge bg-light text-danger ms-1" id="count-selected">0</span>
        </button>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <table class="data-table table table-bordered table-striped mb-0">
                <thead>
                    <tr>
                        <th style="width:40px;" class="text-center">
                            <input type="checkbox" id="checkbox-master" class="form-check-input" title="Tout sélectionner">
                        </th>
                        <th>#</th>
                        <th>Destinataire</th>
                        <th>Sujet</th>
                        <th>Statut</th>
                        <th>Ajouté le</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for entry in entries %}
                    <tr class="row-entry">
                        <td class="text-center">
                            <input type="checkbox" name="ids[]" value="{{ entry.id }}"
                                   class="form-check-input row-checkbox">
                        </td>
                        <td>{{ entry.id }}</td>
                        <td>{{ entry.sendto }}</td>
                        <td class="small text-muted" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                            {{ entry.sujet }}
                        </td>
                        <td>
                            {% if entry.statut == 'en_attente' %}
                                <span class="badge bg-warning text-dark">En attente</span>
                            {% elseif entry.statut == 'envoye' %}
                                <span class="badge bg-success">Envoyé</span>
                            {% elseif entry.statut == 'erreur' %}
                                <span class="badge bg-danger">Erreur</span>
                            {% else %}
                                <span class="badge bg-secondary">{{ entry.statut }}</span>
                            {% endif %}
                        </td>
                        <td class="small">{{ entry.createdAt|date('d/m/Y H:i') }}</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    onclick="deleteSingle({{ entry.id }}, '{{ csrf_token('delete' ~ entry.id) }}', this)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small d-flex justify-content-between">
            <span>{{ entries|length }} entrée(s) au total</span>
            <span>
                <span id="footer-attente">{{ entries|filter(e => e.statut == 'en_attente')|length }}</span> en attente ·
                <span id="footer-envoye">{{ entries|filter(e => e.statut == 'envoye')|length }}</span> envoyés ·
                <span id="footer-erreur">{{ entries|filter(e => e.statut == 'erreur')|length }}</span> erreurs
            </span>
        </div>
    </div>
</form>

<form id="form-delete-single" method="post" style="display:none;">
    <input type="hidden" name="_token" id="single-token">
</form>

<form id="form-delete-all" method="post"
      action="{{ path('app_communication_mail_file_attente_delete_all') }}"
      style="display:none;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete_all_file_attente') }}">
</form>

{% else %}
<div class="card">
    <div class="card-body p-0">
        <table class="data-table table table-bordered table-striped mb-0">
            <thead>
                <tr>
                    <th style="width:40px;"></th>
                    <th>#</th>
                    <th>Destinataire</th>
                    <th>Sujet</th>
                    <th>Statut</th>
                    <th>Ajouté le</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">Aucun mail en file d'attente.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
{% endif %}

<script>
// ── Sélection multiple ───────────────────────────────────────────────────────
(function () {
    const master         = document.getElementById('checkbox-master');
    const checkboxes     = () => document.querySelectorAll('.row-checkbox');
    const btnSelectAll   = document.getElementById('btn-select-all');
    const btnDeselectAll = document.getElementById('btn-deselect-all');
    const btnDelete      = document.getElementById('btn-delete-selected');
    const countBadge     = document.getElementById('count-selected');
    const formMultiple   = document.getElementById('form-delete-multiple');

    if (!master) return;

    function updateUI() {
        const all     = checkboxes();
        const checked = document.querySelectorAll('.row-checkbox:checked');
        const n       = checked.length;

        countBadge.textContent = n;
        btnDelete.disabled     = n === 0;

        master.indeterminate = n > 0 && n < all.length;
        master.checked       = n === all.length && all.length > 0;

        document.querySelectorAll('.row-entry').forEach(row => {
            const cb = row.querySelector('.row-checkbox');
            row.classList.toggle('table-active', cb && cb.checked);
        });
    }

    master.addEventListener('change', function () {
        checkboxes().forEach(cb => { cb.checked = master.checked; });
        updateUI();
    });

    document.querySelectorAll('.row-checkbox').forEach(cb => {
        cb.addEventListener('change', updateUI);
    });

    if (btnSelectAll) btnSelectAll.addEventListener('click', function () {
        checkboxes().forEach(cb => { cb.checked = true; });
        updateUI();
    });

    if (btnDeselectAll) btnDeselectAll.addEventListener('click', function () {
        checkboxes().forEach(cb => { cb.checked = false; });
        updateUI();
    });

    if (btnDelete) btnDelete.addEventListener('click', function () {
        const n = document.querySelectorAll('.row-checkbox:checked').length;
        Swal.fire({
            title: 'Confirmer la suppression',
            text: n + ' élément(s) sélectionné(s) seront supprimés définitivement.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: '<i class="fas fa-trash me-1"></i>Supprimer',
            cancelButtonText: 'Annuler'
        }).then(function (result) {
            if (result.isConfirmed) { formMultiple.submit(); }
        });
    });

    // Tout supprimer
    const btnDeleteAll = document.getElementById('btn-delete-all');
    if (btnDeleteAll) {
        btnDeleteAll.addEventListener('click', function () {
            const total = this.dataset.total;
            Swal.fire({
                title: 'Vider la file d\'attente mail ?',
                html: '<strong>' + total + ' entrée(s)</strong> seront supprimées définitivement.<br>Cette action est irréversible.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-trash-alt me-1"></i>Tout supprimer',
                cancelButtonText: 'Annuler',
                focusCancel: true
            }).then(function (result) {
                if (result.isConfirmed) {
                    document.getElementById('form-delete-all').submit();
                }
            });
        });
    }
})();

function deleteSingle(id, token) {
    Swal.fire({
        title: 'Supprimer cet envoi ?',
        text: 'Cette action est irréversible.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: '<i class="fas fa-trash me-1"></i>Supprimer',
        cancelButtonText: 'Annuler'
    }).then(function (result) {
        if (result.isConfirmed) {
            const form  = document.getElementById('form-delete-single');
            form.action = '/crud/communication-mail/file-attente/' + id + '/delete';
            document.getElementById('single-token').value = token;
            form.submit();
        }
    });
}

// ── Envoi automatique par lot (Ajax toutes les 1 min) ────────────────────────
(function () {
    const INTERVAL_MS   = 1 * 60 * 1000;
    const BATCH_URL     = '{{ path('app_communication_mail_file_attente_process_batch') }}';

    const elStatus      = document.getElementById('batch-status');
    const elSpinner     = document.getElementById('batch-spinner');
    const elCountdown   = document.getElementById('countdown');
    const elLog         = document.getElementById('batch-log');
    const btnSendNow    = document.getElementById('btn-send-now');
    const elBadge       = document.getElementById('badge-attente');
    const elFooterAtt   = document.getElementById('footer-attente');
    const elFooterEnv   = document.getElementById('footer-envoye');
    const elFooterErr   = document.getElementById('footer-erreur');

    function updateCounters(remaining, newEnvoye, newErreur) {
        // Badge dans le titre
        if (elBadge) {
            elBadge.textContent = remaining + ' en attente';
            elBadge.classList.toggle('bg-warning', remaining > 0);
            elBadge.classList.toggle('text-dark',  remaining > 0);
            elBadge.classList.toggle('bg-success', remaining === 0);
            elBadge.classList.toggle('text-white', remaining === 0);
            // Animation pop subtile
            elBadge.classList.remove('badge-pop');
            void elBadge.offsetWidth; // reflow pour relancer l'animation
            elBadge.classList.add('badge-pop');
        }
        // Footer
        if (elFooterAtt) elFooterAtt.textContent = remaining;
        if (elFooterEnv && newEnvoye !== undefined) elFooterEnv.textContent = parseInt(elFooterEnv.textContent || 0) + newEnvoye;
        if (elFooterErr && newErreur !== undefined) elFooterErr.textContent = parseInt(elFooterErr.textContent || 0) + newErreur;
    }

    let secondsLeft = INTERVAL_MS / 1000;
    let countdownTimer = null;
    let sending = false;

    function pad(n) { return String(n).padStart(2, '0'); }

    function startCountdown() {
        secondsLeft = INTERVAL_MS / 1000;
        clearInterval(countdownTimer);
        countdownTimer = setInterval(function () {
            secondsLeft--;
            const m = Math.floor(secondsLeft / 60);
            const s = secondsLeft % 60;
            elCountdown.textContent = m + ':' + pad(s);
            if (secondsLeft <= 0) {
                clearInterval(countdownTimer);
                sendBatch();
            }
        }, 1000);
    }

    function addLog(html) {
        elLog.style.display = 'block';
        const line = document.createElement('div');
        line.innerHTML = html;
        elLog.prepend(line);
    }

    function updateRowStatut(id, statut) {
        const row = document.querySelector('tr.row-entry [name="ids[]"][value="' + id + '"]');
        if (!row) return;
        const tr  = row.closest('tr');
        const td  = tr.querySelector('td:nth-child(5)');
        if (!td) return;
        const badges = {
            'envoye': '<span class="badge bg-success">Envoyé</span>',
            'erreur': '<span class="badge bg-danger">Erreur</span>',
        };
        td.innerHTML = badges[statut] || td.innerHTML;
    }

    function sendBatch() {
        if (sending) return;
        sending = true;
        elSpinner.classList.remove('d-none');
        elStatus.textContent = 'Envoi en cours…';
        btnSendNow.disabled  = true;

        fetch(BATCH_URL, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            const now = new Date().toLocaleTimeString('fr-FR');
            if (data.processed === 0) {
                elStatus.textContent = 'File d\'attente vide.';
                addLog('<span class="text-muted">[' + now + '] Aucun mail en attente.</span>');
                updateCounters(0);
            } else {
                const ok  = data.results.filter(function (r) { return r.statut === 'envoye'; }).length;
                const err = data.results.filter(function (r) { return r.statut === 'erreur'; }).length;

                elStatus.textContent = data.processed + ' mail(s) traité(s) — ' + data.remaining + ' restant(s).';

                data.results.forEach(function (r) {
                    updateRowStatut(r.id, r.statut);
                    const icon   = r.statut === 'envoye' ? '✅' : '❌';
                    addLog('<span class="text-muted">[' + now + ']</span> ' + icon + ' ' + r.sendto);
                });

                addLog(
                    '<strong>[' + now + '] Lot envoyé : ' + ok + ' ✅ ' + err + ' ❌ — ' +
                    data.remaining + ' en attente</strong>'
                );

                updateCounters(data.remaining, ok, err);
            }
        })
        .catch(function () {
            elStatus.textContent = 'Erreur lors de la requête.';
            addLog('<span class="text-danger">[Erreur réseau] La requête a échoué.</span>');
        })
        .finally(function () {
            sending = false;
            elSpinner.classList.add('d-none');
            btnSendNow.disabled = false;
            startCountdown();
        });
    }

    btnSendNow.addEventListener('click', function () {
        clearInterval(countdownTimer);
        sendBatch();
    });

    startCountdown();
})();
</script>

{% endblock %}
