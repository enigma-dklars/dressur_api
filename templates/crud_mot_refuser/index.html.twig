{% extends 'basePrivate.html.twig' %}

{% block title %}MotRefuser index{% endblock %}

{% block body %}
    <span class="h4 me-3">MotRefuser index</span>
    <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_mot_refuser_new') }}">Create new</a>

    <table class="data-table table table-bordered table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Mot</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for mot_refuser in mot_refusers %}
            <tr>
                <td>{{ mot_refuser.id }}</td>
                <td>{{ mot_refuser.mot }}</td>
                <td>
                    {% include "crud_mot_refuser/_delete_form.html.twig" %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
