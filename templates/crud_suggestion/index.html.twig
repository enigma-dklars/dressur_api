{% extends 'basePrivate.html.twig' %}

{% block title %}Suggestion index{% endblock %}

{% block body %}
    <p class="h4 me-3">Suggestion index</p>
    {# <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_suggestion_new') }}">Create new</a> #}

    <table class="data-table table table-bordered table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Suggestion</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for suggestion in suggestions %}
            <tr>
                <td>{{ suggestion.id }}</td>
                <td>{{ suggestion.suggestion|nl2br }}</td>
                <td>
                    {% include "crud_suggestion/_delete_form.html.twig" %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
