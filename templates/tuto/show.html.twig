{% extends 'baseAdmin.html.twig' %}

{% block title %}Tuto{% endblock %}

{% block body %}
    <h1>Tuto</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ tuto.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ tuto.titre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ tuto.description }}</td>
            </tr>
            <tr>
                <th>Url</th>
                <td>{{ tuto.url }}</td>
            </tr>
            <tr>
                <th>Activated</th>
                <td>{{ tuto.activated ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ tuto.createdAt ? tuto.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ tuto.updatedAt ? tuto.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_tuto_index') }}">back to list</a>

    {{ include('tuto/_delete_form.html.twig') }}
{% endblock %}
