{% extends 'baseAdmin.html.twig' %}

{% block title %}Communication Mail — Portail{% endblock %}

{% block body %}

<div class="d-flex align-items-center mb-4">
    <h4 class="mb-0"><i class="fas fa-envelope me-2 text-primary"></i>Communication par Mail</h4>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

{# ── Statistiques rapides ── #}
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="display-6 fw-bold text-warning">{{ nb_attente }}</div>
            <div class="text-muted small">En attente d'envoi</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="display-6 fw-bold text-success">{{ nb_envoye }}</div>
            <div class="text-muted small">Envoyés</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="display-6 fw-bold text-primary">{{ nb_prospects }}</div>
            <div class="text-muted small">Adresses en base</div>
        </div>
    </div>
</div>

{# ── Campagnes & outils ── #}
<h5 class="mb-3 fw-semibold">Campagnes</h5>
<div class="row g-3 mb-4">

    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="mb-3"><span class="fs-1">🚀</span></div>
                <h5 class="card-title fw-semibold">Attirer de nouveaux utilisateurs</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Envoyez un mail engageant à des adresses externes pour les inviter à rejoindre Dressur via le web ou l'application mobile.
                </p>
                <a href="{{ path('app_communication_mail_campagne_prospect') }}" class="btn btn-primary mt-2">
                    <i class="fas fa-paper-plane me-1"></i>Lancer la campagne
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="mb-3"><span class="fs-1">📋</span></div>
                <h5 class="card-title fw-semibold">File d'attente d'envoi</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Consultez et gérez les mails en attente d'envoi, envoyés ou en erreur.
                    {% if nb_attente > 0 %}
                        <br><span class="badge bg-warning text-dark mt-1">{{ nb_attente }} en attente</span>
                    {% endif %}
                </p>
                <a href="{{ path('app_communication_mail_file_attente') }}" class="btn btn-outline-secondary mt-2">
                    <i class="fas fa-list me-1"></i>Voir la file d'attente
                </a>
            </div>
        </div>
    </div>

</div>

<h5 class="mb-3 fw-semibold">Base de données</h5>
<div class="row g-3">

    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="mb-3"><span class="fs-1">🗂️</span></div>
                <h5 class="card-title fw-semibold">Adresses en base</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Consultez toutes les adresses mail collectées lors des campagnes. Ces adresses sont conservées pour des réutilisations futures.
                    <br><span class="badge bg-primary mt-1">{{ nb_prospects }} adresse(s)</span>
                </p>
                <a href="{{ path('app_communication_mail_prospects') }}" class="btn btn-outline-primary mt-2">
                    <i class="fas fa-database me-1"></i>Voir la liste
                </a>
            </div>
        </div>
    </div>

</div>

{% endblock %}
