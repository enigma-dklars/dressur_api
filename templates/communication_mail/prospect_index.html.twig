{% extends 'baseAdmin.html.twig' %}

{% block title %}Communication Mail — Liste des prospects{% endblock %}

{% block body %}

<div class="d-flex align-items-center mb-3">
    <p class="h4 me-3 mb-0"><i class="fas fa-envelope me-2 text-primary"></i>Prospects mail</p>
    <a class="btn btn-sm btn-primary ms-auto" href="{{ path('app_communication_mail_prospect_new') }}">
        <i class="fas fa-plus me-1"></i>Importer des adresses
    </a>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="card">
    <div class="card-body p-0">
        <table class="data-table table table-bordered table-striped mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Email</th>
                    <th>Statut</th>
                    <th>Enregistré le</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for prospect in prospects %}
                <tr>
                    <td>{{ prospect.id }}</td>
                    <td>{{ prospect.email }}</td>
                    <td>
                        {% if prospect.statut == 'en_attente' %}
                            <span class="badge bg-secondary">En attente</span>
                        {% elseif prospect.statut == 'envoye' %}
                            <span class="badge bg-success">Envoyé</span>
                        {% elseif prospect.statut == 'erreur' %}
                            <span class="badge bg-danger">Erreur</span>
                        {% else %}
                            <span class="badge bg-light text-dark">{{ prospect.statut }}</span>
                        {% endif %}
                    </td>
                    <td>{{ prospect.createdAt|date('d/m/Y H:i') }}</td>
                    <td>
                        <form method="post" action="{{ path('app_communication_mail_prospect_delete', {id: prospect.id}) }}" onsubmit="return confirm('Supprimer cette adresse ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ prospect.id) }}">
                            <button type="submit" class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Aucune adresse enregistrée.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if prospects|length > 0 %}
    <div class="card-footer text-muted small">
        {{ prospects|length }} adresse(s) au total
    </div>
    {% endif %}
</div>

{% endblock %}
