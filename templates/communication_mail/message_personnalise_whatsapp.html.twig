{% extends 'baseAdmin.html.twig' %}

{% block title %}Message WhatsApp Personnalisé{% endblock %}

{% block body %}

<div class="d-flex align-items-center mb-4">
    <h4 class="mb-0">
        <i class="fab fa-whatsapp me-2 text-success"></i>Message WhatsApp Personnalisé
    </h4>
    <a href="{{ path('app_communication_mail_portal') }}" class="btn btn-sm btn-outline-secondary ms-auto">
        <i class="fas fa-arrow-left me-1"></i>Retour au portail
    </a>
</div>


<div class="row g-4">

    {# ── Colonne gauche : formulaire ── #}
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-semibold">
                <i class="fas fa-pen me-1 text-success"></i>Composer le message
            </div>
            <div class="card-body">

                <form method="post" action="{{ path('app_communication_mail_message_personnalise_whatsapp') }}"
                      onsubmit="return confirm('Confirmer l\'ajout des messages à la file d\'attente WhatsApp ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('message_personnalise_whatsapp') }}">

                    {# ── Sélection de l'audience ── #}
                    <div class="mb-4">
                        <label for="audience" class="form-label fw-semibold">
                            <i class="fas fa-users me-1 text-primary"></i>Audience cible
                        </label>
                        <select class="form-select" id="audience" name="audience" required>
                            <option value="" disabled selected>— Choisir une audience —</option>
                            {% for group, groupAudiences in audiencesByGroup %}
                                <optgroup label="{{ group }}">
                                    {% for key, a in groupAudiences %}
                                        <option value="{{ key }}" data-description="{{ a.description|e('html_attr') }}">
                                            {{ a.emoji }} {{ a.label }} — {{ audienceCounts[key]|default(0) }} utilisateur(s)
                                        </option>
                                    {% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>
                        <div id="audience-count" class="alert alert-info d-none py-2 px-3 mt-2 mb-0" role="status" aria-live="polite">
                            <div>
                                <i class="fas fa-users me-1"></i>
                                <strong id="audience-count-value">0</strong>
                                <span id="audience-count-label">utilisateur correspondant</span>
                            </div>
                            <div id="audience-count-description" class="small mt-1"></div>
                        </div>
                        <div class="form-text">
                            Seuls les utilisateurs avec un numéro WhatsApp confirmé sont inclus. Chaque utilisateur est compté et programmé une seule fois.
                        </div>
                    </div>

                    {# ── Rédaction du message ── #}
                    <div class="mb-3">
                        <label for="message" class="form-label fw-semibold">
                            <i class="fab fa-whatsapp me-1 text-success"></i>Message
                        </label>
                        <textarea class="form-control font-monospace"
                                  id="message"
                                  name="message"
                                  rows="10"
                                  required
                                  placeholder="Bonjour {pseudo} !&#10;&#10;Votre compte Dressur ({mail}) est prêt.&#10;&#10;Contactez-nous au besoin."
                                  oninput="updatePreview()"></textarea>
                        <div class="form-text">
                            Utilisez les variables ci-dessous pour personnaliser le message pour chaque utilisateur.
                        </div>
                    </div>

                    {# ── Variables disponibles ── #}
                    <div class="mb-4">
                        <div class="small fw-semibold text-muted mb-2">
                            <i class="fas fa-tags me-1"></i>Variables disponibles — cliquez pour insérer :
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            {% for var, desc in {
                                '{pseudo}': 'Pseudo',
                                '{nom}':    'Nom',
                                '{mail}':   'Adresse mail',
                                '{tel}':    'Téléphone',
                                '{uid}':    'Identifiant unique'
                            } %}
                                <button type="button"
                                        class="btn btn-sm btn-outline-success font-monospace"
                                        onclick="insertVariable('{{ var }}')">
                                    {{ var }}
                                    <span class="text-muted ms-1 fw-normal" style="font-family:sans-serif;font-size:11px;">{{ desc }}</span>
                                </button>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fab fa-whatsapp me-2"></i>Ajouter à la file d'attente WhatsApp
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>

    {# ── Colonne droite : aperçu en temps réel ── #}
    <div class="col-md-5">

        {# Info audience ── #}
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold">
                <i class="fas fa-info-circle me-1 text-primary"></i>À propos des audiences
            </div>
                <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    {% for group, groupAudiences in audiencesByGroup %}
                        <li class="list-group-item py-2 px-3 bg-light text-uppercase fw-semibold" style="font-size:10px; letter-spacing:.04em;">
                            {{ group }}
                        </li>
                        {% for key, a in groupAudiences %}
                        <li class="list-group-item d-flex align-items-start gap-2 small">
                            <span class="fs-5">{{ a.emoji }}</span>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">{{ a.label }}</div>
                                <div class="text-muted" style="font-size:11px;">{{ a.description }}</div>
                                <span class="badge bg-info text-dark mt-1">{{ audienceCounts[key]|default(0) }} utilisateur(s)</span>
                            </div>
                        </li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>
        </div>

        {# Aperçu du message ── #}
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-semibold">
                <i class="fab fa-whatsapp me-1 text-success"></i>Aperçu du message
                <span class="badge bg-secondary ms-2 small fw-normal">exemple avec données fictives</span>
            </div>
            <div class="card-body" style="background:#f8f9fa;">
                <div id="preview-bubble"
                     style="background:#e9fbe5;border-radius:16px 16px 4px 16px;padding:16px 20px;font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;line-height:1.6;color:#111;white-space:pre-wrap;word-break:break-word;box-shadow:0 1px 3px rgba(0,0,0,.12);min-height:80px;">
                    <span class="text-muted fst-italic">Votre message apparaîtra ici…</span>
                </div>
                <div class="text-end small text-muted mt-2" style="font-size:11px;">✓✓ Envoyé</div>
                <div class="mt-3 p-2 rounded" style="background:#fff3cd;font-size:11px;color:#856404;">
                    <i class="fas fa-info-circle me-1"></i>
                    Les variables seront remplacées par les données réelles de chaque utilisateur au moment de l'enregistrement.
                </div>
            </div>
        </div>

    </div>

</div>

<script>
const AUDIENCE_COUNTS = {{ audienceCounts|json_encode|raw }};

function updateAudienceCount() {
    const audienceSelect = document.getElementById('audience');
    const selectedOption = audienceSelect.options[audienceSelect.selectedIndex];
    const countBox = document.getElementById('audience-count');
    const countValue = document.getElementById('audience-count-value');
    const countLabel = document.getElementById('audience-count-label');
    const countDescription = document.getElementById('audience-count-description');
    const count = AUDIENCE_COUNTS[audienceSelect.value];

    if (count === undefined) {
        countBox.classList.add('d-none');
        return;
    }

    countValue.textContent = new Intl.NumberFormat('fr-FR').format(count);
    countLabel.textContent = count === 1
        ? 'utilisateur correspond à cette audience.'
        : 'utilisateurs correspondent à cette audience.';
    countDescription.textContent = selectedOption.dataset.description || '';
    countBox.classList.remove('d-none');
}

document.getElementById('audience').addEventListener('change', updateAudienceCount);

const FAKE_DATA = {
    '{pseudo}': 'jean_dupont',
    '{nom}':    'Jean Dupont',
    '{mail}':   'jean.dupont@example.com',
    '{tel}':    '+22890123456',
    '{uid}':    'abc123xyz',
};

function updatePreview() {
    const textarea = document.getElementById('message');
    const bubble   = document.getElementById('preview-bubble');
    const raw = textarea.value;

    bubble.textContent = '';

    if (raw.trim() === '') {
        const placeholder = document.createElement('span');
        placeholder.className = 'text-muted fst-italic';
        placeholder.textContent = 'Votre message apparaîtra ici…';
        bubble.appendChild(placeholder);
        return;
    }

    // Split text on known variables, render each part safely
    const pattern = /(\{pseudo\}|\{nom\}|\{mail\}|\{tel\}|\{uid\})/g;
    const parts = raw.split(pattern);

    parts.forEach(part => {
        if (FAKE_DATA[part] !== undefined) {
            const strong = document.createElement('strong');
            strong.className = 'text-success';
            strong.textContent = FAKE_DATA[part];
            bubble.appendChild(strong);
        } else {
            bubble.appendChild(document.createTextNode(part));
        }
    });
}

function insertVariable(variable) {
    const textarea = document.getElementById('message');
    const start = textarea.selectionStart;
    const end   = textarea.selectionEnd;
    textarea.value = textarea.value.substring(0, start) + variable + textarea.value.substring(end);
    textarea.selectionStart = textarea.selectionEnd = start + variable.length;
    textarea.focus();
    updatePreview();
}
</script>

{% endblock %}
