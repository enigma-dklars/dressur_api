{% extends 'baseAdmin.html.twig' %}

{% block title %}Communication Mail — File d'attente{% endblock %}

{% block body %}

<div class="d-flex align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-list me-2 text-primary"></i>File d'attente d'envoi</h4>
    <a href="{{ path('app_communication_mail_portal') }}" class="btn btn-sm btn-outline-secondary ms-auto">
        <i class="fas fa-arrow-left me-1"></i>Retour au portail
    </a>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="card">
    <div class="card-body p-0">
        <table class="data-table table table-bordered table-striped mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Destinataire</th>
                    <th>Sujet</th>
                    <th>Statut</th>
                    <th>Ajouté le</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for entry in entries %}
                <tr>
                    <td>{{ entry.id }}</td>
                    <td>{{ entry.sendto }}</td>
                    <td class="small text-muted" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                        {{ entry.sujet }}
                    </td>
                    <td>
                        {% if entry.statut == 'en_attente' %}
                            <span class="badge bg-warning text-dark">En attente</span>
                        {% elseif entry.statut == 'envoye' %}
                            <span class="badge bg-success">Envoyé</span>
                        {% elseif entry.statut == 'erreur' %}
                            <span class="badge bg-danger">Erreur</span>
                        {% else %}
                            <span class="badge bg-secondary">{{ entry.statut }}</span>
                        {% endif %}
                    </td>
                    <td class="small">{{ entry.createdAt|date('d/m/Y H:i') }}</td>
                    <td>
                        <form method="post" action="{{ path('app_communication_mail_file_attente_delete', {id: entry.id}) }}"
                              onsubmit="return confirm('Supprimer cet envoi ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entry.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Aucun mail en file d'attente.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if entries|length > 0 %}
    <div class="card-footer text-muted small d-flex justify-content-between">
        <span>{{ entries|length }} entrée(s) au total</span>
        <span>
            {{ entries|filter(e => e.statut == 'en_attente')|length }} en attente ·
            {{ entries|filter(e => e.statut == 'envoye')|length }} envoyés ·
            {{ entries|filter(e => e.statut == 'erreur')|length }} erreurs
        </span>
    </div>
    {% endif %}
</div>

{% endblock %}
