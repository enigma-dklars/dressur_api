{% extends 'baseAdmin.html.twig' %}

{% block title %}Communication Mail — Adresses en base{% endblock %}

{% block body %}

<div class="d-flex align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-database me-2 text-primary"></i>Adresses mail en base</h4>
    <a href="{{ path('app_communication_mail_portal') }}" class="btn btn-sm btn-outline-secondary ms-auto">
        <i class="fas fa-arrow-left me-1"></i>Retour au portail
    </a>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="card">
    <div class="card-body p-0">
        <table class="data-table table table-bordered table-striped mb-0" data-order='[[0,"desc"]]'>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Adresse mail</th>
                    <th>Ajoutée le</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for prospect in prospects %}
                <tr>
                    <td>{{ prospect.id }}</td>
                    <td class="font-monospace">{{ prospect.email }}</td>
                    <td class="small">{{ prospect.createdAt|date('d/m/Y H:i') }}</td>
                    <td>
                        <form method="post" action="{{ path('app_communication_mail_prospect_delete', {id: prospect.id}) }}"
                              onsubmit="return confirm('Supprimer cette adresse de la base ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ prospect.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">Aucune adresse enregistrée.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if prospects|length > 0 %}
    <div class="card-footer text-muted small">
        {{ prospects|length }} adresse(s) en base
    </div>
    {% endif %}
</div>

{% endblock %}
