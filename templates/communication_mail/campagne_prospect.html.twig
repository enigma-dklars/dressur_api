{% extends 'baseAdmin.html.twig' %}

{% block title %}Campagne — Attirer de nouveaux utilisateurs{% endblock %}

{% block body %}

<div class="d-flex align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-paper-plane me-2 text-primary"></i>Attirer de nouveaux utilisateurs</h4>
    <a href="{{ path('app_communication_mail_portal') }}" class="btn btn-sm btn-outline-secondary ms-auto">
        <i class="fas fa-arrow-left me-1"></i>Retour au portail
    </a>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="row g-4">

    {# ── Colonne gauche : saisie des adresses ── #}
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                <i class="fas fa-at me-1"></i>Adresses destinataires
            </div>
            <div class="card-body">

                <form method="post" action="{{ path('app_communication_mail_campagne_prospect') }}">

                    <div class="mb-3">
                        <label class="form-label small text-muted">Sujet du mail</label>
                        <div class="form-control-plaintext fw-semibold small border rounded px-2 py-1 bg-light">{{ sujet }}</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted">Reply-to (expéditeur)</label>
                        <div class="form-control-plaintext small border rounded px-2 py-1 bg-light">{{ replyto }}</div>
                    </div>

                    <div class="mb-3">
                        <label for="emails" class="form-label fw-semibold">
                            Adresses mail <span class="text-danger">*</span>
                        </label>
                        <textarea
                            id="emails"
                            name="emails"
                            class="form-control font-monospace"
                            rows="12"
                            placeholder="exemple@mail.com, autre@mail.com&#10;encore@mail.com"
                            required
                        ></textarea>
                        <div class="form-text">
                            Séparateurs acceptés : virgule, point-virgule, espace, retour à la ligne.<br>
                            Les doublons et adresses invalides sont ignorés automatiquement.<br>
                            Chaque adresse est conservée dans la base de prospects.
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane me-1"></i>Valider et envoyer en file d'attente
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>

    {# ── Colonne droite : aperçu du mail ── #}
    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                <i class="fas fa-eye me-1"></i>Aperçu du mail envoyé
            </div>
            <div class="card-body p-0">
                <div class="p-3">
                    {{ contentmail|raw }}
                </div>
            </div>
        </div>
    </div>

</div>

{% endblock %}
