{% extends 'baseAdmin.html.twig' %}

{% block title %}Communication Mail — Historique des envois{% endblock %}

{% block body %}

<div class="d-flex align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-history me-2 text-primary"></i>Historique des envois</h4>
    <div class="ms-auto d-flex gap-2">
        {% if total_logs > 0 %}
            <form method="post" action="{{ path('app_communication_mail_log_clear') }}"
                  onsubmit="return confirm('Vider tout l\'historique des envois ? Cette action est irréversible.')">
                <input type="hidden" name="_token" value="{{ csrf_token('clear_mail_logs') }}">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="fas fa-trash-can me-1"></i>Vider les logs
                </button>
            </form>
        {% endif %}
        <a href="{{ path('app_communication_mail_portal') }}" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Retour au portail
        </a>
    </div>
</div>

{# ── Stats par sender (round-robin) — masquées par défaut ────────────────── #}
{% if stats_sender|length > 0 %}
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header py-2 px-3 bg-transparent d-flex align-items-center">
        <span class="fw-semibold small">
            <i class="fas fa-chart-bar me-1 text-primary"></i>Répartition round-robin par compte d'envoi
        </span>
        <button class="btn btn-sm btn-outline-secondary ms-auto"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#stats-rr"
                aria-expanded="false"
                aria-controls="stats-rr"
                id="btn-toggle-stats">
            <i class="fas fa-eye me-1"></i>Afficher
        </button>
    </div>
    <div class="collapse" id="stats-rr">
        <div class="card-body p-3">
            {% set total_all = 0 %}
            {% for s in stats_sender %}{% set total_all = total_all + s.total %}{% endfor %}
            <div class="row g-2">
            {% for s in stats_sender %}
                {% set pct = total_all > 0 ? ((s.total / total_all) * 100)|round(1) : 0 %}
                <div class="col-md-6 col-lg-4">
                    <div class="p-2 border rounded">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-semibold text-truncate" style="max-width:70%;" title="{{ s.sender }}">
                                <i class="fas fa-envelope-open-text me-1 text-muted"></i>{{ s.sender }}
                            </span>
                            <span class="badge bg-primary">{{ s.total }}</span>
                        </div>
                        <div class="progress" style="height:6px;">
                            <div class="progress-bar" role="progressbar" style="width:{{ pct }}%"
                                 aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="text-end text-muted small mt-1">{{ pct }}%</div>
                    </div>
                </div>
            {% endfor %}
            </div>
        </div>
    </div>
</div>
<script>
(function () {
    const el  = document.getElementById('stats-rr');
    const btn = document.getElementById('btn-toggle-stats');
    if (!el || !btn) return;
    el.addEventListener('show.bs.collapse',  function () { btn.innerHTML = '<i class="fas fa-eye-slash me-1"></i>Masquer'; });
    el.addEventListener('hide.bs.collapse',  function () { btn.innerHTML = '<i class="fas fa-eye me-1"></i>Afficher'; });
})();
</script>
{% endif %}

{# ── Filtres ──────────────────────────────────────────────────────────────── #}
<form method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body p-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1">Raison</label>
                <select name="raison" class="form-select form-select-sm">
                    <option value="">Toutes les raisons</option>
                    {% for row in raisons %}
                        <option value="{{ row.raison }}" {{ filters.raison == row.raison ? 'selected' : '' }}>
                            {{ row.raison }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Sender</label>
                <select name="sender" class="form-select form-select-sm">
                    <option value="">Tous les comptes</option>
                    {% for row in senders %}
                        <option value="{{ row.sender }}" {{ filters.sender == row.sender ? 'selected' : '' }}>
                            {{ row.sender }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Du</label>
                <input type="date" name="date_from" class="form-control form-control-sm"
                       value="{{ filters.date_from }}">
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Au</label>
                <input type="date" name="date_to" class="form-control form-control-sm"
                       value="{{ filters.date_to }}">
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">
                    <i class="fas fa-filter me-1"></i>Filtrer
                </button>
                <a href="{{ path('app_communication_mail_log') }}" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-times"></i>
                </a>
            </div>
        </div>
    </div>
</form>

{# ── Tableau des logs ─────────────────────────────────────────────────────── #}
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="data-table table table-bordered table-striped mb-0" data-order='[[4,"desc"]]'>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Raison</th>
                    <th>Sender</th>
                    <th>Destinataire</th>
                    <th>Date d'envoi</th>
                </tr>
            </thead>
            <tbody>
            {% if logs|length == 0 %}
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        {% if filters.raison or filters.sender or filters.date_from or filters.date_to %}
                            Aucun résultat pour ces filtres.
                        {% else %}
                            Aucun envoi enregistré pour le moment.
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                {% for log in logs %}
                <tr>
                    <td class="text-muted small">{{ log.id }}</td>
                    <td>
                        {% if log.raison == 'campagne_prospect' %}
                            <span class="badge bg-primary">campagne_prospect</span>
                        {% elseif log.raison == 'report' %}
                            <span class="badge bg-secondary">report</span>
                        {% elseif log.raison == 'general' %}
                            <span class="badge bg-light text-dark border">general</span>
                        {% else %}
                            <span class="badge bg-info text-dark">{{ log.raison }}</span>
                        {% endif %}
                    </td>
                    <td class="small text-muted">{{ log.emailSender }}</td>
                    <td class="small">{{ log.emailRecepteur }}</td>
                    <td class="small text-muted">{{ log.datEnvoi|date('d/m/Y H:i:s') }}</td>
                </tr>
                {% endfor %}
            {% endif %}
            </tbody>
        </table>
    </div>
    {% if logs|length > 0 %}
    <div class="card-footer text-muted small d-flex justify-content-between">
        <span>{{ logs|length }} entrée(s) affichée(s)</span>
        {% if logs|length == 500 %}
            <span class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>Limite de 500 résultats atteinte — affinez les filtres.</span>
        {% endif %}
    </div>
    {% endif %}
</div>

{% endblock %}
