{% extends 'baseAdmin.html.twig' %}

{% block title %}Env index{% endblock %}

{% block body %}
    <span class="h4 me-3">Env index</span>
    {# <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_env_new') }}">Create new</a> #}

    <div class="table-responsive">
        <table class="data-table table table-bordered table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th>Id</th>
                    <th>V. App</th>
                    <th>ImportantUpdate</th>
                    <th>V. DS BOT</th>
                    <th>🤖 IA Active</th>
                    <th>Frais adhésion vendeur</th>
                    <th>Recharge initiale développeur</th>
                    <th>Clé fournisseur</th>
                </tr>
            </thead>
            <tbody>
            {% for env in envs %}
                <tr>
                    <td>
                        {% include "crud_env/_delete_form.html.twig" %}
                    </td>
                    <td>{{ env.id }}</td>
                    <td>{{ env.versionApp }}</td>
                    <td>{{ env.importantUpdate ? 'Yes' : 'No' }}</td>
                    <td>{{ env.versionDressurBot }}</td>
                    <td>
                        {% if env.iaActive %}
                            <span class="badge bg-success">✅ Activé</span>
                        {% else %}
                            <span class="badge bg-danger">🔴 Désactivé</span>
                        {% endif %}
                    </td>
                    <td>{{ env.fraisAdhesionVendeur|number_format(0, ',', ' ') }} FCFA</td>
                    <td>{{ env.montantRechargeInitialeDeveloppeur|number_format(0, ',', ' ') }} FCFA</td>
                    <td>
                        {% if env.zefameApiKey is not empty %}
                            <span class="badge bg-success">Configurée</span>
                        {% else %}
                            <span class="badge bg-secondary">Non configurée</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="10">Aucun enregistrement.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}
