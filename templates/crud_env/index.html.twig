{% extends 'basePrivate.html.twig' %}

{% block title %}Env index{% endblock %}

{% block body %}
    <h1>Env index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>CommissionBonus</th>
                <th>VersionApp</th>
                <th>ImportantUpdate</th>
                <th>UsersTel</th>
                <th>DoBoostPayant</th>
                <th>LinkLocalServer</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for env in envs %}
            <tr>
                <td>{{ env.id }}</td>
                <td>{{ env.commissionBonus }}</td>
                <td>{{ env.versionApp }}</td>
                <td>{{ env.importantUpdate ? 'Yes' : 'No' }}</td>
                <td>{{ env.usersTel ? env.usersTel|json_encode : '' }}</td>
                <td>{{ env.doBoostPayant ? 'Yes' : 'No' }}</td>
                <td>{{ env.linkLocalServer }}</td>
                <td>
                    <a href="{{ path('app_crud_env_show', {'id': env.id}) }}">show</a>
                    <a href="{{ path('app_crud_env_edit', {'id': env.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_crud_env_new') }}">Create new</a>
{% endblock %}
