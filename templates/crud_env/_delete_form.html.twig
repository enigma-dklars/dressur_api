<form method="post" action="{{ path('app_crud_env_delete', {'id': env.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ env.id) }}">
    <a href="{{ path('app_crud_env_show', {'id': env.id}) }}" class="btn btn-sm btn-info">Show</a>
    <a href="{{ path('app_crud_env_edit', {'id': env.id}) }}" class="btn btn-sm btn-success">Edit</a>
    {# <button class="btn btn-sm btn-danger">Delete</button> #}
</form>
