{% extends 'baseAdmin.html.twig' %}
{% block title %}Boost{% endblock %}
{% block body %}
    <h1>Boost</h1>
    <table class="table table-bordered table-striped">
        <tbody>
            <tr><th>Id</th><td>{{ boost.id }}</td></tr>
            <tr><th>User</th><td>{{ boost.user.pseudo }}</td></tr>
            <tr><th>Formule</th><td>{{ boost.formuleBoost }}</td></tr>
            <tr>
                <th>Type</th>
                <td>
                    {% if boost.typeBoost == 'quota' %}
                        <span class="badge text-white" style="background:#6f42c1">Par Contacts (quota)</span>
                    {% else %}
                        <span class="badge bg-info text-dark">Par Durée (date)</span>
                    {% endif %}
                </td>
            </tr>
            <tr><th>Mode</th><td>{{ boost.mode }}</td></tr>
            <tr><th>Source</th><td>{{ boost.source }}</td></tr>
            <tr><th>DateDebut</th><td>{{ boost.dateDebut ? boost.dateDebut|date('Y-m-d H:i:s') : '' }}</td></tr>
            <tr>
                <th>DateExp</th>
                <td>{{ boost.dateExp ? boost.dateExp|date('Y-m-d H:i:s') : '— (quota non épuisé)' }}</td>
            </tr>
            <tr>
                <th>Contacts obtenus / max</th>
                <td>
                    {% if boost.typeBoost == 'quota' %}
                        {{ boost.nbContactsObtenus }} / {{ boost.formuleBoost.nbContactsMax }}
                    {% else %}
                        —
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>
    <a href="{{ path('app_crud_boost_index') }}">back to list</a>
    <a href="{{ path('app_crud_boost_edit', {'id': boost.id}) }}" class="btn btn-sm btn-success">Edit</a>
    {{ include('crud_boost/_delete_form.html.twig') }}
{% endblock %}
