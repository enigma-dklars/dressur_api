{% extends 'baseAdmin.html.twig' %}

{% block title %}Nouveau Boost Admin{% endblock %}

{% block body %}

<div class="row g-2 mb-3">
    <div class="col">
        <span class="h4"><i class="bi bi-rocket-takeoff me-2"></i>Ajouter un Boost Contact</span>
        <span class="badge bg-success ms-2">Activé immédiatement</span>
    </div>
    <div class="col-auto">
        <a href="{{ path('app_crud_boost_index') }}" class="btn btn-sm btn-secondary">
            <i class="bi bi-arrow-left me-1"></i>Retour à la liste
        </a>
    </div>
</div>

{% if errors is defined and errors|length > 0 %}
    <div class="alert alert-danger">
        <ul class="mb-0">
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}


<form method="post" action="{{ path('app_crud_boost_admin_new') }}">
<div class="row g-3">

    {# ── Colonne gauche ── #}
    <div class="col-md-7">

        <div class="card mb-3">
            <div class="card-header fw-semibold">
                <i class="bi bi-person me-2"></i>Bénéficiaire
            </div>
            <div class="card-body">
                <label class="form-label">Utilisateur <span class="text-danger">*</span></label>
                <select name="user_id" class="form-select single-select" required>
                    <option value="">-- Choisir un utilisateur --</option>
                    {% for u in users %}
                        <option value="{{ u.id }}">
                            {{ u.pseudo }}{% if u.nom %} — {{ u.nom }}{% endif %}{% if u.mail %} ({{ u.mail }}){% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">
                <i class="bi bi-list-check me-2"></i>Formule &amp; Mode
            </div>
            <div class="card-body">
                <label class="form-label">Formule <span class="text-danger">*</span></label>
                <select name="formule_id" id="formule_select" class="form-select mb-3" required>
                    <option value="">-- Choisir une formule --</option>
                    {% for f in formules %}
                        <option value="{{ f.id }}"
                            data-type="{{ f.typeBoost }}"
                            data-jours="{{ f.nbrJour }}"
                            data-quota="{{ f.nbContactsMax }}"
                            data-prix="{{ f.prix }}">
                            {{ f.titre }} — {{ f.prix }} FCFA —
                            {% if f.typeBoost == 'quota' %}
                                {{ f.nbContactsMax }} contacts
                            {% else %}
                                {{ f.nbrJour }} jour(s)
                            {% endif %}
                        </option>
                    {% endfor %}
                </select>

                <div id="expiration_info" class="alert alert-info py-2 mb-3" style="display:none;">
                    <i class="bi bi-calendar-check me-1"></i>
                    Date d'expiration : <strong id="expiration_date"></strong>
                </div>

                <label class="form-label">Mode</label>
                <select name="mode" class="form-select">
                    <option value="Gratuit">Gratuit</option>
                    <option value="Payant">Payant</option>
                    <option value="Kdo">Kdo</option>
                </select>
            </div>
        </div>

    </div>

    {# ── Colonne droite : récapitulatif ── #}
    <div class="col-md-5">

        <div class="card mb-3">
            <div class="card-header fw-semibold">
                <i class="bi bi-info-circle me-2"></i>Récapitulatif
            </div>
            <div class="card-body small">
                <table class="table table-sm mb-0">
                    <tr><td>Source</td><td><span class="badge bg-dark">admin</span></td></tr>
                    <tr><td>Date début</td><td>Maintenant</td></tr>
                    <tr>
                        <td>Type</td>
                        <td id="recap_type" class="text-muted">—</td>
                    </tr>
                    <tr>
                        <td id="recap_exp_label">Date expiration</td>
                        <td id="recap_exp" class="text-muted">— choisir une formule —</td>
                    </tr>
                    <tr>
                        <td>Prix formule</td>
                        <td id="recap_prix" class="text-muted">—</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="d-grid mt-2">
            <button type="submit" class="btn btn-success btn-lg">
                <i class="bi bi-rocket-takeoff me-2"></i>Enregistrer le boost
            </button>
        </div>

    </div>

</div>
</form>

{% endblock %}

{% block script %}
<script>
(function () {
    var select    = document.getElementById('formule_select');
    var infoBox   = document.getElementById('expiration_info');
    var expDate   = document.getElementById('expiration_date');
    var recapExp  = document.getElementById('recap_exp');
    var recapExpLabel = document.getElementById('recap_exp_label');
    var recapType = document.getElementById('recap_type');
    var recapPrix = document.getElementById('recap_prix');
    select.addEventListener('change', function () {
        var opt   = this.options[this.selectedIndex];
        var type  = opt.getAttribute('data-type');
        var jours = parseInt(opt.getAttribute('data-jours') || '0');
        var quota = opt.getAttribute('data-quota');
        var prix  = opt.getAttribute('data-prix');
        if (!type) {
            infoBox.style.display  = 'none';
            recapExp.textContent   = '— choisir une formule —';
            recapType.textContent  = '—';
            recapPrix.textContent  = '—';
            return;
        }
        recapPrix.textContent = prix ? prix + ' FCFA' : '—';
        recapType.textContent = type === 'quota' ? 'Par Contacts (quota)' : 'Par Durée (date)';
        if (type === 'quota') {
            infoBox.style.display      = 'none';
            recapExpLabel.textContent  = 'Quota contacts';
            recapExp.textContent       = quota ? quota + ' contacts max' : '—';
        } else {
            recapExpLabel.textContent  = 'Date expiration';
            var d = new Date();
            d.setDate(d.getDate() + jours);
            var label = d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
            expDate.textContent   = label + ' (' + jours + ' jour' + (jours > 1 ? 's' : '') + ')';
            recapExp.textContent  = label;
            infoBox.style.display = 'block';
        }
    });
})();
</script>
{% endblock %}
