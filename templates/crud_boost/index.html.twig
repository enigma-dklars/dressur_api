{% extends 'baseAdmin.html.twig' %}

{% block title %}Boost index{% endblock %}

{% block body %}
    <p class="h4 me-3">Boost index</p>
    {# <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_boost_new') }}">Create new</a> #}

    <!-- Filtre Source -->
    <div class="mb-3 d-flex align-items-center gap-2">
        <span class="small fw-semibold me-1">Source :</span>
        <a href="{{ path('app_crud_boost_index') }}" class="badge text-decoration-none {{ sourceFilter == '' ? 'bg-dark' : 'bg-secondary' }}">Tous</a>
        <a href="{{ path('app_crud_boost_index', {'source': 'web'}) }}" class="badge text-decoration-none {{ sourceFilter == 'web' ? 'bg-primary' : 'bg-secondary' }}">web</a>
        <a href="{{ path('app_crud_boost_index', {'source': 'mobile'}) }}" class="badge text-decoration-none {{ sourceFilter == 'mobile' ? 'bg-warning text-dark' : 'bg-secondary' }}">mobile</a>
        <a href="{{ path('app_crud_boost_index', {'source': 'none'}) }}" class="badge text-decoration-none {{ sourceFilter == 'none' ? 'bg-dark' : 'bg-secondary' }}">none</a>
    </div>

    <table class="data-table table table-bordered table-striped">
        <thead>
            <tr>
                <th></th>
                <th>Source</th>
                <th>Id</th>
                <th>User</th>
                <th width="1">Status</th>
                <th width="1">Mode</th>
                <th>Formule</th>
                <th>DateDebut</th>
                <th>DateExp</th>
            </tr>
        </thead>
        <tbody>
        {% for boost in boosts %}
            <tr>
                {# <td></td> #}
                <td>{% include "crud_boost/_delete_form.html.twig" %}</td>
                <td class="text-center">
                    {% if boost.source == 'web' %}
                        <span class="badge bg-primary">web</span>
                    {% elseif boost.source == 'mobile' %}
                        <span class="badge bg-warning text-dark">mobile</span>
                    {% else %}
                        <span class="badge bg-secondary">none</span>
                    {% endif %}
                </td>
                <td>{{ boost.id }}</td>
                <td>{{ boost.user.pseudo }}</td>
                <td class="text-center">
                    {% if date() < boost.dateDebut and date() < boost.dateExp %}
                        <span class="badge bg-danger">Programmer</span>
                    {% endif %}
                    {% if date() > boost.dateDebut and date() < boost.dateExp %}
                        <span class="badge bg-warning">En cours</span>
                    {% endif %}
                    {% if date() > boost.dateDebut and date() > boost.dateExp %}
                        <span class="badge bg-success">Terminer</span>
                    {% endif %}
                </td>
                <td class="text-center">
                    {% if boost.mode == "Gratuit" %}
                        <span class="badge bg-danger">{{boost.mode}}</span>
                    {% else %}
                        <span class="badge bg-success">{{boost.mode}}</span>
                    {% endif %}
                </td>
                <td>{{ boost.formuleBoost }}</td>
                <td>{{ boost.dateDebut ? boost.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ boost.dateExp ? boost.dateExp|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
