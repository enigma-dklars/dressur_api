{% extends 'basePrivate.html.twig' %}
{% block title %}Espace Partenaire{% endblock %}
{% block body %}
<div class="container-fluid px-0 pb-4">
<div class="web-feature-hero mt-3">
    <i class="fas fa-handshake d-block fs-1 mb-3" aria-hidden="true"></i>
    <h1 class="web-feature-hero-title">
        {% if user.estPartenaire %}Votre Espace Partenaire{% else %}Devenez Partenaire Dressur{% endif %}
    </h1>
    <p class="web-feature-hero-subtitle">
        {% if user.estPartenaire %}
            Gérez votre code partenaire et suivez les utilisateurs que vous accompagnez.
        {% else %}
            Accompagnez les utilisateurs Dressur et développez votre réseau grâce à votre code partenaire.
        {% endif %}
    </p>
</div>
{% if user.estPartenaire %}
    {# ══════════════════════════════════════════════════════════════ #}
    {#  VUE PARTENAIRE ACTIF                                         #}
    {# ══════════════════════════════════════════════════════════════ #}
    <div class="web-feature-card mt-4 mb-3">
            <h2 class="web-feature-card-title mb-3"><i class="fas fa-star text-warning me-2"></i>Votre Espace Partenaire</h2>
            {# ── Code partenaire ─────────────────────────────────── #}
            <p class="web-feature-section-title text-uppercase fs-6 mb-2">Votre Code Partenaire</p>
            <div class="web-feature-card d-flex align-items-center justify-content-between gap-3 mb-3 p-3">
                <span class="font-monospace fs-4 fw-bold text-primary text-break" id="epCodeVal">{{ user.codePartenaire }}</span>
                <button class="web-feature-btn-primary btn-outline-primary btn-sm flex-shrink-0" id="btnCopierCode">
                    <i class="fas fa-copy me-1"></i>Copier
                </button>
            </div>
            <p class="web-feature-card-text small mb-4">Partagez ce code à vos contacts pour les affilier. Il change automatiquement après chaque utilisation.</p>
            {# ── Accompagnés ─────────────────────────────────────── #}
            <p class="web-feature-section-title text-uppercase fs-6 mb-2">
                Mes Accompagnés
                <span class="web-feature-badge ms-1">{{ accompagnes|length }}</span>
            </p>
            {% if accompagnes|length == 0 %}
                <p class="web-feature-card-text text-center py-3 small">Aucun accompagné pour l'instant. Partagez votre code !</p>
            {% else %}
                {% for acc in accompagnes %}
                <div class="web-feature-card mb-2 p-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="fw-semibold">{{ acc.getNom() ?: '—' }}</span>
                        <span class="text-muted ms-2 small text-break">@{{ acc.getPseudo() }}</span>
                    </div>
                    <div class="web-feature-card-text small">
                        <i class="fab fa-whatsapp text-success me-1"></i>{{ acc.getTel() ?: '—' }}
                        &nbsp;·&nbsp;
                        <i class="fas fa-envelope me-1"></i>{{ acc.getMail() ?: '—' }}
                        &nbsp;·&nbsp;
                        <i class="fas fa-calendar me-1"></i>Affilié le {{ acc.getCreatedAt() ? acc.getCreatedAt()|date('d/m/Y') : '—' }}
                    </div>
                </div>
                {% endfor %}
            {% endif %}
            {# ── Lien vers la présentation ───────────────────────── #}
            <div class="mt-4 pt-3 border-top">
                <a href="#presentationSection" class="web-feature-btn-primary d-inline-flex">
                    <i class="fas fa-info-circle me-1"></i>Revoir la présentation de l'Espace Partenaire
                </a>
            </div>
    </div>
    {# ── Présentation (accessible via ancre) ─────────────────────── #}
    <div id="presentationSection">
{% endif %}
    {# ══════════════════════════════════════════════════════════════ #}
    {#  PRÉSENTATION & CONDITIONS (toujours visible)                  #}
    {# ══════════════════════════════════════════════════════════════ #}
    <div class="web-feature-card mb-3">
            <h2 class="web-feature-card-title"><i class="fas fa-handshake text-primary me-2"></i>Qu'est-ce que l'Espace Partenaire ?</h2>
            <p class="web-feature-card-text mt-2 mb-0">
                Le Partenaire Dressur est un utilisateur confirmé qui <strong>maîtrise la plateforme</strong> et s'engage à
                <strong>accompagner, aider et expliquer</strong> Dressur aux personnes qui utilisent son code d'affiliation.
                C'est un rôle actif, pas seulement un statut.
            </p>
    </div>
    <div class="web-feature-card mb-3">
            <h2 class="web-feature-card-title"><i class="fas fa-gift text-success me-2"></i>Vos avantages en tant que Partenaire</h2>
            <ul class="web-feature-card-text mt-3 mb-0 ps-3 lh-lg">
                <li><strong>2 % de commission</strong> sur chaque transaction payante de vos accompagnés, crédités automatiquement sur votre solde Dressur</li>
                <li>Le solde accumulé est utilisable sur tous les services payants de la plateforme (boost contact, promos…)</li>
                <li>Accès à votre tableau de bord dédié avec la liste de vos accompagnés</li>
            </ul>
    </div>
    {% if not user.estPartenaire %}
    <div class="web-feature-card mb-3">
            <h2 class="web-feature-card-title"><i class="fas fa-route text-primary me-2"></i>Comment devenir Partenaire ?</h2>
            <div class="row g-3 mt-2">
                <div class="col-md-4">
                    <div class="d-flex gap-2 align-items-start">
                        <span class="web-feature-badge">1</span>
                        <div><strong>Préparez votre profil</strong><p class="web-feature-card-text small mb-0 mt-1">Renseignez et confirmez vos informations personnelles.</p></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-2 align-items-start">
                        <span class="web-feature-badge">2</span>
                        <div><strong>Utilisez Dressur</strong><p class="web-feature-card-text small mb-0 mt-1">Découvrez la plateforme et atteignez les conditions d’accès.</p></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-2 align-items-start">
                        <span class="web-feature-badge">3</span>
                        <div><strong>Passez l’entretien</strong><p class="web-feature-card-text small mb-0 mt-1">Contactez l’équipe Dressur sur WhatsApp pour la validation finale.</p></div>
                    </div>
                </div>
            </div>
    </div>
    {% endif %}
    <div class="web-feature-card mb-3">
            <h2 class="web-feature-card-title mb-3"><i class="fas fa-list-check text-warning me-2"></i>Conditions pour devenir Partenaire</h2>
            {% set condNom = user.nom and user.nom != '' %}
            {% set condTel = user.telIsVerified %}
            {% set condMail = user.mailIsVerified %}
            {% set condAnciennete = joursInscrit >= 7 %}
            {% set condCumul = cumulFcfa >= 2000 %}
            <ul class="list-unstyled mb-3">
                <li class="d-flex align-items-start gap-2 py-2 border-bottom">
                    {% if condNom %}<i class="fas fa-check-circle text-success fs-5 flex-shrink-0"></i>{% else %}<i class="fas fa-times-circle text-danger fs-5 flex-shrink-0"></i>{% endif %}
                    <span>Nom complet renseigné dans le profil</span>
                </li>
                <li class="d-flex align-items-start gap-2 py-2 border-bottom">
                    {% if condTel %}<i class="fas fa-check-circle text-success fs-5 flex-shrink-0"></i>{% else %}<i class="fas fa-times-circle text-danger fs-5 flex-shrink-0"></i>{% endif %}
                    <span>Numéro WhatsApp confirmé</span>
                </li>
                <li class="d-flex align-items-start gap-2 py-2 border-bottom">
                    {% if condMail %}<i class="fas fa-check-circle text-success fs-5 flex-shrink-0"></i>{% else %}<i class="fas fa-times-circle text-danger fs-5 flex-shrink-0"></i>{% endif %}
                    <span>Adresse e-mail confirmée</span>
                </li>
                <li class="d-flex align-items-start gap-2 py-2 border-bottom">
                    {% if condAnciennete %}<i class="fas fa-check-circle text-success fs-5 flex-shrink-0"></i>{% else %}<i class="fas fa-times-circle text-danger fs-5 flex-shrink-0"></i>{% endif %}
                    <span>
                        Inscrit depuis au moins 7 jours
                        {% if not condAnciennete %}
                            <span class="text-muted ms-1 small">({{ joursInscrit }}j / 7j)</span>
                        {% endif %}
                    </span>
                </li>
                <li class="d-flex align-items-start gap-2 py-2 border-bottom">
                    {% if condCumul %}<i class="fas fa-check-circle text-success fs-5 flex-shrink-0"></i>{% else %}<i class="fas fa-times-circle text-danger fs-5 flex-shrink-0"></i>{% endif %}
                    <span>
                        Au moins 2 000 FCFA cumulés en services payants
                        <span class="text-muted ms-1 small">({{ cumulFcfa|number_format(0, ',', ' ') }} / 2 000 FCFA)</span>
                    </span>
                </li>
                <li class="d-flex align-items-start gap-2 py-2">
                    <i class="fab fa-whatsapp text-success fs-5 flex-shrink-0"></i>
                    <span>Entretien de validation avec l'équipe Dressur sur WhatsApp (dernière étape)</span>
                </li>
            </ul>
            {# ── Bouton entretien (conditions 1-5 remplies, pas encore partenaire) ── #}
            {% if not user.estPartenaire %}
                {% if condNom and condTel and condMail and condAnciennete and condCumul %}
                    <a href="https://wa.me/22964044294?text={{ "Bonjour, j'aimerais passer l'entretien pour devenir Partenaire Dressur. Mon pseudo est : " ~ user.pseudo | url_encode }}"
                       target="_blank" rel="noopener noreferrer"
                       class="web-feature-btn-primary w-100 mt-2">
                        <i class="fab fa-whatsapp me-2"></i>Demander l'entretien WhatsApp
                    </a>
                    <p class="web-feature-card-text text-center mt-2 small">
                        Toutes vos conditions sont remplies. Contactez l'équipe Dressur pour planifier votre entretien.
                        Après validation, votre statut Partenaire sera activé.
                    </p>
                {% else %}
                    <button class="web-feature-btn-primary w-100 mt-2" disabled>
                        Demander l'entretien WhatsApp
                    </button>
                    <p class="text-danger text-center mt-2 small">
                        Complétez toutes les conditions ci-dessus pour débloquer l'entretien.
                    </p>
                {% endif %}
            {% endif %}
    </div>
{% if user.estPartenaire %}
    </div>{# fin #presentationSection #}
{% endif %}
</div>
<script>
document.getElementById('btnCopierCode')?.addEventListener('click', function () {
    const code = document.getElementById('epCodeVal')?.textContent.trim();
    if (!code) return;
    navigator.clipboard.writeText(code).then(() => {
        this.innerHTML = '<i class="fas fa-check me-1"></i>Copié !';
        this.classList.replace('btn-outline-primary', 'btn-success');
        setTimeout(() => {
            this.innerHTML = '<i class="fas fa-copy me-1"></i>Copier';
            this.classList.replace('btn-success', 'btn-outline-primary');
        }, 2000);
    });
});
</script>
{% endblock %}
