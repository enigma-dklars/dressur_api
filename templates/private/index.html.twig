      <div class="modal-footer">
        <button type="button"
                id="closeWarningBtn"
                class="btn btn-sm btn-danger"
                data-bs-dismiss="modal"
                disabled>
          Fermer (5)
        </button>
      </div>
    </div>
  </div>
