{% extends 'basePrivate.html.twig' %}

{% block title %}DASHBOARD{% endblock %}

{% block body %}



    <div class="row g-3 mb-3">
        {% if (user.nombreContactDispo <= 0 and user.boostEnCours == false) or
            user.telIsVerified == false or
            user.mailIsVerified == false or
            user.nom|replace({' ': ''}) == '' or
            user.nom is null %}

        {% endif %}

        {% if user.telIsVerified == false and user.mailIsVerified == true and user.nom is not null and user.nom|trim != '' %}
            <div class="{% if user.mailIsVerified == false %}col-md-6 {% else %}col-md-12{% endif %}">
                <div class="card radius-10 mb-0 h-100">
                    <div class="card-body">
                        <p class="mb-0 text-secondary"><i class="fab fa-whatsapp me-1"></i> Confirmation du numéro WhatsApp</p>
                        <p class="mt-1 mb-2">
                            Assurez-vous de nous envoyer <span class="text-success fw-bold">WhatsApp Confirmation</span> avec le numéro WhatsApp utiliser pour créer votre compte Dressur. 
                            Cliquez juste sur <span class="mx-1 px-2 rounded bg-success text-white">Demander</span> ci-dessous pour demander la confirmation de votre numéro WhatsApp. 
                            Les demandes sont traitées le plus tôt possible, ne vous inquiétez pas. 
                        </p>
                        <a href="https://wa.me/22964044294??text=WhatsApp Confirmation" target="_blank" class="btn btn-sm btn-success">Demander</a>
                    </div>
                </div>
            </div>
        {% endif %}

        {% if user.mailIsVerified == false %}
            <div class="{% if user.telIsVerified == false %}col-md-6 {% else %}col-md-12{% endif %}">
                <div class="card radius-10 mb-0 h-100">
                    <div class="card-body">
                        <p class="mb-0 text-secondary"><i class="fas fa-envelope me-1"></i> Confirmation de l'adresse mail</p>
                        <p class="mt-1 mb-2">
                            Cliquez sur <span class="mx-1 px-2 rounded bg-primary text-white">Envoyer le code</span> pour recevoir un nouveau code de confirmation de votre adresse mail (<span class="mx-1 px-2 rounded bg-primary text-white">{{user.mail}}</span>). Contactez simplement l'Assistance Dressur après 2H d'attente...
                        </p>
                        <div class="mb-0">
                            <div class="mt-0 mb-0 msgError" id="msgErrorValideMail" style="display: none;"></div>
                        </div>
                        <label for="" hidden>Code reçu par mail</label>
                        <input type="text" class="form-control form-control-sm mt-1 mb-2 getInfo getInfoVerifMail" placeholder="Code reçu par mail" id="codeVerifMail">
                        <div class="text-end">
                            <button class="btn btn-sm btn-primary me-1" id="envoyerCodeMail">Envoyer le Code</button>
                            <button class="btn btn-sm btn-primary ms-1" id="validerVerifMail">Valider</button>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        {% if user.nom|replace({' ': ''}) == '' or user.nom is null %}
            <div class="col-12">
                <a href="/editprofil" class="dropdown-item">
                    <div class="card radius-10 mb-0 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="setting-icon"><i class="fas fa-user fs-4"></i></div>
                                <div class="setting-text ms-3 fs-6"><span>Compléter votre Profil</span></div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        {% endif %}

        {% if user.nombreContactDispo <= 100 and user.boostEnCours == false %}
            <div class="col-12">
                <a href="/newboostcontact" class="dropdown-item">
                    <div class="card radius-10 mb-0 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="setting-icon"><i class="fas fa-user-plus fs-4"></i></div>
                                <div class="setting-text ms-3 fs-6"><span>Faire un Boost Contact pour avoir plus de contact</span></div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        {% endif %}

        {% if user.nombreContactDispo > 0 %}
            <div class="col-md-12">
                <div class="card radius-10 mb-0 h-100">
                    <div class="card-body">
                        <p class="mb-2 text-primary fw-normal fs-4">
                            <i class="fas fa-users-rectangle me-1"></i> ADD DS Disponible
                        </p>
                        <p class="mb-2 fs-6 mb-1">
                            {{user.nombreContactDispo}} contact(s) disponible(s) selon vos préférences pays.
                        </p>
                        <p class="px-3 py-2 mb-2 small bg-danger rounded text-white">
                            Note : Vous utilisez la version web de Dressur. L'enregistrement des contacts ne sera donc pas automatique dans votre téléphone. Pour enregistrer les contacts obtenus dans votre téléphone, veuillez accéder à la page "Liste des contacts" sur Dressur Web et exporter les contacts au format VCF ou CSV, puis les importer dans votre téléphone. Afin de vous assurer de ne manquer aucun nouveau contact, connectez-vous deux fois par jour pour effectuer cette action.
                        </p>
                        <div class="mt-2 mb-1">
                            {% if user.telIsVerified == true %}
                                <button class="btn btn-md btn-info me-2 mb-2 mb-md-0" url="/api/addTousUserContact/{{user.uid}}/fr" id="ajouter_tous_les_contacts">
                                    Ajouter Tous les {{user.nombreContactDispo}} Contact(s)
                                </button>
                            {% else %}
                                <button class="btn btn-md btn-info me-2 mb-2 mb-md-0" data-bs-toggle="modal" data-bs-target="#doit_confirmer_le_numéro_whatsapp">
                                    Ajouter Tous les {{user.nombreContactDispo}} Contact(s)
                                </button>
                            {% endif %}
                            <a href="/contact" class="btn btn-md btn-info">Liste des contacts</a>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>

    <div class="modal fade" id="doit_confirmer_le_numéro_whatsapp" tabindex="-1" style="display: none;" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-body p-0">
                    <div class="card radius-10 mb-0 h-100">
                        <div class="card-body">
                            <p class="mb-0 text-secondary"><i class="fab fa-whatsapp me-1"></i> Configuration et Confirmation du Compte</p>
                            <p class="mt-1 mb-2">
                                Vous n’avez pas encore terminé la configuration et la confirmation de votre compte. 
                                Veuillez fermer cette fenêtre, lire attentivement les instructions affichées sur la page actuelle afin de savoir quoi faire pour finaliser la configuration et la confirmation de votre compte. 
                                Une fois cette étape terminée, vous pourrez revenir et utiliser cette fonctionnalité sans problème.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>


    <div class="mb-3">
        {{actu|raw}}
    </div>

    <div class="modal fade" id="warningModal" tabindex="-1"
     aria-labelledby="warningModalLabel"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-danger">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title text-center w-100" id="warningModalLabel">
          ⚠️ Avertissement important
        </h5>
      </div>

      <div class="modal-body">
        <p>
          Dressur ne peut garantir la fiabilité ou la moralité des utilisateurs de la plateforme.<br><br>
          Il est fortement conseillé de ne jamais envoyer d’argent pour un service sans être certain
          de pouvoir entrer en possession de ce pour quoi vous payez.<br><br>
          <strong>
            Dressur ne saurait être tenu responsable en cas d’arnaque ou de perte financière
            causée par un autre utilisateur.
          </strong>
        </p>
      </div>

      <div class="modal-footer">
        <button type="button"
                id="closeWarningBtn"
                class="btn btn-sm btn-danger"
                data-bs-dismiss="modal"
                disabled>
          Fermer (5)
        </button>
      </div>
    </div>
  </div>
</div>
<script>
document.addEventListener("DOMContentLoaded", function () {
    const modalEl = document.getElementById('warningModal');
    const closeBtn = document.getElementById('closeWarningBtn');

    // Ouvre le modal automatiquement
    const warningModal = new bootstrap.Modal(modalEl);
    warningModal.show();

    let countdown = 5;
    closeBtn.textContent = `Fermer (${countdown}s)`;

    const timer = setInterval(() => {
        countdown--;
        if (countdown > 0) {
            closeBtn.textContent = `Fermer (${countdown}s)`;
        } else {
            clearInterval(timer);
            closeBtn.textContent = "Fermer";
            closeBtn.disabled = false;
        }
    }, 1000);
});
</script>

{% endblock %}
