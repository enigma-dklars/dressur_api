{% extends 'basePrivate.html.twig' %}
{% block title %}Code Partenaire{% endblock %}
{% block body %}
<style>
.cp-wrap{max-width:560px;margin:0 auto}
.cp-cond-list{list-style:none;padding:0;margin:0 0 20px}
.cp-cond-list li{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--bs-border-color,rgba(0,0,0,.07));font-size:14px}
.cp-cond-list li:last-child{border-bottom:none}
.cp-cond-list .cp-ok{color:#198754;font-size:16px}
.cp-cond-list .cp-nok{color:#dc3545;font-size:16px}
html.dark-theme .cp-cond-list li,html.semi-dark .cp-cond-list li{border-color:rgba(255,255,255,.08)}
</style>
<div class="cp-wrap mt-3">
    {# ── Si déjà accompagné ───────────────────────────── #}
    {% if user.aUnPartenaire %}
    <div class="card">
        <div class="card-body text-center py-4">
            <i class="fas fa-handshake text-success" style="font-size:3rem"></i>
            <p class="mt-3 mb-0">Vous avez déjà un partenaire. Cette section n'est plus accessible.</p>
            <a href="/parametres" class="btn btn-primary mt-3">Retour aux paramètres</a>
        </div>
    </div>
    {% else %}
    <div class="card">
        <div class="card-body">
            <h5 class="mb-1"><i class="fas fa-handshake text-primary me-2"></i>Utiliser un Code Partenaire</h5>
            <p class="text-muted mb-4" style="font-size:13px">
                Un partenaire vous a transmis un code à 8 caractères. Renseignez-le ci-dessous pour être associé.
            </p>
            {# ── Conditions ───────────────────────────────── #}
            <p class="fw-semibold mb-2" style="font-size:13px;text-transform:uppercase;letter-spacing:.5px">Conditions requises</p>
            <ul class="cp-cond-list">
                <li>
                    {% if user.nom %}
                        <i class="fas fa-check-circle cp-ok"></i>
                    {% else %}
                        <i class="fas fa-times-circle cp-nok"></i>
                    {% endif %}
                    <span>Nom &amp; prénom renseignés</span>
                </li>
                <li>
                    {% if user.telIsVerified %}
                        <i class="fas fa-check-circle cp-ok"></i>
                    {% else %}
                        <i class="fas fa-times-circle cp-nok"></i>
                    {% endif %}
                    <span>Numéro WhatsApp confirmé</span>
                </li>
                <li>
                    {% if user.mailIsVerified %}
                        <i class="fas fa-check-circle cp-ok"></i>
                    {% else %}
                        <i class="fas fa-times-circle cp-nok"></i>
                    {% endif %}
                    <span>Adresse e-mail confirmée</span>
                </li>
                <li>
                    <i class="fas fa-shield-alt text-warning" style="font-size:16px"></i>
                    <span>Votre numéro et e-mail ne doivent pas avoir déjà été utilisés pour une affiliation</span>
                </li>
            </ul>
            {# ── Feedback ─────────────────────────────────── #}
            <div id="cpFeedback" class="alert" style="display:none"></div>
            {# ── Formulaire ───────────────────────────────── #}
            {% set canSubmit = user.nom and user.telIsVerified and user.mailIsVerified %}
            <div class="mb-3">
                <label for="inputCode" class="form-label fw-semibold">Code Partenaire</label>
                <input type="text"
                       id="inputCode"
                       class="form-control"
                       maxlength="8"
                       placeholder="Ex: A3B7KX2P"
                       style="text-transform:uppercase;letter-spacing:3px;font-size:18px;font-weight:600"
                       {% if not canSubmit %}disabled{% endif %}>
                <div class="form-text">8 caractères, insensible à la casse.</div>
            </div>
            <button id="btnValider"
                    class="btn btn-primary w-100"
                    {% if not canSubmit %}disabled{% endif %}>
                <span id="btnLabel">VALIDER LE CODE</span>
                <span id="btnSpinner" class="spinner-border spinner-border-sm ms-2" style="display:none"></span>
            </button>
            {% if not canSubmit %}
            <p class="text-danger text-center mt-2" style="font-size:12px">
                Complétez les conditions ci-dessus pour pouvoir utiliser un code partenaire.
            </p>
            {% endif %}
        </div>
    </div>
    <script>
    document.getElementById('btnValider')?.addEventListener('click', async function () {
        const code = document.getElementById('inputCode').value.trim().toUpperCase();
        const feedback = document.getElementById('cpFeedback');
        const spinner = document.getElementById('btnSpinner');
        const btn = this;
        feedback.style.display = 'none';
        if (code.length !== 8) {
            feedback.className = 'alert alert-danger';
            feedback.textContent = 'Le code doit contenir exactement 8 caractères.';
            feedback.style.display = 'block';
            return;
        }
        btn.disabled = true;
        spinner.style.display = 'inline-block';
        try {
            const response = await fetch('/api/utiliserCodePartenaire', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: code }),
                credentials: 'same-origin'
            });
            const data = await response.json();
            if (data.success) {
                feedback.className = 'alert alert-success';
                feedback.textContent = data.message || 'Partenaire associé avec succès !';
                feedback.style.display = 'block';
                document.getElementById('inputCode').disabled = true;
                btn.disabled = true;
                // Redirige vers les paramètres après 2 secondes
                setTimeout(() => { window.location.href = '/parametres'; }, 2000);
            } else {
                feedback.className = 'alert alert-danger';
                feedback.textContent = data.message || 'Une erreur est survenue.';
                feedback.style.display = 'block';
                btn.disabled = false;
            }
        } catch (e) {
            feedback.className = 'alert alert-danger';
            feedback.textContent = 'Erreur réseau. Veuillez réessayer.';
            feedback.style.display = 'block';
            btn.disabled = false;
        } finally {
            spinner.style.display = 'none';
        }
    });
    </script>
    {% endif %}
</div>
{% endblock %}
