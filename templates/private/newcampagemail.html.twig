<div class="bg-danger text-white p-3 rounded">
    NB: Après avoir rempli et envoyer votre campagne, elle sera analysée par les administrateurs de Dressur.
    Si votre campagne est acceptée, vous passerez au paiement et ainsi votre campagne sera effectuée.
</div>

<div class="card mt-3">
    <div class="card-body">
        <p class="h4 text-center pb-3">Nouvelle Campagne</p>

        <div class="row g-2">
            <div class="col-12" hidden>
                <input type="text" id="uid" value="{{user.uid}}">
            </div>
            <div class="col-12">
                <div class="mt-0" id="msgError" style="display: none;"></div>
            </div>
            <div class="col-md-12 bg-info text-white rounded py-2 px-2 text-center" id="description-formule-mail">
                Veuillez choisir une formule...
            </div>
            <div class="col-md-6">
                <label for="formule-campage">Formule de Campagne</label>
                <select id="formule-campage" class="form-select getInfo">
                    <option value="" disabled selected>Veuillez choisir une formule... </option>
                    {% for formuleCampageMail in formuleCampageMails %}
                        <option value="[{{formuleCampageMail.id}},{{formuleCampageMail.prix}},{{formuleCampageMail.nombremail}}]"
                        prix="{{formuleCampageMail.prix}}" nombre-mail="{{formuleCampageMail.nombremail}}" >{{formuleCampageMail.titre}}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-6">
                <label for="titre">Titre</label>
                <input type="text" class="form-control getInfo" id="titre">
            </div>
            <div class="col-md-4">
                <label for="sujet">Sujet</label>
                <input type="text" class="form-control getInfo mb-2" id="sujet">

                <label for="reply-to">Répondre à</label>
                <input type="text" class="form-control getInfo" readonly value="{{user.mail}}" id="reply-to">
            </div>
            <div class="col-md-8">
                <label for="destinataires">Les Destinaraires</label>
                <textarea id="destinataires" class="form-control getInfo" rows="3"></textarea>
                <i class="small text-danger fw-normal">Séparez les adresses par des virgules</i>
            </div>
            <div class="col-md-12">
                <label for="contenu-mail">Contenu du Mail</label>
                <textarea id="contenu-mail" class="form-control getInfo" rows="5"></textarea>
            </div>
            <div class="col-md-12">
                <button class="btn btn-primary" id="newcampagnemail">Envoyer</button>
            </div>
        </div>
    </div>
</div>