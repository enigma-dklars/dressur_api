{% extends "basePrivate.html.twig" %}
{% block title %}Recharger mon solde Vendeur{% endblock %}

{% block body %}
<style>
.vr-wrap{max-width:560px;margin:0 auto}
.vr-solde{display:flex;align-items:center;gap:14px;background:rgba(13,110,253,.07);border:1px solid rgba(13,110,253,.18);border-radius:14px;padding:18px 20px;margin-bottom:20px}
.vr-solde i{font-size:22px;color:var(--bs-primary,#0d6efd)}
.vr-solde .vr-solde-label{font-size:.78rem;color:var(--bs-secondary-color,#6c757d);margin:0}
.vr-solde .vr-solde-val{font-size:1.5rem;font-weight:800;color:var(--bs-primary,#0d6efd);margin:0;line-height:1.1}

html.dark-theme .vr-solde,html.semi-dark .vr-solde{background:rgba(13,110,253,.15);border-color:rgba(13,110,253,.3)}
</style>

<div class="vr-wrap">
    <div class="d-flex align-items-center gap-2 mb-3">
        <a href="/parametres" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-chevron-left"></i>
        </a>
        <h5 class="mb-0 fw-bold">Recharger mon solde</h5>
    </div>

    {# Solde actuel #}
    <div class="vr-solde">
        <i class="fas fa-wallet"></i>
        <div>
            <p class="vr-solde-label">Solde actuel</p>
            <p class="vr-solde-val">{{ user.soldeDressur ?? 0 }} FCFA</p>
        </div>
    </div>

    {# Formulaire #}
    <div class="card border-0 shadow-sm p-3 mb-4">

        {# Montant #}
        <div class="mb-3">
            <label class="form-label fw-semibold">Montant à recharger <span class="text-muted fw-normal">(minimum 500 FCFA)</span></label>
            <div class="input-group">
                <input type="number" id="vr_montant" class="form-control" min="500" placeholder="Minimum 500 FCFA">
                <span class="input-group-text">FCFA</span>
            </div>
            <div id="vr_montantError" class="text-danger small mt-1" style="display:none"></div>
        </div>

        {# Numéro de paiement #}
        <div class="mb-3">
            <label class="form-label fw-semibold">Indicatif + Numéro du paiement</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                <input type="tel" id="vr_tel" class="form-control" placeholder="+22890000000"
                       value="{{ user.tel ?? '' }}">
            </div>
            <div id="vr_telError" class="text-danger small mt-1" style="display:none"></div>
        </div>

        {# Méthode de paiement #}
        <div class="mb-4">
            <label class="form-label fw-semibold">Méthode de paiement</label>
            <select id="vr_methode" class="form-select">
                <option value="" disabled selected>Choisissez un moyen de paiement</option>
                {% for m in listeMethodePaiements %}
                    <option value="{{ m.value }}">{{ m.titre }}</option>
                {% endfor %}
            </select>
        </div>

        <button id="vr_btn" class="btn btn-primary w-100 btn-lg">
            <span id="vr_btnText">Recharger</span>
            <span id="vr_spinner" class="spinner-border spinner-border-sm ms-2" style="display:none"></span>
        </button>
    </div>
</div>

<script>
(function(){
    document.getElementById('vr_btn').addEventListener('click', async function(){
        const montant = parseInt(document.getElementById('vr_montant').value,10)||0;
        const tel     = document.getElementById('vr_tel').value.trim();
        const methode = document.getElementById('vr_methode').value;
        const errM    = document.getElementById('vr_montantError');
        const errT    = document.getElementById('vr_telError');
        const btn     = document.getElementById('vr_btn');
        const spinner = document.getElementById('vr_spinner');
        const btnText = document.getElementById('vr_btnText');

        // Validation
        errM.style.display = 'none';
        errT.style.display = 'none';
        let ok = true;

        if(montant < 500){
            errM.textContent    = 'Le montant minimum est de 500 FCFA.';
            errM.style.display  = 'block';
            ok = false;
        }
        if(!tel){
            errT.textContent    = 'Veuillez saisir votre numéro de paiement (format international).';
            errT.style.display  = 'block';
            ok = false;
        }
        if(!methode){ showAlert('Attention','Veuillez choisir un moyen de paiement.','warning'); ok = false; }
        if(!ok) return;

        // Envoi
        btn.disabled     = true;
        spinner.style.display = 'inline-block';
        btnText.textContent   = 'Traitement en cours…';

        try{
            const fd = new FormData();
            fd.append('uid',               getUID());
            fd.append('methodePaiementId', methode);
            fd.append('montant',           montant);
            fd.append('tel',               tel);

            const res  = await fetch(`${API_BASE_URL}/vendeur/recharge`, { method:'POST', body:fd });
            const data = await res.json();

            if(data.error){
                showAlert(data.titre||'Erreur', data.message||'Une erreur est survenue.', 'danger');
            } else if(data.url && data.url !== 'none'){
                window.location.href = data.url;
            } else if(data.direct){
                showAlert('Succès','Solde rechargé de '+montant+' FCFA. Retour en cours…','success');
                setTimeout(()=>{ window.location.href = '/parametres'; }, 2500);
            }
        } catch(e){
            showAlert('Erreur','Une erreur réseau s\'est produite. Veuillez réessayer.','danger');
        } finally{
            btn.disabled          = false;
            spinner.style.display = 'none';
            btnText.textContent   = 'Recharger';
        }
    });
})();
</script>
{% endblock %}
