<div class="row g-3">
    {% for actu in actus %}
        <div class="col-md-4">
            <div class="card mb-0 shadow h-100">
                <a href="/actualite/{{ actu.token }}">
                    <img src="/promotion/{{ actu.image }}" class="card-img-top image-actu" alt="{{ actu.pseudoAnnonceur }}">
                </a>
                <div class="card-body">
                    <p class="card-text actu-small-description mb-2">
                        {% if actu.typePromotionAffaire == "produit_service" %}<div class="actu-small-description mb-1">{{ actu.description }}</div>{% endif %}
                        {% if actu.typePromotionAffaire == "offre_emploi" %}<div class="actu-small-description mb-1">{{ actu.annotherInfo.description_poste }}</div>{% endif %}
                        {% if actu.typePromotionAffaire == "dmd_emploi" %}<div class="actu-small-description mb-1">{{ actu.annotherInfo.description_profil_demandeur }}</div>{% endif %}
                    </p>
                    <div class="row align-items-center">
                        <div class="col-5">
                            <div class="row g-2">
                                <div class="col-auto text-muted small"><i class="fas fa-eye me-1"></i>{{ actu.nombreImpression }}</div>
                                <div class="col-auto text-muted small"><i class="fas fa-hand-pointer me-1"></i>{{ actu.nombreDeVues }}</div>
                            </div>
                        </div>
                        <div class="col-7 text-end d-flex gap-1 justify-content-end">
                            <button class="btn btn-info btn-sm shar-actu py-0 px-1 border-0"
                                pseudoAnnonceur="{{ actu.pseudoAnnonceur }}"
                                description="{{ actu.description }}"
                                whatsappNumber="{{ actu.whatsappNumber }}"
                                image="{{ actu.image }}">
                                <i class="fas fa-share-nodes me-1"></i> Partager
                            </button>
                            <a href="/actualite/{{ actu.token }}" class="btn btn-outline-primary btn-sm py-0 px-2">
                                Voir <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info text-center fw-semibold fs-6">
            Aucune actualité disponible selon vos préférences.
        </div>
    {% endfor %}
</div>
