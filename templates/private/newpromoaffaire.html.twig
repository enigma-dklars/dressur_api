<div class="bg-danger text-white p-3 rounded">
    NB: Après avoir rempli et envoyé votre promotion, elle sera analysée par les administrateurs de Dressur. Si votre promotion est acceptée, vous passerez au paiement et ainsi votre promotion sera visible par des milliers d'utilisateurs correspondant à vos préférences pays.
</div>
<div class="card mt-3">
    <div class="card-body">
        <p class="h4 text-center pb-3">Nouvelle Promotion Affaire</p>

        <form id="promotionForm" enctype="multipart/form-data" class="row g-3">
            <div class="col-12" hidden>
                <input type="text" id="uid" value="{{user.uid}}">
            </div>
            <div class="col-12">
                <div class="mt-0" id="msgError" style="display: none;"></div>
            </div>
            <div class="col-12">
                <label for="formule-promo-page-new-affaire">Formule de Promotion Affaire</label>
                <select id="formule-promo-page-new-affaire" class="form-select">
                    <option value="" disabled selected>Veuillez choisir une formule... </option>
                    {% for formuleBoost in formuleBoosts %}
                        <option value="[{{formuleBoost.id}},{{formuleBoost.prix}},{{formuleBoost.nbrJour}}]"
                        prix="{{formuleBoost.prix}}" nbr-jour="{{formuleBoost.nbrJour}}">{{formuleBoost.titre}}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12">
                <div class="py-2 text-center bg-info rounded px-2" id="description-boost-payant">
                    Veuillez choisir une formule...
                </div>
            </div>
            <div class="col-md-6">
                <label for="image" class="form-label">Sélectionner une image</label>
                <input type="file" class="form-control getInfo" id="image" accept="image/*">
                <div id="imagePreview" class="mt-3"></div>
            </div>
            <div class="col-md-6">
                <label for="description" class="form-label">Description de la promotion</label>
                <textarea class="form-control getInfo" id="description" rows="15"></textarea>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary" id="btn-promotionForm">Envoyer</button>
            </div>
        </form>
    </div>
</div>