{% extends 'basePrivate.html.twig' %}

{% block title %}Mon Programme de récompenses{% endblock %}

{% block body %}
<style>
.pr-dashboard{max-width:1100px;margin:0 auto}.pr-hero{background:linear-gradient(135deg,#1565c0,#4f46e5);color:#fff;border-radius:20px;padding:24px;margin-bottom:16px;box-shadow:0 12px 28px rgba(21,101,192,.2)}.pr-hero h1{font-size:1.3rem}.pr-card{background:var(--bs-body-bg,#fff);border:1px solid var(--bs-border-color,rgba(0,0,0,.08));border-radius:16px;padding:18px;margin-bottom:14px;box-shadow:0 3px 12px rgba(0,0,0,.05)}.pr-stat{display:flex;align-items:center;gap:12px}.pr-stat i{width:42px;height:42px;border-radius:13px;display:flex;align-items:center;justify-content:center;background:rgba(13,110,253,.12);color:#0d6efd}.pr-stat strong{display:block;font-size:1.15rem;color:var(--bs-body-color,#212529)}.pr-stat span{font-size:.78rem;color:var(--bs-secondary-color,#6c757d)}.pr-history{display:flex;gap:12px;align-items:center}.pr-history img{width:58px;height:58px;border-radius:12px;object-fit:cover;background:#eee}.pr-history-main{min-width:0;flex:1}.pr-history-title{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--bs-body-color,#212529)}.pr-history-meta{font-size:.78rem;color:var(--bs-secondary-color,#6c757d)}.pr-status{font-size:.72rem;font-weight:700;border-radius:999px;padding:5px 9px;white-space:nowrap}.pr-status-green{background:rgba(25,135,84,.12);color:#198754}.pr-status-red{background:rgba(220,53,69,.12);color:#dc3545}.pr-status-orange{background:rgba(255,193,7,.16);color:#997404}.pr-status-blue{background:rgba(13,110,253,.12);color:#0d6efd}.pr-status-gray{background:rgba(108,117,125,.12);color:#6c757d}.pr-proof{background:var(--bs-tertiary-bg,#f8f9fa);border-radius:12px;padding:14px;margin-top:12px}.pr-proof label{font-size:.8rem;font-weight:600}.pr-section-title{font-size:1rem;font-weight:700;color:var(--bs-body-color,#212529)}html.dark-theme .pr-card,html.semi-dark .pr-card{box-shadow:0 3px 12px rgba(0,0,0,.25)}
@media(min-width:768px){.pr-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.pr-stats .pr-card{margin-bottom:0}}
</style>
<div class="pr-dashboard">
  <section class="pr-hero d-flex align-items-center justify-content-between gap-3 flex-wrap"><div><h1 class="mb-1 fw-bold"><i class="fas fa-star me-2"></i>Mon Programme</h1><p class="mb-0" style="color:rgba(255,255,255,.86)">Partagez des promotions sur votre statut WhatsApp et suivez vos récompenses.</p></div><div class="text-end"><div class="small" style="color:rgba(255,255,255,.8)">Solde disponible</div><div class="fs-3 fw-bold">{{ balance|number_format(0, ',', ' ') }} FCFA</div></div></section>

  {% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>{% endfor %}{% endfor %}

  <div class="pr-stats mb-3"><div class="pr-card pr-stat"><i class="fas fa-eye"></i><div><strong>{{ views|number_format(0, ',', ' ') }}</strong><span>Vues totales</span></div></div><div class="pr-card pr-stat"><i class="fas fa-coins" style="background:rgba(25,135,84,.12);color:#198754"></i><div><strong>{{ earnings|number_format(0, ',', ' ') }} F</strong><span>Gains totaux</span></div></div><div class="pr-card pr-stat"><i class="fas fa-clock-rotate-left" style="background:rgba(255,193,7,.16);color:#997404"></i><div><strong>{{ history|length }}</strong><span>Participations</span></div></div></div>

  <div class="pr-card d-flex align-items-center justify-content-between gap-3 flex-wrap"><div><div class="pr-section-title"><i class="fas fa-briefcase text-primary me-2"></i>Explorer les promotions affaires</div><div class="small text-secondary mt-1">Découvrez les offres éligibles au Programme des récompenses.</div></div><a class="btn btn-primary" href="{{ path('app_programme_recompense_promotions') }}"><i class="fas fa-arrow-right me-1"></i>Explorer</a></div>

  <section class="pr-card"><div class="d-flex align-items-center justify-content-between gap-2 mb-2"><h2 class="pr-section-title mb-0"><i class="fas fa-clock-rotate-left text-primary me-2"></i>Historique de participation</h2><a href="{{ path('app_programme_recompense') }}" class="btn btn-sm btn-outline-secondary">Conditions</a></div><p class="small text-secondary">Sélectionnez une participation pour consulter son statut et envoyer vos preuves lorsque cela est nécessaire.</p>
    {% if history is empty %}<div class="text-center text-secondary py-4">Aucun historique disponible.</div>{% else %}
      {% for item in history %}
        {% set status = item.status|default('') %}{% set statusLabel = {'en_cours':'En cours','terminer':'Temps écoulé','en_attente':'En attente','approuver':'Approuvé','echouer':'Échoué','refuser':'Refusé'}[status]|default('Inconnu') %}{% set statusClass = status == 'approuver' ? 'pr-status-green' : (status in ['echouer','refuser'] ? 'pr-status-red' : (status == 'en_attente' ? 'pr-status-orange' : (status == 'en_cours' ? 'pr-status-blue' : 'pr-status-gray'))) %}
        <details class="border-top pt-3 mt-3"><summary class="pr-history" style="cursor:pointer;list-style:none"><img src="/promotion/{{ item.promotion.image }}" alt=""><div class="pr-history-main"><div class="pr-history-title">{{ item.promotion.description|slice(0, 80) }}{% if item.promotion.description|length > 80 %}…{% endif %}</div><div class="pr-history-meta">{{ item.createdAt ? item.createdAt|date('d/m/Y H:i') : '—' }} · {{ item.nbrVue|default(0) }} vues · {{ item.recompense|default(0) }} FCFA</div></div><span class="pr-status {{ statusClass }}">{{ statusLabel }}</span></summary>
          <div class="mt-3 small text-secondary"><p class="mb-2">{{ item.promotion.description }}</p><p class="mb-2"><strong>Référence :</strong> {{ item.referenceParticipation }} · <strong>Partages :</strong> {{ item.nbrPartage|default(0) }}</p>
            {% if status in ['en_cours','terminer'] %}<div class="pr-proof"><div class="fw-semibold mb-2">Soumettre les deux captures de preuve</div><p class="mb-3">La vidéo de preuve doit être envoyée séparément à l’assistance Dressur sur WhatsApp.</p><form action="{{ path('app_programme_recompense_preuves') }}" method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token('programme_recompense_preuves') }}"><input type="hidden" name="idHistorique" value="{{ item.id }}"><div class="row g-2"><div class="col-md-6"><label for="capture1-{{ item.id }}" class="form-label">1. Liste des statuts</label><input id="capture1-{{ item.id }}" class="form-control form-control-sm" type="file" name="capture1" accept="image/jpeg,image/png,image/webp" required></div><div class="col-md-6"><label for="capture2-{{ item.id }}" class="form-label">2. Statut ouvert</label><input id="capture2-{{ item.id }}" class="form-control form-control-sm" type="file" name="capture2" accept="image/jpeg,image/png,image/webp" required></div></div><button class="btn btn-primary btn-sm mt-3" type="submit"><i class="fas fa-upload me-1"></i>Envoyer les preuves</button></form></div>{% elseif status == 'en_attente' %}<div class="alert alert-warning py-2 mb-0">Vos captures sont en cours d’examen. Envoyez également la vidéo à l’assistance Dressur.</div>{% elseif status == 'approuver' %}<div class="alert alert-success py-2 mb-0">Vos preuves ont été validées et la récompense a été créditée sur votre solde Dressur.</div>{% elseif status in ['echouer','refuser'] %}<div class="alert alert-danger py-2 mb-0">Cette participation ne peut plus recevoir de récompense.</div>{% endif %}
          </div>
        </details>
      {% endfor %}
    {% endif %}
  </section>
</div>
{% endblock %}
