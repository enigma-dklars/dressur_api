{% extends 'basePrivate.html.twig' %}

{% block title %}Programme des récompenses{% endblock %}

{% block body %}
<style>
.pr-hero{background:linear-gradient(135deg,#1565c0,#4f46e5);color:#fff;border-radius:20px;padding:28px 24px;margin-bottom:18px;box-shadow:0 12px 28px rgba(21,101,192,.22)}
.pr-card{background:var(--bs-body-bg,#fff);border:1px solid var(--bs-border-color,rgba(0,0,0,.08));border-radius:16px;padding:20px;margin-bottom:14px;box-shadow:0 3px 12px rgba(0,0,0,.05)}
.pr-card h2{font-size:1.02rem;font-weight:700;margin:0 0 12px;color:var(--bs-body-color,#212529)}
.pr-card p,.pr-card li{font-size:.9rem;line-height:1.55;color:var(--bs-secondary-color,#6c757d)}
.pr-card ul{padding-left:1.2rem;margin-bottom:0}.pr-card li{margin-bottom:7px}.pr-card li:last-child{margin-bottom:0}
.pr-step{display:flex;gap:12px;align-items:flex-start;margin-bottom:12px}.pr-step:last-child{margin-bottom:0}.pr-step-number{width:28px;height:28px;border-radius:50%;background:#e8f0fe;color:#1565c0;display:flex;align-items:center;justify-content:center;font-weight:700;flex:0 0 28px}
.pr-condition{display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:12px;background:var(--bs-tertiary-bg,#f8f9fa);margin-bottom:8px;font-size:.88rem;color:var(--bs-body-color,#212529)}
.pr-condition i{font-size:18px}.pr-condition.ok i{color:#198754}.pr-condition.no i{color:#dc3545}
.pr-reward{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-radius:12px;background:var(--bs-tertiary-bg,#f8f9fa);margin-bottom:8px}.pr-reward:last-child{margin-bottom:0}.pr-reward strong{color:var(--bs-body-color,#212529)}.pr-reward span{font-weight:700;color:#198754}
html.dark-theme .pr-card,html.semi-dark .pr-card{box-shadow:0 3px 12px rgba(0,0,0,.25)}
@media(min-width:768px){.pr-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.pr-grid .pr-card{margin-bottom:0}}
</style>

<div class="container-fluid px-0" style="max-width:1100px;margin:0 auto;">
  <section class="pr-hero">
    <div class="d-flex align-items-center gap-3 mb-2"><i class="fas fa-star" style="font-size:28px"></i><h1 class="h4 mb-0 fw-bold">Gagnez des récompenses avec Dressur</h1></div>
    <p class="mb-0" style="color:rgba(255,255,255,.88)">Partagez des promotions d’affaires sur votre statut WhatsApp et soyez récompensé.</p>
  </section>

  {% for type, messages in app.flashes %}
    {% for message in messages %}<div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>{% endfor %}
  {% endfor %}

  <div class="pr-grid">
    <section class="pr-card">
      <h2><i class="fas fa-circle-info text-primary me-2"></i>Présentation</h2>
      <p>Le Programme des récompenses Dressur est une opportunité de gain occasionnelle destinée aux utilisateurs qui partagent des promotions d’affaires (produits et services) depuis Dressur sur leur statut WhatsApp.</p>
      <p class="mb-0">Les annonceurs font connaître leurs offres et les utilisateurs reçoivent une récompense après validation des preuves, selon le quota disponible.</p>
    </section>

    <section class="pr-card">
      <h2><i class="fab fa-whatsapp text-success me-2"></i>Réseau concerné</h2>
      <ul><li>WhatsApp — statut uniquement.</li><li>Les autres réseaux sociaux ne sont pas pris en charge.</li></ul>
    </section>

    <section class="pr-card">
      <h2><i class="fas fa-list-check text-primary me-2"></i>Comment ça fonctionne</h2>
      <div class="pr-step"><span class="pr-step-number">1</span><div>Identifiez une promotion éligible au programme.</div></div>
      <div class="pr-step"><span class="pr-step-number">2</span><div>Partagez-la depuis Dressur vers votre statut WhatsApp.</div></div>
      <div class="pr-step"><span class="pr-step-number">3</span><div>Conservez le contenu officiel sans modifier l’image ni le texte.</div></div>
      <div class="pr-step"><span class="pr-step-number">4</span><div>Après 20 heures, soumettez vos preuves pour analyse.</div></div>
      <div class="pr-step"><span class="pr-step-number">5</span><div>Si les preuves sont validées et le quota disponible, votre solde est crédité.</div></div>
    </section>

    <section class="pr-card">
      <h2><i class="fas fa-chart-line text-primary me-2"></i>Paliers de vues et récompenses</h2>
      <p>Vous êtes rémunéré selon le plus haut seuil de vues atteint.</p>
      <div class="pr-reward"><strong>250 vues</strong><span>100 FCFA</span></div><div class="pr-reward"><strong>500 vues</strong><span>200 FCFA</span></div><div class="pr-reward"><strong>1 000 vues</strong><span>500 FCFA</span></div><div class="pr-reward"><strong>2 000 vues</strong><span>1 000 FCFA</span></div><div class="pr-reward"><strong>4 000 vues</strong><span>2 500 FCFA</span></div>
    </section>

    <section class="pr-card">
      <h2><i class="fas fa-shield-halved text-primary me-2"></i>Règles essentielles</h2>
      <ul><li>Le partage doit être effectué depuis Dressur.</li><li>Le statut doit rester visible au moins 20 heures et la preuve doit être soumise avant 24 heures.</li><li>Toute modification du contenu annule la récompense.</li><li>Les preuves doivent être authentiques, complètes et personnelles.</li><li>Seuls les premiers utilisateurs fournissant des preuves valides sont récompensés.</li></ul>
    </section>

    <section class="pr-card">
      <h2><i class="fas fa-camera text-primary me-2"></i>Preuves obligatoires</h2>
      <p>Vous devrez fournir deux captures d’écran : la liste des statuts avec la promotion visible, puis le statut ouvert avec l’image, le texte, les vues et la date/heure visibles.</p>
      <p class="mb-0">Une vidéo montrant l’ouverture de WhatsApp, le statut, la lecture du contenu, le défilement des vues et les informations de date/heure doit être envoyée séparément à l’assistance Dressur sur WhatsApp.</p>
    </section>

    <section class="pr-card">
      <h2><i class="fas fa-wallet text-primary me-2"></i>Récompense et solde</h2>
      <ul><li>Les gains sont ajoutés à votre solde du Programme des récompenses.</li><li>Le solde est un crédit Dressur et n’est pas retirable en espèces.</li><li>Il peut être utilisé automatiquement pour payer un Boost Contact, une Promotion Affaire ou une Promotion Réseaux Sociaux.</li><li>Atteindre un seuil ne garantit pas automatiquement le paiement : les preuves et le quota doivent être validés.</li></ul>
    </section>
  </div>

  <section class="pr-card mt-3">
    <h2><i class="fas fa-user-check text-primary me-2"></i>Conditions d’accès</h2>
    {% set conditionRows = [
      {key:'inscritDepuis7Jours', label:'Votre compte est inscrit depuis au moins 7 jours.', icon:'fa-calendar-check'},
      {key:'mailConfirme', label:'Votre adresse e-mail est confirmée.', icon:'fa-envelope-circle-check'},
      {key:'whatsappConfirme', label:'Votre numéro WhatsApp est confirmé.', icon:'fa-phone-volume'},
      {key:'cinqCommandes', label:'Vous avez effectué au moins 5 commandes payantes (' ~ conditions.nbrCommandes ~ '/5).', icon:'fa-cart-shopping'}
    ] %}
    {% for row in conditionRows %}
      <div class="pr-condition {{ conditions[row.key] ? 'ok' : 'no' }}"><i class="fas {{ conditions[row.key] ? 'fa-circle-check' : 'fa-circle-xmark' }}"></i><span>{{ row.label }}</span></div>
    {% endfor %}
    <div class="mt-3 d-flex align-items-center justify-content-between gap-3 flex-wrap">
      <span class="small text-secondary">En cliquant sur Participer, vous acceptez les règles et vous engagez à fournir les preuves demandées.</span>
      <form method="post" action="{{ path('app_programme_recompense_inscription') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('programme_recompense_inscription') }}">
        <button class="btn btn-primary" type="submit" {% if not conditions.toutesConditionsRemplies %}disabled{% endif %}><i class="fas fa-star me-1"></i>Participer</button>
      </form>
    </div>
  </section>
</div>
{% endblock %}
