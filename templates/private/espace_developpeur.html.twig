{% block title %}Espace développeur{% endblock %}

{% block body %}
<div class="container-fluid px-0 pb-5">
    <section class="web-feature-hero mt-3">
        <i class="fas fa-code d-block fs-1 mb-3" aria-hidden="true"></i>
        <h1 class="web-feature-hero-title">Espace développeur</h1>
        <p class="web-feature-hero-subtitle mb-0">Connectez vos outils à Dressur avec une API HTTP/JSON sécurisée.</p>
    </section>

    <div class="row g-3 mt-2">
        <div class="col-12 col-xl-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <p class="text-uppercase small text-muted fw-semibold mb-2">Solde Dressur</p>
                    <div class="display-6 fw-bold">{{ user.soldeDressur|default(0) }} <span class="fs-6">FCFA</span></div>
                    <p class="text-muted mt-2 mb-0">Le même solde est utilisé pour vos services Dressur et vos commandes API.</p>
                    {% if user.developpeur|default(false) %}
                        <span class="badge bg-success mt-3">Accès développeur actif</span>
                    {% else %}
                        <span class="badge bg-secondary mt-3">Statut : {{ user.developerProfileStatus|default('inactive') }}</span>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-8">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <h2 class="h5 mb-1">Documentation API</h2>
                            <p class="text-muted mb-0">Catalogue, commandes, commentaires JSON, idempotence et polling protégé.</p>
                        </div>
                        <a class="btn btn-outline-primary" href="{{ documentationUrl }}" target="_blank" rel="noopener">Ouvrir la documentation</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if not user.developpeur|default(false) %}
    <section class="card shadow-sm border-0 mt-3">
        <div class="card-body">
            <h2 class="h5">Activer l’accès développeur</h2>
            {% if user.montantRechargeInitialeDeveloppeur|default(0) <= 0 %}
                <div class="alert alert-info mb-0">L’activation est momentanément indisponible. Veuillez contacter l’assistance par WhatsApp.</div>
            {% else %}
                <p class="text-muted">Une recharge minimale de <strong>{{ user.montantRechargeInitialeDeveloppeur }} FCFA</strong> est requise. Le montant payé est crédité intégralement à votre solde Dressur et vous pouvez recharger davantage.</p>
                <form id="developerActivationForm" class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="developerAmount">Montant de recharge</label>
                        <input id="developerAmount" class="form-control" type="number" min="{{ user.montantRechargeInitialeDeveloppeur }}" step="1" value="{{ user.montantRechargeInitialeDeveloppeur }}" required>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="developerTel">Numéro de téléphone</label>
                        <input id="developerTel" class="form-control" type="tel" value="{{ user.tel|default('') }}" required>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="developerPayment">Moyen de paiement</label>
                        <select id="developerPayment" class="form-select" required>
                            <option value="">Choisir</option>
                            {% for method in paymentMethods %}
                                <option value="{{ method.id }}">{{ method.pays }} — {{ method.titre }} ({{ method.aggregator }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input id="developerConditions" class="form-check-input" type="checkbox" required>
                            <label class="form-check-label" for="developerConditions">J’accepte les conditions d’utilisation de l’API développeur Dressur.</label>
                        </div>
                    </div>
                    <div class="col-12"><button class="btn btn-primary" type="submit">Continuer vers le paiement</button></div>
                </form>
                <div id="developerActivationMessage" class="mt-3" aria-live="polite"></div>
            {% endif %}
        </div>
    </section>
    {% else %}
    <section class="card shadow-sm border-0 mt-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                <div><h2 class="h5 mb-1">Clés API privées</h2><p class="text-muted mb-0">Le secret complet n’est affiché qu’une seule fois à la création.</p></div>
                <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#newDeveloperKeyModal">Nouvelle clé</button>
            </div>
            <div id="developerKeyMessage" aria-live="polite"></div>
            <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Libellé</th><th>Identifiant</th><th>Scopes</th><th>État</th><th></th></tr></thead><tbody id="developerKeysBody"><tr><td colspan="5" class="text-muted">Chargement…</td></tr></tbody></table></div>
        </div>
    </section>
    <section class="card shadow-sm border-0 mt-3">
        <div class="card-body">
            <h2 class="h5">Historique des commandes API</h2>
            <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Référence</th><th>Quantité</th><th>Montant</th><th>Statut</th><th>Date</th></tr></thead><tbody id="developerOrdersBody"><tr><td colspan="5" class="text-muted">Chargement…</td></tr></tbody></table></div>
        </div>
    </section>
    {% endif %}
</div>

{% if user.developpeur|default(false) %}
<div class="modal fade" id="newDeveloperKeyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <form id="developerKeyForm">
            <div class="modal-header"><h2 class="modal-title h5">Créer une clé API</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button></div>
            <div class="modal-body">
                <label for="developerKeyLabel" class="form-label">Libellé</label>
                <input id="developerKeyLabel" class="form-control" maxlength="120" placeholder="Mon intégration" required>
                <div class="form-text">Les scopes sont activés sur l’ensemble de l’API développeur v1 pour cette première version.</div>
                <div id="developerNewKeySecret" class="alert alert-warning d-none mt-3"></div>
            </div>
            <div class="modal-footer"><button class="btn btn-primary" type="submit">Créer la clé</button></div>
        </form>
    </div></div>
</div>
{% endif %}

<script>
(function () {
    const message = (element, text, type) => { element.innerHTML = '<div class="alert alert-' + type + '">' + text + '</div>'; };
    const activationForm = document.getElementById('developerActivationForm');
    if (activationForm) {
        activationForm.addEventListener('submit', async function (event) {
            event.preventDefault();
            const output = document.getElementById('developerActivationMessage');
            const body = new URLSearchParams({
                montantRecharge: document.getElementById('developerAmount').value,
                tel: document.getElementById('developerTel').value,
                methodePaiementId: document.getElementById('developerPayment').value,
                conditionsAccepted: document.getElementById('developerConditions').checked ? '1' : '0'
            });
            try {
                const response = await fetch('/api/developpeur/activation', { method: 'POST', body, credentials: 'same-origin', headers: {'X-Requested-With': 'XMLHttpRequest'} });
                const data = await response.json();
                if (!response.ok || data.error) { message(output, data.message || 'Impossible de démarrer le paiement.', 'danger'); return; }
                message(output, data.message || 'Paiement démarré. Suivez les instructions affichées.', 'success');
                if (data.redirect) window.location.href = data.redirect;
            } catch (error) { message(output, 'Service momentanément indisponible. Veuillez réessayer.', 'danger'); }
        });
    }

    const ordersBody = document.getElementById('developerOrdersBody');
    if (ordersBody) {
        fetch('/api/developpeur/historique', {credentials: 'same-origin'}).then(r => r.json()).then(data => { if (data.error) { ordersBody.innerHTML = '<tr><td colspan="5" class="text-danger">Impossible de charger l’historique.</td></tr>'; return; } const labels = {0: 'invalid_url', 1: 'pending', 2: 'in_progress', 3: 'completed'}; ordersBody.innerHTML = (data.orders || []).length ? data.orders.map(order => '<tr><td><code>' + escapeHtml(order.reference) + '</code></td><td>' + escapeHtml(order.quantity) + '</td><td>' + escapeHtml(order.amount) + ' FCFA</td><td>' + escapeHtml(labels[order.statusNumber] || 'unknown') + '</td><td>' + escapeHtml(order.createdAt || '') + '</td></tr>').join('') : '<tr><td colspan="5" class="text-muted">Aucune commande API.</td></tr>'; }).catch(() => { ordersBody.innerHTML = '<tr><td colspan="5" class="text-danger">Impossible de charger l’historique.</td></tr>'; });
    }
    const keysBody = document.getElementById('developerKeysBody');
    const keyMessage = document.getElementById('developerKeyMessage');
    let currentKeys = [];
    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[character]));
    const renderKeys = (keys) => {
        currentKeys = keys;
        if (!keysBody) return;
        keysBody.innerHTML = keys.length ? keys.map(key => '<tr><td>' + escapeHtml(key.label) + '</td><td><code>' + escapeHtml(key.keyId) + '</code><br><small>' + escapeHtml(key.secretPrefix) + '…</small></td><td><small>' + escapeHtml((key.scopes || []).join(', ')) + '</small></td><td><span class="badge ' + (key.revokedAt ? 'bg-secondary' : 'bg-success') + '">' + (key.revokedAt ? 'Révoquée' : 'Active') + '</span></td><td>' + (key.revokedAt ? '' : '<button class="btn btn-sm btn-outline-danger" data-revoke-key="' + escapeHtml(key.keyId) + '">Révoquer</button>') + '</td></tr>').join('') : '<tr><td colspan="5" class="text-muted">Aucune clé API.</td></tr>';
    };
    if (keysBody) {
        fetch('/api/developpeur/cles', {credentials: 'same-origin'}).then(r => r.json()).then(data => { if (!data.error) renderKeys(data.keys || []); else message(keyMessage, data.message || 'Impossible de charger les clés.', 'danger'); }).catch(() => message(keyMessage, 'Impossible de charger les clés.', 'danger'));
        keysBody.addEventListener('click', async (event) => { const button = event.target.closest('[data-revoke-key]'); if (!button || !window.confirm('Révoquer cette clé ?')) return; const response = await fetch('/api/developpeur/cles/' + encodeURIComponent(button.dataset.revokeKey) + '/revoquer', {method: 'POST', credentials: 'same-origin'}); const data = await response.json(); if (data.error) message(keyMessage, data.message || 'Impossible de révoquer la clé.', 'danger'); else { message(keyMessage, data.message || 'Clé révoquée.', 'success'); currentKeys = currentKeys.map(key => key.keyId === button.dataset.revokeKey ? Object.assign({}, key, {revokedAt: new Date().toISOString()}) : key); renderKeys(currentKeys); } });
    }
    const keyForm = document.getElementById('developerKeyForm');
    if (keyForm) keyForm.addEventListener('submit', async (event) => { event.preventDefault(); const response = await fetch('/api/developpeur/cles', {method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: new URLSearchParams({label: document.getElementById('developerKeyLabel').value})}); const data = await response.json(); const secret = document.getElementById('developerNewKeySecret'); if (data.error) { secret.className = 'alert alert-danger mt-3'; secret.textContent = data.message || 'Impossible de créer la clé.'; return; } secret.className = 'alert alert-warning mt-3'; secret.innerHTML = '<strong>Copiez maintenant ce token, il ne sera plus réaffiché :</strong><br><code>' + escapeHtml(data.token) + '</code>'; currentKeys.unshift(data.key); renderKeys(currentKeys); });
})();
</script>
{% endblock %}
