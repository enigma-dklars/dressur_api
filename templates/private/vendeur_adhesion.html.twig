{% extends "basePrivate.html.twig" %}
{% block title %}Devenir Vendeur{% endblock %}

{% block body %}
<div class="container-fluid px-0 pb-4">

    {# ── Back button ── #}
    <div class="d-flex align-items-center gap-2 mb-0 px-2 pt-2">
        <a href="/parametres" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-chevron-left"></i>
        </a>
        <h5 class="mb-0 fw-bold">Devenir Vendeur</h5>
    </div>

    {# ── Header gradient ── #}
    <div class="web-feature-hero mt-3">
        <i class="fas fa-store d-block fs-1 mb-3" aria-hidden="true"></i>
        <h1 class="web-feature-hero-title">Devenez Vendeur Dressur</h1>
        <p class="web-feature-hero-subtitle">Accédez à des avantages exclusifs et développez votre activité avec Dressur.</p>
    </div>

    <div class="pt-4 px-3">

        {# ── Présentation ── #}
        <p class="web-feature-section-title">Présentation</p>
        <p class="web-feature-card-text">
            Le statut Vendeur Dressur est réservé aux utilisateurs qui souhaitent bénéficier d'avantages commerciaux sur la plateforme.
            Il s'obtient via un paiement unique d'adhésion et donne accès à des fonctionnalités et tarifs privilégiés.
        </p>

        <hr class="my-4">

        {# ── Avantages ── #}
        <p class="web-feature-section-title">Avantages vendeur</p>
        <div class="d-flex align-items-start gap-2 web-feature-space-xs">
            <i class="fas fa-tag text-primary mt-1 flex-shrink-0 small" aria-hidden="true"></i>
            <span class="web-feature-card-text">10% de réduction sur toutes les promotions réseau sociaux</span>
        </div>
        <div class="d-flex align-items-start gap-2 web-feature-space-xs">
            <i class="fas fa-wallet text-primary mt-1 flex-shrink-0 small" aria-hidden="true"></i>
            <span class="web-feature-card-text">Solde rechargeable utilisable pour vos achats sur Dressur</span>
        </div>
        <div class="d-flex align-items-start gap-2 web-feature-space-sm">
            <i class="fas fa-headset text-primary mt-1 flex-shrink-0 small" aria-hidden="true"></i>
            <span class="web-feature-card-text">Support prioritaire réservé aux vendeurs</span>
        </div>

        <hr class="my-4">

        {# ── Comment ça marche ── #}
        <p class="web-feature-section-title">Comment ça marche</p>
        <div class="d-flex align-items-start gap-2 web-feature-space-xs">
            <div class="web-feature-badge flex-shrink-0">1</div>
            <span class="web-feature-card-text">Choisissez votre méthode de paiement (Mobile Money ou carte).</span>
        </div>
        <div class="d-flex align-items-start gap-2 web-feature-space-xs">
            <div class="web-feature-badge flex-shrink-0">2</div>
            <span class="web-feature-card-text">Payez les frais d'adhésion de {{ fraisAdhesionVendeur|number_format(0, ',', ' ') }} FCFA (paiement unique).</span>
        </div>
        <div class="d-flex align-items-start gap-2 web-feature-space-xs">
            <div class="web-feature-badge flex-shrink-0">3</div>
            <span class="web-feature-card-text">Effectuez une recharge initiale de votre solde (minimum 500 FCFA).</span>
        </div>
        <div class="d-flex align-items-start gap-2 web-feature-space-sm">
            <div class="web-feature-badge flex-shrink-0">4</div>
            <span class="web-feature-card-text">Votre statut vendeur est activé immédiatement après confirmation du paiement.</span>
        </div>

        <hr class="my-4">

        {# ── Frais d'adhésion ── #}
        <p class="web-feature-section-title">Frais d'adhésion</p>
        <div class="web-feature-card text-center mb-0">
            <div class="display-6 fw-bold text-primary lh-1">{{ fraisAdhesionVendeur|number_format(0, ',', ' ') }} FCFA</div>
            <div class="small text-muted d-block mt-2">Paiement unique, non répétable.</div>
        </div>

        <hr class="my-4">

        {# ── Paiement ── #}
        <p class="web-feature-section-title">Paiement</p>
        <div class="web-feature-card">

            {# Méthode de paiement #}
            <div class="mb-3">
                <label class="form-label fw-semibold small text-secondary">Méthode de paiement</label>
                <select id="va_methode" class="form-select">
                    <option value="" disabled selected>Moyen de paiement mobile ou par carte</option>
                    {% for m in listeMethodePaiements %}
                        <option value="{{ m.value }}">{{ m.titre }}</option>
                    {% endfor %}
                </select>
            </div>

            {# Numéro de paiement #}
            <div class="mb-3">
                <label class="form-label fw-semibold small text-secondary">Indicatif + Numéro du paiement</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-phone"></i></span>
                    <input type="tel" id="va_tel" class="form-control" placeholder="+22890000000"
                           value="{{ user.tel ?? '' }}">
                </div>
            </div>

            {# Recharge initiale #}
            <div class="mb-3">
                <label class="form-label fw-semibold small text-secondary">
                    Recharge initiale <span class="fw-normal text-muted">(obligatoire, min 500 FCFA)</span>
                </label>
                <div class="input-group">
                    <input type="number" id="va_montant" class="form-control" min="500" value="500" placeholder="500">
                    <span class="input-group-text">FCFA</span>
                </div>
                <div id="va_montantError" class="text-danger small mt-1" style="display:none"></div>
            </div>

            {# Total dynamique #}
            <div class="web-feature-card d-flex justify-content-between align-items-center py-3 px-3 mb-3">
                <span class="fw-semibold">Total à payer</span>
                <strong id="va_total" class="text-primary fs-5">{{ (fraisAdhesionVendeur + 500)|number_format(0, ',', ' ') }} FCFA</strong>
            </div>

            <button id="va_btn" class="web-feature-btn-primary w-100 mt-1">
                <span id="va_btnText">Payer <span id="va_btnTotal">{{ (fraisAdhesionVendeur + 500)|number_format(0, ',', ' ') }}</span> FCFA</span>
                <span id="va_spinner" class="spinner-border spinner-border-sm ms-2" style="display:none"></span>
            </button>
        </div>
    </div>
</div>

<script>
(function(){
    const montantInput = document.getElementById('va_montant');
    const totalEl      = document.getElementById('va_total');
    const btnTotalEl   = document.getElementById('va_btnTotal');
    const errEl        = document.getElementById('va_montantError');
    const btn          = document.getElementById('va_btn');
    const spinner      = document.getElementById('va_spinner');
    const fraisAdhesion = {{ fraisAdhesionVendeur|json_encode|raw }};

    function fmt(n){ return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g,' '); }

    function updateTotal(){
        const recharge = Math.max(0, parseInt(montantInput.value,10)||0);
        const total = fraisAdhesion + recharge;
        totalEl.textContent    = fmt(total) + ' FCFA';
        btnTotalEl.textContent = fmt(total);
    }
    montantInput.addEventListener('input', updateTotal);
    updateTotal();

    btn.addEventListener('click', async function(){
        const methode = document.getElementById('va_methode').value;
        const tel     = document.getElementById('va_tel').value.trim();
        const montant = parseInt(montantInput.value,10)||0;

        if(!methode){ showAlert('Attention','Veuillez choisir un moyen de paiement.','warning'); return; }
        if(!tel)    { showAlert('Attention','Veuillez saisir votre numéro de paiement (format international).','warning'); return; }
        if(montant < 500){
            errEl.textContent    = 'Une recharge initiale d\'au moins 500 FCFA est obligatoire.';
            errEl.style.display  = 'block';
            return;
        }
        errEl.style.display = 'none';

        btn.disabled = true;
        spinner.style.display = 'inline-block';

        try{
            const fd = new FormData();
            fd.append('uid',               getUID());
            fd.append('methodePaiementId', methode);
            fd.append('montantRecharge',   montant);
            fd.append('tel',               tel);

            const res  = await fetch(`${API_BASE_URL}/vendeur/adhesion`, { method:'POST', body:fd });
            const data = await res.json();

            if(data.error){
                showAlert(data.titre||'Erreur', data.message||'Une erreur est survenue.', 'danger');
            } else if(data.url && data.url !== 'none'){
                window.location.href = data.url;
            } else if(data.direct){
                showAlert('Succès 🎉','Paiement confirmé. Vous êtes maintenant vendeur ! Actualisation en cours…','success');
                setTimeout(()=>{ window.location.href = '/parametres'; }, 2500);
            }
        } catch(e){
            showAlert('Erreur','Une erreur réseau s\'est produite. Veuillez réessayer.','danger');
        } finally{
            btn.disabled = false;
            spinner.style.display = 'none';
        }
    });
})();
</script>
{% endblock %}
