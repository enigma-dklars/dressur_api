{% extends 'baseAdmin.html.twig' %}

{% block title %}ADMIN DASHBOARD{% endblock %}

{% block body %}
    <div class="row g-2 mb-2 row-cols-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 row-cols-xxl-5">
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Solde</p>
                            <h4 class="my-1">
                                <span class=" 
                                    {% if soldeZefame <= 5 %}text-danger{% endif %} 
                                    {% if soldeZefame > 5 and soldeZefame <= 10 %}text-warning{% endif %}
                                    {% if soldeZefame > 10 %}text-success{% endif %}
                                ">
                                    {{ soldeZefame|number_format(2, '.', ' ') }} €
                                </span>
                            </h4>
                            <p class="mb-0 font-13 text-warning"><i class="bi bi-caret-up-fill"></i> Solde API PRS</p>
                        </div>
                        <div class="widget-icon-large 
                            {% if soldeZefame <= 5 %}bg-gradient-danger{% endif %} 
                            {% if soldeZefame > 5 and soldeZefame <= 10 %}bg-gradient-warning{% endif %}
                            {% if soldeZefame > 10 %}bg-gradient-success{% endif %}
                            text-white ms-auto">
                            <i class="fas fa-euro-sign"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

