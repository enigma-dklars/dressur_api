{% extends 'baseAdmin.html.twig' %}

{% block title %}ADMIN DASHBOARD{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        <div class="alert alert-{{ label }} mb-5">
            {% for message in messages %}
                <p>{{ message|raw }}</p>
            {% endfor %}
        </div>
    {% endfor %}

    {# ═══════════════════════════════════════════════════
        GRILLE DES STATISTIQUES
        Ordre : Pays · Solde · Users totaux
                Validation PA · Validation PR
                En cours boost · Programmé boost · En cours affaire
                Prog Recomp users · Vendeurs · Partenaires
                PA Prog Recomp · PA DS Statut
                Supprimés · Bannis · Sans service
    ═══════════════════════════════════════════════════ #}
    <div class="row g-2 mb-2 row-cols-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 row-cols-xxl-5">

        {# ── Répartition complète par pays ───────────────────── #}
        <div class="col-12" style="flex:0 0 100%;max-width:100%;width:100%;">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="mb-2">
                        <p class="mb-0 text-secondary">Utilisateurs par pays</p>
                        <p class="mb-0 font-13 text-secondary">Indicatif · nombre d’inscrits</p>
                    </div>
                    {% if topPays is not empty %}
                        {% set countryColors = ['bg-primary', 'bg-success', 'bg-warning', 'bg-info', 'bg-secondary'] %}
                        <div class="d-flex flex-wrap gap-2">
                            {% for row in topPays %}
                                {% set countryColor = loop.index0 < 5 ? countryColors[loop.index0] : 'bg-secondary' %}
                                {% set countryTextColor = loop.index0 == 2 ? 'text-dark' : 'text-white' %}
                                <span class="badge {{ countryColor }} {{ countryTextColor }}" style="font-size:.82rem;font-weight:500;padding:.5rem .65rem;">
                                    +{{ row.pays }} &middot; {{ row.nbr }}
                                </span>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="mb-0 text-secondary" style="font-size:.8rem;">Aucune donnée</p>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ── Solde API ───────────────────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Solde</p>
                            <h4 class="my-1">
                                <span class="{% if soldeZefame <= 5 %}text-danger{% elseif soldeZefame <= 10 %}text-warning{% else %}text-success{% endif %}">
                                    {{ soldeZefame|number_format(2, '.', ' ') }} €
                                </span>
                            </h4>
                            <p class="mb-0 font-13 text-secondary">Solde API PRS</p>
                        </div>
                        <div class="widget-icon-large {% if soldeZefame <= 5 %}bg-danger{% elseif soldeZefame <= 10 %}bg-warning{% else %}bg-success{% endif %} text-white ms-auto">
                            <i class="fas fa-euro-sign"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Utilisateurs totaux (réels | bots) ──────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Inscrits</p>
                            <h4 class="my-1">{{nbr_user}} <span class="text-secondary" style="font-size:.85rem">|</span> {{nbr_user_bot}}</h4>
                            <p class="mb-0 font-13 text-secondary">Réels&nbsp;|&nbsp;Bots</p>
                        </div>
                        <div class="widget-icon-large bg-primary text-white ms-auto">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Validation – Promo Affaire ───────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">En attente</p>
                            <h4 class="my-1 {% if valid_promo_affaire > 0 %}text-warning{% endif %}">{{valid_promo_affaire}}</h4>
                            <p class="mb-0 font-13 text-secondary">Validation P. Affaire</p>
                        </div>
                        <div class="widget-icon-large bg-warning text-white ms-auto">
                            <a href="{{path('app_crud_promotion_promo_en_attente')}}" class="text-white"><i class="fas fa-hourglass-half"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Validation – Promo Réseau ────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">En attente</p>
                            <h4 class="my-1 {% if valid_promo_reseau > 0 %}text-warning{% endif %}">{{valid_promo_reseau}}</h4>
                            <p class="mb-0 font-13 text-secondary">Validation P. Réseau</p>
                        </div>
                        <div class="widget-icon-large bg-warning text-white ms-auto">
                            <a href="{{path('app_crud_promo_reseau_promo_reseau_en_attente')}}" class="text-white"><i class="fas fa-hourglass-half"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── En cours – Boost Contact ──────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">En cours</p>
                            <h4 class="my-1 text-primary">{{encour_boost}}</h4>
                            <p class="mb-0 font-13 text-secondary">Boost Contact</p>
                        </div>
                        <div class="widget-icon-large bg-primary text-white ms-auto">
                            <i class="fas fa-bolt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Programmé – Boost Contact ────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Programmé</p>
                            <h4 class="my-1 text-info">{{programmer_boost}}</h4>
                            <p class="mb-0 font-13 text-secondary">Boost Contact</p>
                        </div>
                        <div class="widget-icon-large bg-info text-white ms-auto">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── En cours – Promo Affaire ──────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">En cours</p>
                            <h4 class="my-1 text-info">{{encour_affaire}}</h4>
                            <p class="mb-0 font-13 text-secondary">Promo Affaire</p>
                        </div>
                        <div class="widget-icon-large bg-info text-white ms-auto">
                            <i class="fas fa-briefcase"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Users – Programme Récompenses ───────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Programme</p>
                            <h4 class="my-1 text-success">{{users_prog_recomp}}</h4>
                            <p class="mb-0 font-13 text-secondary">Récompenses</p>
                        </div>
                        <div class="widget-icon-large bg-success text-white ms-auto">
                            <i class="fas fa-trophy"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Users Vendeurs ────────────────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Vendeurs</p>
                            <h4 class="my-1">{{users_vendeur}}</h4>
                            <p class="mb-0 font-13 text-secondary">Compte vendeur</p>
                        </div>
                        <div class="widget-icon-large bg-secondary text-white ms-auto">
                            <i class="fas fa-store"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Users Partenaires ──────────────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Partenaires</p>
                            <h4 class="my-1 text-primary">{{users_partenaire}}</h4>
                            <p class="mb-0 font-13 text-secondary">Compte partenaire</p>
                        </div>
                        <div class="widget-icon-large bg-primary text-white ms-auto">
                            <i class="fas fa-handshake"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Promo Affaire – Prog Récompenses ─────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Promo Affaire</p>
                            <h4 class="my-1 text-success">{{p_aff_recomp}}</h4>
                            <p class="mb-0 font-13 text-secondary">Prog. Récompenses</p>
                        </div>
                        <div class="widget-icon-large bg-success text-white ms-auto">
                            <i class="fas fa-trophy"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Promo Affaire – DS Statut ─────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Promo Affaire</p>
                            <h4 class="my-1 text-success">{{p_aff_ds_statut}}</h4>
                            <p class="mb-0 font-13 text-secondary">DS Statut</p>
                        </div>
                        <div class="widget-icon-large bg-success text-white ms-auto">
                            <i class="fas fa-circle-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Comptes supprimés ─────────────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Supprimés</p>
                            <h4 class="my-1 text-danger">{{deleted_users}}</h4>
                            <p class="mb-0 font-13 text-secondary">Comptes</p>
                        </div>
                        <div class="widget-icon-large bg-danger text-white ms-auto">
                            <i class="fas fa-user-minus"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Comptes bannis ────────────────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Bannis</p>
                            <h4 class="my-1 text-danger">{{banned_users}}</h4>
                            <p class="mb-0 font-13 text-secondary">Comptes</p>
                        </div>
                        <div class="widget-icon-large bg-danger text-white ms-auto">
                            <i class="fas fa-ban"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Users sans aucun service ─────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Sans service</p>
                            <h4 class="my-1 text-warning">{{users_inactifs}}</h4>
                            <p class="mb-0 font-13 text-secondary">Aucune utilisation</p>
                        </div>
                        <a href="{{ path('app_crud_user_sans_service') }}" class="widget-icon-large bg-warning text-white ms-auto text-decoration-none" title="Voir la liste">
                            <i class="fas fa-user-clock"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Graphique évolution 30 jours -->
    <div class="mt-4 mb-2">
        <h6 class="text-secondary fw-semibold mb-2"><i class="bi bi-graph-up me-1"></i>Évolution sur 30 jours</h6>
    </div>
    <div class="card radius-10 mb-3">
        <div class="card-body">
            <canvas id="evolutionChart" style="max-height: 380px;"></canvas>
        </div>
    </div>

    {# ── Transactions approuvées – 4 dernières semaines ─────────  #}
    <div class="row g-2 mb-2">
        <div class="col-12">
            <p class="mb-1 text-secondary fw-semibold" style="font-size:.85rem;letter-spacing:.04em;">
                <i class="fas fa-calendar-week me-1"></i> TRANSACTIONS APPROUVÉES — 4 DERNIÈRES SEMAINES
            </p>
        </div>
    </div>
    <div class="row g-2 mb-4 row-cols-2 row-cols-md-4">
        {% set weekColors = ['#4e73df', '#1cc88a', '#f6a21e', '#9b59b6'] %}
        {% set weekBgs    = ['bg-primary', 'bg-success', 'bg-warning', 'bg-secondary'] %}
        {% for week in weeklyTransactions %}
        <div class="col">
            <div class="card radius-10 mb-0 h-100" style="border-left:4px solid {{ weekColors[loop.index0] }};">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between">
                        <div>
                            <p class="mb-0 fw-semibold" style="font-size:.8rem;color:{{ weekColors[loop.index0] }};">
                                {{ week.label }}
                            </p>
                            <p class="mb-1 text-secondary" style="font-size:.72rem;">
                                {{ week.dateStart }} → {{ week.dateEnd }}
                            </p>
                            <h4 class="my-1 fw-bold" style="color:{{ weekColors[loop.index0] }};">
                                {{ week.total | number_format(0, ',', ' ') }}
                                <span class="text-secondary" style="font-size:.7rem;font-weight:400;">FCFA</span>
                            </h4>
                            <p class="mb-0 font-13 text-secondary">
                                <i class="fas fa-check-circle text-success me-1" style="font-size:.75rem;"></i>
                                {{ week.nbr }} transaction{{ week.nbr > 1 ? 's' : '' }}
                            </p>
                        </div>
                        <div class="widget-icon {{ weekBgs[loop.index0] }} text-white ms-2" style="width:38px;height:38px;min-width:38px;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                            <i class="fas fa-calendar-check" style="font-size:.9rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    {# ── Comparaison mensuelle ─────────────────────────────────  #}
    <div class="row g-2 mb-2">
        <div class="col-12">
            <p class="mb-1 text-secondary fw-semibold" style="font-size:.85rem;letter-spacing:.04em;">
                <i class="fas fa-chart-bar me-1"></i> TRANSACTIONS APPROUVÉES — COMPARAISON MENSUELLE
            </p>
        </div>
    </div>
    <div class="row g-2 mb-4 row-cols-1 row-cols-md-3">

        {# Mois en cours #}
        <div class="col">
            <div class="card radius-10 mb-0 h-100" style="border-left:4px solid #1cc88a;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary" style="font-size:.8rem;">Mois en cours</p>
                            <p class="mb-1 fw-semibold" style="font-size:.75rem;color:#1cc88a;">
                                {{ monthlyTransactions.current.label }}
                            </p>
                            <h4 class="my-1 fw-bold" style="color:#1cc88a;">
                                {{ monthlyTransactions.current.total | number_format(0, ',', ' ') }}
                                <span class="text-secondary" style="font-size:.7rem;font-weight:400;">FCFA</span>
                            </h4>
                            <p class="mb-0 font-13 text-secondary">
                                <i class="fas fa-check-circle text-success me-1" style="font-size:.75rem;"></i>
                                {{ monthlyTransactions.current.nbr }} transaction{{ monthlyTransactions.current.nbr > 1 ? 's' : '' }}
                            </p>
                        </div>
                        <div class="widget-icon-large bg-success text-white ms-auto">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Mois précédent #}
        <div class="col">
            <div class="card radius-10 mb-0 h-100" style="border-left:4px solid #858796;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary" style="font-size:.8rem;">Mois précédent</p>
                            <p class="mb-1 fw-semibold" style="font-size:.75rem;color:#858796;">
                                {{ monthlyTransactions.previous.label }}
                            </p>
                            <h4 class="my-1 fw-bold text-secondary">
                                {{ monthlyTransactions.previous.total | number_format(0, ',', ' ') }}
                                <span class="text-secondary" style="font-size:.7rem;font-weight:400;">FCFA</span>
                            </h4>
                            <p class="mb-0 font-13 text-secondary">
                                <i class="fas fa-check-circle text-success me-1" style="font-size:.75rem;"></i>
                                {{ monthlyTransactions.previous.nbr }} transaction{{ monthlyTransactions.previous.nbr > 1 ? 's' : '' }}
                            </p>
                        </div>
                        <div class="widget-icon-large bg-secondary text-white ms-auto">
                            <i class="fas fa-calendar"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Comparaison #}
        <div class="col">
            <div class="card radius-10 mb-0 h-100"
                 style="border-left:4px solid {% if monthlyTransactions.isBetter %}#1cc88a{% else %}#e74a3b{% endif %};">
                <div class="card-body d-flex flex-column justify-content-center">
                    <p class="mb-1 text-secondary" style="font-size:.8rem;">Comparaison</p>
                    {% if monthlyTransactions.variation is not null %}
                        {% if monthlyTransactions.isBetter %}
                            <h3 class="fw-bold mb-1" style="color:#1cc88a;">
                                <i class="fas fa-arrow-up me-1"></i>+{{ monthlyTransactions.variation }}%
                            </h3>
                            <p class="mb-0 font-13 text-success fw-semibold">
                                Ce mois est meilleur que le précédent
                            </p>
                        {% else %}
                            <h3 class="fw-bold mb-1" style="color:#e74a3b;">
                                <i class="fas fa-arrow-down me-1"></i>{{ monthlyTransactions.variation }}%
                            </h3>
                            <p class="mb-0 font-13 text-danger fw-semibold">
                                Ce mois est en dessous du précédent
                            </p>
                        {% endif %}
                        <p class="mb-0 font-13 text-secondary mt-1">
                            Écart :
                            {{ (monthlyTransactions.current.total - monthlyTransactions.previous.total) | abs | number_format(0, ',', ' ') }} FCFA
                        </p>
                    {% else %}
                        <h3 class="fw-bold mb-1 text-secondary">—</h3>
                        <p class="mb-0 font-13 text-secondary">Pas encore de données comparatives</p>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>

    <!-- Performances du mois (30 j vs 30 j précédents) -->
    <div class="mt-2 mb-2">
        <h6 class="text-secondary fw-semibold mb-2"><i class="bi bi-bar-chart-steps me-1"></i>Performances du mois</h6>
    </div>
    <div class="row g-2 mb-4">
        {% for item in chartSummary %}
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card radius-10 h-100" style="border-left: 4px solid {{ item.color }};">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center mb-2">
                        <i class="{{ item.icon }} me-2" style="color:{{ item.color }};font-size:1.1rem;"></i>
                        <span class="text-secondary small fw-semibold">{{ item.label }}</span>
                    </div>
                    <div class="d-flex align-items-end justify-content-between">
                        <div>
                            <div class="fs-3 fw-bold" style="color:{{ item.color }};">{{ item.current }}</div>
                            <div class="text-secondary" style="font-size:.75rem;">30 derniers jours</div>
                        </div>
                        <div class="text-end">
                            {% if item.variation is null %}
                                <span class="badge bg-secondary">–</span>
                            {% elseif item.variation > 0 %}
                                <span class="badge bg-success"><i class="bi bi-arrow-up-short"></i> +{{ item.variation }}%</span>
                            {% elseif item.variation < 0 %}
                                <span class="badge bg-danger"><i class="bi bi-arrow-down-short"></i> {{ item.variation }}%</span>
                            {% else %}
                                <span class="badge bg-secondary">0%</span>
                            {% endif %}
                            <div class="text-secondary mt-1" style="font-size:.72rem;">vs {{ item.previous }} période préc.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- Répartition par source -->
    <div class="mt-3 mb-2">
        <h6 class="text-secondary fw-semibold mb-2"><i class="bi bi-bar-chart-fill me-1"></i>Répartition par source</h6>
    </div>
    <div class="row g-2 row-cols-1 row-cols-md-3 row-cols-xl-5 mb-4">
        <div class="col">
            <div class="card radius-10 mb-0 h-100">
                <div class="card-body p-3">
                    <a href="{{ path('app_crud_user_index') }}" class="text-decoration-none">
                        <p class="mb-2 text-secondary small fw-semibold">Users</p>
                    </a>
                    <div class="d-flex flex-wrap gap-1">
                        <a href="{{ path('app_crud_user_index') }}" class="badge bg-dark text-white text-decoration-none" style="font-size:.8rem">Tous {{ userSourceCounts.total }}</a>
                        <a href="{{ path('app_crud_user_index', {'source': 'mobile'}) }}" class="badge bg-warning text-dark text-decoration-none" style="font-size:.8rem">mobile {{ userSourceCounts.mobile }}</a>
                        <a href="{{ path('app_crud_user_index', {'source': 'web'}) }}" class="badge bg-primary text-white text-decoration-none" style="font-size:.8rem">web {{ userSourceCounts.web }}</a>
                        <a href="{{ path('app_crud_user_index', {'source': 'none'}) }}" class="badge bg-secondary text-white text-decoration-none" style="font-size:.8rem">none {{ userSourceCounts.none }}</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card radius-10 mb-0 h-100">
                <div class="card-body p-3">
                    <a href="{{ path('app_crud_promotion_index') }}" class="text-decoration-none">
                        <p class="mb-2 text-secondary small fw-semibold">Promotions</p>
                    </a>
                    <div class="d-flex flex-wrap gap-1">
