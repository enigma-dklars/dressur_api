    <!-- Tableau récapitulatif 30 jours vs 30 jours précédents -->
    <div class="row g-2 mb-4">
        {% for item in chartSummary %}
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card radius-10 h-100" style="border-left: 4px solid {{ item.color }};">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center mb-2">
                        <i class="{{ item.icon }} me-2" style="color:{{ item.color }};font-size:1.1rem;"></i>
                        <span class="text-secondary small fw-semibold">{{ item.label }}</span>
                    </div>
                    <div class="d-flex align-items-end justify-content-between">
                        <div>
                            <div class="fs-3 fw-bold" style="color:{{ item.color }};">{{ item.current }}</div>
                            <div class="text-secondary" style="font-size:.75rem;">30 derniers jours</div>
                        </div>
                        <div class="text-end">
                            {% if item.variation is null %}
                                <span class="badge bg-secondary">–</span>
                            {% elseif item.variation > 0 %}
                                <span class="badge bg-success"><i class="bi bi-arrow-up-short"></i> +{{ item.variation }}%</span>
                            {% elseif item.variation < 0 %}
                                <span class="badge bg-danger"><i class="bi bi-arrow-down-short"></i> {{ item.variation }}%</span>
                            {% else %}
                                <span class="badge bg-secondary">0%</span>
                            {% endif %}
                            <div class="text-secondary mt-1" style="font-size:.72rem;">vs {{ item.previous }} période préc.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
(function () {
    var labels   = {{ chartLabels | json_encode | raw }};
    var users    = {{ chartUsers | json_encode | raw }};
    var boosts   = {{ chartBoosts | json_encode | raw }};
    var promoAff = {{ chartPromoAff | json_encode | raw }};
    var promoRes = {{ chartPromoRes | json_encode | raw }};

    var shortLabels = labels.map(function(d) {
        var parts = d.split('-');
        return parts[2] + '/' + parts[1];
    });

    var ctx = document.getElementById('evolutionChart').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: shortLabels,
            datasets: [
                {
                    label: 'Inscriptions utilisateurs',
                    data: users,
                    borderColor: '#4e73df',
                    backgroundColor: 'rgba(78,115,223,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
                {
                    label: 'Boost Contact',
                    data: boosts,
                    borderColor: '#f6a21e',
                    backgroundColor: 'rgba(246,162,30,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
                {
                    label: 'Promotion Affaire',
                    data: promoAff,
                    borderColor: '#1cc88a',
                    backgroundColor: 'rgba(28,200,138,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
                {
                    label: 'Promo Réseau Sociaux',
                    data: promoRes,
                    borderColor: '#9b59b6',
                    backgroundColor: 'rgba(155,89,182,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
            ]
        },
        options: {
            responsive: true,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            plugins: {
                legend: {
                    position: 'top',
                    labels: { usePointStyle: true, padding: 16 }
                },
                tooltip: {
                    callbacks: {
                        title: function(items) {
                            return labels[items[0].dataIndex];
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { maxRotation: 45, minRotation: 30 }
                },
                y: {
                    beginAtZero: true,
                    ticks: { stepSize: 1, precision: 0 },
                    grid: { color: 'rgba(0,0,0,0.05)' }
                }
            }
        }
    });
})();
</script>
