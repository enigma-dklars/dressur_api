    {# ── Top utilisateurs par service ─────────────────────────  #}
    {% set servicesTables = [
        { id: 'tbl-boost-contact',  title: 'Boost Contact',   color: '#0d6efd', rows: topUsersBoostContact },
        { id: 'tbl-promo-affaire',  title: 'Promo Affaire (Boost + Re-Boost)', color: '#17ad37', rows: topUsersPromoAffaire },
        { id: 'tbl-reseau-sociaux', title: 'Réseaux Sociaux', color: '#00c6fb', rows: topUsersReseauxSociaux }
    ] %}

    {% for svc in servicesTables %}
    <div class="card radius-10 mb-4">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="mb-0 fw-semibold" style="color:{{ svc.color }};">
                    <i class="fas fa-trophy me-1"></i> Top utilisateurs — {{ svc.title }}
                </h6>
                <div class="d-flex align-items-center gap-2">
                    <label class="mb-0 text-secondary small">Afficher</label>
                    <input type="number"
                           class="form-control form-control-sm top-limit-input"
                           data-table="{{ svc.id }}"
                           value="10" min="1" max="{{ svc.rows|length }}"
                           style="width:70px;">
                    <span class="text-secondary small">/ {{ svc.rows|length }} chargés</span>
                </div>
            </div>

            {% if svc.rows is empty %}
                <p class="text-secondary small mb-0">Aucune donnée.</p>
            {% else %}
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0" id="{{ svc.id }}">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Pseudo</th>
                            <th>Nom</th>
                            <th>Téléphone</th>
                            <th>Mail</th>
                            <th class="text-end">Montant dépensé</th>
                            <th class="text-center">Transactions</th>
                            <th>Création compte</th>
                            <th>Dernière connexion</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in svc.rows %}
                        <tr class="top-row">
                            <td>
                                {% if loop.index == 1 %}
                                    <span class="badge bg-warning text-dark">🥇 1</span>
                                {% elseif loop.index == 2 %}
                                    <span class="badge bg-secondary">🥈 2</span>
                                {% elseif loop.index == 3 %}
                                    <span class="badge bg-danger">🥉 3</span>
                                {% else %}
                                    <span class="text-secondary">{{ loop.index }}</span>
                                {% endif %}
                            </td>
                            <td class="fw-semibold">{{ row.pseudo ?? '—' }}</td>
                            <td>{{ row.nom ?? '—' }}</td>
                            <td class="text-nowrap">
                                {% if row.pays %}+{{ row.pays }}{% endif %}
                                {{ row.tel ?? '—' }}
                            </td>
                            <td>{{ row.mail ?? '—' }}</td>
                            <td class="text-end fw-bold" style="color:{{ svc.color }};">
                                {{ row.total | number_format(0, ',', ' ') }}
                            </td>
                            <td class="text-center">
                                <span class="badge bg-warning border">{{ row.nbr_tx }}</span>
                            </td>
                            <td class="text-nowrap small text-secondary">
                                {{ row.created_at ? row.created_at|date('d/m/Y') : '—' }}
                            </td>
                            <td class="text-nowrap small text-secondary">
                                {{ row.last_login ? row.last_login|date('d/m/Y H:i') : '—' }}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>
    </div>
    {% endfor %}

{% endblock %}

{% block script %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
(function () {
    var labels        = {{ chartLabels | json_encode | raw }};
    var users         = {{ chartUsers | json_encode | raw }};
    var boostsGratuit = {{ chartBoostsGratuit | json_encode | raw }};
    var boostsPayant  = {{ chartBoostsPayant | json_encode | raw }};
    var promoAff      = {{ chartPromoAff | json_encode | raw }};
    var promoRes      = {{ chartPromoRes | json_encode | raw }};

    var shortLabels = labels.map(function(d) {
        var parts = d.split('-');
        return parts[2] + '/' + parts[1];
    });

    var ctx = document.getElementById('evolutionChart').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: shortLabels,
            datasets: [
                {
                    label: 'Inscriptions utilisateurs',
                    data: users,
                    borderColor: '#4e73df',
                    backgroundColor: 'rgba(78,115,223,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
                {
                    label: 'Boost Contact Gratuit',
                    data: boostsGratuit,
                    borderColor: '#f6a21e',
                    backgroundColor: 'rgba(246,162,30,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
                {
                    label: 'Boost Contact Payant',
                    data: boostsPayant,
                    borderColor: '#e74c3c',
                    backgroundColor: 'rgba(231,76,60,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
                {
                    label: 'Promotion Affaire',
                    data: promoAff,
                    borderColor: '#1cc88a',
                    backgroundColor: 'rgba(28,200,138,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
                {
                    label: 'Promo Réseau Sociaux',
                    data: promoRes,
                    borderColor: '#9b59b6',
                    backgroundColor: 'rgba(155,89,182,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
            ]
        },
        options: {
            responsive: true,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            plugins: {
                legend: {
                    position: 'top',
                    labels: { usePointStyle: true, padding: 16 }
                },
                tooltip: {
                    callbacks: {
                        title: function(items) {
                            return labels[items[0].dataIndex];
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { maxRotation: 45, minRotation: 30 }
                },
                y: {
                    beginAtZero: true,
                    ticks: { stepSize: 1, precision: 0 },
                    grid: { color: 'rgba(0,0,0,0.05)' }
                }
            }
        }
    });
})();

// ── Top utilisateurs : affichage dynamique ───────────────────
document.querySelectorAll('.top-limit-input').forEach(function(input) {
    function applyLimit() {
        var tableId = input.getAttribute('data-table');
        var limit   = Math.max(1, parseInt(input.value) || 10);
        var rows    = document.querySelectorAll('#' + tableId + ' tbody .top-row');
        rows.forEach(function(row, i) {
            row.style.display = i < limit ? '' : 'none';
        });
    }
    applyLimit();
    input.addEventListener('input', applyLimit);
});
</script>
{% endblock %}