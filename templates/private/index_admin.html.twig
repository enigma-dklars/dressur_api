{% extends 'baseAdmin.html.twig' %}

{% block title %}ADMIN DASHBOARD{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        <div class="alert alert-{{ label }} mb-5">
            {% for message in messages %}
                <p>{{ message|raw }}</p>
            {% endfor %}
        </div>
    {% endfor %}

    {# ═══════════════════════════════════════════════════
        GRILLE DES STATISTIQUES
        Ordre : Solde · Users totaux · Top 5 Pays
                Validation PA · Validation PR
                En cours boost · Programmé boost · En cours affaire
                Prog Recomp users · Vendeurs
                PA Prog Recomp · PA DS Statut
                Supprimés · Bannis · Sans service
    ═══════════════════════════════════════════════════ #}
    <div class="row g-2 mb-2 row-cols-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 row-cols-xxl-5">

        {# ── Solde API ───────────────────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Solde</p>
                            <h4 class="my-1">
                                <span class="{% if soldeZefame <= 5 %}text-danger{% elseif soldeZefame <= 10 %}text-warning{% else %}text-success{% endif %}">
                                    {{ soldeZefame|number_format(2, '.', ' ') }} €
                                </span>
                            </h4>
                            <p class="mb-0 font-13 text-secondary">Solde API PRS</p>
                        </div>
                        <div class="widget-icon-large {% if soldeZefame <= 5 %}bg-danger{% elseif soldeZefame <= 10 %}bg-warning{% else %}bg-success{% endif %} text-white ms-auto">
                            <i class="fas fa-euro-sign"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Utilisateurs totaux (réels | bots) ──────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Inscrits</p>
                            <h4 class="my-1">{{nbr_user}} <span class="text-secondary" style="font-size:.85rem">|</span> {{nbr_user_bot}}</h4>
                            <p class="mb-0 font-13 text-secondary">Réels&nbsp;|&nbsp;Bots</p>
                        </div>
                        <div class="widget-icon-large bg-primary text-white ms-auto">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Top 5 Pays ───────────────────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <div class="widget-icon-large bg-info text-white me-2" style="width:38px;height:38px;font-size:18px;flex-shrink:0;">
                            <i class="fas fa-globe"></i>
                        </div>
                        <div>
                            <p class="mb-0 text-secondary" style="font-size:.78rem;line-height:1.1;">Top 5 Pays</p>
                            <p class="mb-0 font-13 text-secondary" style="font-size:.72rem;">par indicatif</p>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        {% for row in topPays %}
                            {% set colors = ['bg-primary', 'bg-success', 'bg-warning', 'bg-info', 'bg-secondary'] %}
                            <span class="badge {{ colors[loop.index0] }} text-white me-1" style="font-size:.75rem;font-weight:500;">
                                +{{ row.pays }} &middot; {{ row.nbr }}
                            </span>
                        {% else %}
                            <p class="mb-0 text-secondary" style="font-size:.8rem;">Aucune donnée</p>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        {# ── Validation – Promo Affaire ───────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">En attente</p>
                            <h4 class="my-1 {% if valid_promo_affaire > 0 %}text-warning{% endif %}">{{valid_promo_affaire}}</h4>
                            <p class="mb-0 font-13 text-secondary">Validation P. Affaire</p>
                        </div>
                        <div class="widget-icon-large bg-warning text-white ms-auto">
                            <a href="{{path('app_crud_promotion_promo_en_attente')}}" class="text-white"><i class="fas fa-hourglass-half"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Validation – Promo Réseau ────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">En attente</p>
                            <h4 class="my-1 {% if valid_promo_reseau > 0 %}text-warning{% endif %}">{{valid_promo_reseau}}</h4>
                            <p class="mb-0 font-13 text-secondary">Validation P. Réseau</p>
                        </div>
                        <div class="widget-icon-large bg-warning text-white ms-auto">
                            <a href="{{path('app_crud_promo_reseau_promo_reseau_en_attente')}}" class="text-white"><i class="fas fa-hourglass-half"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── En cours – Boost Contact ──────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">En cours</p>
                            <h4 class="my-1 text-primary">{{encour_boost}}</h4>
                            <p class="mb-0 font-13 text-secondary">Boost Contact</p>
                        </div>
                        <div class="widget-icon-large bg-primary text-white ms-auto">
                            <i class="fas fa-bolt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Programmé – Boost Contact ────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Programmé</p>
                            <h4 class="my-1 text-info">{{programmer_boost}}</h4>
                            <p class="mb-0 font-13 text-secondary">Boost Contact</p>
                        </div>
                        <div class="widget-icon-large bg-info text-white ms-auto">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── En cours – Promo Affaire ──────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">En cours</p>
                            <h4 class="my-1 text-info">{{encour_affaire}}</h4>
                            <p class="mb-0 font-13 text-secondary">Promo Affaire</p>
                        </div>
                        <div class="widget-icon-large bg-info text-white ms-auto">
                            <i class="fas fa-briefcase"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Users – Programme Récompenses ───────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Programme</p>
                            <h4 class="my-1 text-success">{{users_prog_recomp}}</h4>
                            <p class="mb-0 font-13 text-secondary">Récompenses</p>
                        </div>
                        <div class="widget-icon-large bg-success text-white ms-auto">
                            <i class="fas fa-trophy"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Users Vendeurs ────────────────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Vendeurs</p>
                            <h4 class="my-1">{{users_vendeur}}</h4>
                            <p class="mb-0 font-13 text-secondary">Compte vendeur</p>
                        </div>
                        <div class="widget-icon-large bg-secondary text-white ms-auto">
                            <i class="fas fa-store"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Promo Affaire – Prog Récompenses ─────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Promo Affaire</p>
                            <h4 class="my-1 text-success">{{p_aff_recomp}}</h4>
                            <p class="mb-0 font-13 text-secondary">Prog. Récompenses</p>
                        </div>
                        <div class="widget-icon-large bg-success text-white ms-auto">
                            <i class="fas fa-trophy"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Promo Affaire – DS Statut ─────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Promo Affaire</p>
                            <h4 class="my-1 text-success">{{p_aff_ds_statut}}</h4>
                            <p class="mb-0 font-13 text-secondary">DS Statut</p>
                        </div>
                        <div class="widget-icon-large bg-success text-white ms-auto">
                            <i class="fas fa-circle-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Comptes supprimés ─────────────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Supprimés</p>
                            <h4 class="my-1 text-danger">{{deleted_users}}</h4>
                            <p class="mb-0 font-13 text-secondary">Comptes</p>
                        </div>
                        <div class="widget-icon-large bg-danger text-white ms-auto">
                            <i class="fas fa-user-minus"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Comptes bannis ────────────────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Bannis</p>
                            <h4 class="my-1 text-danger">{{banned_users}}</h4>
                            <p class="mb-0 font-13 text-secondary">Comptes</p>
                        </div>
                        <div class="widget-icon-large bg-danger text-white ms-auto">
                            <i class="fas fa-ban"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Users sans aucun service ─────────────────────────  #}
        <div class="col">
            <div class="card radius-10 mb-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Sans service</p>
                            <h4 class="my-1 text-warning">{{users_inactifs}}</h4>
                            <p class="mb-0 font-13 text-secondary">Aucune utilisation</p>
                        </div>
                        <div class="widget-icon-large bg-warning text-white ms-auto">
                            <i class="fas fa-user-clock"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Graphique évolution 30 jours -->
    <div class="mt-4 mb-2">
        <h6 class="text-secondary fw-semibold mb-2"><i class="bi bi-graph-up me-1"></i>Évolution sur 30 jours</h6>
    </div>
    <div class="card radius-10 mb-3">
        <div class="card-body">
            <canvas id="evolutionChart" style="max-height: 380px;"></canvas>
        </div>
    </div>

    <!-- Performances du mois (30 j vs 30 j précédents) -->
    <div class="mt-2 mb-2">
        <h6 class="text-secondary fw-semibold mb-2"><i class="bi bi-bar-chart-steps me-1"></i>Performances du mois</h6>
    </div>
    <div class="row g-2 mb-4">
        {% for item in chartSummary %}
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card radius-10 h-100" style="border-left: 4px solid {{ item.color }};">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center mb-2">
                        <i class="{{ item.icon }} me-2" style="color:{{ item.color }};font-size:1.1rem;"></i>
                        <span class="text-secondary small fw-semibold">{{ item.label }}</span>
                    </div>
                    <div class="d-flex align-items-end justify-content-between">
                        <div>
                            <div class="fs-3 fw-bold" style="color:{{ item.color }};">{{ item.current }}</div>
                            <div class="text-secondary" style="font-size:.75rem;">30 derniers jours</div>
                        </div>
                        <div class="text-end">
                            {% if item.variation is null %}
                                <span class="badge bg-secondary">–</span>
                            {% elseif item.variation > 0 %}
                                <span class="badge bg-success"><i class="bi bi-arrow-up-short"></i> +{{ item.variation }}%</span>
                            {% elseif item.variation < 0 %}
                                <span class="badge bg-danger"><i class="bi bi-arrow-down-short"></i> {{ item.variation }}%</span>
                            {% else %}
                                <span class="badge bg-secondary">0%</span>
                            {% endif %}
                            <div class="text-secondary mt-1" style="font-size:.72rem;">vs {{ item.previous }} période préc.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- Répartition par source -->
    <div class="mt-3 mb-2">
        <h6 class="text-secondary fw-semibold mb-2"><i class="bi bi-bar-chart-fill me-1"></i>Répartition par source</h6>
    </div>
    <div class="row g-2 row-cols-1 row-cols-md-3 row-cols-xl-5 mb-4">
        <div class="col">
            <div class="card radius-10 mb-0 h-100">
                <div class="card-body p-3">
                    <a href="{{ path('app_crud_user_index') }}" class="text-decoration-none">
                        <p class="mb-2 text-secondary small fw-semibold">Users</p>
                    </a>
                    <div class="d-flex flex-wrap gap-1">
                        <a href="{{ path('app_crud_user_index') }}" class="badge bg-dark text-white text-decoration-none" style="font-size:.8rem">Tous {{ userSourceCounts.total }}</a>
                        <a href="{{ path('app_crud_user_index', {'source': 'mobile'}) }}" class="badge bg-warning text-dark text-decoration-none" style="font-size:.8rem">mobile {{ userSourceCounts.mobile }}</a>
                        <a href="{{ path('app_crud_user_index', {'source': 'web'}) }}" class="badge bg-primary text-white text-decoration-none" style="font-size:.8rem">web {{ userSourceCounts.web }}</a>
                        <a href="{{ path('app_crud_user_index', {'source': 'none'}) }}" class="badge bg-secondary text-white text-decoration-none" style="font-size:.8rem">none {{ userSourceCounts.none }}</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card radius-10 mb-0 h-100">
                <div class="card-body p-3">
                    <a href="{{ path('app_crud_promotion_index') }}" class="text-decoration-none">
                        <p class="mb-2 text-secondary small fw-semibold">Promotions</p>
                    </a>
                    <div class="d-flex flex-wrap gap-1">
                        <a href="{{ path('app_crud_promotion_index') }}" class="badge bg-dark text-white text-decoration-none" style="font-size:.8rem">Tous {{ promotionSourceCounts.total }}</a>
                        <a href="{{ path('app_crud_promotion_index', {'source': 'mobile'}) }}" class="badge bg-warning text-dark text-decoration-none" style="font-size:.8rem">mobile {{ promotionSourceCounts.mobile }}</a>
                        <a href="{{ path('app_crud_promotion_index', {'source': 'web'}) }}" class="badge bg-primary text-white text-decoration-none" style="font-size:.8rem">web {{ promotionSourceCounts.web }}</a>
                        <a href="{{ path('app_crud_promotion_index', {'source': 'none'}) }}" class="badge bg-secondary text-white text-decoration-none" style="font-size:.8rem">none {{ promotionSourceCounts.none }}</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card radius-10 mb-0 h-100">
                <div class="card-body p-3">
                    <a href="{{ path('app_crud_promo_reseau_index') }}" class="text-decoration-none">
                        <p class="mb-2 text-secondary small fw-semibold">Promo Réseau</p>
                    </a>
                    <div class="d-flex flex-wrap gap-1">
                        <a href="{{ path('app_crud_promo_reseau_index') }}" class="badge bg-dark text-white text-decoration-none" style="font-size:.8rem">Tous {{ promoReseauSourceCounts.total }}</a>
                        <a href="{{ path('app_crud_promo_reseau_index', {'source': 'mobile'}) }}" class="badge bg-warning text-dark text-decoration-none" style="font-size:.8rem">mobile {{ promoReseauSourceCounts.mobile }}</a>
                        <a href="{{ path('app_crud_promo_reseau_index', {'source': 'web'}) }}" class="badge bg-primary text-white text-decoration-none" style="font-size:.8rem">web {{ promoReseauSourceCounts.web }}</a>
                        <a href="{{ path('app_crud_promo_reseau_index', {'source': 'none'}) }}" class="badge bg-secondary text-white text-decoration-none" style="font-size:.8rem">none {{ promoReseauSourceCounts.none }}</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card radius-10 mb-0 h-100">
                <div class="card-body p-3">
                    <a href="{{ path('app_crud_boost_index') }}" class="text-decoration-none">
                        <p class="mb-2 text-secondary small fw-semibold">Boosts</p>
                    </a>
                    <div class="d-flex flex-wrap gap-1">
                        <a href="{{ path('app_crud_boost_index') }}" class="badge bg-dark text-white text-decoration-none" style="font-size:.8rem">Tous {{ boostSourceCounts.total }}</a>
                        <a href="{{ path('app_crud_boost_index', {'source': 'mobile'}) }}" class="badge bg-warning text-dark text-decoration-none" style="font-size:.8rem">mobile {{ boostSourceCounts.mobile }}</a>
                        <a href="{{ path('app_crud_boost_index', {'source': 'web'}) }}" class="badge bg-primary text-white text-decoration-none" style="font-size:.8rem">web {{ boostSourceCounts.web }}</a>
                        <a href="{{ path('app_crud_boost_index', {'source': 'none'}) }}" class="badge bg-secondary text-white text-decoration-none" style="font-size:.8rem">none {{ boostSourceCounts.none }}</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card radius-10 mb-0 h-100">
                <div class="card-body p-3">
                    <a href="{{ path('app_crud_transaction_index') }}" class="text-decoration-none">
                        <p class="mb-2 text-secondary small fw-semibold">Transactions</p>
                    </a>
                    <div class="d-flex flex-wrap gap-1">
                        <a href="{{ path('app_crud_transaction_index') }}" class="badge bg-dark text-white text-decoration-none" style="font-size:.8rem">Tous {{ transactionSourceCounts.total }}</a>
                        <a href="{{ path('app_crud_transaction_index', {'source': 'mobile'}) }}" class="badge bg-warning text-dark text-decoration-none" style="font-size:.8rem">mobile {{ transactionSourceCounts.mobile }}</a>
                        <a href="{{ path('app_crud_transaction_index', {'source': 'web'}) }}" class="badge bg-primary text-white text-decoration-none" style="font-size:.8rem">web {{ transactionSourceCounts.web }}</a>
                        <a href="{{ path('app_crud_transaction_index', {'source': 'none'}) }}" class="badge bg-secondary text-white text-decoration-none" style="font-size:.8rem">none {{ transactionSourceCounts.none }}</a>
                    </div>
                </div>
            </div>
        </div>

    </div>

    {# ── Revenus par service ───────────────────────────────────  #}
    <div class="row g-2 mb-4 row-cols-1 row-cols-sm-2 row-cols-xl-4">

        <div class="col">
            <div class="card radius-10 mb-0 h-100" style="border-left:4px solid #0d6efd;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Boost Contact</p>
                            <h4 class="my-1" style="color:#0d6efd;">{{ revenueByService['boost_contact'].total | number_format(0, ',', ' ') }}</h4>
                            <p class="mb-0 font-13 text-secondary">{{ revenueByService['boost_contact'].nbr }} transactions</p>
                        </div>
                        <div class="widget-icon-large bg-primary text-white ms-auto">
                            <i class="fas fa-bolt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card radius-10 mb-0 h-100" style="border-left:4px solid #17ad37;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Promo Affaire</p>
                            <h4 class="my-1" style="color:#17ad37;">{{ revenueByService['boost_affaire'].total | number_format(0, ',', ' ') }}</h4>
                            <p class="mb-0 font-13 text-secondary">{{ revenueByService['boost_affaire'].nbr }} transactions</p>
                        </div>
                        <div class="widget-icon-large bg-success text-white ms-auto">
                            <i class="fas fa-briefcase"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card radius-10 mb-0 h-100" style="border-left:4px solid #f7971e;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Re-Boost Affaire</p>
                            <h4 class="my-1" style="color:#f7971e;">{{ revenueByService['re_boost_affaire'].total | number_format(0, ',', ' ') }}</h4>
                            <p class="mb-0 font-13 text-secondary">{{ revenueByService['re_boost_affaire'].nbr }} transactions</p>
                        </div>
                        <div class="widget-icon-large bg-warning text-white ms-auto">
                            <i class="fas fa-redo"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card radius-10 mb-0 h-100" style="border-left:4px solid #00c6fb;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div>
                            <p class="mb-0 text-secondary">Réseaux Sociaux</p>
                            <h4 class="my-1" style="color:#00c6fb;">{{ revenueByService['boost_reseau_sociaux'].total | number_format(0, ',', ' ') }}</h4>
                            <p class="mb-0 font-13 text-secondary">{{ revenueByService['boost_reseau_sociaux'].nbr }} transactions</p>
                        </div>
                        <div class="widget-icon-large bg-info text-white ms-auto">
                            <i class="fas fa-share-alt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endblock %}

{% block script %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
(function () {
    var labels        = {{ chartLabels | json_encode | raw }};
    var users         = {{ chartUsers | json_encode | raw }};
    var boostsGratuit = {{ chartBoostsGratuit | json_encode | raw }};
    var boostsPayant  = {{ chartBoostsPayant | json_encode | raw }};
    var promoAff      = {{ chartPromoAff | json_encode | raw }};
    var promoRes      = {{ chartPromoRes | json_encode | raw }};

    var shortLabels = labels.map(function(d) {
        var parts = d.split('-');
        return parts[2] + '/' + parts[1];
    });

    var ctx = document.getElementById('evolutionChart').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: shortLabels,
            datasets: [
                {
                    label: 'Inscriptions utilisateurs',
                    data: users,
                    borderColor: '#4e73df',
                    backgroundColor: 'rgba(78,115,223,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
                {
                    label: 'Boost Contact Gratuit',
                    data: boostsGratuit,
                    borderColor: '#f6a21e',
                    backgroundColor: 'rgba(246,162,30,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
                {
                    label: 'Boost Contact Payant',
                    data: boostsPayant,
                    borderColor: '#e74c3c',
                    backgroundColor: 'rgba(231,76,60,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
                {
                    label: 'Promotion Affaire',
                    data: promoAff,
                    borderColor: '#1cc88a',
                    backgroundColor: 'rgba(28,200,138,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
                {
                    label: 'Promo Réseau Sociaux',
                    data: promoRes,
                    borderColor: '#9b59b6',
                    backgroundColor: 'rgba(155,89,182,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true,
                },
            ]
        },
        options: {
            responsive: true,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            plugins: {
                legend: {
                    position: 'top',
                    labels: { usePointStyle: true, padding: 16 }
                },
                tooltip: {
                    callbacks: {
                        title: function(items) {
                            return labels[items[0].dataIndex];
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { maxRotation: 45, minRotation: 30 }
                },
                y: {
                    beginAtZero: true,
                    ticks: { stepSize: 1, precision: 0 },
                    grid: { color: 'rgba(0,0,0,0.05)' }
                }
            }
        }
    });
})();
</script>
{% endblock %}