{% extends 'basePrivate.html.twig' %}

{% block title %}Promo. Affaire{% endblock %}

{% block body %}
<div class="row g-3">
    {% for promoaffaire in listepromoaffaire %}
        <div class="col-md-4">
            <div class="card mb-0 h-100">
                <div class="card-body">
                    {% if promoaffaire.typePromotionAffaire == "produit_service" %}
                        {% set bg_badge = "bg-success" %}
                        {% set tpa = "Produit Service" %}
                    {% elseif promoaffaire.typePromotionAffaire == "sites_applications" %}
                        {% set bg_badge = "bg-info" %}
                        {% set tpa = "Sites & Applications" %}
                    {% elseif promoaffaire.typePromotionAffaire == "offre_emploi" %}
                        {% set bg_badge = "bg-warning" %}
                        {% set tpa = "Offre Emploi" %}
                    {% else %}
                        {% set bg_badge = "bg-danger" %}
                        {% set tpa = "Demande Emploi" %}
                    {% endif %}
                    <span class="badge {{bg_badge}} text-white mb-1">{{ tpa }}</span>
                    
                    {% if promoaffaire.statusNumber == 0 %}{% set bg_badge = "bg-danger" %}{% endif %}
                    {% if promoaffaire.statusNumber == 1 %}{% set bg_badge = "bg-warning" %}{% endif %}
                    {% if promoaffaire.statusNumber == 2 %}{% set bg_badge = "bg-warning" %}{% endif %}
                    {% if promoaffaire.statusNumber == 3 %}{% set bg_badge = "bg-success" %}{% endif %}
                    {% if promoaffaire.statusNumber == 4 %}{% set bg_badge = "bg-success" %}{% endif %}
                    <span class="badge {{bg_badge}} text-white mb-1 mx-1">{{promoaffaire.status}}</span> 
                    
                    {% if promoaffaire.statusNumber == 0 %}
                        <p>
                            Motif : {{promoaffaire.motif}}
                        </p>
                        {% if promoaffaire.motifsRefus|length > 1 %}
                            <button class="btn btn-sm btn-outline-secondary mb-1" data-bs-toggle="modal" data-bs-target="#modal_historique_refus_{{promoaffaire.id}}">
                                Voir les refus précédents ({{ promoaffaire.motifsRefus|length - 1 }})
                            </button>
                        {% endif %}
                        {% if promoaffaire.typePromotionAffaire == "produit_service" %} <div class="actu-small-description mb-1"> <span class="text-success small">Tenez compte du motif de refus pour modifier votre promotion. Merci...</span> </div> {% endif %}
                        {% if promoaffaire.typePromotionAffaire == "offre_emploi" %} <div class="actu-small-description mb-1"> <span class="text-success small">Tenez compte du motif de refus pour soumettre une nouvelle promotion. Merci...</span> </div> {% endif %}
                        {% if promoaffaire.typePromotionAffaire == "dmd_emploi" %} <div class="actu-small-description mb-1"> <span class="text-success small">Tenez compte du motif de refus pour soumettre une nouvelle promotion. Merci...</span> </div> {% endif %}
                        {% if promoaffaire.typePromotionAffaire == "sites_applications" %} <div class="actu-small-description mb-1"> <span class="text-success small">Tenez compte du motif de refus pour soumettre une nouvelle promotion. Merci...</span> </div> {% endif %}
                    {% else %}
                        {% if promoaffaire.motifsRefus|length > 0 %}
                            <button class="btn btn-sm btn-outline-secondary mb-1" data-bs-toggle="modal" data-bs-target="#modal_historique_refus_{{promoaffaire.id}}">
                                <i class="fas fa-history me-1"></i> Historique des refus
                            </button>
                        {% endif %}
                        <div class="d-flex justify-content-between mb-1">
                            <div>
                                Impressions : <strong>{{promoaffaire.nombreImpression}}</strong>
                            </div>
                            <div>
                                Vues : <strong>{{promoaffaire.nombreDeVues}}</strong>
                            </div>
                        </div>
                        {% if promoaffaire.typePromotionAffaire == "produit_service" %} <div class="actu-small-description mb-1"> {{promoaffaire.description}} </div> {% endif %}
                        {% if promoaffaire.typePromotionAffaire == "offre_emploi" %} <div class="actu-small-description mb-1"> {{promoaffaire.annotherInfo.description_poste}} </div> {% endif %}
                        {% if promoaffaire.typePromotionAffaire == "dmd_emploi" %} <div class="actu-small-description mb-1"> {{promoaffaire.annotherInfo.description_profil_demandeur}} </div> {% endif %}
                        {% if promoaffaire.typePromotionAffaire == "sites_applications" %}
                            <div class="mb-1">
                                {% if promoaffaire.sousTypeSiteApp == "site_web" %}
                                    <span class="badge bg-info text-white">Site web</span>
                                {% elseif promoaffaire.sousTypeSiteApp == "app_mobile" %}
                                    <span class="badge bg-info text-white">App mobile</span>
                                {% else %}
                                    <span class="badge bg-info text-white">Logiciel</span>
                                {% endif %}
                            </div>
                            {% if promoaffaire.nomSiteApp %}
                                <div class="fw-semibold mb-1">{{ promoaffaire.nomSiteApp }}</div>
                            {% endif %}
                            <div class="actu-small-description mb-1">{{ promoaffaire.description }}</div>
                            {% if promoaffaire.urlSiteApp %}
                                <div class="mb-1">
                                    <a href="{{ promoaffaire.urlSiteApp }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary rounded-pill">
                                        {% if promoaffaire.sousTypeSiteApp == "site_web" %}
                                            <i class="fas fa-globe me-1"></i> Visiter
                                        {% elseif promoaffaire.sousTypeSiteApp == "app_mobile" %}
                                            <i class="fas fa-mobile-alt me-1"></i> Installer
                                        {% else %}
                                            <i class="fas fa-download me-1"></i> Télécharger
                                        {% endif %}
                                    </a>
                                </div>
                            {% endif %}
                        {% endif %}
                    {% endif %}
                    
                    <div class="{% if promoaffaire.statusNumber == 2 or promoaffaire.statusNumber == 4 %}d-flex justify-content-between{% else %}text-end{% endif %} mt-2">
                        {% if promoaffaire.statusNumber == 2 or promoaffaire.statusNumber == 4 %}
                            <button class="btn btn-sm btn-warning rounded-pill" data-bs-toggle="modal" data-bs-target="#modal_payerpromoaffaire_{{promoaffaire.id}}"><i class="fas fa-credit-card me-1"></i> Payer</button>
                        {% endif %}
                        {% if promoaffaire.statusNumber == 0 and promoaffaire.typePromotionAffaire == "produit_service" %}
                            <button class="btn btn-sm btn-danger text-white editPromotionAffaire rounded-pill" data-bs-toggle="modal" data-bs-target="#modal_modifier_promoaffaire_{{promoaffaire.id}}"><i class="fas fa-pen me-1"></i> Modifier</button>
                        {% endif %}
                        <button class="btn btn-sm btn-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#modal_promoaffaire_{{promoaffaire.id}}"><i class="fas fa-info me-2"></i>{% if promoaffaire.statusNumber != 2 %}Détails{% endif %}</button>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="modal_modifier_promoaffaire_{{promoaffaire.id}}" tabindex="-1" style="display: none;" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5>Modifier la promotion affaire</h5>
                        </div>
                        <div class="modal-body">
                            <div class="col-12">
                                <div class="mt-0 msgError" id="msgError-{{promoaffaire.id}}" style="display: none;"></div>
                            </div>
                            <div hidden>
                                <input type="text" id="idPromoAffaire-{{promoaffaire.id}}" value="{{promoaffaire.id}}">
                            </div>
                            <form id="promotionForm" enctype="multipart/form-data" class="mt-2">
                                <div class="row">
                                    <div class="col-md-12">
                                        <label for="image" class="form-label">Sélectionner une image</label>
                                        <input type="file" class="form-control getInfo imagePromoServiceProduit" id="image_{{promoaffaire.id}}" accept="image/*" id_promo_affaire="{{promoaffaire.id}}">
                                        <div id="imagePreview_{{promoaffaire.id}}" class="mt-2">
                                            <img src="/promotion/{{promoaffaire.image}}" class="card-img-top" style="height: 325px; object-fit: contain;">
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <label for="description" class="form-label">Description de la promotion</label>
                                        <textarea class="form-control getInfo" id="description_{{promoaffaire.id}}" rows="15">{{promoaffaire.description}}</textarea>
                                    </div>
                                    <div class="col-md-12 mt-3">
                                        <label class="form-label">Numéro WhatsApp de contact</label>
                                        <input type="text" class="form-control" id="whatsappContact_{{promoaffaire.id}}" name="whatsappContact" value="{{promoaffaire.whatsappContact}}" placeholder="+22900000000">
                                        <div class="form-text">Format international requis, ex : +22900000000</div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Fermer</button>
                            <button type="button" class="btn btn-primary btn-sm modifierpromoaffaire" id_promo_affaire="{{promoaffaire.id}}" id="modifierpromoaffaire-{{promoaffaire.id}}">Modifier</button>
                        </div>
                    </div>
                </div>
            </div>

            {# Modal historique des refus #}
            {% if promoaffaire.motifsRefus|length > 0 %}
            <div class="modal fade" id="modal_historique_refus_{{promoaffaire.id}}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="fas fa-history me-2"></i>Historique des refus</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <ol>
                                {% for motifEntry in promoaffaire.motifsRefus|sort((a, b) => b.dateRefus <=> a.dateRefus) %}
                                    <li class="mb-3">
                                        <strong>{{ motifEntry.dateRefus|date('d/m/Y à H:i') }}</strong>
                                        <div>{{ motifEntry.motif }}</div>
                                    </li>
                                {% endfor %}
                            </ol>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}

            <div class="modal fade" id="modal_payerpromoaffaire_{{promoaffaire.id}}" tabindex="-1" style="display: none;" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5>Démarer la promotion affaire</h5>
                        </div>
                        <div class="modal-body">
                            <div class="col-12">
                                <div class="mt-0 msgError msgError-{{promoaffaire.id}}" id="msgError-{{promoaffaire.id}}" style="display: none;"></div>
                            </div>
                            <div hidden>
                                <input type="text" id="idPromoAffaire-{{promoaffaire.id}}" value="{{promoaffaire.id}}">
                            </div>
                            <div class="mb-2">
                                <label for="formulBoost">Formule de Boost</label>
                                <select id="formulBosst" class="form-select getInfoBoostPayant-{{promoaffaire.id}} formulBoostPayant-{{promoaffaire.id}}">
                                    <option value="" selected disabled>Choissisez une Formule de Boost</option>
                                    {% for formulBoost in listeFormulBoost %}
                                        <option value="{{formulBoost.id}}">{{formulBoost.label}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="mb-2">
                                <label for="moyen-paiement">Moyen de paiement mobile ou par carte</label>
                                <select id="moyen-paiement-{{promoaffaire.id}}" class="form-select getInfo getInfoBoostPayant-{{promoaffaire.id}} moyenPaiementPayant-{{promoaffaire.id}}">
                                    <option value="" disabled selected>Choisisez le Moyen de paiement mobile ou par carte</option>
                                    {% for uneMethodePaiement in listeMethodePaiements %}
                                        <option value="{{uneMethodePaiement.value}}">{{uneMethodePaiement.titre}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div>
                                <label for="numero-paiement">Indicatif + Numéro de Paiement</label>
                                <input type="text" class="form-control getInfo getInfoBoostPayant-{{promoaffaire.id}} numeroPaiementPayant-{{promoaffaire.id}}" id="numero-paiement-{{promoaffaire.id}}">
                            </div>
                            <div class="mt-3">
                                <label for="in-programme-recompense-{{promoaffaire.id}}" class="form-label">Programme Récompense</label>
                                <select id="in-programme-recompense-{{promoaffaire.id}}" class="form-select reboost-in-programme">
                                    <option value="0" selected>Non</option>
                                    <option value="1">Oui</option>
                                </select>
                            </div>
                            <div class="mt-3 reboost-reward-options" style="display: none;">
                                <label class="form-label">Budget du Programme Récompense</label>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    {% for rewardBudget in [500, 1000, 2000, 5000] %}
                                        <button type="button" class="btn btn-sm btn-outline-primary reboost-budget-button" data-budget="{{ rewardBudget }}">{{ rewardBudget|number_format(0, ',', ' ') }} FCFA</button>
                                    {% endfor %}
                                    <button type="button" class="btn btn-sm btn-outline-primary reboost-budget-button" data-budget="custom">Personnalisé</button>
                                </div>
                                <input type="hidden" class="reboost-reward-budget" value="0">
                                <input type="hidden" class="reboost-reward-budget-type" value="predefined">
                                <div class="reboost-custom-reward-group" style="display: none;">
                                    <label for="custom-reward-budget-{{promoaffaire.id}}" class="form-label">Montant personnalisé</label>
                                    <input type="text" inputmode="numeric" pattern="[0-9]+" class="form-control reboost-custom-reward-budget" id="custom-reward-budget-{{promoaffaire.id}}" placeholder="Ex. 5001" autocomplete="off">
                                    <div class="form-text">Le montant doit être un entier strictement supérieur à 5 000 FCFA.</div>
                                </div>
                            </div>
                            <div class="form-check mt-3">
                                <input type="checkbox" class="form-check-input reboost-publish-status" id="publish-dressur-status-{{promoaffaire.id}}" value="1">
                                <label class="form-check-label" for="publish-dressur-status-{{promoaffaire.id}}">Publier dans le statut Dressur</label>
                            </div>
                            <div class="form-check mt-2">
                                <input type="checkbox" class="form-check-input reboost-boost-facebook" id="boost-facebook-{{promoaffaire.id}}" value="1">
                                <label class="form-check-label" for="boost-facebook-{{promoaffaire.id}}">Ajouter un boost Facebook</label>
                            </div>
                            <div class="mt-2 reboost-facebook-amount-group" style="display: none;">
                                <label for="boost-facebook-amount-{{promoaffaire.id}}" class="form-label">Montant du boost Facebook</label>
                                <input type="text" inputmode="numeric" pattern="[0-9]+" class="form-control reboost-facebook-amount" id="boost-facebook-amount-{{promoaffaire.id}}" value="700" autocomplete="off">
                                <div class="form-text">Minimum : 700 FCFA.</div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Fermer</button>
                            <button type="button" class="btn btn-primary btn-sm payerpromoaffaire" payerpromoaffaire="{{promoaffaire.id}}" id="payerpromoaffaire-{{promoaffaire.id}}">PAYER et BOOSTER</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="modal_promoaffaire_{{promoaffaire.id}}" tabindex="-1" style="display: none;" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-body p-0">
                            <img src="/promotion/{{promoaffaire.image}}" alt="" class="card-img-top mb-3">
                            <p class="px-3">
                                Formule de promotion : {{promoaffaire.formulePromotion}} Fcfa
                            </p>
                            <p class="px-3">
                                Date de début : {{promoaffaire.dateDebut}}
                            </p>
                            <p class="px-3">
                                Date de fin : {{promoaffaire.dateExp}}
                            </p>
                            <p class="px-3">
                                {{promoaffaire.description|nl2br}}
                            </p>
                            <div class="px-3">
                                {% for key, value in promoaffaire.annotherInfo %}
                                    <div class="mb-1">
                                        <div class="fw-bolder text-primary fs-6">{{ key | replace({'_': ' '}) | capitalize }} : </div>
                                        <div style="word-wrap: break-word; white-space: normal;">{{ value|nl2br }}</div>
                                        <hr>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info text-center fw-semibold fs-6">
            Aucune Promotion Affaire trouvé.
        </div>
    {% endfor %}
</div>
{% endblock %}
