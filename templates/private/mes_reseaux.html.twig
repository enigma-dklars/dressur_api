{% extends "basePrivate.html.twig" %}
{% block title %}Mes réseaux{% endblock %}

{% block body %}
<style>
.ds-networks-wrap{max-width:720px;margin:0 auto}
.ds-networks-header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:18px}
.ds-networks-heading{flex:1}
.ds-networks-back{display:inline-flex;align-items:center;gap:6px;color:var(--bs-secondary-color,#6c757d);font-size:12px;text-decoration:none;margin-bottom:10px}
.ds-networks-back:hover{color:var(--bs-primary,#0d6efd)}
.ds-networks-title{font-weight:700;font-size:1.1rem;margin:0 0 5px;display:flex;align-items:center;gap:8px}
.ds-networks-intro{font-size:13px;color:var(--bs-secondary-color,#6c757d);margin:0}
.ds-networks-add{white-space:nowrap;border-radius:20px;font-size:12px;font-weight:600;padding:8px 14px}
.ds-network-card{display:flex;align-items:center;gap:14px;background:var(--bs-body-bg,#fff);border-radius:15px;border:1px solid var(--bs-border-color,rgba(0,0,0,.08));box-shadow:0 3px 10px rgba(0,0,0,.05);padding:14px 16px;margin-bottom:10px}
.ds-network-icon{width:44px;height:44px;border-radius:13px;display:flex;align-items:center;justify-content:center;background:rgba(13,110,253,.10);flex-shrink:0}
.ds-network-icon i{font-size:19px;color:var(--bs-primary,#0d6efd)}
.ds-network-body{min-width:0;flex:1}
.ds-network-name{font-weight:600;font-size:14px;margin:0 0 3px;color:var(--bs-body-color,#212529)}
.ds-network-url{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--bs-secondary-color,#6c757d);font-size:12px;text-decoration:none}
.ds-network-url:hover{color:var(--bs-primary,#0d6efd)}
.ds-network-actions{display:flex;align-items:center;gap:4px;flex-shrink:0}
.ds-network-edit,.ds-network-delete{border:0;background:transparent;color:var(--bs-secondary-color,#6c757d);border-radius:9px;padding:8px 10px;line-height:1}
.ds-network-edit:hover{background:rgba(13,110,253,.10);color:var(--bs-primary,#0d6efd)}
.ds-network-delete{flex-shrink:0}
.ds-network-delete-spinner{display:none;width:.9rem;height:.9rem}
.ds-network-delete.is-loading .ds-network-delete-icon{display:none}
.ds-network-delete.is-loading .ds-network-delete-spinner{display:inline-block}
.ds-network-delete:hover{background:rgba(220,53,69,.10);color:#dc3545}
.ds-networks-empty{background:var(--bs-body-bg,#fff);border:1px dashed var(--bs-border-color,rgba(0,0,0,.16));border-radius:15px;padding:34px 22px;text-align:center}
.ds-networks-empty-icon{width:56px;height:56px;border-radius:17px;display:flex;align-items:center;justify-content:center;margin:0 auto 13px;background:rgba(13,110,253,.10)}
.ds-networks-empty-icon i{font-size:24px;color:var(--bs-primary,#0d6efd)}
.ds-networks-empty h6{font-weight:700;margin-bottom:6px}
.ds-networks-empty p{color:var(--bs-secondary-color,#6c757d);font-size:13px;margin-bottom:17px}
.ds-networks-state{font-size:13px}
.ds-networks-spinner{width:1rem;height:1rem}
.ds-network-modal-note{font-size:12px;color:var(--bs-secondary-color,#6c757d)}
html.dark-theme .ds-network-card,html.dark-theme .ds-networks-empty,html.semi-dark .ds-network-card,html.semi-dark .ds-networks-empty{background:#202a40;border-color:rgba(255,255,255,.10);box-shadow:0 3px 10px rgba(0,0,0,.3)}
html.dark-theme .ds-network-name,html.semi-dark .ds-network-name{color:#fcfcfc}
html.dark-theme .ds-network-url,html.semi-dark .ds-network-url{color:#9ea4aa}
html.dark-theme .ds-networks-title,html.semi-dark .ds-networks-title{color:#fcfcfc}
html.dark-theme .ds-networks-intro,html.semi-dark .ds-networks-intro{color:#9ea4aa}
html.dark-theme .ds-networks-back,html.semi-dark .ds-networks-back{color:#9ea4aa}
@media (max-width:575px){
    .ds-networks-header{align-items:stretch;flex-direction:column;gap:12px}
    .ds-networks-add{align-self:flex-start}
}
</style>

<div class="ds-networks-wrap">
    <div class="ds-networks-header">
        <div class="ds-networks-heading">
            <a href="/parametres" class="ds-networks-back">
                <i class="fas fa-arrow-left"></i> Paramètres
            </a>
            <h5 class="ds-networks-title">
                <i class="fas fa-share-nodes text-primary"></i>Mes réseaux
            </h5>
            <p class="ds-networks-intro">Ajoutez les liens publics que vous souhaitez afficher sur votre profil.</p>
        </div>
        <button type="button" class="btn btn-primary ds-networks-add" id="dsAddNetworkButton"
                data-bs-toggle="modal" data-bs-target="#dsAddNetworkModal" disabled>
            <i class="fas fa-plus me-1"></i>Ajouter un réseau
        </button>
    </div>

    <div id="dsNetworksLoading" class="alert alert-light ds-networks-state d-flex align-items-center gap-2" role="status">
        <span class="spinner-border ds-networks-spinner" aria-hidden="true"></span>
        Chargement de vos réseaux…
    </div>


    <div id="dsNetworksEmpty" class="ds-networks-empty d-none">
        <div class="ds-networks-empty-icon"><i class="fas fa-share-nodes"></i></div>
        <h6>Aucun réseau enregistré</h6>
        <p>Ajoutez vos réseaux publics pour permettre à vos contacts de vous retrouver facilement.</p>
        <button type="button" class="btn btn-primary btn-sm" id="dsAddFirstNetworkButton"
                data-bs-toggle="modal" data-bs-target="#dsAddNetworkModal" disabled>
            <i class="fas fa-plus me-1"></i>Ajouter mon premier réseau
        </button>
    </div>

    <div id="dsNetworksList" class="d-none" aria-live="polite"></div>
</div>

<div class="modal fade" id="dsAddNetworkModal" tabindex="-1" aria-labelledby="dsAddNetworkModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dsAddNetworkModalLabel">Ajouter un réseau</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <form id="dsAddNetworkForm">
                <div class="modal-body">
                    <div id="dsAddNetworkError" class="alert alert-danger d-none" role="alert"></div>
                <div class="mb-3" id="dsNetworkTypeGroup">
                        <label for="dsNetworkType" class="form-label">Réseau</label>
                        <select class="form-select" id="dsNetworkType" required>
                            <option value="">Sélectionnez un réseau</option>
                        </select>
                    </div>
                    <div class="mb-3 d-none" id="dsEditingNetworkGroup">
                        <label for="dsEditingNetworkLabel" class="form-label">Réseau</label>
                        <input type="text" class="form-control" id="dsEditingNetworkLabel" readonly>
                    </div>
                    <div class="mb-2">
                        <label for="dsNetworkUrl" class="form-label">URL du profil</label>
                        <input type="url" class="form-control" id="dsNetworkUrl"
                               placeholder="https://…" autocomplete="url" maxlength="512"
                               aria-describedby="dsNetworkUrlHelp dsNetworkUrlCount" required>
                    </div>
                    <div class="d-flex justify-content-between gap-3">
                        <p class="ds-network-modal-note mb-0" id="dsNetworkUrlHelp">URL HTTPS, 512 caractères maximum.</p>
                        <span class="ds-network-modal-note text-nowrap" id="dsNetworkUrlCount">0/512</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary" id="dsSaveNetworkButton">
                        <span class="spinner-border spinner-border-sm d-none me-1" id="dsSaveNetworkSpinner" aria-hidden="true"></span>
                        <span id="dsSaveNetworkText">Enregistrer</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block script %}
<script>
(function () {
    'use strict';

    const networksEndpoint = '/api/user/social-networks';
    const catalogEndpoint = networksEndpoint + '/catalog';
    const loading = document.getElementById('dsNetworksLoading');
    const empty = document.getElementById('dsNetworksEmpty');
    const list = document.getElementById('dsNetworksList');
    const addButton = document.getElementById('dsAddNetworkButton');
    const addFirstButton = document.getElementById('dsAddFirstNetworkButton');
    const addForm = document.getElementById('dsAddNetworkForm');
    const addError = document.getElementById('dsAddNetworkError');
    const networkType = document.getElementById('dsNetworkType');
    const networkTypeGroup = document.getElementById('dsNetworkTypeGroup');
    const editingNetworkGroup = document.getElementById('dsEditingNetworkGroup');
    const editingNetworkLabel = document.getElementById('dsEditingNetworkLabel');
    const networkUrl = document.getElementById('dsNetworkUrl');
    const networkUrlCount = document.getElementById('dsNetworkUrlCount');
    const saveButton = document.getElementById('dsSaveNetworkButton');
    const saveButtonText = document.getElementById('dsSaveNetworkText');
    const saveSpinner = document.getElementById('dsSaveNetworkSpinner');
    const modal = document.getElementById('dsAddNetworkModal');
    const modalTitle = document.getElementById('dsAddNetworkModalLabel');
    const maxUrlLength = 512;
    let networks = [];
    let catalog = [];
    let editingNetworkType = null;
    let deletingNetworkType = null;

    function setVisible(element, visible) {
        element.classList.toggle('d-none', !visible);
    }

    function showError(message, canRetry) {
        const options = { type: 'danger', title: canRetry ? 'Chargement impossible' : 'Erreur', message: message };
        if (canRetry) {
            options.confirmLabel = 'Réessayer';
            options.cancelLabel = 'Fermer';
            options.onConfirm = function () { return loadNetworks(); };
        }
        if (window.DressurMessages && typeof window.DressurMessages.show === 'function') {
            return window.DressurMessages.show(options);
        }
        window.alert(message);
        return Promise.resolve(false);
    }

    function showSuccess(message) {
        if (window.DressurMessages && typeof window.DressurMessages.show === 'function') {
            return window.DressurMessages.show({ type: 'success', title: 'Succès', message: message });
        }
        window.alert(message);
        return Promise.resolve(false);
    }

    function getNetworkLabel(networkTypeValue) {
        const network = catalog.find(function (item) {
            return item.id === networkTypeValue;
        });

        return network ? network.label : networkTypeValue || 'Réseau';
    }

    function updateUrlCounter() {
        const length = networkUrl.value.length;
        networkUrlCount.textContent = length + '/' + maxUrlLength;
        networkUrlCount.classList.toggle('text-danger', length >= maxUrlLength);
    }

    function clearFormError() {
        addError.textContent = '';
        setVisible(addError, false);
        networkUrl.classList.remove('is-invalid');
    }

    function setCreateMode() {
        editingNetworkType = null;
        modalTitle.textContent = 'Ajouter un réseau';
        saveButtonText.textContent = 'Enregistrer';
        setVisible(networkTypeGroup, true);
        setVisible(editingNetworkGroup, false);
        networkType.disabled = false;
        addForm.reset();
        clearFormError();
        updateUrlCounter();
    }

    function setEditMode(network) {
        editingNetworkType = network.networkType;
        modalTitle.textContent = 'Modifier l’URL du réseau';
        saveButtonText.textContent = 'Enregistrer les modifications';
        setVisible(networkTypeGroup, false);
        setVisible(editingNetworkGroup, true);
        networkType.disabled = true;
        editingNetworkLabel.value = getNetworkLabel(network.networkType);
        networkUrl.value = network.url || '';
        clearFormError();
        updateUrlCounter();
    }

    function renderPage() {
        populateCatalog();
        renderNetworks(networks);
        setVisible(empty, networks.length === 0);
        setVisible(list, networks.length > 0);
    }

    async function requestJson(url, options) {
        const requestOptions = Object.assign({
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json' }
        }, options || {});

        if (requestOptions.body) {
            requestOptions.headers = Object.assign({}, requestOptions.headers, {
                'Content-Type': 'application/json'
            });
        }

        const response = await fetch(url, requestOptions);
        let data = {};
        try {
            data = await response.json();
        } catch (parseError) {
            data = {};
        }

        if (!response.ok || data.error) {
            const requestError = new Error(
                data.message || data.titre || 'Une erreur est survenue. Veuillez réessayer.'
            );
            requestError.data = data;
            requestError.status = response.status;
            throw requestError;
        }

        return data;
    }

    function renderNetworks(networks) {
        list.replaceChildren();
        networks.forEach(function (network) {
            const card = document.createElement('article');
            card.className = 'ds-network-card';

            const icon = document.createElement('div');
            icon.className = 'ds-network-icon';
            icon.innerHTML = '<i class="fas fa-share-nodes" aria-hidden="true"></i>';

            const body = document.createElement('div');
            body.className = 'ds-network-body';

            const name = document.createElement('p');
            name.className = 'ds-network-name';
            name.textContent = network.networkType || 'Réseau';

            const link = document.createElement('a');
            link.className = 'ds-network-url';
            link.href = network.url || '#';
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.textContent = network.url || 'URL indisponible';

            body.append(name, link);

            const deleteButton = document.createElement('button');
            const actions = document.createElement('div');
            actions.className = 'ds-network-actions';

            const editButton = document.createElement('button');
            editButton.type = 'button';
            editButton.className = 'ds-network-edit';
            editButton.title = 'Modifier ce réseau';
            editButton.setAttribute('aria-label', 'Modifier ' + getNetworkLabel(network.networkType));
            editButton.innerHTML = '<i class="fas fa-pen" aria-hidden="true"></i>';
            editButton.addEventListener('click', function () {
                setEditMode(network);
                bootstrap.Modal.getOrCreateInstance(modal).show();
            });

            deleteButton.type = 'button';
            deleteButton.className = 'ds-network-delete';
            deleteButton.dataset.networkType = network.networkType || '';
            deleteButton.title = 'Supprimer ce réseau';
            deleteButton.setAttribute('aria-label', 'Supprimer ' + getNetworkLabel(network.networkType));
            deleteButton.innerHTML = '<span class="ds-network-delete-icon"><i class="fas fa-trash" aria-hidden="true"></i></span>' +
                '<span class="spinner-border spinner-border-sm ds-network-delete-spinner" aria-hidden="true"></span>';
            deleteButton.addEventListener('click', deleteNetwork);

            actions.append(editButton, deleteButton);
            card.append(icon, body, actions);
            list.appendChild(card);
        });
    }

    function populateCatalog() {
        networkType.replaceChildren();
        const placeholder = document.createElement('option');
        placeholder.value = '';
        const addedNetworkTypes = new Set(networks.map(function (network) {
            return network.networkType;
        }));
        const availableCatalog = catalog.filter(function (network) {
            return !addedNetworkTypes.has(network.id);
        });
        placeholder.textContent = availableCatalog.length
            ? 'Sélectionnez un réseau'
            : 'Tous les réseaux sont déjà ajoutés';
        networkType.appendChild(placeholder);

        availableCatalog.forEach(function (network) {
            const option = document.createElement('option');
            option.value = network.id;
            option.textContent = network.label || network.id;
            networkType.appendChild(option);
        });

        const enabled = availableCatalog.length > 0;
        addButton.disabled = !enabled;
        addFirstButton.disabled = !enabled;
    }

    async function loadNetworks() {
        setVisible(loading, true);
        setVisible(empty, false);
        setVisible(list, false);
        addButton.disabled = true;
        addFirstButton.disabled = true;

        try {
            const responses = await Promise.all([
                requestJson(networksEndpoint),
                requestJson(catalogEndpoint)
            ]);
            networks = Array.isArray(responses[0].networks) ? responses[0].networks : [];
            catalog = Array.isArray(responses[1].networks) ? responses[1].networks : [];

            renderPage();
            setVisible(loading, false);
        } catch (requestError) {
            setVisible(loading, false);
            showError(requestError.message, true);
        }
    }

    async function deleteNetwork(event) {
        const button = event.currentTarget;
        const type = button.dataset.networkType;
        if (!type || button.disabled || deletingNetworkType !== null) {
            return;
        }

        const confirmed = window.DressurMessages
            ? await window.DressurMessages.show({
                type: 'question',
                title: 'Supprimer ce réseau ?',
                message: 'Le réseau ' + getNetworkLabel(type) + ' sera retiré de votre profil.',
                confirmLabel: 'Supprimer',
                cancelLabel: 'Annuler',
                onConfirm: function () { return true; }
            })
            : window.confirm('Supprimer ' + getNetworkLabel(type) + ' de votre profil ?');
        if (!confirmed) {
            return;
        }

        deletingNetworkType = type;
        button.disabled = true;
        button.classList.add('is-loading');
        button.setAttribute('aria-busy', 'true');
        try {
            await requestJson(networksEndpoint + '/' + encodeURIComponent(type), { method: 'DELETE' });
            networks = networks.filter(function (network) {
                return network.networkType !== type;
            });
            renderPage();
            setVisible(error, false);
            showSuccess('Le réseau a été supprimé.');
        } catch (requestError) {
            showError(requestError.message);
        } finally {
            deletingNetworkType = null;
            if (document.body.contains(button)) {
                button.disabled = false;
                button.classList.remove('is-loading');
                button.removeAttribute('aria-busy');
            }
        }
    }

    addButton.addEventListener('click', setCreateMode);
    addFirstButton.addEventListener('click', setCreateMode);
    networkUrl.addEventListener('input', updateUrlCounter);
    modal.addEventListener('hidden.bs.modal', setCreateMode);

    addForm.addEventListener('submit', async function (event) {
        event.preventDefault();
        clearFormError();

        const selectedNetworkType = editingNetworkType || networkType.value;
        const url = networkUrl.value.trim();
        if (!selectedNetworkType) {
            addError.textContent = 'Veuillez sélectionner un réseau.';
            setVisible(addError, true);
            return;
        }
        if (!url) {
            addError.textContent = 'Veuillez saisir une URL.';
            setVisible(addError, true);
            return;
        }
        if (networkUrl.value.length > maxUrlLength) {
            networkUrl.classList.add('is-invalid');
            addError.textContent = 'L’URL ne doit pas dépasser 512 caractères.';
            setVisible(addError, true);
            return;
        }

        saveButton.disabled = true;
        setVisible(saveSpinner, true);

        try {
            const responseData = await requestJson(
                editingNetworkType
                    ? networksEndpoint + '/' + encodeURIComponent(editingNetworkType)
                    : networksEndpoint,
                {
                method: editingNetworkType ? 'PATCH' : 'POST',
                body: JSON.stringify({
                    ...(editingNetworkType ? {} : { networkType: selectedNetworkType }),
                    url: url
                })
                }
            );
            if (editingNetworkType) {
                networks = networks.map(function (network) {
                    return network.networkType === editingNetworkType
                        ? responseData.network
                        : network;
                });
            } else {
                networks = networks.concat(responseData.network);
            }
            renderPage();
            bootstrap.Modal.getOrCreateInstance(modal).hide();
            showSuccess(editingNetworkType
                ? 'L’URL du réseau a été modifiée.'
                : 'Le réseau a été ajouté.');
        } catch (requestError) {
            addError.textContent = requestError.message;
            setVisible(addError, true);
        } finally {
            saveButton.disabled = false;
            setVisible(saveSpinner, false);
        }
    });

    setCreateMode();
    loadNetworks();
}());
</script>
{% endblock %}