{% extends 'baseAdmin.html.twig' %}

{% block title %}Notification index{% endblock %}

{% block body %}
    <div class="d-flex align-items-center mb-3">
        <p class="h4 me-3 mb-0">Notification index</p>
        <span class="badge bg-secondary">{{ notifications|length }} notification(s)</span>
    </div>

    <div class="table-responsive">
        <table class="data-table table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Notification</th>
                    <th>User</th>
                    <th>Type</th>
                    <th>CreatedAt</th>
                    <th>Id</th>
                </tr>
            </thead>
            <tbody>
            {% for notification in notifications %}
                <tr>
                    <td>{{ notification.text }}</td>
                    <td>
                        {% if notification.user %}
                            {% if notification.user.pseudo %}
                                {{ notification.user.pseudo }}
                            {% elseif notification.user.mail %}
                                {{ notification.user.mail }}
                            {% elseif notification.user.tel %}
                                {{ notification.user.tel }}
                            {% else %}
                                Utilisateur
                            {% endif %}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td>
                        {% if notification.user %}
                            <span class="badge bg-primary">personal</span>
                        {% else %}
                            <span class="badge bg-secondary">global</span>
                        {% endif %}
                    </td>
                    <td>{{ notification.createdAt ? notification.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ notification.id }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
