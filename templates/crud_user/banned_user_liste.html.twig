{% extends 'baseAdmin.html.twig' %}

{% block title %}Liste Banned User{% endblock %}

{% block body %}
    <div class="row g-2 mb-2">
        <div class="col-6"><p class="h4 me-3 text-danger">Liste Banned User</p></div>
        <div class="col-6 text-end">
            <a class="btn btn-sm btn-danger h4" href="{{ path('app_crud_user_purge') }}">Purge un User</a>
            <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_user_index') }}">Back To List</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="data-table table table-bordered table-striped">
            <thead>
                <tr>
                    <th width="5"></th>
                    <th width="5">Tel</th>
                    <th width="5">Mail</th>
                    <th>Motif</th>
                </tr>
            </thead>
            <tbody>
                {% for item in usersBanned %}
                    <tr>
                        <td>{{ loop.revindex }}</td>
                        <td>{{ item.tel|default('—') }}</td>
                        <td>{{ item.mail|default('—') }}</td>
                        <td>
                            <div>{{ item.motif|default('—') }}</div>
                            {% if item.createdAt %}<small class="text-muted">{{ item.createdAt|date('d/m/Y H:i') }}</small>{% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
