{% extends 'basePrivate.html.twig' %}

{% block title %}User : {{option}}{% endblock %}

{% block body %}
    <div class="row g-2 mb-4">
        <div class="col-md-6">
            <p class="h4 me-3">User : {{option}}</p>
        </div>
        <div class="col-md-6">
            <!-- Barre de recherche -->
            <form method="get" class="d-flex">
                <input type="text" name="search" class="form-control me-2" 
                       placeholder="Rechercher..." value="{{ search ?? '' }}">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i>
                </button>
                {% if search %}
                    <a href="{{ path('app_crud_user_index') }}" class="btn btn-secondary ms-2">
                        <i class="fas fa-times"></i>
                    </a>
                {% endif %}
            </form>
        </div>
    </div>

    <!-- Informations sur les résultats -->
    <div class="alert alert-info mb-3 small p-1 text-center">
        <strong>{{ totalItems }}</strong> utilisateur(s) trouvé(s)
        {% if search %}
            pour la recherche : "<strong>{{ search }}</strong>"
        {% endif %}
    </div>

    <div class="table-responsive">
        <table class="data-table table table-bordered table-striped my-5">
            <thead>
                <tr>
                    <th></th>
                    <th>Pseudo</th>
                    <th>Tel</th>
                    <th>Tel V.</th>
                    <th>Mail</th>
                    <th>Mail V.</th>
                    <th>Invt</th>
                    <th>Parr</th>
                    <th>Bonus</th>
                    <th>N.C</th>
                    <th>B.C</th>
                    <th>P.A</th>
                    <th>P.R</th>
                    <th>C.M</th>
                    <th>Lock</th>
                    <th>LastLoginTo</th>
                    <th>CreatedAt</th>
                    <th>Uid</th>
                    <th>Id</th>
                </tr>
            </thead>
            <tbody>
            {% set id_users = [] %}
            
            {% for user in users %}
                {% set id_users = id_users | merge([user.id]) %}
            {% endfor %}

            {% for user in users %}
                <tr>
                    <td>{% include "crud_user/_delete_form.html.twig" %}</td>
                    <td>
                        {{ user.pseudo }}
                    </td>
                    <td>{{ user.tel }}</td>
                    <td class="text-center">
                        {% if user.telIsVerified == true %}
                            <span class="badge bg-success">Yes</span>
                        {% else %}
                            <a href="{{ path('app_crud_user_activerTel', {'id': user.id}) }}" class="text-white badge bg-danger">Activer</a>
                        {% endif %}
                    </td>
                    <td class="small">{{ user.mail }}</td>
                    <td class="text-center">
                        {% if user.mailIsVerified == true %}
                            <span class="badge bg-success">Yes</span>
                        {% else %}
                            <a href="{{ path('app_crud_user_activerMail', {'id': user.id}) }}" class="text-white badge bg-danger">Activer</a>
                        {% endif %}
                    </td>
                    <td class="text-end">{{user.filleuls|length}}</td>
                    <td class="text-center">
                        {% if user.parrain %}
                            <span class="badge bg-success">Yes</span>
                        {% else %}
                            <span class="badge bg-danger">No</span>                                
                        {% endif %}
                    </td>
                    <td class="text-end">{{user.soldeBonus}}</td>
                    <td class="text-end">
                        {% set lesContactsDuUser = [] %}
                        {% for item in user.contact.whoIAdd %}
                            {% if item in id_users %}
                                {% if item not in lesContactsDuUser %}
                                    {% set lesContactsDuUser = lesContactsDuUser | merge([item]) %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                        {% for item in user.contact.whoAddMe %}
                            {% if item in id_users %}
                                {% if item not in lesContactsDuUser %}
                                    {% set lesContactsDuUser = lesContactsDuUser | merge([item]) %}
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                        {{lesContactsDuUser|length}}
                    </td>
                    <td class="text-end">{{user.boosts|length}}</td>
                    <td class="text-end">{{user.promotions|length}}</td>
                    <td class="text-end">{{user.promoReseaus|length}}</td>
                    <td class="text-end">{{user.campagneMails|length}}</td>
                    <td class="text-center">
                        {{ user.blocked ? '<span class="badge bg-danger">Yes</span>' : '<span class="badge bg-success">No</span>' }}
                    </td>
                    <td>{{ user.lastLoginTo ? user.lastLoginTo|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ user.createdAt ? user.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ user.uid }}</td>
                    <td>{{ user.id }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="27">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Pagination Bootstrap 5 -->
    {% if totalPages > 1 %}
    <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination justify-content-center">
            <!-- Premier -->
            <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                <a class="page-link" 
                   href="{{ path('app_crud_user_index', {'page': 1, 'search': search}) }}">
                    <i class="fas fa-angle-double-left"></i>
                </a>
            </li>
            
            <!-- Précédent -->
            <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                <a class="page-link" 
                   href="{{ path('app_crud_user_index', {'page': currentPage - 1, 'search': search}) }}">
                    <i class="fas fa-angle-left"></i>
                </a>
            </li>
            
            <!-- Pages -->
            {% set startPage = max(1, currentPage - 2) %}
            {% set endPage = min(totalPages, startPage + 4) %}
            {% set startPage = max(1, endPage - 4) %}
            
            {% for i in startPage..endPage %}
                <li class="page-item {% if i == currentPage %}active{% endif %}">
                    <a class="page-link" 
                       href="{{ path('app_crud_user_index', {'page': i, 'search': search}) }}">
                        {{ i }}
                    </a>
                </li>
            {% endfor %}
            
            <!-- Suivant -->
            <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                <a class="page-link" 
                   href="{{ path('app_crud_user_index', {'page': currentPage + 1, 'search': search}) }}">
                    <i class="fas fa-angle-right"></i>
                </a>
            </li>
            
            <!-- Dernier -->
            <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                <a class="page-link" 
                   href="{{ path('app_crud_user_index', {'page': totalPages, 'search': search}) }}">
                    <i class="fas fa-angle-double-right"></i>
                </a>
            </li>
        </ul>
    </nav>
    {% endif %}

    <!-- Sélecteur de limite par page -->
    <div class="d-flex justify-content-end align-items-center mt-3">
        <span class="me-2">Afficher :</span>
        <select class="form-select form-select-sm" style="width: auto;" onchange="changeLimit(this.value)">
            <option value="10" {% if limit == 10 %}selected{% endif %}>10</option>
            <option value="20" {% if limit == 20 %}selected{% endif %}>20</option>
            <option value="50" {% if limit == 50 %}selected{% endif %}>50</option>
            <option value="100" {% if limit == 100 %}selected{% endif %}>100</option>
        </select>
        <span class="ms-2">par page</span>
    </div>
{% endblock %}

{% block script %}
<script>
function changeLimit(limit) {
    const url = new URL(window.location.href);
    url.searchParams.set('limit', limit);
    url.searchParams.set('page', 1); // Retour à la première page
    window.location.href = url.toString();
}
</script>
{% endblock %}