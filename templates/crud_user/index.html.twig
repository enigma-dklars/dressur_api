{% extends 'basePrivate.html.twig' %}

{% block title %}User index{% endblock %}

{% block body %}
    <h1>User index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Uid</th>
                <th>Pseudo</th>
                <th>Nom</th>
                <th>Mail</th>
                <th>Pays</th>
                <th>Tel</th>
                <th>Apropos</th>
                <th>Password</th>
                <th>CreatedAt</th>
                <th>MailIsVerified</th>
                <th>TelIsVerified</th>
                <th>SoldeBonus</th>
                <th>CodeBonus</th>
                <th>ThemeDark</th>
                <th>Admin</th>
                <th>Blocked</th>
                <th>Tiktok</th>
                <th>Instagram</th>
                <th>Facebook</th>
                <th>Youtube</th>
                <th>Lang</th>
                <th>LastLoginTo</th>
                <th>Avatar</th>
                <th>Banniere</th>
                <th>HasReceived</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.uid }}</td>
                <td>{{ user.pseudo }}</td>
                <td>{{ user.nom }}</td>
                <td>{{ user.mail }}</td>
                <td>{{ user.pays }}</td>
                <td>{{ user.tel }}</td>
                <td>{{ user.apropos }}</td>
                <td>{{ user.password }}</td>
                <td>{{ user.createdAt ? user.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ user.mailIsVerified ? 'Yes' : 'No' }}</td>
                <td>{{ user.telIsVerified ? 'Yes' : 'No' }}</td>
                <td>{{ user.soldeBonus }}</td>
                <td>{{ user.codeBonus }}</td>
                <td>{{ user.themeDark ? 'Yes' : 'No' }}</td>
                <td>{{ user.admin ? 'Yes' : 'No' }}</td>
                <td>{{ user.blocked ? 'Yes' : 'No' }}</td>
                <td>{{ user.tiktok }}</td>
                <td>{{ user.instagram }}</td>
                <td>{{ user.facebook }}</td>
                <td>{{ user.youtube }}</td>
                <td>{{ user.lang }}</td>
                <td>{{ user.lastLoginTo ? user.lastLoginTo|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ user.avatar }}</td>
                <td>{{ user.banniere }}</td>
                <td>{{ user.hasReceived }}</td>
                <td>
                    <a href="{{ path('app_crud_user_show', {'id': user.id}) }}">show</a>
                    <a href="{{ path('app_crud_user_edit', {'id': user.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="27">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_crud_user_new') }}">Create new</a>
{% endblock %}
