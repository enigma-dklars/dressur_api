{% extends user.lecteur == true ? 'basePrivate.html.twig' : 'baseAdmin.html.twig' %}

{% block title %}Check User{% endblock %}

{% block body %}
<div class="row g-2 mb-3 align-items-center">
    <div class="col"><p class="h4 text-info mb-0">Check User</p></div>
    <div class="col-auto"><a class="btn btn-sm btn-primary" href="{{ path('app_crud_user_index') }}">Back To List</a></div>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} py-2">{{ message }}</div>
    {% endfor %}
{% endfor %}

<form action="{{ path('app_crud_user_check') }}" method="post" class="mb-4 py-4 px-3 bg-info rounded">
    <label for="identifier" class="text-white fw-semibold mb-1 d-block">Email · Téléphone · Pseudo · Uid · Id</label>
    <div class="input-group">
        <input type="text" class="form-control form-control-lg" id="identifier" name="identifier" autofocus required>
        <button type="submit" class="btn btn-light btn-lg">Rechercher</button>
    </div>
</form>

{% if user_check %}
    {% set u = user_check["user_info"] %}

    {# Contacts #}
    {% set id_users = [] %}
    {% for usr in users %}{% set id_users = id_users | merge([usr.id]) %}{% endfor %}
    {% set lesContactsDuUser = [] %}
    {% for item in u.contact.whoIAdd %}
        {% if item in id_users and item not in lesContactsDuUser %}{% set lesContactsDuUser = lesContactsDuUser | merge([item]) %}{% endif %}
    {% endfor %}
    {% for item in u.contact.whoAddMe %}
        {% if item in id_users and item not in lesContactsDuUser %}{% set lesContactsDuUser = lesContactsDuUser | merge([item]) %}{% endif %}
    {% endfor %}

    <hr>

    {# ── Actions ───────────────────────────────────────────────── #}
    {% if user.lecteur != true %}<div class="mb-3">{% include "crud_user/_delete_form.html.twig" with {'user': u} only %}</div>{% endif %}

    {# ── Identité ──────────────────────────────────────────────── #}
    <div class="card mb-3">
        <div class="card-header fw-bold">🪪 Identité</div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-6 col-md-3"><small class="text-muted d-block">Pseudo</small><strong>{{ u.pseudo }}</strong></div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Nom</small>{{ u.nom }}</div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Id</small>{{ u.id }}</div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Uid</small><span class="text-break small">{{ u.uid }}</span></div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Langue</small>{{ u.lang }}</div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Pays</small>{{ u.pays }}</div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Lid</small>{{ u.lid ?? '—' }}</div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Source inscription</small>{{ u.registerSource ?? '—' }}</div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Source dernière connexion</small>{{ u.lastLoginSource ?? '—' }}</div>
                <div class="col-6 col-md-3">
                    <small class="text-muted d-block">Admin</small>
                    {{ u.admin ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-secondary">No</span>' }}
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted d-block">Vendeur</small>
                    {{ u.isVendeur ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-secondary">No</span>' }}
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted d-block">Bloqué</small>
                    {{ u.blocked ? '<span class="badge bg-danger">Yes</span>' : '<span class="badge bg-success">No</span>' }}
                </div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Créé le</small>{{ u.createdAt ? u.createdAt|date('d/m/Y H:i') : '—' }}</div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Dernière connexion</small>{{ u.lastLoginTo ? u.lastLoginTo|date('d/m/Y H:i') : '—' }}</div>
            </div>
        </div>
    </div>

    {# ── Contact ───────────────────────────────────────────────── #}
    <div class="card mb-3">
        <div class="card-header fw-bold">📞 Contact</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <small class="text-muted d-block">Numéro WhatsApp</small>
                    <strong>{{ u.tel }}</strong>
                    <div class="mt-1">
                        {% if u.telIsVerified %}
                            <span class="badge bg-success">Vérifié</span>
                        {% else %}
                            <span class="badge bg-danger me-2">Non vérifié</span>
                            {% if user.lecteur != true %}
                            <form action="{{ path('app_crud_user_activerTel', {'id': u.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Confirmer l\'activation du numéro WhatsApp ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('activer_tel' ~ u.id) }}">
                                <button type="submit" class="btn btn-sm btn-warning">Activer</button>
                            </form>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <small class="text-muted d-block">Adresse Mail</small>
                    <strong>{{ u.mail }}</strong>
                    <div class="mt-1">
                        {% if u.mailIsVerified %}
                            <span class="badge bg-success">Vérifié</span>
                        {% else %}
                            <span class="badge bg-danger me-2">Non vérifié</span>
                            {% if user.lecteur != true %}
                            <form action="{{ path('app_crud_user_activerMail', {'id': u.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Confirmer l\'activation de l\'adresse mail ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('activer_mail' ~ u.id) }}">
                                <button type="submit" class="btn btn-sm btn-warning">Activer</button>
                            </form>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Réseaux sociaux ───────────────────────────────────────── #}
    {% if u.tiktok or u.instagram or u.facebook or u.youtube %}
    <div class="card mb-3">
        <div class="card-header fw-bold">🌐 Réseaux sociaux</div>
        <div class="card-body">
            <div class="row g-2">
                {% if u.tiktok %}<div class="col-6 col-md-3"><small class="text-muted d-block">TikTok</small><a href="{{ u.tiktok }}" target="_blank">{{ u.tiktok }}</a></div>{% endif %}
                {% if u.instagram %}<div class="col-6 col-md-3"><small class="text-muted d-block">Instagram</small><a href="{{ u.instagram }}" target="_blank">{{ u.instagram }}</a></div>{% endif %}
                {% if u.facebook %}<div class="col-6 col-md-3"><small class="text-muted d-block">Facebook</small><a href="{{ u.facebook }}" target="_blank">{{ u.facebook }}</a></div>{% endif %}
                {% if u.youtube %}<div class="col-6 col-md-3"><small class="text-muted d-block">YouTube</small><a href="{{ u.youtube }}" target="_blank">{{ u.youtube }}</a></div>{% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {# ── Programme Récompense ──────────────────────────────────── #}
    <div class="card mb-3">
        <div class="card-header fw-bold">🎁 Programme Récompense</div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <small class="text-muted d-block">Inscrit</small>
                    {{ u.isInscritProgrammeRecompense ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-danger">No</span>' }}
                </div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Solde</small>{{ u.soldeProgrammeRecompense }}</div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Réseau retrait</small>{{ u.reseauRetrait ?? '—' }}</div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Numéro retrait</small>{{ u.numeroRetrait ?? '—' }}</div>
            </div>
        </div>
    </div>

    {# ── Préférences & Stats ───────────────────────────────────── #}
    <div class="card mb-3">
        <div class="card-header fw-bold">📊 Préférences & Stats</div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-12"><small class="text-muted d-block">Pays préférés ({{ nbr_pays_preference }})</small><span class="small">{{ pays_preference }}</span></div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Contacts</small>{{ contactCount }}</div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Boosts</small>{{ u.boosts|length }}</div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Promo Affaire</small>{{ u.promotions|length }}</div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Promo Réseau</small>{{ u.promoReseaus|length }}</div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Transactions</small>{{ transactions|length }}</div>
            </div>
        </div>
    </div>

    {# ── Boosts ────────────────────────────────────────────────── #}
    <div class="card mb-3">
        <div class="card-header fw-bold">⚡ Boosts ({{ u.boosts|length }})</div>
        {% if u.boosts|length > 0 %}
        <div class="table-responsive">
            <table class="table table-sm table-bordered table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Formule</th>
                        <th>Mode</th>
                        <th>Type</th>
                        <th>Source</th>
                        <th>Contacts obtenus</th>
                        <th>Début</th>
                        <th>Exp.</th>
                    </tr>
                </thead>
                <tbody>
                {% for boost in u.boosts %}
                    <tr>
                        <td>{{ boost.id }}</td>
                        <td>{{ boost.formuleBoost.titre }}</td>
                        <td>{{ boost.mode }}</td>
                        <td>{{ boost.typeBoost }}</td>
                        <td>{{ boost.source ?? '—' }}</td>
                        <td class="text-end">{{ boost.nbContactsObtenus }}</td>
                        <td>{{ boost.dateDebut ? boost.dateDebut|date('d/m/Y') : '—' }}</td>
                        <td>{{ boost.dateExp ? boost.dateExp|date('d/m/Y') : '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="card-body text-muted">Aucun boost.</div>
        {% endif %}
    </div>

    {# ── Promo Affaire ─────────────────────────────────────────── #}
    <div class="card mb-3">
        <div class="card-header fw-bold">📢 Promo Affaire ({{ u.promotions|length }})</div>
        {% if u.promotions|length > 0 %}
        <div class="table-responsive">
            <table class="table table-sm table-bordered table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Formule</th>
                        <th>Type</th>
                        <th>Mode</th>
                        <th>Status</th>
                        <th>Source</th>
                        <th>Début</th>
                        <th>Exp.</th>
                        <th>Créé le</th>
                    </tr>
                </thead>
                <tbody>
                {% for promo in u.promotions %}
                    <tr>
                        <td>{{ promo.id }}</td>
                        <td>{{ promo.formulePromoAffaire ? promo.formulePromoAffaire.titre : '—' }}</td>
                        <td>{{ promo.typePromotionAffaire ?? '—' }}</td>
                        <td>{{ promo.mode ?? '—' }}</td>
                        <td>
                            {% if promo.status == 0 %}<span class="badge bg-danger">Rejeté</span>
                            {% elseif promo.status == 1 %}<span class="badge bg-warning text-dark">En attente</span>
                            {% elseif promo.status == 2 %}<span class="badge bg-info">Att. paiement</span>
                            {% elseif promo.status == 3 %}<span class="badge bg-success">En cours</span>
                            {% elseif promo.status == 4 %}<span class="badge bg-secondary">Terminé</span>
                            {% else %}{{ promo.status }}{% endif %}
                        </td>
                        <td>{{ promo.source ?? '—' }}</td>
                        <td>{{ promo.dateDebut ? promo.dateDebut|date('d/m/Y') : '—' }}</td>
                        <td>{{ promo.dateExp ? promo.dateExp|date('d/m/Y') : '—' }}</td>
                        <td>{{ promo.createdAt ? promo.createdAt|date('d/m/Y') : '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="card-body text-muted">Aucune promo affaire.</div>
        {% endif %}
    </div>

    {# ── Promo Réseau ──────────────────────────────────────────── #}
    <div class="card mb-3">
        <div class="card-header fw-bold">🌐 Promo Réseau ({{ u.promoReseaus|length }})</div>
        {% if u.promoReseaus|length > 0 %}
        <div class="table-responsive">
            <table class="table table-sm table-bordered table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Formule</th>
                        <th>Qte</th>
                        <th>Prix (FCFA)</th>
                        <th>Compteur</th>
                        <th>Status</th>
                        <th>Id Zef</th>
                        <th>Source</th>
                        <th>URL</th>
                        <th>Créé le</th>
                    </tr>
                </thead>
                <tbody>
                {% for pr in u.promoReseaus %}
                    <tr>
                        <td>{{ pr.id }}</td>
                        <td>{{ pr.formulePromoReseau.titre }}</td>
                        <td class="text-end">{{ pr.qteDemander }}</td>
                        <td class="text-end">{{ pr.prixFixer }}</td>
                        <td class="text-end">{{ pr.compteurRestant }} / {{ pr.qteDemander }}</td>
                        <td>
                            {% if pr.status == 0 %}<span class="badge bg-warning text-dark">Remboursé</span>
                            {% elseif pr.status == 1 %}<span class="badge bg-secondary">En attente</span>
                            {% elseif pr.status == 2 %}<span class="badge bg-success">En cours</span>
                            {% elseif pr.status == 3 %}<span class="badge bg-dark">Terminé</span>
                            {% else %}{{ pr.status }}{% endif %}
                        </td>
                        <td>{{ pr.idZefame ?? '—' }}</td>
                        <td>{{ pr.source ?? '—' }}</td>
                        <td><a href="{{ pr.url }}" target="_blank" class="text-break small">{{ pr.url|slice(0, 40) }}{% if pr.url|length > 40 %}…{% endif %}</a></td>
                        <td>{{ pr.createdAt ? pr.createdAt|date('d/m/Y') : '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="card-body text-muted">Aucune promo réseau.</div>
        {% endif %}
    </div>

    {# ── Transactions ──────────────────────────────────────────── #}
    <div class="card mb-3">
        <div class="card-header fw-bold">💳 Transactions ({{ transactions|length }})</div>
        {% if transactions|length > 0 %}
        <div class="table-responsive">
            <table class="table table-sm table-bordered table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Id Transaction</th>
                        <th>Référence</th>
                        <th>Montant</th>
                        <th>Status</th>
                        <th>Pour</th>
                        <th>Créé le</th>
                    </tr>
                </thead>
                <tbody>
                {% for tx in transactions %}
                    <tr>
                        <td>{{ tx.id }}</td>
                        <td>{{ tx.idTransaction ?? '—' }}</td>
                        <td>{{ tx.reference ?? '—' }}</td>
                        <td class="text-end">{{ tx.amount }}</td>
                        <td>
                            {% if tx.status == 'approved' %}<span class="badge bg-success">Approuvé</span>
                            {% elseif tx.status == 'pending' %}<span class="badge bg-warning text-dark">En attente</span>
                            {% elseif tx.status == 'declined' %}<span class="badge bg-danger">Refusé</span>
                            {% else %}<span class="badge bg-secondary">{{ tx.status ?? '—' }}</span>{% endif %}
                        </td>
                        <td>{{ tx.transactionFor ?? '—' }}</td>
                        <td>{{ tx.createdAt ? tx.createdAt|date('d/m/Y H:i') : '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="card-body text-muted">Aucune transaction.</div>
        {% endif %}
    </div>

{% endif %}
{% endblock %}
