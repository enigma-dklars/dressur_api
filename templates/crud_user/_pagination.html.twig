{% if totalPages > 1 %}
<nav aria-label="Navigation des utilisateurs" class="mt-3">
    <ul class="pagination justify-content-center flex-wrap">
        <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
            <a class="page-link" href="{{ path('app_crud_user_index', {'page': 1, 'search': search, 'source': sourceFilter, 'segment': segmentFilter ?? ''}) }}" aria-label="Première page">
                <i class="fas fa-angle-double-left"></i>
            </a>
        </li>
        <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
            <a class="page-link" href="{{ path('app_crud_user_index', {'page': currentPage - 1, 'search': search, 'source': sourceFilter, 'segment': segmentFilter ?? ''}) }}" aria-label="Page précédente">
                <i class="fas fa-angle-left"></i>
            </a>
        </li>

        {% set startPage = max(1, currentPage - 2) %}
        {% set endPage = min(totalPages, startPage + 4) %}
        {% set startPage = max(1, endPage - 4) %}
        {% for i in startPage..endPage %}
            <li class="page-item {% if i == currentPage %}active{% endif %}">
                <a class="page-link" href="{{ path('app_crud_user_index', {'page': i, 'search': search, 'source': sourceFilter, 'segment': segmentFilter ?? ''}) }}">{{ i }}</a>
            </li>
        {% endfor %}

        <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
            <a class="page-link" href="{{ path('app_crud_user_index', {'page': currentPage + 1, 'search': search, 'source': sourceFilter, 'segment': segmentFilter ?? ''}) }}" aria-label="Page suivante">
                <i class="fas fa-angle-right"></i>
            </a>
        </li>
        <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
            <a class="page-link" href="{{ path('app_crud_user_index', {'page': totalPages, 'search': search, 'source': sourceFilter, 'segment': segmentFilter ?? ''}) }}" aria-label="Dernière page">
                <i class="fas fa-angle-double-right"></i>
            </a>
        </li>
    </ul>
</nav>
{% endif %}
