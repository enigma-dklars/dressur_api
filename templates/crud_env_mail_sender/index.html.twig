{% extends 'baseAdmin.html.twig' %}

{% block title %}EnvMailSender index{% endblock %}

{% block body %}
    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <span class="h4 me-3">EnvMailSender index</span>
            <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_env_mail_sender_new') }}">Create new</a>
        </div>
        <div class="col-md-6 text-end">
            <button class="btn btn-sm btn-warning h4 me-2" onclick="confirmVerifyAll()">Vérifier tous</button>
            <button class="btn btn-sm btn-success h4 me-2" onclick="confirmReactivate()">Réactiver tous</button>
            <button class="btn btn-sm btn-danger h4 me-2" onclick="confirmRemiseZero()">Remise à zéro</button>
            <button class="btn btn-sm btn-secondary h4" onclick="confirmResetLastUsedAt()">Reset rotation</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="data-table table table-bordered table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th>Id</th>
                    <th>Count.MS</th>
                    <th>Dernier envoi</th>
                    <th>Activ.</th>
                    <th>MailAdresse</th>
                    <th>Password</th>
                    <th>SmtpServer</th>
                    <th>SmtpPort</th>
                    <th>SmtpSecured</th>
                </tr>
            </thead>
            <tbody>
            {% for env_mail_sender in env_mail_senders %}
                <tr>
                    <td>
                        {% include "crud_env_mail_sender/_delete_form.html.twig" %}
                    </td>
                    <td>{{ env_mail_sender.id }}</td>
                    <td>{{ env_mail_sender.countMailSent }}</td>
                    <td class="small text-nowrap">
                        {% if env_mail_sender.lastUsedAt %}
                            {{ env_mail_sender.lastUsedAt|date('d/m/Y H:i:s') }}
                        {% else %}
                            <span class="badge bg-secondary">Jamais</span>
                        {% endif %}
                    </td>
                    <td class="text-center">
                        {% if env_mail_sender.activated %}
                            <span class="badge bg-success">Oui</span>
                        {% else %}
                            <span class="badge bg-danger">Non</span>
                        {% endif %}
                    </td>
                    <td>{{ env_mail_sender.mailAdresse }}</td>
                    <td>
                        <div class="d-inline-flex align-items-center gap-1">
                            <code
                                class="mail-sender-password text-nowrap"
                                data-password="{{ env_mail_sender.password|default('')|e('html_attr') }}"
                                data-revealed="false"
                            >******</code>
                            <button
                                type="button"
                                class="border-0 bg-transparent p-0 text-secondary js-toggle-mail-password" style="line-height:1; width:1rem; height:1rem;"
                                title="Afficher le mot de passe"
                                aria-label="Afficher le mot de passe"
                            >
                                <i class="fas fa-eye" aria-hidden="true"></i>
                            </button>
                            <button
                                type="button"
                                class="border-0 bg-transparent p-0 text-secondary js-copy-mail-password" style="line-height:1; width:1rem; height:1rem;"
                                title="Révéler le mot de passe pour le copier"
                                aria-label="Révéler le mot de passe pour le copier"
                                disabled
                            >
                                <i class="fas fa-copy" aria-hidden="true"></i>
                            </button>
                        </div>
                    </td>
                    <td>{{ env_mail_sender.smtpServer }}</td>
                    <td>{{ env_mail_sender.smtpPort }}</td>
                    <td>{{ env_mail_sender.smtpSecured }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="10">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}

{% block script %}
<script>
document.addEventListener('click', async function (event) {
    const toggleButton = event.target.closest('.js-toggle-mail-password');
    if (toggleButton) {
        const container = toggleButton.closest('div');
        const passwordElement = container.querySelector('.mail-sender-password');
        const copyButton = container.querySelector('.js-copy-mail-password');
        const isRevealed = passwordElement.dataset.revealed === 'true';
        const password = passwordElement.dataset.password || '';

        passwordElement.dataset.revealed = isRevealed ? 'false' : 'true';
        passwordElement.textContent = isRevealed ? '******' : password;
        copyButton.disabled = isRevealed;
        toggleButton.title = isRevealed ? 'Afficher le mot de passe' : 'Masquer le mot de passe';
        toggleButton.setAttribute('aria-label', toggleButton.title);
        toggleButton.querySelector('i').classList.toggle('fa-eye', isRevealed);
        toggleButton.querySelector('i').classList.toggle('fa-eye-slash', !isRevealed);
        return;
    }

    const copyButton = event.target.closest('.js-copy-mail-password');
    if (!copyButton || copyButton.disabled) {
        return;
    }

    const container = copyButton.closest('div');
    const passwordElement = container.querySelector('.mail-sender-password');
    const password = passwordElement.dataset.password || '';

    try {
        await navigator.clipboard.writeText(password);
        const icon = copyButton.querySelector('i');
        icon.classList.remove('fa-copy');
        icon.classList.add('fa-check');
        copyButton.title = 'Mot de passe copié';
        window.setTimeout(function () {
            icon.classList.remove('fa-check');
            icon.classList.add('fa-copy');
            copyButton.title = 'Copier le mot de passe';
        }, 1500);
    } catch (error) {
        copyButton.title = 'Copie impossible';
    }
});

function confirmVerifyAll() {
    Swal.fire({
        title: 'Vérifier tous les senders ?',
        text: 'Une connexion SMTP sera testée pour chaque compte. Les comptes invalides seront désactivés automatiquement.',
        icon: 'info',
        showCancelButton: true,
        confirmButtonText: 'Oui, vérifier',
        cancelButtonText: 'Annuler',
        confirmButtonColor: '#ffc107',
        cancelButtonColor: '#6c757d',
    }).then((result) => {
        if (result.isConfirmed) {
            window.location.href = '{{ path('app_crud_env_mail_sender_verify_all') }}';
        }
    });
}

function confirmReactivate() {
    Swal.fire({
        title: 'Réactiver tous les senders ?',
        text: 'Tous les senders désactivés seront remis actifs.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Oui, réactiver',
        cancelButtonText: 'Annuler',
        confirmButtonColor: '#198754',
        cancelButtonColor: '#6c757d',
    }).then((result) => {
        if (result.isConfirmed) {
            window.location.href = '{{ path('app_crud_env_mail_sender_reactivate_all') }}';
        }
    });
}

function confirmResetLastUsedAt() {
    Swal.fire({
        title: 'Réinitialiser la rotation ?',
        text: 'La date de dernier envoi de tous les comptes sera effacée. Le prochain envoi repartira du premier compte disponible.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: '<i class="fas fa-sync-alt me-1"></i>Oui, réinitialiser',
        cancelButtonText: 'Annuler',
        confirmButtonColor: '#6c757d',
        cancelButtonColor: '#6c757d',
    }).then((result) => {
        if (result.isConfirmed) {
            window.location.href = '{{ path('app_crud_env_mail_sender_reset_last_used_at') }}';
        }
    });
}

function confirmRemiseZero() {
    Swal.fire({
        title: 'Remettre à zéro les compteurs ?',
        text: "Tous les compteurs d'envoi seront réinitialisés à 0.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Oui, remettre à zéro',
        cancelButtonText: 'Annuler',
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
    }).then((result) => {
        if (result.isConfirmed) {
            window.location.href = '{{ path('app_crud_env_mail_sender_remise_zero') }}';
        }
    });
}
</script>
{% endblock %}
