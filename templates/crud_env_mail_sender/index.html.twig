{% extends 'baseAdmin.html.twig' %}

{% block title %}EnvMailSender index{% endblock %}

{% block body %}
    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <span class="h4 me-3">EnvMailSender index</span>
            <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_env_mail_sender_new') }}">Create new</a>
        </div>
        <div class="col-md-6 text-end">
            <button class="btn btn-sm btn-success h4 me-2" onclick="confirmReactivate()">Réactiver tous</button>
            <button class="btn btn-sm btn-danger h4" onclick="confirmRemiseZero()">Remise à zéro</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="data-table table table-bordered table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th>Id</th>
                    <th>Count.MS</th>
                    <th>Activ.</th>
                    <th>MailAdresse</th>
                    <th>Password</th>
                    <th>SmtpServer</th>
                    <th>SmtpPort</th>
                    <th>SmtpSecured</th>
                </tr>
            </thead>
            <tbody>
            {% for env_mail_sender in env_mail_senders %}
                <tr>
                    <td>
                        {% include "crud_env_mail_sender/_delete_form.html.twig" %}
                    </td>
                    <td>{{ env_mail_sender.id }}</td>
                    <td>{{ env_mail_sender.countMailSent }}</td>
                    <td class="text-center">
                        {% if env_mail_sender.activated %}
                            <span class="badge bg-success">Oui</span>
                        {% else %}
                            <span class="badge bg-danger">Non</span>
                        {% endif %}
                    </td>
                    <td>{{ env_mail_sender.mailAdresse }}</td>
                    <td>{{ env_mail_sender.password }}</td>
                    <td>{{ env_mail_sender.smtpServer }}</td>
                    <td>{{ env_mail_sender.smtpPort }}</td>
                    <td>{{ env_mail_sender.smtpSecured }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="10">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}

{% block javascripts %}
<script>
function confirmReactivate() {
    Swal.fire({
        title: 'Réactiver tous les senders ?',
        text: 'Tous les senders désactivés seront remis actifs.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Oui, réactiver',
        cancelButtonText: 'Annuler',
        confirmButtonColor: '#198754',
        cancelButtonColor: '#6c757d',
    }).then((result) => {
        if (result.isConfirmed) {
            window.location.href = '{{ path('app_crud_env_mail_sender_reactivate_all') }}';
        }
    });
}

function confirmRemiseZero() {
    Swal.fire({
        title: 'Remettre à zéro les compteurs ?',
        text: "Tous les compteurs d'envoi seront réinitialisés à 0.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Oui, remettre à zéro',
        cancelButtonText: 'Annuler',
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
    }).then((result) => {
        if (result.isConfirmed) {
            window.location.href = '{{ path('app_crud_env_mail_sender_remise_zero') }}';
        }
    });
}
</script>
{% endblock %}
