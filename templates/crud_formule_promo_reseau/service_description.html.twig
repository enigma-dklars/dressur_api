{% extends 'baseAdmin.html.twig' %}

{% block title %}Service + Description{% endblock %}

{% block body %}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Service + Description</h4>
    <a href="{{ path('app_crud_formule_promo_reseau_index') }}" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Retour à la liste
    </a>
</div>

{% for label, messages in app.flashes %}
    <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
        {% for message in messages %}
            <p class="mb-0">{{ message|raw }}</p>
        {% endfor %}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
{% endfor %}

<form action="" method="post" id="form-service-desc">
<div class="row g-4">

    {# ── Colonne gauche : ID + champs à modifier ── #}
    <div class="col-lg-5">

        {# Recherche par ID #}
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-danger text-white fw-bold">
                <i class="bi bi-search me-2"></i>ID du service
            </div>
            <div class="card-body">
                <div class="input-group">
                    <input type="number"
                           name="id_service"
                           id="id_service"
                           class="form-control form-control-lg"
                           placeholder="ex: 1087"
                           value="{{ idService }}"
                           autocomplete="off"
                           min="1">
                    <button type="button" class="btn btn-outline-secondary" id="btn-lookup" title="Rechercher">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
                <div class="mt-2">
                    <button type="button" class="btn btn-warning w-100" id="btn-next-sans-desc">
                        <i class="bi bi-lightning-charge-fill me-1"></i>Trouver suivant sans description
                    </button>
                    <div id="next-sans-desc-status" class="form-text mt-1"></div>
                </div>
                <div id="lookup-status" class="form-text mt-1"></div>
            </div>
        </div>

        {# Champs modifiables #}
        <div class="card shadow-sm">
            <div class="card-header fw-bold">
                <i class="bi bi-sliders me-2"></i>Champs à modifier
            </div>
            <div class="card-body">

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Prix DS</label>
                        <input type="number" step="any" name="prix" id="field-prix"
                               class="form-control" placeholder="0.000">
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Prix Zefame</label>
                        <input type="number" step="any" name="prix_zefame" id="field-prix-zef"
                               class="form-control" placeholder="0.000">
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Qté Min</label>
                        <input type="number" step="1" name="qte_min" id="field-qte-min"
                               class="form-control" placeholder="0">
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Qté Max</label>
                        <input type="number" step="1" name="qte_max" id="field-qte-max"
                               class="form-control" placeholder="0">
                    </div>
                </div>

                <div class="mb-3">
                    <label for="description_service" class="form-label fw-semibold small">Description (FR)</label>
                    <textarea name="description_service"
                              id="description_service"
                              rows="10"
                              class="form-control font-monospace"
                              placeholder="Chargée automatiquement après la recherche…"></textarea>
                    <div class="form-text">"Zefame" / "zefame" → "Dressur" à l'enregistrement.</div>
                </div>

                <button type="submit" class="btn btn-danger w-100" id="btn-submit" disabled>
                    <i class="bi bi-floppy me-2"></i>Enregistrer les modifications
                </button>

            </div>
        </div>
    </div>

    {# ── Colonne droite : aperçu info service ── #}
    <div class="col-lg-7">

        <div id="card-loading" class="card shadow-sm d-none">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-danger" role="status"></div>
                <div class="mt-2 text-muted small">Recherche en cours…</div>
            </div>
        </div>

        <div class="card shadow-sm" id="card-info" style="opacity:.35;pointer-events:none;">
            <div class="card-header fw-bold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-info-circle me-2"></i>Informations actuelles en base</span>
                <span id="badge-available" class="badge bg-secondary">—</span>
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label text-muted small mb-1">Titre</label>
                    <div class="fw-semibold fs-6" id="info-titre"><span class="text-muted">—</span></div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="text-muted small mb-1">Prix DS</div>
                            <div class="fw-bold text-primary" id="info-prix">—</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="text-muted small mb-1">Qté</div>
                            <div class="fw-bold" id="info-qte">—</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="text-muted small mb-1">Qté Min</div>
                            <div class="fw-bold text-warning" id="info-qteMin">—</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="text-muted small mb-1">Qté Max</div>
                            <div class="fw-bold text-danger" id="info-qteMax">—</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="text-muted small mb-1">Prix Zefame</div>
                            <div class="fw-bold text-success" id="info-prixZef">—</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="text-muted small mb-1">ID interne</div>
                            <div class="fw-bold text-secondary" id="info-id">—</div>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="form-label text-muted small mb-1">Description actuellement en base</label>
                    <div class="border rounded p-2 bg-light font-monospace small"
                         id="info-desc-preview"
                         style="max-height:220px;overflow-y:auto;white-space:pre-wrap;">(aucune description enregistrée)</div>
                </div>

            </div>
        </div>
    </div>

</div>
</form>

<script>
(function () {
    const inputId    = document.getElementById('id_service');
    const btnLookup  = document.getElementById('btn-lookup');
    const statusEl   = document.getElementById('lookup-status');
    const cardInfo   = document.getElementById('card-info');
    const cardLoad   = document.getElementById('card-loading');
    const btnSubmit  = document.getElementById('btn-submit');

    const elTitre    = document.getElementById('info-titre');
    const elPrix     = document.getElementById('info-prix');
    const elQte      = document.getElementById('info-qte');
    const elQteMin   = document.getElementById('info-qteMin');
    const elQteMax   = document.getElementById('info-qteMax');
    const elPrixZef  = document.getElementById('info-prixZef');
    const elId       = document.getElementById('info-id');
    const elBadge    = document.getElementById('badge-available');
    const elDescPrev = document.getElementById('info-desc-preview');

    // Champs éditables
    const fPrix      = document.getElementById('field-prix');
    const fPrixZef   = document.getElementById('field-prix-zef');
    const fQteMin    = document.getElementById('field-qte-min');
    const fQteMax    = document.getElementById('field-qte-max');
    const fDesc      = document.getElementById('description_service');

    let debounceTimer = null;

    function setStatus(html, type) {
        statusEl.className = 'form-text mt-1 text-' + (type || 'secondary');
        statusEl.innerHTML = html;
    }

    function setLoading(on) {
        cardLoad.classList.toggle('d-none', !on);
        cardInfo.classList.toggle('d-none', on);
    }

    function resetAll() {
        cardInfo.style.opacity = '0.35';
        cardInfo.style.pointerEvents = 'none';
        btnSubmit.disabled = true;

        elTitre.innerHTML = '<span class="text-muted">—</span>';
        [elPrix, elQte, elQteMin, elQteMax, elPrixZef, elId].forEach(el => el.textContent = '—');
        elBadge.textContent = '—';
        elBadge.className = 'badge bg-secondary';
        elDescPrev.textContent = '(aucune description enregistrée)';

        fPrix.value = '';
        fPrixZef.value = '';
        fQteMin.value = '';
        fQteMax.value = '';
        fDesc.value = '';
    }

    function fillAll(data) {
        if (!data.found) { resetAll(); return; }

        cardInfo.style.opacity = '1';
        cardInfo.style.pointerEvents = 'auto';
        btnSubmit.disabled = false;

        // Panneau info (lecture)
        let titreHtml = '';
        if (data.parent) titreHtml += '<span class="text-muted">' + data.parent.titre + ' › </span>';
        titreHtml += '<strong>' + (data.titre || '') + '</strong>';
        elTitre.innerHTML = titreHtml;

        elPrix.textContent    = data.prix        ?? '—';
        elQte.textContent     = data.qte         ?? '—';
        elQteMin.textContent  = data.qteMin      ?? '—';
        elQteMax.textContent  = data.qteMax      ?? '—';
        elPrixZef.textContent = data.prixZefame  ?? '—';
        elId.textContent      = data.id          ?? '—';

        elBadge.textContent = data.available ? 'Actif' : 'Inactif';
        elBadge.className   = 'badge ' + (data.available ? 'bg-success' : 'bg-danger');
        elDescPrev.textContent = data.description || '(aucune description enregistrée)';

        // Champs éditables pré-remplis
        fPrix.value    = data.prix       !== null ? data.prix       : '';
        fPrixZef.value = data.prixZefame !== null ? data.prixZefame : '';
        fQteMin.value  = data.qteMin     !== null ? data.qteMin     : '';
        fQteMax.value  = data.qteMax     !== null ? data.qteMax     : '';
        fDesc.value    = data.description || '';
    }

    function lookup() {
        const val = parseInt(inputId.value, 10);
        if (!val || val <= 0) {
            setStatus('Saisissez un ID valide.', 'warning');
            resetAll();
            return;
        }

        setStatus('<span class="spinner-border spinner-border-sm me-1"></span>Recherche…');
        setLoading(true);

        fetch('/crud/formule/promo/reseau/service_description/info?id_service=' + val)
            .then(r => r.json())
            .then(data => {
                setLoading(false);
                if (data.found) {
                    setStatus('<i class="bi bi-check-circle-fill me-1"></i>Trouvé : <strong>' + (data.titre || '') + '</strong>', 'success');
                } else {
                    setStatus('<i class="bi bi-x-circle-fill me-1"></i>' + (data.message || 'Introuvable'), 'danger');
                }
                fillAll(data);
            })
            .catch(() => {
                setLoading(false);
                setStatus('<i class="bi bi-x-circle-fill me-1"></i>Erreur réseau.', 'danger');
                resetAll();
            });
    }

    btnLookup.addEventListener('click', lookup);

    // ── Bouton "Trouver suivant sans description" ──────────────
    const btnNext      = document.getElementById('btn-next-sans-desc');
    const nextStatus   = document.getElementById('next-sans-desc-status');

    function setNextStatus(html, type) {
        nextStatus.innerHTML = html;
        nextStatus.className = 'form-text mt-1' + (type ? ' text-' + type : '');
    }

    btnNext.addEventListener('click', function () {
        btnNext.disabled = true;
        setNextStatus('<span class="spinner-border spinner-border-sm me-1"></span>Recherche…');

        fetch('/crud/formule/promo/reseau/service_description/next-sans-description')
            .then(r => r.json())
            .then(data => {
                btnNext.disabled = false;
                if (data.found) {
                    inputId.value = data.idZefame;
                    setNextStatus('<i class="bi bi-check-circle-fill me-1"></i>ID <strong>' + data.idZefame + '</strong> chargé.', 'success');
                    lookup();
                } else {
                    setNextStatus('<i class="bi bi-check2-all me-1"></i>' + (data.message || 'Aucune formule sans description.'), 'success');
                    resetAll();
                }
            })
            .catch(() => {
                btnNext.disabled = false;
                setNextStatus('<i class="bi bi-x-circle-fill me-1"></i>Erreur réseau.', 'danger');
            });
    });

    inputId.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        const val = parseInt(this.value, 10);
        if (val > 0) {
            setStatus('…');
            debounceTimer = setTimeout(lookup, 500);
        } else {
            setStatus('');
            resetAll();
        }
    });

    inputId.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); clearTimeout(debounceTimer); lookup(); }
    });

})();
</script>

{% endblock %}
