{% extends 'baseAdmin.html.twig' %}

{% block title %}FormulePromoReseau index{% endblock %}

{% block body %}
    <span class="h4 me-3">FormulePromoReseau index</span>
    <a class="btn btn-sm btn-warning h4" href="{{ path('app_crud_formule_promo_reseau_available') }}">Available</a>
    <a class="btn btn-sm btn-primary h4 ms-1" href="{{ path('app_crud_formule_promo_reseau_new') }}">Create new</a>
    <a class="btn btn-sm btn-danger h4 ms-1" href="{{ path('app_crud_formule_promo_reseau_service_description') }}">Service + Description</a>



    <div class="table-responsive">
        <table class="data-table table table-bordered table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th>Id.Zef</th>
                    <th>Titre</th>
                    <th>Descp</th>
                    <th>Prix DS</th>
                    <th>Prix VD</th>
                    <th>Prix ZF</th>
                    <th>QteMin</th>
                    <th>QteMax</th>
                    <th>Qte</th>
                    <th>Activ.</th>
                    <th>Comm.</th>
                    <th>Id</th>
                </tr>
            </thead>
            <tbody>
            {% for formule_promo_reseau in formule_promo_reseaus %}
                <tr>
                    <td>{% include "crud_formule_promo_reseau/_delete_form.html.twig" %}</td>
                    <td>{{ formule_promo_reseau.idZefame }}</td>
                    <td>
                        {% if formule_promo_reseau.parent %}
                        {{formule_promo_reseau.parent.titre}} 
                        {% endif %}
                        {{ formule_promo_reseau.titre }}
                    </td>
                    <td class="text-center">
                        {% if formule_promo_reseau.description %}
                            <span class="badge bg-success">Yes</span>
                        {% else %}
                            <span class="badge bg-danger">No</span>
                        {% endif %}
                    </td>
                    <td>{{ formule_promo_reseau.prix }}</td>
                    <td>{{ formule_promo_reseau.prixVendeur }}</td>
                    <td>{{ formule_promo_reseau.prixZefame }}</td>
                    <td>{{ formule_promo_reseau.qteMin }}</td>
                    <td>{{ formule_promo_reseau.qteMax }}</td>
                    <td>{{ formule_promo_reseau.qte }}</td>
                    <td class="text-center">{{ formule_promo_reseau.available ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-danger">No</span>' }}</td>
                    <td class="text-center">{{ formule_promo_reseau.commentairesRequis ? '<span class="badge bg-warning text-dark">Oui</span>' : '<span class="badge bg-secondary">Non</span>' }}</td>
                    <td>{{ formule_promo_reseau.id }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="12">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}
