{% extends 'basePrivate.html.twig' %}

{% block title %}FormulePromoReseau index{% endblock %}

{% block body %}
    <h1>FormulePromoReseau index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>IconFlutterName</th>
                <th>Description</th>
                <th>DescriptionEn</th>
                <th>Prix</th>
                <th>Qte</th>
                <th>QteMin</th>
                <th>QteMax</th>
                <th>Available</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for formule_promo_reseau in formule_promo_reseaus %}
            <tr>
                <td>{{ formule_promo_reseau.id }}</td>
                <td>{{ formule_promo_reseau.titre }}</td>
                <td>{{ formule_promo_reseau.iconFlutterName }}</td>
                <td>{{ formule_promo_reseau.description }}</td>
                <td>{{ formule_promo_reseau.descriptionEn }}</td>
                <td>{{ formule_promo_reseau.prix }}</td>
                <td>{{ formule_promo_reseau.qte }}</td>
                <td>{{ formule_promo_reseau.qteMin }}</td>
                <td>{{ formule_promo_reseau.qteMax }}</td>
                <td>{{ formule_promo_reseau.available ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_crud_formule_promo_reseau_show', {'id': formule_promo_reseau.id}) }}">show</a>
                    <a href="{{ path('app_crud_formule_promo_reseau_edit', {'id': formule_promo_reseau.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_crud_formule_promo_reseau_new') }}">Create new</a>
{% endblock %}
