{% extends 'baseAdmin.html.twig' %}

{% block title %}EnvPaiementApi index{% endblock %}

{% block body %}
    <div class="row g-2 mb-2">
        <div class="col-md-6">
            <span class="h4 me-3">EnvPaiementApi index</span>
            <a class="btn btn-sm btn-primary h4" href="{{ path('app_env_paiement_api_new') }}">Create new</a>
        </div>
        <div class="col-md-6 text-end">
            <a class="btn btn-sm btn-danger h4" href="{{ path('app_env_paiement_api_remise_zero') }}">Remise à zéro</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="data-table table table-bordered table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th>Id</th>
                    <th>Count.TA</th>
                    <th>Activ.</th>
                    <th>Aggregator</th>
                    <th>Account</th>
                    <th>Link</th>
                    <th>ApiKey</th>
                    <th>Environment</th>
                    <th>EndpointSecret</th>
                    <th>RouteWebhook</th>
                </tr>
            </thead>
            <tbody>
            {% for env_paiement_api in env_paiement_apis %}
                <tr>
                    <td>
                        {% include "crud_env_paiement_api/_delete_form.html.twig" %}
                    </td>
                    <td>{{ env_paiement_api.id }}</td>
                    <td>{{ env_paiement_api.countTransactionApproved }}</td>
                    <td class="text-center">
                        {% if env_paiement_api.activated %}
                            <span class="badge bg-success">Oui</span>
                        {% else %}
                            <span class="badge bg-danger">Non</span>
                        {% endif %}
                    </td>
                    <td>{{ env_paiement_api.aggregator }}</td>
                    <td>{{ env_paiement_api.accountName }}</td>
                    <td class="text-center">
                        {% if env_paiement_api.linkPaiement %}
                            <span
                                class="badge bg-primary text-white copy-payment-link"
                                role="button"
                                tabindex="0"
                                data-copy-link="{{ env_paiement_api.linkPaiement }}"
                                title="Copier l’URL de paiement"
                                aria-label="Copier l’URL de paiement"
                            >Copier</span>
                        {% endif %}
                    </td>
                    <td>{{ env_paiement_api.apiKey }}</td>
                    <td>{{ env_paiement_api.environment }}</td>
                    <td>{{ env_paiement_api.endpointSecret }}</td>
                    <td>{{ env_paiement_api.routeWebhook }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <style>
        .copy-payment-link {
            cursor: pointer;
            user-select: none;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.copy-payment-link').forEach(function (badge) {
                const copyLink = async function () {
                    const link = badge.dataset.copyLink;

                    try {
                        if (navigator.clipboard && window.isSecureContext) {
                            await navigator.clipboard.writeText(link);
                        } else {
                            const fallbackInput = document.createElement('textarea');
                            fallbackInput.value = link;
                            fallbackInput.setAttribute('readonly', '');
                            fallbackInput.style.position = 'fixed';
                            fallbackInput.style.opacity = '0';
                            document.body.appendChild(fallbackInput);
                            fallbackInput.select();
                            document.execCommand('copy');
                            fallbackInput.remove();
                        }

                        const originalLabel = badge.textContent;
                        badge.textContent = 'Copié';
                        window.setTimeout(function () {
                            badge.textContent = originalLabel;
                        }, 1500);
                    } catch (error) {
                        console.error('Impossible de copier le lien de paiement.', error);
                    }
                };

                badge.addEventListener('click', copyLink);
                badge.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        copyLink();
                    }
                });
            });
        });
    </script>

{% endblock %}
