{% extends 'basePrivate.html.twig' %}

{% block title %}New MsgAi{% endblock %}

{% block body %}
    <p class="h4 me-3">Create new MsgAi 
        <a class="ms-2 btn btn-sm btn-primary" href="{{ path('app_crud_msg_ai_index') }}">Liste</a>
    </p>

<div class="container mt-4">

    <form id="form-testers" method="POST" action="{{ path('app_crud_msg_ai_create_for_all') }}">
        
        <div id="testers-container">

            <!-- Premier Message ci-dessous -->
            <div class="tester-item card p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="mb-0 fw-bold">Message ci-dessous</label>
                    <button type="button" class="btn btn-danger btn-sm btn-delete">
                        Supprimer
                    </button>
                </div>

                <textarea 
                    name="testers[]" 
                    class="form-control tester-input" 
                    rows="10"
                    placeholder="La variante du message ici"
                ></textarea>
            </div>

        </div>

        <div class="d-flex justify-content-between mt-3">
            <button type="button" id="btn-add" class="btn btn-primary">
                Ajouter un Message
            </button>

            <button type="submit" id="btn-submit" class="btn btn-success">
                Valider
            </button>
        </div>

    </form>
</div>
{% endblock %}

{% block script %}
<script>
$(document).ready(function () {

    $('#btn-add').click(function () {

        let html = `
            <div class="tester-item card p-3 mb-3 new-item">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="mb-0 fw-bold">Message ci-dessous</label>
                    <button type="button" class="btn btn-danger btn-sm btn-delete">
                        Supprimer
                    </button>
                </div>

                <textarea 
                    name="testers[]" 
                    class="form-control tester-input" 
                    rows="10"
                    placeholder="La variante du message ici"
                ></textarea>
            </div>
        `;

        // Ajouter le message
        $('#testers-container').append(html);

        // Sélectionner le dernier élément ajouté
        let newItem = $('#testers-container .tester-item').last();

        // Focus dans le textarea
        let textarea = newItem.find('textarea');
        textarea.focus();

        // Animation highlight (800ms)
        newItem.animate({ backgroundColor: '#ffffff' }, 800);

        // Défilement automatique à son niveau
        $('html, body').animate({
            scrollTop: newItem.offset().top - 50
        }, 600);
    });

    // 🗑️ Supprimer un message (avec confirmation)
    $(document).on('click', '.btn-delete', function () {
        if (confirm("Voulez-vous vraiment supprimer ce Message ci-dessous ?")) {
            $(this).closest('.tester-item').remove();
        }
    });

    // ✅ Vérification avant soumission
    $('#form-testers').submit(function (e) {
        let hasEmpty = false;

        $('.tester-input').each(function () {
            if ($(this).val().trim() === "") {
                hasEmpty = true;
            }
        });

        if (hasEmpty) {
            e.preventDefault();
            alert("Il existe un Message ci-dessous vide. Veuillez le remplir ou le supprimer.");
        }
    });

});
</script>
{% endblock %}
