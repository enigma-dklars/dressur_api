<form method="post" action="{{ path('app_crud_msg_ai_delete', {'id': msg_ai.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ msg_ai.id) }}">
    
    <a class="btn btn-sm btn-info"href="{{ path('app_crud_msg_ai_show', {'id': msg_ai.id}) }}">Show</a>
    <a class="btn btn-sm btn-success"href="{{ path('app_crud_msg_ai_edit', {'id': msg_ai.id}) }}">Edit</a>
    <button class="btn btn-sm btn-danger">Delete</button>
</form>
