{% extends 'basePrivate.html.twig' %}

{% block title %}CampagneMail index{% endblock %}

{% block body %}
    <div class="row g-2 mb-3">
        <div class="col-md-6">
            <span class="h4 me-3">CampagneMail index</span> 
            <a class="btn btn-sm btn-primary h4 me-2" href="{{ path('app_crud_campagne_mail_new') }}">Create new</a>
            <a class="btn btn-sm btn-primary h4" href="{{ path('mailforallusers') }}">For all users</a>
        </div>
        <div class="col-md-6 text-end">
            {% if nbr_file_attente >= 1 %}
                <a class="btn btn-sm btn-warning" href="{{ path('app_crud_campagne_mail_pending') }}"><i class="fa fa-spinner fa-spin me-2"></i> File Attente ({{nbr_file_attente}})</a>
            {% endif %}
        </div>
    </div>

    <div class="table-responsive">
        <table class="data-table table table-bordered table-striped">
            <thead>
                <tr>
                    <th width="0"></th>
                    <th></th>
                    <th>Id</th>
                    <th>User</th>
                    {# <th>Titre</th> #}
                    {# <th>Sujet</th> #}
                    {# <th>Replyto</th> #}
                    {# <th>Sendto</th> #}
                    {# <th>Contentmail</th> #}
                    <th>CreatedAt</th>
                    <th>Status</th>
                    <th>Motif</th>
                </tr>
            </thead>
            <tbody>
            {% for campagne_mail in campagne_mails %}
                <tr>
                    <td></td>
                    <td>{% include "crud_campagne_mail/_delete_form.html.twig" %}</td>
                    <td>{{ campagne_mail.id }}</td>
                    <td>{{ campagne_mail.user.pseudo }}</td>
                    {# <td>{{ campagne_mail.titre }}</td> #}
                    {# <td>{{ campagne_mail.sujet }}</td> #}
                    {# <td>{{ campagne_mail.replyto }}</td> #}
                    {# <td>{{ campagne_mail.sendto }}</td> #}
                    {# <td>{{ campagne_mail.contentmail }}</td> #}
                    <td>{{ campagne_mail.createdAt ? campagne_mail.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ campagne_mail.status }}</td>
                    <td>{{ campagne_mail.motif }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="10">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}
