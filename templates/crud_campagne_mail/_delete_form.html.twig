<form method="post" action="{{ path('app_crud_campagne_mail_delete', {'id': campagne_mail.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ campagne_mail.id) }}">

    <a href="{{ path('app_crud_campagne_mail_show', {'id': campagne_mail.id}) }}" class="btn btn-sm btn-info">Show</a>

    <a href="{{ path('app_crud_campagne_mail_edit', {'id': campagne_mail.id}) }}" class="btn btn-sm btn-success">Edit</a>

    {% if campagne_mail.status == 3 and campagne_mail.traitement == false %}
        <a href="{{ path('app_crud_campagne_mail_start', {'id': campagne_mail.id}) }}" class="btn btn-sm btn-warning">Start</a>
    {% endif %}
    {# <button class="btn btn-sm btn-danger">Delete</button> #}
</form>