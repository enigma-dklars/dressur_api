{% extends 'basePrivate.html.twig' %}

{% block title %}New CampagneMail{% endblock %}

{% block body %}
    <div class="row g-2 mb-3">
        <div class="col-md-6"><span class="h4 me-3">CampagneMail index</span> <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_campagne_mail_new') }}">Create new</a></div>
        <div class="col-md-6 text-end">
            <a class="btn btn-sm btn-primary" href="{{ path('app_crud_campagne_mail_index') }}">Liste Campagne Mail</a>
        </div>
    </div>

    <form method="post">
        <label for="mesage" class="mb-2">Message</label>
        <textarea name="message" id="message" rows="20" class="form-control mb-2"></textarea>
        <button type="submit" class="btn btn-danger">Envoyer a tous les user</button>
    </form>
{% endblock %}