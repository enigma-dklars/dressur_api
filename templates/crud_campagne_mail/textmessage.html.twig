{% extends 'basePrivate.html.twig' %}

{% block title %}New CampagneMail{% endblock %}

{% block body %}
    <div class="row g-2 mb-3">
        <div class="col-md-6"><span class="h4 me-3">Send for all users Dressur</span></div>
        <div class="col-md-6 text-end">
            <a class="btn btn-sm btn-primary" href="{{ path('app_crud_campagne_mail_index') }}">Liste Campagne Mail</a>
        </div>
    </div>

    <form method="post">
        <label for="title" class="mb-2">Title</label>
        <input name="title" id="title" rows="20" class="form-control mb-3">

        <label for="subject" class="mb-2">Subject</label>
        <input name="subject" id="subject" rows="20" class="form-control mb-3">

        <label for="mesage" class="mb-2">Message</label>
        <textarea name="message" id="message" rows="20" class="form-control mb-3"></textarea>
        <button type="submit" class="btn btn-danger">Envoyer a tous les user</button>
    </form>
{% endblock %}