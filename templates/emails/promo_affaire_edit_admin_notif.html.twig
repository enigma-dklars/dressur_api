{% extends 'emails/templates_mail.html.twig' %}

{% block contenu_mail %}
<style>
  .container {
    font-family: Arial, sans-serif;
    max-width: 560px;
    padding: 20px;
  }
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: bold;
    margin: 2px 0;
  }
  .badge-oui { background-color: #d4edda; color: #155724; }
  .badge-non { background-color: #f8d7da; color: #721c24; }
  .info-block {
    background-color: #f0f4ff;
    border-left: 4px solid #2a4b9a;
    padding: 12px 16px;
    border-radius: 4px;
    margin: 12px 0;
  }
  .info-block p {
    margin: 5px 0;
    font-size: 14px;
    color: #333;
  }
  .info-block strong {
    color: #2a4b9a;
  }
  .section-title {
    font-size: 13px;
    text-transform: uppercase;
    color: #888;
    letter-spacing: 1px;
    margin: 18px 0 6px 0;
  }
  .alert-box {
    background-color: #cce5ff;
    border: 1px solid #b8daff;
    border-radius: 4px;
    padding: 12px;
    font-size: 14px;
    color: #004085;
    margin-bottom: 16px;
  }
</style>

<div class="container">
  <h2 style="color:#2a4b9a; margin-bottom: 4px;">✏️ Promotion Affaire Modifiée</h2>
  <p style="color:#555; margin-top: 0;">Un utilisateur vient de modifier une promotion affaire existante.</p>

  <div class="alert-box">
    ℹ️ La promotion a été remise en attente de validation (statut 1). Veuillez la vérifier depuis le panneau d'administration.
  </div>

  <p class="section-title">Utilisateur</p>
  <div class="info-block">
    <p><strong>Nom :</strong> {{ user_nom }}</p>
    <p><strong>Email :</strong> {{ user_mail }}</p>
    <p><strong>Téléphone :</strong> {{ user_tel }}</p>
  </div>

  <p class="section-title">Promotion concernée</p>
  <div class="info-block">
    <p><strong>ID Promotion :</strong> #{{ promotion_id }}</p>
    <p>
      <strong>Description modifiée :</strong>
      {% if description_modifiee %}
        <span class="badge badge-oui">OUI</span>
      {% else %}
        <span class="badge badge-non">NON</span>
      {% endif %}
    </p>
    <p>
      <strong>Image modifiée :</strong>
      {% if image_modifiee %}
        <span class="badge badge-oui">OUI</span>
      {% else %}
        <span class="badge badge-non">NON</span>
      {% endif %}
    </p>
    {% if description_modifiee %}
    <p><strong>Nouvelle description :</strong> {{ nouvelle_description }}</p>
    {% endif %}
  </div>
</div>
{% endblock %}
