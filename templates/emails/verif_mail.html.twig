{% extends 'emails/templates_mail.html.twig' %}

{% block contenu_mail %}
  <style>
    .container {
      font-family: 'Arial', sans-serif;
      background-color: #f4f4f4;
      margin: 0;
      padding: 0;
      text-align: center;
      background-color: #ffffff;
      padding: 20px;
      border-radius: 5px;
    }
    h2 {
      color: #333;
    }
    p {
      color: #555;
    }
     pre {
      background-color: #eee;
      padding: 10px;
      border-radius: 3px;
      font-size: 14px;
      margin: 10px 0;
    }
  </style>

  <div class="container">
    <h2>Vérification de l'Adresse E-mail</h2>
    <p>{{username}}, Bienvenue sur Dressur ! Avant de commencer à utiliser notre application, veuillez vérifier votre adresse e-mail.</p>
    <p>Copiez et collez le code de vérification suivant dans la section prévue sur l'application Dressur :</p>
    <pre>Code de Vérification : {{code}} </pre>
    <p>Merci de faire partie de la communauté Dressur !</p>
  </div>


{% endblock %}