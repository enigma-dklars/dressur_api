{% extends 'baseAdmin.html.twig' %}
{% block title %}FormuleBoost{% endblock %}
{% block body %}
    <h1>FormuleBoost</h1>
    <table class="table table-bordered table-striped">
        <tbody>
            <tr><th>Id</th><td>{{ formule_boost.id }}</td></tr>
            <tr><th>Titre</th><td>{{ formule_boost.titre }}</td></tr>
            <tr><th>Prix</th><td>{{ formule_boost.prix }} FCFA</td></tr>
            <tr>
                <th>Type de boost</th>
                <td>
                    {% if formule_boost.typeBoost == 'quota' %}
                        <span class="badge text-white" style="background:#6f42c1">Par Contacts (quota)</span>
                    {% else %}
                        <span class="badge bg-info text-dark">Par Durée (date)</span>
                    {% endif %}
                </td>
            </tr>
            <tr><th>NbrJour <small class="text-muted">(type date)</small></th><td>{{ formule_boost.typeBoost == 'date' ? formule_boost.nbrJour : '—' }}</td></tr>
            <tr><th>NbContactsMax <small class="text-muted">(type quota)</small></th><td>{{ formule_boost.typeBoost == 'quota' ? formule_boost.nbContactsMax : '—' }}</td></tr>
            <tr><th>Activated</th><td>{{ formule_boost.activated ? 'Yes' : 'No' }}</td></tr>
            <tr><th>Alert</th><td>{{ formule_boost.alert ? 'Yes' : 'No' }}</td></tr>
        </tbody>
    </table>
    <a href="{{ path('app_crud_formule_boost_index') }}">back to list</a>
    <a href="{{ path('app_crud_formule_boost_edit', {'id': formule_boost.id}) }}" class="btn btn-sm btn-success">Edit</a>
    {{ include('crud_formule_boost/_delete_form.html.twig') }}
{% endblock %}
