            {{ form_errors(form.motif) }}
        </div>

        <div class="col-md-6">
            {{ form_label(form.tel) }}
            {{ form_widget(form.tel) }}
            {{ form_errors(form.tel) }}
        </div>

        <div class="col-md-6">
            {{ form_label(form.mail) }}
