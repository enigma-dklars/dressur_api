{% extends 'baseAdmin.html.twig' %}

{% block title %}Nouvelle Story{% endblock %}

{% block body %}
    <div class="row g-2 mb-3">
        <div class="col">
            <h4>Nouvelle Story</h4>
        </div>
        <div class="col-auto">
            <a href="{{ path('app_crud_story_index') }}" class="btn btn-sm btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Retour
            </a>
        </div>
    </div>

    {% if errors is defined and errors|length > 0 %}
        <div class="alert alert-danger">
            <ul class="mb-0">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="card radius-10">
        <div class="card-body">
            <form id="storyForm" method="post" enctype="multipart/form-data" action="{{ path('app_crud_story_new') }}">

                <div class="mb-3">
                    <label class="form-label fw-bold">Images <small class="text-muted">(plusieurs, max 3 Mo par image)</small></label>
                    <input type="file" id="imageInput" name="images[]" class="form-control" multiple accept="image/*">
                    <div id="imageError" class="mt-1"></div>
                    <div id="imagePreview" class="d-flex flex-column gap-2 mt-2"></div>
                    <div class="form-text">Formats acceptés : JPG, PNG, GIF, WebP...</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Vidéos <small class="text-muted">(URLs, une par ligne — YouTube, Google Drive, etc.)</small></label>
                    <textarea name="videos" class="form-control" rows="4" placeholder="https://www.youtube.com/watch?v=...&#10;https://drive.google.com/..."></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Utilisateur <small class="text-muted">(optionnel — ID numérique)</small></label>
                    <input type="number" name="user_id" class="form-control" placeholder="Ex: 42">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">URL <small class="text-muted">(optionnel)</small></label>
                    <input type="url" id="urlInput" name="url" class="form-control" placeholder="https://...">
                    <div id="urlError" class="invalid-feedback"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Description</label>
                    <textarea name="description" class="form-control" rows="5" placeholder="Texte descriptif de la story..."></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Date d'expiration <small class="text-muted">(optionnel)</small></label>
                    <input type="datetime-local" id="expiredAtInput" name="expired_at" class="form-control">
                    <div id="expiredAtError" class="invalid-feedback"></div>
                </div>

                <div class="text-end">
                    <a href="{{ path('app_crud_story_index') }}" class="btn btn-secondary me-2">Annuler</a>
                    <button type="submit" id="submitBtn" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Créer
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block script %}
<script>
(function () {
    const MAX_SIZE = 3 * 1024 * 1024;
    const imageInput   = document.getElementById('imageInput');
    const imageError   = document.getElementById('imageError');
    const imagePreview = document.getElementById('imagePreview');
    const urlInput     = document.getElementById('urlInput');
    const urlError     = document.getElementById('urlError');
    const expiredInput = document.getElementById('expiredAtInput');
    const expiredError = document.getElementById('expiredAtError');
    const form         = document.getElementById('storyForm');
    const submitBtn    = document.getElementById('submitBtn');

    function formatSize(bytes) {
        return (bytes / (1024 * 1024)).toFixed(2) + ' Mo';
    }

    function validateImages(files) {
        imageError.innerHTML = '';
        imagePreview.innerHTML = '';
        let hasError = false;

        Array.from(files).forEach(function (file) {
            const row = document.createElement('div');
            row.className = 'd-flex align-items-center gap-3 border rounded p-2';

            if (file.size > MAX_SIZE) {
                hasError = true;
                row.classList.add('border-danger', 'bg-danger-subtle');
                row.innerHTML =
                    '<div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded bg-danger-subtle" style="width:80px;height:80px;">' +
                    '<i class="bi bi-exclamation-triangle-fill text-danger fs-2"></i></div>' +
                    '<div class="flex-grow-1 overflow-hidden">' +
                    '<p class="mb-0 fw-semibold text-truncate">' + file.name + '</p>' +
                    '<p class="mb-0 text-danger small">' + formatSize(file.size) + ' — dépasse la limite de 3 Mo</p>' +
                    '</div>';
                const msg = document.createElement('div');
                msg.className = 'alert alert-danger py-1 px-2 mb-1 small';
                msg.textContent = '"' + file.name + '" dépasse 3 Mo (' + formatSize(file.size) + ').';
                imageError.appendChild(msg);
            } else {
                row.classList.add('border-success-subtle');
                const reader = new FileReader();
                reader.onload = function (e) {
                    row.innerHTML =
                        '<img src="' + e.target.result + '" class="rounded flex-shrink-0" style="width:80px;height:80px;object-fit:cover;" alt="">' +
                        '<div class="flex-grow-1 overflow-hidden">' +
                        '<p class="mb-0 fw-semibold text-truncate">' + file.name + '</p>' +
                        '<p class="mb-0 text-muted small">' + formatSize(file.size) + '</p>' +
                        '</div>' +
                        '<span class="badge bg-success flex-shrink-0">' + formatSize(file.size) + '</span>';
                };
                reader.readAsDataURL(file);
            }

            imagePreview.appendChild(row);
        });

        return !hasError;
    }

    function validateUrl() {
        const val = urlInput.value.trim();
        if (val === '') {
            urlInput.classList.remove('is-invalid');
            urlError.textContent = '';
            return true;
        }
        try {
            new URL(val);
            urlInput.classList.remove('is-invalid');
            urlInput.classList.add('is-valid');
            urlError.textContent = '';
            return true;
        } catch (_) {
            urlInput.classList.add('is-invalid');
            urlInput.classList.remove('is-valid');
            urlError.textContent = 'URL invalide. Ex : https://example.com';
            return false;
        }
    }

    function validateExpiredAt() {
        const val = expiredInput.value;
        if (!val) {
            expiredInput.classList.remove('is-invalid', 'is-valid');
            expiredError.textContent = '';
            return true;
        }
        const chosen = new Date(val);
        const now    = new Date();
        if (chosen <= now) {
            expiredInput.classList.add('is-invalid');
            expiredInput.classList.remove('is-valid');
            expiredError.textContent = 'La date d\'expiration doit être dans le futur.';
            return false;
        }
        expiredInput.classList.remove('is-invalid');
        expiredInput.classList.add('is-valid');
        expiredError.textContent = '';
        return true;
    }

    imageInput.addEventListener('change', function () {
        validateImages(this.files);
    });

    urlInput.addEventListener('input', validateUrl);
    expiredInput.addEventListener('change', validateExpiredAt);

    form.addEventListener('submit', function (e) {
        const imgOk = imageInput.files.length === 0 || validateImages(imageInput.files);
        const urlOk = validateUrl();
        const expOk = validateExpiredAt();
        if (!imgOk || !urlOk || !expOk) {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    });
})();
</script>
{% endblock %}
