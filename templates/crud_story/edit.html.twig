{% extends 'baseAdmin.html.twig' %}

{% block title %}Modifier Story #{{ story.id }}{% endblock %}

{% block body %}
    <div class="row g-2 mb-3">
        <div class="col">
            <h4>Modifier Story #{{ story.id }}</h4>
        </div>
        <div class="col-auto">
            <a href="{{ path('app_crud_story_show', {'id': story.id}) }}" class="btn btn-sm btn-info me-2">
                <i class="bi bi-eye me-1"></i> Voir
            </a>
            <a href="{{ path('app_crud_story_index') }}" class="btn btn-sm btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Retour
            </a>
        </div>
    </div>

    {% if errors is defined and errors|length > 0 %}
        <div class="alert alert-danger">
            <ul class="mb-0">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="card radius-10">
        <div class="card-body">
            <form method="post" enctype="multipart/form-data" action="{{ path('app_crud_story_edit', {'id': story.id}) }}">

                {% if story.images|length > 0 %}
                <div class="mb-4">
                    <label class="form-label fw-bold"><i class="bi bi-images me-1"></i> Images existantes</label>
                    <div class="row g-2">
                        {% for image in story.images %}
                        <div class="col-6 col-md-3 text-center">
                            <img src="/story/{{ image }}" class="img-fluid rounded mb-1 shadow-sm" style="height:130px; object-fit:cover; width:100%;" alt="{{ image }}">
                            <div class="form-check justify-content-center d-flex">
                                <input class="form-check-input me-2" type="checkbox" name="delete_images[]" value="{{ image }}" id="del_{{ loop.index }}">
                                <label class="form-check-label text-danger small" for="del_{{ loop.index }}">Supprimer</label>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <div class="mb-3">
                    <label class="form-label fw-bold">Ajouter des images <small class="text-muted">(max 1 Mo par image)</small></label>
                    <input type="file" name="images[]" class="form-control" multiple accept="image/*">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Vidéos <small class="text-muted">(URLs, une par ligne)</small></label>
                    <textarea name="videos" class="form-control" rows="4" placeholder="https://www.youtube.com/watch?v=...">{{ story.videos|join("\n") }}</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Utilisateur <small class="text-muted">(optionnel — ID numérique)</small></label>
                    <input type="number" name="user_id" class="form-control" value="{{ story.user ? story.user.id : '' }}" placeholder="Ex: 42">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">URL <small class="text-muted">(optionnel)</small></label>
                    <input type="url" name="url" class="form-control" value="{{ story.url }}" placeholder="https://...">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Description</label>
                    <textarea name="description" class="form-control" rows="5">{{ story.description }}</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Date d'expiration <small class="text-muted">(optionnel — laisser vide pour supprimer)</small></label>
                    <input type="datetime-local" name="expired_at" class="form-control"
                        value="{{ story.expiredAt ? story.expiredAt|date('Y-m-d\\TH:i') : '' }}">
                </div>

                <div class="row g-2 mb-3 text-muted small">
                    <div class="col-auto">
                        <i class="bi bi-calendar-plus me-1"></i> Créé le : <strong>{{ story.createdAt ? story.createdAt|date('d/m/Y H:i:s') : '—' }}</strong>
                    </div>
                    {% if story.updatedAt %}
                    <div class="col-auto">
                        <i class="bi bi-calendar-check me-1"></i> Dernière modification : <strong>{{ story.updatedAt|date('d/m/Y H:i:s') }}</strong>
                    </div>
                    {% endif %}
                </div>

                <div class="text-end">
                    <a href="{{ path('app_crud_story_index') }}" class="btn btn-secondary me-2">Annuler</a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i> Enregistrer
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
