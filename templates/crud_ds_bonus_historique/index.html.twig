{% extends 'baseAdmin.html.twig' %}

{% block title %}DSBonusHistorique index{% endblock %}

{% block body %}
    <p class="h4 me-3">DSBonusHistorique index</p>
    {# <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_d_s_bonus_historique_new') }}">Create new</a> #}

    <table class="data-table table table-bordered table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>User</th>
                <th>CreatedAt</th>
                <th>Titre</th>
                <th>Montant</th>
                {# <th>actions</th> #}
            </tr>
        </thead>
        <tbody>
        {% for d_s_bonus_historique in d_s_bonus_historiques %}
            <tr>
                <td>{{ d_s_bonus_historique.id }}</td>
                <td>{{ d_s_bonus_historique.user.pseudo }}</td>
                <td>{{ d_s_bonus_historique.createdAt ? d_s_bonus_historique.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ d_s_bonus_historique.titre }}</td>
                <td>{{ d_s_bonus_historique.montant }}</td>
                {# <td>{% include "crud_ds_bonus_historique/_delete_form.html.twig" %}</td> #}
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
