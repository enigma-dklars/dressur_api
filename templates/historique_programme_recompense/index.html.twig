{% extends 'basePrivate.html.twig' %}

{% block title %}HistoriqueProgrammeRecompense index{% endblock %}

{% block body %}
<div class="">
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <p class="h4 me-3">Historique Programme Récompense</p>
        </div>
        <div class="col-md-6 text-end">
            <a href="{{ path('app_historique_programme_recompense_new') }}" class="btn btn-primary">Create new</a>
        </div>
    </div>
</div>
<table class="data-table table table-bordered table-striped">
        <thead>
            <tr>
                <th>Actions</th>
                <th>Id</th>
                <th>Nbr Vue</th>
                <th>Nbr Partage</th>
                <th>Récompense</th>
                <th>Status</th>
                <th>Référence</th>
                <th>Créé le</th>
                <th>Modifié le</th>
            </tr>
        </thead>
        <tbody>
            {% for historique in historique_programme_recompenses %}
                <tr>
                    <td>
                        {% include "historique_programme_recompense/_delete_form.html.twig" with {'historique_programme_recompense': historique} %}
                    </td>
                    <td>{{ historique.id }}</td>
                    <td>{{ historique.nbrVue }}</td>
                    <td>{{ historique.nbrPartage }}</td>
                    <td>{{ historique.recompense }}</td>

                    <td class="text-center">
                        {% if historique.status == 'En attente' %}
                            <span class="badge bg-warning">{{ historique.status }}</span>
                        {% elseif historique.status == 'Validé' %}
                            <span class="badge bg-success">{{ historique.status }}</span>
                        {% elseif historique.status == 'Refusé' %}
                            <span class="badge bg-danger">{{ historique.status }}</span>
                        {% else %}
                            <span class="badge bg-secondary">{{ historique.status }}</span>
                        {% endif %}
                    </td>

                    <td>{{ historique.referenceParticipation }}</td>
                    <td>{{ historique.createdAt ? historique.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ historique.updatedAt ? historique.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9" class="text-center">no records found</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
