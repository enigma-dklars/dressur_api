{% extends 'basePrivate.html.twig' %}

{% block title %}DSBonus index{% endblock %}

{% block body %}
    <span class="h4 me-3">DSBonus index</span>
    <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_d_s_bonus_new') }}">Create new</a>

    <table class="data-table table table-bordered table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Code</th>
                <th>Montant</th>
                <th>DateExp</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for d_s_bonu in d_s_bonuses %}
            <tr>
                <td>{{ d_s_bonu.id }}</td>
                <td>{{ d_s_bonu.code }}</td>
                <td>{{ d_s_bonu.montant }}</td>
                <td>{{ d_s_bonu.dateExp ? d_s_bonu.dateExp|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    {% include "crud_ds_bonus/_delete_form.html.twig" %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
