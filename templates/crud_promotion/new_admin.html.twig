{% extends 'baseAdmin.html.twig' %}

{% block title %}Nouvelle Promotion Admin{% endblock %}

{% block body %}
<div class="row g-2 mb-3">
    <div class="col">
        <span class="h4">Nouvelle Promotion Admin</span>
        <span class="badge bg-success ms-2">Acceptée automatiquement</span>
    </div>
    <div class="col-auto">
        <a href="{{ path('app_crud_promotion_index') }}" class="btn btn-sm btn-secondary">← Retour à la liste</a>
    </div>
</div>

{% if errors is defined and errors|length > 0 %}
    <div class="alert alert-danger">
        <ul class="mb-0">
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

<form method="post" action="{{ path('app_crud_promotion_admin_new') }}" enctype="multipart/form-data">

    <div class="row g-3">

        {# Colonne gauche : champs #}
        <div class="col-md-7">

            <div class="card mb-3">
                <div class="card-header fw-semibold">Bénéficiaire</div>
                <div class="card-body">
                    <label class="form-label">Utilisateur <span class="text-danger">*</span></label>
                    <select name="user_id" class="form-select single-select mb-2" required>
                        <option value="">-- Choisir un utilisateur --</option>
                        {% for u in users %}
                            <option value="{{ u.id }}">{{ u.pseudo }}{% if u.nom %} — {{ u.nom }}{% endif %}{% if u.mail %} ({{ u.mail }}){% endif %}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold">Formule &amp; Type</div>
                <div class="card-body">
                    <label class="form-label mt-1">Type de promotion <span class="text-danger">*</span></label>
                    <select name="type_promotion_affaire" id="type_select" class="form-select mb-3" required>
                        <option value="produit_service">Produit / Service</option>
                        <option value="sites_applications">Sites &amp; Applications</option>
                        <option value="offre_emploi">Offre d'emploi</option>
                        <option value="dmd_emploi">Demande d'emploi</option>
                    </select>

                    <div id="formule_section">
                        <label class="form-label">Formule <span class="text-danger">*</span></label>
                        <select name="formule_id" id="formule_select" class="form-select mb-2">
                            <option value="">-- Choisir une formule --</option>
                            {% for f in formules %}
                                <option value="{{ f.id }}" data-jours="{{ f.nbrJour }}">
                                    {{ f.titre }} — {{ f.prix }} FCFA — {{ f.nbrJour }} jour(s)
                                </option>
                            {% endfor %}
                        </select>

                        <div id="expiration_info" class="alert alert-info py-2 mb-2" style="display:none;">
                            <i class="fas fa-calendar-check me-1"></i>
                            Date d'expiration calculée : <strong id="expiration_date"></strong>
                        </div>
                    </div>

                    <div id="sites_applications_section" style="display:none;">
                        <div class="alert alert-info py-2 mb-3">
                            <i class="fas fa-calendar-check me-1"></i>
                            Durée fixe : <strong>365 jours</strong> — Prix : <strong>7 750 FCFA</strong>
                        </div>

                        <label class="form-label">Sous-type <span class="text-danger">*</span></label>
                        <select name="sous_type_site_app" id="sous_type_select" class="form-select mb-3">
                            <option value="site_web">Site web</option>
                            <option value="app_mobile">Application mobile</option>
                            <option value="logiciel_desktop">Logiciel / Application desktop</option>
                        </select>

                        <label class="form-label">Nom du site / de l'application <span class="text-danger">*</span></label>
                        <input type="text" name="nom_site_app" id="nom_site_app" class="form-control mb-3" maxlength="150" placeholder="Ex : MonApplication">

                        <label class="form-label">URL <span class="text-danger">*</span></label>
                        <input type="url" name="url_site_app" id="url_site_app" class="form-control mb-1" placeholder="https://monsite.com">
                        <small class="text-muted d-block mb-2" id="url_site_app_help">Entrez l'URL de votre site ou application.</small>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold">Description</div>
                <div class="card-body">
                    <textarea name="description" class="form-control" rows="4" placeholder="Décrivez la promotion…" required></textarea>
                </div>
            </div>

        </div>

        {# Colonne droite : image #}
        <div class="col-md-5">

            <div class="card mb-3">
                <div class="card-header fw-semibold">Image <span class="text-danger">*</span> <span class="text-muted fw-normal small">(max 1 Mo)</span></div>
                <div class="card-body">
                    <input type="file" name="image" id="image_input" class="form-control mb-3" accept="image/*" required>

                    <div id="image_preview_wrapper" style="display:none;">
                        <p class="mb-1 small text-muted">Aperçu :</p>
                        <img id="image_preview"
                             src=""
                             alt="Aperçu"
                             style="max-width:100%; max-height:260px; border-radius:8px; border:1px solid #dee2e6; object-fit:contain;">
                        <div id="image_size_warning" class="alert alert-warning py-1 mt-2 small" style="display:none;">
                            <i class="fas fa-exclamation-triangle me-1"></i> Image trop grande (&gt; 1 Mo) — elle sera refusée.
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold">Récapitulatif</div>
                <div class="card-body small">
                    <table class="table table-sm mb-0">
                        <tr><td>Status</td><td><span class="badge bg-success">Acceptée (3)</span></td></tr>
                        <tr><td>Mode</td><td><span class="badge bg-secondary">Admin</span></td></tr>
                        <tr><td>Source</td><td><span class="badge bg-dark">admin</span></td></tr>
                        <tr><td>Date début</td><td>Maintenant</td></tr>
                        <tr><td>Date expiration</td><td id="recap_exp" class="text-muted">— choisir une formule —</td></tr>
                        <tr id="recap_soustype_row" style="display:none;"><td>Sous-type</td><td id="recap_soustype" class="text-muted">—</td></tr>
                        <tr id="recap_nom_row" style="display:none;"><td>Nom</td><td id="recap_nom" class="text-muted">—</td></tr>
                    </table>
                </div>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="fas fa-check-circle me-2"></i>Enregistrer la promotion
                </button>
            </div>
        </div>

    </div>

</form>
{% endblock %}

{% block script %}
<script>
(function () {

    // ── Prévisualisation image ──────────────────────────────────────
    var input   = document.getElementById('image_input');
    var wrapper = document.getElementById('image_preview_wrapper');
    var preview = document.getElementById('image_preview');
    var warning = document.getElementById('image_size_warning');

    input.addEventListener('change', function () {
        var file = this.files[0];
        if (!file) { wrapper.style.display = 'none'; return; }
        var reader = new FileReader();
        reader.onload = function (e) {
            preview.src = e.target.result;
            wrapper.style.display = 'block';
            warning.style.display = (file.size > 1 * 1024 * 1024) ? 'block' : 'none';
        };
        reader.readAsDataURL(file);
    });

    // ── Placeholders URL selon sous-type ───────────────────────────
    var urlPlaceholders = {
        'site_web':         'https://monsite.com',
        'app_mobile':       'https://play.google.com/... ou https://apps.apple.com/...',
        'logiciel_desktop': 'https://monlogiciel.com/telecharger'
    };
    var sousTypeLabels = {
        'site_web':         'Site web',
        'app_mobile':       'Application mobile',
        'logiciel_desktop': 'Logiciel / Desktop'
    };

    var sousTypeSelect  = document.getElementById('sous_type_select');
    var urlInput        = document.getElementById('url_site_app');
    var recapSoustypeRow = document.getElementById('recap_soustype_row');
    var recapSoustype    = document.getElementById('recap_soustype');

    if (sousTypeSelect) {
        sousTypeSelect.addEventListener('change', function () {
            if (urlInput) urlInput.placeholder = urlPlaceholders[this.value] || '';
            if (recapSoustype) recapSoustype.textContent = sousTypeLabels[this.value] || this.value;
        });
    }

    var nomInput    = document.getElementById('nom_site_app');
    var recapNomRow = document.getElementById('recap_nom_row');
    var recapNom    = document.getElementById('recap_nom');
    if (nomInput) {
        nomInput.addEventListener('input', function () {
            if (recapNom) recapNom.textContent = this.value || '—';
        });
    }

    // ── Basculement sections selon type ────────────────────────────
    var typeSelect        = document.getElementById('type_select');
    var formuleSection    = document.getElementById('formule_section');
    var siteAppSection    = document.getElementById('sites_applications_section');
    var formuleSelectEl   = document.getElementById('formule_select');
    var recapExp          = document.getElementById('recap_exp');

    function toggleSections() {
        var isSiteApp = (typeSelect.value === 'sites_applications');

        formuleSection.style.display  = isSiteApp ? 'none' : 'block';
        siteAppSection.style.display  = isSiteApp ? 'block' : 'none';

        // formule non requise pour sites_applications
        if (formuleSelectEl) formuleSelectEl.required = !isSiteApp;

        if (isSiteApp) {
            var d = new Date();
            d.setDate(d.getDate() + 365);
            recapExp.textContent = d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' }) + ' (365 jours)';
            if (recapSoustypeRow) recapSoustypeRow.style.display = '';
            if (recapNomRow)      recapNomRow.style.display      = '';
            // Initialiser les valeurs recap
            if (recapSoustype) recapSoustype.textContent = sousTypeLabels[sousTypeSelect.value] || '—';
            if (recapNom)      recapNom.textContent      = (nomInput && nomInput.value) ? nomInput.value : '—';
        } else {
            recapExp.textContent = '— choisir une formule —';
            if (recapSoustypeRow) recapSoustypeRow.style.display = 'none';
            if (recapNomRow)      recapNomRow.style.display      = 'none';
        }
    }

    typeSelect.addEventListener('change', toggleSections);
    toggleSections(); // init

    // ── Date d'expiration calculée (formule) ───────────────────────
    var infoBox  = document.getElementById('expiration_info');
    var expDate  = document.getElementById('expiration_date');

    if (formuleSelectEl) {
        formuleSelectEl.addEventListener('change', function () {
            var opt   = this.options[this.selectedIndex];
            var jours = parseInt(opt.getAttribute('data-jours'));
            if (!jours) { infoBox.style.display = 'none'; recapExp.textContent = '— choisir une formule —'; return; }

            var d = new Date();
            d.setDate(d.getDate() + jours);
            var label = d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });

            expDate.textContent  = label + ' (' + jours + ' jour' + (jours > 1 ? 's' : '') + ')';
            recapExp.textContent = label;
            infoBox.style.display = 'block';
        });
    }

})();
</script>
{% endblock %}
