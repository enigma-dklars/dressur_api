{% extends 'basePrivate.html.twig' %}

{% block title %}Promotion index{% endblock %}

{% block body %}
    <h1>Promotion index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Description</th>
                <th>Image</th>
                <th>DateDebut</th>
                <th>DateExp</th>
                <th>Status</th>
                <th>NombreDeVue</th>
                <th>Mode</th>
                <th>NombreImpression</th>
                <th>Limited</th>
                <th>WhoSaw</th>
                <th>Motif</th>
                <th>IsFakeVue</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for promotion in promotions %}
            <tr>
                <td>{{ promotion.id }}</td>
                <td>{{ promotion.description }}</td>
                <td>{{ promotion.image }}</td>
                <td>{{ promotion.dateDebut ? promotion.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ promotion.dateExp ? promotion.dateExp|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ promotion.status }}</td>
                <td>{{ promotion.nombreDeVue }}</td>
                <td>{{ promotion.mode }}</td>
                <td>{{ promotion.nombreImpression }}</td>
                <td>{{ promotion.limited ? 'Yes' : 'No' }}</td>
                <td>{{ promotion.whoSaw ? promotion.whoSaw|json_encode : '' }}</td>
                <td>{{ promotion.motif }}</td>
                <td>{{ promotion.isFakeVue ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_crud_promotion_show', {'id': promotion.id}) }}">show</a>
                    <a href="{{ path('app_crud_promotion_edit', {'id': promotion.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="14">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_crud_promotion_new') }}">Create new</a>
{% endblock %}
