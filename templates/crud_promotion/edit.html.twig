{% extends 'baseAdmin.html.twig' %}

    {% block title %}Modifier la promotion #{{ promotion.id }}{% endblock %}

    {% block body %}
    {% set info = promotion.annotherInfo|default({}) %}
    {% set currentName = promotion.nomSiteApp|default(info.nomSiteApp|default(info.nom|default(''))) %}
    {% set currentUrl = promotion.urlSiteApp|default(info.urlSiteApp|default(info.url|default(''))) %}
    {% set currentSubtype = promotion.sousTypeSiteApp|default(info.sousTypeSiteApp|default(info.sousType|default('site_web'))) %}
    {% set submitted = formData|default({})|length > 0 %}
    {% set selectedUserId = submitted ? formData.user_id|default('') : (promotion.user ? promotion.user.id : '') %}
    {% set selectedFormulaId = submitted ? formData.formule_id|default('') : (promotion.formulePromoAffaire ? promotion.formulePromoAffaire.id : '') %}
    {% set selectedType = submitted ? formData.type_promotion_affaire|default('') : promotion.typePromotionAffaire %}
    {% set selectedStatus = submitted ? formData.status|default('') : promotion.status %}
    {% set selectedMode = submitted ? formData.mode|default('') : promotion.mode %}
    {% set selectedSource = submitted ? formData.source|default('') : promotion.source|default('') %}
    {% set currentName = submitted ? formData.nom_site_app|default('') : promotion.nomSiteApp|default(info.nomSiteApp|default(info.nom|default(''))) %}
    {% set currentUrl = submitted ? formData.url_site_app|default('') : promotion.urlSiteApp|default(info.urlSiteApp|default(info.url|default(''))) %}
    {% set currentSubtype = submitted ? formData.sous_type_site_app|default('') : promotion.sousTypeSiteApp|default(info.sousTypeSiteApp|default(info.sousType|default('site_web'))) %}
    {% set siteApp = selectedType == 'sites_applications' %}
    {% set dateDebutValue = submitted ? formData.date_debut|default('') : (promotion.dateDebut ? promotion.dateDebut|date('Y-m-d\TH:i') : '') %}
    {% set dateExpValue = submitted ? formData.date_exp|default('') : (promotion.dateExp ? promotion.dateExp|date('Y-m-d\TH:i') : '') %}
    {% set descriptionValue = submitted ? formData.description|default('') : promotion.description|default('') %}
    {% set motifValue = submitted ? formData.motif|default('') : promotion.motif|default('') %}
    {% set whatsappValue = submitted ? formData.whatsapp_contact|default('') : promotion.whatsappContact|default('') %}
    {% set checkedReferencement = submitted ? (formData.referencement is defined) : checkedReferencement %}
    {% set checkedReward = submitted ? (formData.in_programme_recompense is defined) : checkedReward %}
    {% set checkedDressurStatus = submitted ? (formData.publish_on_dressur_status is defined) : checkedDressurStatus %}
    {% set checkedFacebook = submitted ? (formData.boost_facebook is defined) : checkedFacebook %}
    {% set checkedLimited = submitted ? (formData.limited is defined) : checkedLimited %}
    {% set checkedFakeView = submitted ? (formData.is_fake_vue is defined) : checkedFakeView %}
    {% set siteApp = promotion.typePromotionAffaire == 'sites_applications' %}
    {% set dateDebutValue = promotion.dateDebut ? promotion.dateDebut|date('Y-m-d\TH:i') : '' %}
    {% set dateExpValue = promotion.dateExp ? promotion.dateExp|date('Y-m-d\TH:i') : '' %}

    <div class="row g-2 mb-3 align-items-center">
      <div class="col"><span class="h4">Modifier la promotion #{{ promotion.id }}</span></div>
      <div class="col-auto"><a href="{{ path('app_crud_promotion_index') }}" class="btn btn-sm btn-secondary">← Retour à la liste</a></div>
    </div>

    {% if errors|length > 0 %}
    <div class="alert alert-danger"><ul class="mb-0">{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>
    {% endif %}

    <form method="post" action="{{ path('app_crud_promotion_edit', {id: promotion.id}) }}" enctype="multipart/form-data">
      <input type="hidden" name="_token" value="{{ csrf_token('edit' ~ promotion.id) }}">
      <div class="row g-3">
          <div class="col-lg-7">
              <div class="card mb-3"><div class="card-header fw-semibold">Bénéficiaire</div><div class="card-body">
                  <label class="form-label">Utilisateur <span class="text-danger">*</span></label>
                  <select name="user_id" class="form-select" required>
                      {% for u in users %}<option value="{{ u.id }}"{% if selectedUserId == u.id %} selected{% endif %}>{{ u.pseudo }}{% if u.nom %} — {{ u.nom }}{% endif %}{% if u.mail %} ({{ u.mail }}){% endif %}</option>{% endfor %}
                  </select>
              </div></div>

              <div class="card mb-3"><div class="card-header fw-semibold">Type et formule</div><div class="card-body">
                  <label class="form-label">Type de promotion <span class="text-danger">*</span></label>
                  <select name="type_promotion_affaire" id="type_select" class="form-select mb-3" required>
                    {% for label, value in {"Produit / Service":"produit_service","Sites & Applications":"sites_applications","Offre d'emploi":"offre_emploi","Demande d'emploi":"dmd_emploi"} %}<option value="{{ value }}"{% if selectedType == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
                  </select>
                  <div id="formule_section">
                      <label class="form-label">Formule <span class="text-danger">*</span></label>
                      <select name="formule_id" id="formule_select" class="form-select">
                          <option value="">-- Choisir une formule --</option>
                          {% for f in formules %}<option value="{{ f.id }}" data-jours="{{ f.nbrJour }}"{% if selectedFormulaId == f.id %} selected{% endif %}>{{ f.titre }} — {{ f.prix }} FCFA — {{ f.nbrJour }} jour(s)</option>{% endfor %}
                      </select>
                  </div>
                  <div id="sites_applications_section" class="mt-3">
                      <label class="form-label">Sous-type <span class="text-danger">*</span></label>
                      <select name="sous_type_site_app" id="sous_type_select" class="form-select mb-3">
                          <option value="site_web"{% if currentSubtype == 'site_web' %} selected{% endif %}>Site web</option>
                          <option value="app_mobile"{% if currentSubtype == 'app_mobile' %} selected{% endif %}>Application mobile</option>
                          <option value="logiciel_desktop"{% if currentSubtype == 'logiciel_desktop' %} selected{% endif %}>Logiciel / Application desktop</option>
                      </select>
                      <label class="form-label">Nom du site ou de l’application <span class="text-danger">*</span></label>
                      <input type="text" name="nom_site_app" id="nom_site_app" class="form-control mb-3" value="{{ currentName }}" maxlength="255">
                      <label class="form-label">URL <span class="text-danger">*</span></label>
                      <input type="url" name="url_site_app" id="url_site_app" class="form-control" value="{{ currentUrl }}" placeholder="https://exemple.com">
                  </div>
              </div></div>

              <div class="card mb-3"><div class="card-header fw-semibold">Description</div><div class="card-body">
                  <textarea name="description" class="form-control" rows="7" required>{{ descriptionValue }}</textarea>
              </div></div>

              <div class="card mb-3"><div class="card-header fw-semibold">Statut et options</div><div class="card-body">
                  <div class="row g-2">
                      <div class="col-md-4"><label class="form-label">Statut</label><select name="status" class="form-select"><option value="0"{% if selectedStatus == 0 %} selected{% endif %}>Refusée</option><option value="1"{% if selectedStatus == 1 %} selected{% endif %}>En attente</option><option value="2"{% if selectedStatus == 2 %} selected{% endif %}>En cours</option><option value="3"{% if selectedStatus == 3 %} selected{% endif %}>Acceptée</option></select></div>
                      <div class="col-md-4"><label class="form-label">Mode</label><select name="mode" class="form-select"><option value="Admin"{% if selectedMode == 'Admin' %} selected{% endif %}>Admin</option><option value="Web"{% if selectedMode == 'Web' %} selected{% endif %}>Web</option><option value="Mobile"{% if selectedMode == 'Mobile' %} selected{% endif %}>Mobile</option></select></div>
                      <div class="col-md-4"><label class="form-label">Source</label><select name="source" class="form-select"><option value="admin"{% if selectedSource == 'admin' %} selected{% endif %}>Admin</option><option value="web"{% if selectedSource == 'web' %} selected{% endif %}>Web</option><option value="mobile"{% if selectedSource == 'mobile' %} selected{% endif %}>Mobile</option></select></div>
                  </div>
                  <div class="row g-2 mt-2"><div class="col-md-6"><label class="form-label">Date de début</label><input type="datetime-local" name="date_debut" class="form-control" value="{{ dateDebutValue }}" required></div><div class="col-md-6"><label class="form-label">Date d’expiration</label><input type="datetime-local" name="date_exp" class="form-control" value="{{ dateExpValue }}" required></div></div>
                  <div class="mt-3"><label class="form-label">Motif</label><textarea name="motif" class="form-control" rows="2">{{ motifValue }}</textarea></div>
                  <div class="mt-3"><label class="form-label">WhatsApp de contact</label><input type="text" name="whatsapp_contact" class="form-control" value="{{ whatsappValue }}"></div>
                  <div class="row mt-3">
                      <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="referencement"{% if checkedReferencement %} checked{% endif %}><label class="form-check-label">Référencement</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="in_programme_recompense"{% if checkedReward %} checked{% endif %}><label class="form-check-label">Programme de récompense</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="publish_on_dressur_status"{% if checkedDressurStatus %} checked{% endif %}><label class="form-check-label">Publier dans Dressur Status</label></div></div>
                      <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="boost_facebook"{% if checkedFacebook %} checked{% endif %}><label class="form-check-label">Promotion Facebook</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="limited"{% if checkedLimited %} checked{% endif %}><label class="form-check-label">Promotion limitée</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="is_fake_vue"{% if checkedFakeView %} checked{% endif %}><label class="form-check-label">Fausse vue</label></div></div>
                  </div>
              </div></div>
          </div>

          <div class="col-lg-5">
              <div class="card mb-3"><div class="card-header fw-semibold">Image <span class="text-muted fw-normal small">(facultative, max 1 Mo)</span></div><div class="card-body">
                  <p class="small text-muted mb-2">Image actuelle :</p><img src="{{ asset('promotion/' ~ promotion.image) }}" alt="Image actuelle" class="img-fluid rounded mb-3" style="max-height:260px; object-fit:contain;">
                  <input type="file" name="image" id="image_input" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp">
                  <div id="image_preview_wrapper" class="mt-3" style="display:none"><p class="small text-muted mb-1">Nouvel aperçu :</p><img id="image_preview" src="" alt="Nouvel aperçu" class="img-fluid rounded" style="max-height:260px; object-fit:contain;"><div id="image_size_warning" class="alert alert-warning py-1 mt-2 small" style="display:none">Image trop grande (&gt; 1 Mo).</div></div>
              </div></div>
              <div class="card mb-3"><div class="card-header fw-semibold">Récapitulatif</div><div class="card-body small"><table class="table table-sm mb-0"><tr><td>Type</td><td id="recap_type">{{ selectedType }}</td></tr><tr id="recap_sous_type_row"{% if not siteApp %} style="display:none"{% endif %}><td>Sous-type</td><td id="recap_sous_type">{{ currentSubtype }}</td></tr><tr id="recap_nom_row"{% if not siteApp %} style="display:none"{% endif %}><td>Nom</td><td id="recap_nom">{{ currentName|default('—') }}</td></tr><tr id="recap_url_row"{% if not siteApp %} style="display:none"{% endif %}><td>URL</td><td id="recap_url">{{ currentUrl|default('—') }}</td></tr><tr><td>Statut</td><td id="recap_status">{{ promotion.status }}</td></tr><tr><td>Début</td><td>{{ promotion.dateDebut ? promotion.dateDebut|date('d/m/Y H:i') : '—' }}</td></tr><tr><td>Expiration</td><td>{{ promotion.dateExp ? promotion.dateExp|date('d/m/Y H:i') : '—' }}</td></tr><tr><td>Formule</td><td>{{ promotion.formulePromoAffaire ? promotion.formulePromoAffaire.titre : 'Aucune' }}</td></tr><tr><td>Source</td><td>{{ selectedSource|default('—') }}</td></tr></table></div></div>
              <div class="d-grid"><button type="submit" class="btn btn-success btn-lg"><i class="fas fa-save me-2"></i>Enregistrer les modifications</button></div>
          </div>
      </div>
    </form>
    {% endblock %}

    {% block script %}
    <script>
    (function () {
      var input = document.getElementById('image_input');
      var wrapper = document.getElementById('image_preview_wrapper');
      var preview = document.getElementById('image_preview');
      var warning = document.getElementById('image_size_warning');
      if (input) input.addEventListener('change', function () {
          var file = this.files[0];
          if (!file) { wrapper.style.display = 'none'; return; }
          var reader = new FileReader();
          reader.onload = function (event) { preview.src = event.target.result; wrapper.style.display = 'block'; warning.style.display = file.size > 1048576 ? 'block' : 'none'; };
          reader.readAsDataURL(file);
      });
      var typeSelect = document.getElementById('type_select');
      var formulaSection = document.getElementById('formule_section');
      var formulaSelect = document.getElementById('formule_select');
      var siteSection = document.getElementById('sites_applications_section');
      var subtype = document.getElementById('sous_type_select');
      var name = document.getElementById('nom_site_app');
      var url = document.getElementById('url_site_app');
      var rows = [document.getElementById('recap_sous_type_row'), document.getElementById('recap_nom_row'), document.getElementById('recap_url_row')];
      function toggle() {
          var isSite = typeSelect.value === 'sites_applications';
          formulaSection.style.display = isSite ? 'none' : 'block';
          siteSection.style.display = isSite ? 'block' : 'none';
          formulaSelect.required = !isSite;
          subtype.required = isSite; name.required = isSite; url.required = isSite;
          rows.forEach(function (row) { if (row) row.style.display = isSite ? '' : 'none'; });
          document.getElementById('recap_type').textContent = typeSelect.options[typeSelect.selectedIndex].text;
          document.getElementById('recap_sous_type').textContent = subtype.options[subtype.selectedIndex].text;
          document.getElementById('recap_nom').textContent = name.value || '—';
          document.getElementById('recap_url').textContent = url.value || '—';
      }
      typeSelect.addEventListener('change', toggle); subtype.addEventListener('change', toggle); name.addEventListener('input', toggle); url.addEventListener('input', toggle); toggle();
    })();
    </script>
    {% endblock %}
    