{% extends 'basePrivate.html.twig' %}

{% block title %}PromoReseau index{% endblock %}

{% block body %}
    <h1>PromoReseau index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>QteDemander</th>
                <th>PrixFixer</th>
                <th>Url</th>
                <th>Status</th>
                <th>IdZefame</th>
                <th>CompteurDebut</th>
                <th>CompteurRestant</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for promo_reseau in promo_reseaus %}
            <tr>
                <td>{{ promo_reseau.id }}</td>
                <td>{{ promo_reseau.qteDemander }}</td>
                <td>{{ promo_reseau.prixFixer }}</td>
                <td>{{ promo_reseau.url }}</td>
                <td>{{ promo_reseau.status }}</td>
                <td>{{ promo_reseau.idZefame }}</td>
                <td>{{ promo_reseau.compteurDebut }}</td>
                <td>{{ promo_reseau.compteurRestant }}</td>
                <td>{{ promo_reseau.createdAt ? promo_reseau.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ promo_reseau.updatedAt ? promo_reseau.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_crud_promo_reseau_show', {'id': promo_reseau.id}) }}">show</a>
                    <a href="{{ path('app_crud_promo_reseau_edit', {'id': promo_reseau.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_crud_promo_reseau_new') }}">Create new</a>
{% endblock %}
