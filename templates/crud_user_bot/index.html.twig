{% extends 'basePrivate.html.twig' %}

{% block title %}UserBot index{% endblock %}

{% block body %}
    <h1>UserBot index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Numero</th>
                <th>AdresseMac</th>
                <th>UuidMachine</th>
                <th>DiskSerialNumber</th>
                <th>CreatedAt</th>
                <th>ExpiratedAt</th>
                <th>TypeMachine</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user_bot in user_bots %}
            <tr>
                <td>{{ user_bot.id }}</td>
                <td>{{ user_bot.nom }}</td>
                <td>{{ user_bot.email }}</td>
                <td>{{ user_bot.numero }}</td>
                <td>{{ user_bot.adresseMac }}</td>
                <td>{{ user_bot.uuidMachine }}</td>
                <td>{{ user_bot.diskSerialNumber }}</td>
                <td>{{ user_bot.createdAt ? user_bot.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ user_bot.expiratedAt ? user_bot.expiratedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ user_bot.typeMachine }}</td>
                <td>
                    <a href="{{ path('app_crud_user_bot_show', {'id': user_bot.id}) }}">show</a>
                    <a href="{{ path('app_crud_user_bot_edit', {'id': user_bot.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_crud_user_bot_new') }}">Create new</a>
{% endblock %}
