{% extends 'basePrivate.html.twig' %}

{% block title %}UserBot index{% endblock %}

{% block body %}
    <p class="h4 me-3">UserBot index</p>
    {# <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_user_bot_new') }}">Create new</a> #}

    <div class="table-responsive">
        <table class="data-table table table-bordered table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Numero</th>
                    <th>Signature</th>
                    <th>NbrMsg</th>
                    <th>UpdatedAt</th>
                    <th>ExpiratedAt</th>
                    <th>CreatedAt</th>
                </tr>
            </thead>
            <tbody>
            {% for user_bot in user_bots %}
                <tr>
                    <td>{% include "crud_user_bot/_delete_form.html.twig" %}</td>
                    <td>{{ user_bot.id }}</td>
                    <td>{{ user_bot.nom }}</td>
                    <td>{{ user_bot.email }}</td>
                    <td>{{ user_bot.numero }}</td>
                    <td>{{ user_bot.signature }}</td>
                    <td>{{ user_bot.nbrMsgSent }}</td>
                    <td>{{ user_bot.updatedAt ? user_bot.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ user_bot.expiratedAt ? user_bot.expiratedAt|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ user_bot.createdAt ? user_bot.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="10">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}
