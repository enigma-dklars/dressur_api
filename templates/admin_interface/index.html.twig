{% extends 'base.html.twig' %}

{% block title %}Admin Interface Controller{% endblock %}

{% block body %}
    <div class="row g-2 border p-1 rounded border-danger fw-semibold pb-2">
        <div class="col-1"> <label for="" class="small text-danger">Com. Bonus</label> <input type="text" class="text-danger form-control form-control-sm" placeholder="Com. Bonus" value="{{env.commissionBonus}}" id="commissionBonus"> </div>
        <div class="col-1"> <label for="" class="small text-danger">Version App</label> <input type="text" class="text-danger form-control form-control-sm" placeholder="Version App" value="{{env.versionApp}}" id="versionApp"> </div>
        <div class="col-1"> <label for="" class="small text-danger">Update ?</label> <input type="text" class="text-danger form-control form-control-sm" placeholder="Update ?" value="{% if env.importantUpdate %}1{% else %}0{% endif %}" id="importantUpdate"> </div>
        <div class="col-1"> <label for="" class="small text-danger">Do Boost ?</label> <input type="text" class="text-danger form-control form-control-sm" placeholder="Do Boost ?" value="{% if env.doBoostPayant %}1{% else %}0{% endif %}" id="doBoostPayant"> </div>
        <div class="col-7"> <label for="" class="small text-danger">Link Local Server</label> <input type="text" class="text-danger form-control form-control-sm" placeholder="Link Local Server" value="{{env.linkLocalServer}}" id="linkLocalServer"> </div>
        <div class="col-1"> <br> <button class="btn btn-danger btn-sm w-100 fw-semibold" id="envButtonOK">OK</button> </div>
    </div> <br>
    <div class="row g-2 border p-1 rounded border-danger fw-semibold">
        <div class="col-md-3 p-0">
            <div class="accordion" id="accordionVerifNum">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseVerifNum" aria-expanded="true" aria-controls="collapseVerifNum">
                            Verif Num.
                        </button>
                    </h2>
                    <div id="collapseVerifNum" class="accordion-collapse collapse show" data-bs-parent="#accordionVerifNum">
                        <div class="accordion-body p-1">
                            <div class="row g-2">
                                {% for user in users %}
                                    <div class="col-12">
                                        <div class="card">
                                            <div class="card-body">
                                                Pseudo : {{ user.pseudo }} <br>
                                                Tel : {{ user.tel }} <br>
                                                Mail : {{ user.mail }} <br>
                                                CreatedAt : {{ user.createdAt ? user.createdAt|date('Y-m-d H:i:s') : '' }} <br>
                                                <a class="btn btn-sm btn-primary mb-1 me-2" target="_blank" href="https://wa.me/{{user.tel}}">Tester</a> 
                                                <a class="btn btn-sm btn-success mb-1 me-2" target="_blank" href="{{ path('app_admin_user_valider', {'id': user.id}) }}">Valider</a> 
                                                <a class="btn btn-sm btn-danger mb-1 me-2" target="_blank" href="{{ path('app_admin_user_rejeter', {'id': user.id}) }}">Rejeter</a> 
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="col-12">
                                        <h3 class="text-center text-danger mt-5">
                                            RIEN
                                        </h3>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
              </div>
        </div>
        <div class="col-md-3 p-0">
            <div class="accordion" id="accordionVerifPromo">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseVerifPromo" aria-expanded="true" aria-controls="collapseVerifPromo">
                            Verif Promo.
                        </button>
                    </h2>
                    <div id="collapseVerifPromo" class="accordion-collapse collapse show" data-bs-parent="#accordionVerifPromo">
                        <div class="accordion-body p-1">
                             <div class="row g-2">
                                    {% for promotion in promotions %}
                                        <div class="col-12">
                                            <div class="card">
                                                <img src="/promotion/{{promotion.image}}" class="card-img-top" alt="...">
                                                <div class="card-body">
                                                <p class="card-text">
                                                    {{ promotion.description|nl2br }}
                                                </p>
                                                <a class="btn btn-sm btn-success mb-1 me-2" target="_blank" href="{{ path('app_admin_promotion_valider', {'id': promotion.id}) }}">Valider</a> 
                                                <a class="btn btn-sm btn-danger mb-1 me-2" target="_blank" href="{{ path('app_admin_promotion_rejeter', {'id': promotion.id}) }}">Rejeter</a>
                                                </div>
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="col-12">
                                            <h3 class="text-center text-danger mt-5">
                                                RIEN
                                            </h3>
                                        </div>
                                    {% endfor %}
                                </div>
                        </div>
                    </div>
                </div>
              </div>
        </div>
        <div class="col-md-3 p-0">
            <div class="accordion" id="accordionVerifMail">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseVerifMail" aria-expanded="true" aria-controls="collapseVerifMail">
                            Verif Mail.
                        </button>
                    </h2>
                    <div id="collapseVerifMail" class="accordion-collapse collapse show" data-bs-parent="#accordionVerifMail">
                        <div class="accordion-body">
                            Body Verif Mail.
                        </div>
                    </div>
                </div>
              </div>
        </div>
        <div class="col-md-3 p-0">
            <div class="accordion" id="accordionVerifSMS">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseVerifSMS" aria-expanded="true" aria-controls="collapseVerifSMS">
                            Verif SMS.
                        </button>
                    </h2>
                    <div id="collapseVerifSMS" class="accordion-collapse collapse show" data-bs-parent="#accordionVerifSMS">
                        <div class="accordion-body">
                            Body Verif SMS.
                        </div>
                    </div>
                </div>
              </div>
        </div>
    </div>
{% endblock %}

{% block jquery %}
    <script src="/jquery/admin.js"></script>
{% endblock %}