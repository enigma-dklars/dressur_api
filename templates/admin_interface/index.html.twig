{% extends 'base.html.twig' %}

{% block title %}Admin Interface Controller{% endblock %}

{% block body %}
    <div class="row g-2 border p-1 rounded border-danger fw-semibold pb-2">
        <div class="col-md-1"> <label for="" class="small text-danger">Com. Bonus</label> <input type="text" class="text-danger form-control form-control-sm" placeholder="Com. Bonus" value="{{env.commissionBonus}}" id="commissionBonus"> </div>
        <div class="col-md-1"> <label for="" class="small text-danger">Version App</label> <input type="text" class="text-danger form-control form-control-sm" placeholder="Version App" value="{{env.versionApp}}" id="versionApp"> </div>
        <div class="col-md-1"> <label for="" class="small text-danger">Update ?</label> <input type="text" class="text-danger form-control form-control-sm" placeholder="Update ?" value="{% if env.importantUpdate %}1{% else %}0{% endif %}" id="importantUpdate"> </div>
        <div class="col-md-1"> <label for="" class="small text-danger">Do Boost ?</label> <input type="text" class="text-danger form-control form-control-sm" placeholder="Do Boost ?" value="{% if env.doBoostPayant %}1{% else %}0{% endif %}" id="doBoostPayant"> </div>
        <div class="col-md-7"> <label for="" class="small text-danger">Link Local Server</label> <input type="text" class="text-danger form-control form-control-sm" placeholder="Link Local Server" value="{{env.linkLocalServer}}" id="linkLocalServer"> </div>
        <div class="col-md-1"> <br> <button class="btn btn-danger btn-sm w-100 fw-semibold" id="envButtonOK">OK</button> </div>
    </div>
{% endblock %}

{% block jquery %}
    <script src="/jquery/admin.js"></script>
{% endblock %}