{% extends 'basePrivate.html.twig' %}

{% block title %}MethodePaiement index{% endblock %}

{% block body %}
    <div class="row g-2 mb-2">
        <div class="col-6"><p class="h4 me-3">Methode Paiement</p></div>
        <div class="col-6 text-end"><a href="{{ path('app_methode_paiement_new') }}" class="btn btn-sm btn-primary">Create new</a></div>
    </div>

    <div class="table-responsive">
        <table class="data-table table table-bordered table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th>Id</th>
                    <th>Pays</th>
                    <th>Titre</th>
                    <th>Code</th>
                    <th>Aggregator</th>
                    <th>Activated</th>
                    <th>Isdirect</th>
                    <th>Autre Un</th>
                    <th>Requires</th>
                </tr>
            </thead>
            <tbody>
            {% for methode_paiement in methode_paiements %}
                <tr>
                    <td>
                        {{ include('crud_methode_paiement/_delete_form.html.twig') }}
                    </td>
                    <td>{{ methode_paiement.id }}</td>
                    <td>{{ methode_paiement.pays }}</td>
                    <td>{{ methode_paiement.titre }}</td>
                    <td>{{ methode_paiement.code }}</td>
                    <td>{{ methode_paiement.aggregator }}</td>
                    <td class="text-center">
                        {% if methode_paiement.activated == true %}
                            <span class="badge bg-success">Yes</span>
                        {% else %}
                            <span class="badge bg-danger">No</span>
                        {% endif %}
                    </td>
                    <td class="text-center">
                        {% if methode_paiement.isdirect == true %}
                            <span class="badge bg-success">Yes</span>
                        {% else %}
                            <span class="badge bg-danger">No</span>
                        {% endif %}
                    </td>
                    <td class="text-center">
                        {% if methode_paiement.autreMethodeUn is not null %}
                            <span class="badge bg-success">Yes</span> | {{methode_paiement.autreMethodeUn.id}}
                        {% else %}
                            <span class="badge bg-danger">No</span>
                        {% endif %}
                    </td>
                    <td>{{ methode_paiement.requires ? methode_paiement.requires|join(', ') : '' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
