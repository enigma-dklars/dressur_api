{% extends 'basePrivate.html.twig' %}

{% block title %}Preuve{% endblock %}

{% block body %}
    <h1>Preuve</h1>

    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ preuve.id }}</td>
            </tr>
            <tr>
                <th>CaptureListeStatut</th>
                <td>{{ preuve.captureListeStatut }}</td>
            </tr>
            <tr>
                <th>CaptureStatutOuvert</th>
                <td>{{ preuve.captureStatutOuvert }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ preuve.createdAt ? preuve.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ preuve.updatedAt ? preuve.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_preuve_index') }}">back to list</a>

    <a href="{{ path('app_preuve_edit', {'id': preuve.id}) }}">edit</a>

    {{ include('preuve/_delete_form.html.twig') }}
{% endblock %}
