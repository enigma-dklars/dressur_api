{% extends 'baseAdmin.html.twig' %}

{% block title %}Preuve index
{% endblock %}

{% block body %}
	<div class="">
		<div class="row mb-3 align-items-center">
			<div class="col-md-6">
				<p class="h4 me-3">Liste des Preuves</p>
			</div>
			<div class="col-md-6 text-end">
				<a href="{{ path('app_preuve_new') }}" class="btn btn-primary">Nouvelle preuve</a>
			</div>
		</div>

		<div class="table-responsive">
            <table class="data-table table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Actions</th>
                        <th>Id</th>
                        <th>User</th>
                        <th>Historique</th>
                        <th>Capture Liste</th>
                        <th>Capture Ouvert</th>
                        <th>Traitée</th>
                        <th>Créé le</th>
                        <th>Modifié le</th>
                    </tr>
                </thead>
                <tbody>
                    {% for preuve in preuves %}
                        <tr>
                            <td>
                                {% include "preuve/_delete_form.html.twig" with {'preuve': preuve} %}
                            </td>

                            <td>{{ preuve.id }}</td>

                            <!-- USER -->
                            <td>
                                {% if preuve.user %}
                                    <span class="badge bg-primary">
                                        {{ preuve.user.pseudo }}
                                    </span>
                                {% else %}
                                    <span class="badge bg-danger">Aucun user</span>
                                {% endif %}
                            </td>

                            <!-- HISTORIQUE -->
                            <td>
                                {% if preuve.historiqueProgrammeRecompense %}
                                    <span class="badge bg-info">
                                        #{{ preuve.historiqueProgrammeRecompense.id }}
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary">Non lié</span>
                                {% endif %}
                            </td>

                            <!-- IMAGE 1 -->
                            <td class="text-center">
                                {% if preuve.captureListeStatut %}
                                    <a href="{{ asset('preuve_recompense/' ~ preuve.captureListeStatut) }}" target="_blank">
                                        <img src="{{ asset('preuve_recompense/' ~ preuve.captureListeStatut) }}" class="img-fluid rounded" style="max-width:100px;">
                                    </a>
                                {% else %}
                                    <span class="badge bg-danger">Non fourni</span>
                                {% endif %}
                            </td>

                            <!-- IMAGE 2 -->
                            <td class="text-center">
                                {% if preuve.captureStatutOuvert %}
                                    <a href="{{ asset('preuve_recompense/' ~ preuve.captureStatutOuvert) }}" target="_blank">
                                        <img src="{{ asset('preuve_recompense/' ~ preuve.captureStatutOuvert) }}" class="img-fluid rounded" style="max-width:100px;">
                                    </a>
                                {% else %}
                                    <span class="badge bg-danger">Non fourni</span>
                                {% endif %}
                            </td>

                            <!-- IS TREATED -->
                            <td class="text-center">
                                {% if preuve.isTreated %}
                                    <span class="badge bg-success">Traitée</span>
                                {% else %}
                                    <span class="badge bg-warning text-dark">En attente</span>
                                {% endif %}
                            </td>

                            <td>{{ preuve.createdAt ? preuve.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                            <td>{{ preuve.updatedAt ? preuve.updatedAt|date('Y-m-d H:i:s') : '' }}</td>

                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="text-center">Aucun enregistrement trouvé</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
	</div>
{% endblock %}
