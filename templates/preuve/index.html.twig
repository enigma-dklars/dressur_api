{% extends 'basePrivate.html.twig' %}

{% block title %}Preuve index{% endblock %}

{% block body %}
<div class="">
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <p class="h4 me-3">Liste des Preuves</p>
        </div>
        <div class="col-md-6 text-end">
            <a href="{{ path('app_preuve_new') }}" class="btn btn-success">+ Nouvelle preuve</a>
        </div>
    </div>

    <table class="data-table table table-bordered table-striped">
        <thead>
            <tr>
                <th>Actions</th>
                <th>Id</th>
                <th>Capture Liste Statut</th>
                <th>Capture Statut Ouvert</th>
                <th>Créé le</th>
                <th>Modifié le</th>
            </tr>
        </thead>
        <tbody>
            {% for preuve in preuves %}
                <tr>
                    <td>
                        {% include "preuve/_delete_form.html.twig" with {'preuve': preuve} %}
                    </td>
                    <td>{{ preuve.id }}</td>

                    <td class="text-center">
                        {% if preuve.captureListeStatut %}
                            <span class="badge bg-success">Disponible</span>
                        {% else %}
                            <span class="badge bg-danger">Non fourni</span>
                        {% endif %}
                    </td>

                    <td class="text-center">
                        {% if preuve.captureStatutOuvert %}
                            <span class="badge bg-success">Disponible</span>
                        {% else %}
                            <span class="badge bg-danger">Non fourni</span>
                        {% endif %}
                    </td>

                    <td>{{ preuve.createdAt ? preuve.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ preuve.updatedAt ? preuve.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
        </tbody> 
    </table>
</div>
{% endblock %}
