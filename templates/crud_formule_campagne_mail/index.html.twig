{% extends 'basePrivate.html.twig' %}

{% block title %}FormuleCampagneMail index{% endblock %}

{% block body %}
    <span class="h4 me-3">FormuleCampagneMail index</span>
    <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_formule_campagne_mail_new') }}">Create new</a>

    <table class="data-table table table-bordered table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Prix</th>
                <th>Nombre_mail</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for formule_campagne_mail in formule_campagne_mails %}
            <tr>
                <td>{{ formule_campagne_mail.id }}</td>
                <td>{{ formule_campagne_mail.titre }}</td>
                <td>{{ formule_campagne_mail.prix }}</td>
                <td>{{ formule_campagne_mail.nombreMail }}</td>
                <td>
                    {% include "crud_formule_campagne_mail/_delete_form.html.twig" %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
