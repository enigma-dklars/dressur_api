{% extends 'baseAdmin.html.twig' %}

{% block title %}Signalement index{% endblock %}

{% block body %}
    <p class="h4 me-3">Signalement index</p>
    {# <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_signalement_new') }}">Create new</a> #}

    <table class="data-table table table-bordered table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Motif</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for signalement in signalements %}
            <tr>
                <td>{{ signalement.id }}</td>
                <td>{{ signalement.motif|nl2br }}</td>
                <td>
                    {% include "crud_signalement/_delete_form.html.twig" %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
