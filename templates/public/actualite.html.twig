{% extends 'base.html.twig' %}

{% set description = "Découvrez les derniers produits, services et propositions des utilisateurs de Dressur. Restez informé sur les nouveautés et les initiatives au sein de notre communauté." %}
{% set title = "Actualités" %}
{% block referencement %}
    <meta property="og:title" content="{{title}} | Dressur Web" />
    <meta property="og:description" content="{{description}}" />
    <meta property="og:image" content="https://dressur.site/assets/img/og/og-actualite.jpg" />
    <meta property="og:url" content="{{ url('app_actualite') }}" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{title}} | Dressur Web" />
    <meta name="twitter:description" content="{{description}}" />
    <meta name="twitter:image" content="https://dressur.site/assets/img/og/og-actualite.jpg" />
    <meta name="description" content="{{description}}" />
    <meta name="keywords" content="actualités Dressur, nouveautés Dressur, promotions Dressur, annonces Dressur, communauté Dressur, produits Dressur, services Dressur" />
{% endblock %}

{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Actualités Dressur",
  "description": "{{ description }}",
  "url": "{{ url('app_actualite') }}",
  "publisher": {
    "@type": "Organization",
    "name": "Dressur",
    "@id": "https://dressur.site/#organization"
  },
  "mainEntity": {
    "@type": "ItemList",
    "name": "Promotions Affaires des utilisateurs Dressur",
    "itemListElement": [
      {% for actu in actus %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "url": "https://dressur.site/actualite/{{ actu.token }}",
        "name": "{{ actu.pseudoAnnonceur|e('js') }} — Promotion Dressur"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://dressur.site/"},{"@type":"ListItem","position":2,"name":"Actualités","item":"{{ url('app_actualite') }}"}]}
</script>
{% endblock %}

{% block title %}{{title}}{% endblock %}

{% block body %}
    <div class="container my-3">
        <div class="mb-3 h6">
            <span class="fw-bolder">Dressur</span> / <span class="text-primary">Actualités</span>
        </div>
        <div class="row g-3">
            {% for actu in actus %}
                {% set waText %}Bonjour/Bonsoir *{{ actu.pseudoAnnonceur }}*, j'ai une question concernant la promotion ci-dessous: {% if actu.description|length >= 100 %}<<{{ actu.description[:100] }}...>>{% else %}<<{{ actu.description }}>>{% endif %} *Depuis Dressur.* {% endset %}
                {% set waUrl = 'https://wa.me/' ~ actu.whatsappNumber ~ '?text=' ~ waText|url_encode %}

                {% set altText %}{% if actu.typePromotionAffaire == "offre_emploi" %}Offre d'emploi{% if actu.annotherInfo.titre_demande_poste_rechercher is defined and actu.annotherInfo.titre_demande_poste_rechercher %} — {{ actu.annotherInfo.titre_demande_poste_rechercher }}{% endif %}{% if actu.annotherInfo.lieu_travail is defined and actu.annotherInfo.lieu_travail %} à {{ actu.annotherInfo.lieu_travail }}{% endif %} — {{ actu.pseudoAnnonceur }}{% elseif actu.typePromotionAffaire == "dmd_emploi" %}Demande d'emploi{% if actu.annotherInfo.titre_demande_poste_rechercher is defined and actu.annotherInfo.titre_demande_poste_rechercher %} — {{ actu.annotherInfo.titre_demande_poste_rechercher }}{% endif %}{% if actu.annotherInfo.localisation_souhaite is defined and actu.annotherInfo.localisation_souhaite %} à {{ actu.annotherInfo.localisation_souhaite }}{% endif %} — {{ actu.pseudoAnnonceur }}{% else %}Promotion produit / service — {{ actu.pseudoAnnonceur }}{% endif %}{% endset %}
                <div class="col-md-4">
                    <div class="card mb-0 shadow h-100">
                        <a href="/actualite/{{ actu.token }}">
                            <img src="/assets/images/placeholder.png" data-original="/promotion/{{actu.image}}" class="lazy card-img-top image-actu" alt="{{ altText|trim }}" loading="lazy" width="400" height="300">
                        </a>
                        <div class="card-body">
                            <p class="card-text actu-small-description">
                                {% if actu.typePromotionAffaire == "produit_service" %} {{actu.description}} {% endif %}
                                {% if actu.typePromotionAffaire == "offre_emploi" %} {{actu.annotherInfo.description_poste}} {% endif %}
                                {% if actu.typePromotionAffaire == "dmd_emploi" %} {{actu.annotherInfo.description_profil_demandeur}} {% endif %}
                            </p>
                            <div class="row align-items-center">
                                <div class="col-6">
                                    <div class="row g-2">
                                        <div class="col-auto"><i class="fas fa-eye me-1"></i> {{actu.nombreImpression}}</div>
                                        <div class="col-auto"><i class="fas fa-hand-pointer me-1"></i> {{actu.nombreDeVues}}</div>
                                    </div>
                                </div>
                                <div class="col-6 text-end d-flex gap-1 justify-content-end">
                                    <a href="{{ waUrl }}" target="_blank" class="btn btn-success btn-sm rounded-2 py-0"><i class="fab fa-whatsapp"></i></a>
                                    <button class="btn btn-outline-secondary btn-sm py-0 px-2 ds-share-btn"
                                        data-share-url="https://dressur.site/actualite/{{ actu.token }}"
                                        data-share-title="{{ actu.pseudoAnnonceur }} — Dressur"
                                        data-share-text="{{ actu.description[:100] }}">
                                        <i class="fas fa-share-nodes"></i>
                                    </button>
                                    <a href="/actualite/{{ actu.token }}" class="btn btn-info btn-sm rounded-2 py-0">Voir</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    <script>
    (function() {
        if (window._dsShareReady) return;
        window._dsShareReady = true;
        document.addEventListener('click', async function(e) {
            var btn = e.target.closest('.ds-share-btn');
            if (!btn) return;
            var shareData = {
                title: btn.dataset.shareTitle,
                text: btn.dataset.shareText,
                url: btn.dataset.shareUrl
            };
            if (navigator.share) {
                try { await navigator.share(shareData); } catch(err) {}
            } else {
                try {
                    await navigator.clipboard.writeText(btn.dataset.shareUrl);
                    var orig = btn.innerHTML;
                    btn.innerHTML = '<i class="fas fa-check"></i>';
                    setTimeout(function() { btn.innerHTML = orig; }, 2000);
                } catch(err) {
                    window.open(btn.dataset.shareUrl, '_blank');
                }
            }
        });
    })();
    </script>
{% endblock %}
