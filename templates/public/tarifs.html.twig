{% extends 'base.html.twig' %}

{% set description = "Sur cette page sont regroupé les tarifs de chacun des services de Dressur : Dressur Bot, Boost Contact, Campagne Mail, Promotion Affaire, Carte de visite numérique, Promotion réseau socixaux..." %}
{% set title = "Tarifs des services Dressur" %}
{% block referencement %}
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="{{title}} | Dressur Web" />
    <meta property="og:description" content="{{description}}" />
    <meta property="og:image" content="https://dressur.site/assets/img/hero.jpg" />
    <meta property="og:url" content="https://dressur.site" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card Meta Tags (facultatif) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{title}} | Dressur Web" />
    <meta name="twitter:description" content="{{description}}" />
    <meta name="twitter:image" content="https://dressur.site/assets/img/hero.jpg" />

    <!-- Autres balises meta facultatives -->
    <meta name="description" content="{{description}}" />
    <meta name="keywords" content="tarif Dressur, prix kdo, prix cassé, prix gratuit, email Dressur, Facebook Dressur, application Dressur, support Dressur" />
{% endblock %}

{% block title %}{{title}}{% endblock %}

{% block body %}
    <div class="container mt-3">
        <div class="mb-3 h6">
            <span class="fw-bolder">Dressur</span> / <span class="text-primary">Tarifs</span>
        </div>

        <div class="row g-5">
            <div class="col-md-12">
                <p class="fw-bolder display-6">Tarifs des services Dressur</p>
                <p class="fs-5">
                    Ci-dessous vous verez les différents tarifs pour chacun des services Dressur. Pour tous besoin d'éclaircissement, veuillez <a href="{{path('app_contactez_nous')}}">contactez l'assistance Dressur</a> par WhatsApp. Cliquez sur le nom du service pour en savoir plus.
                </p>
            </div>
        </div>

        <div>
            <p class="fw-bolder h5">1- <a href="{{path('app_dressur_bot')}}"> Dressur Bot </a></p>
            <p class="ps-md-4">Avec Dressur Bot, simplifiez vos campagnes de communication en masse sur WhatsApp.</p>
            <table class="data-table table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Formule d'abonnement</th>
                        <th>Prix d'activation</th>
                        <th>Durée d'activation</th>
                        <th>Signature des messages envoyés</th>
                    </tr>
                </thead>
                <tbody>
                {% for formule_dressur_bot in formule_dressur_bots %}
                    <tr>
                        <td>{{ formule_dressur_bot.titre }}</td>
                        <td>{{ formule_dressur_bot.prix }} FCFA</td>
                        <td>{{ formule_dressur_bot.nbrJour }} Jour(s)</td>
                        <td>
                            {% if formule_dressur_bot.signature == "oui" %}
                                <span class="fw-bolder text-danger">Les messages envoyer sont signés par Dressur.</span>
                            {% else %}
                                <span class="fw-bolder text-success">Les messages envoyer ne serons pas signer par Dressur.</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            <p class="ps-md-4">Avec Dressur Bot, le nombre de message envoyer pendant votre durée d'activation n'est pas limité. Faite juste attention au nombre de message envoyer depuis un meme compte WhatsApp pour ne voir votre compte WhatsApp suspendu.</p>
        </div>

        <div>
            <p class="fw-bolder h5">2- <a href="{{path('app_boost_contact')}}"> Boost Contact </a></p>
            <p class="ps-md-4">
                Optimisez vos contacts et augmentez votre visibilité avec Dressur. 
                Ce service vous permet d'évoluer en mode <span class="fw-bolder text-success">GRATUIT</span> comme <span class="fw-bolder text-danger">PAYANT</span>. Ci-dessous les tarifs a titre payante.
            </p>
            <table class="data-table table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Formule d'abonnement</th>
                        <th>Prix de la formule</th>
                        <th>Durée d'activation</th>
                    </tr>
                </thead>
                <tbody>
                {% for formule_boost in formule_boosts %}
                    <tr>
                        <td>{{ formule_boost.titre }}</td>
                        <td>{{ formule_boost.prix }} FCFA</td>
                        <td>{{ formule_boost.nbrJour }} Jour(s)</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div>
            <p class="fw-bolder h5">3- <a href="{{path('app_campagne_mail')}}"> Campagnes Mail </a></p>
            <p class="ps-md-4">Envoyez des emails à des milliers de destinataires avec facilité.</p>
            <table class="data-table table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Formule d'abonnement</th>
                        <th>Prix de la formule</th>
                        <th>Limite de destinataire</th>
                    </tr>
                </thead>
                <tbody>
                {% for formule_campagne_mail in formule_campagne_mails %}
                    <tr>
                        <td>{{ formule_campagne_mail.titre }}</td>
                        <td>{{ formule_campagne_mail.prix }} FCFA</td>
                        <td>{{ formule_campagne_mail.nombreMail }} Adresse Mail(s)</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div>
            <p class="fw-bolder h5">4- <a href="{{path('app_promotion_affaire')}}"> Promotion Affaire </a></p>
            <p class="ps-md-4">
                Promouvez vos produits, services, événements, et plus encore auprès d'un public ciblé.  
                Ce service vous permet d'évoluer en mode <span class="fw-bolder text-success">GRATUIT</span> comme <span class="fw-bolder text-danger">PAYANT</span>. Ci-dessous les tarifs a titre payante.
            </p>
            <table class="data-table table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Formule d'abonnement</th>
                        <th>Prix de la formule</th>
                        <th>Durée</th>
                        <th>Référencement Naturel SEO</th>
                    </tr>
                </thead>
                <tbody>
                {% for formule_promo_affaire in formule_promo_affaires %}
                    <tr>
                        <td>{{ formule_promo_affaire.titre }}</td>
                        <td>{{ formule_promo_affaire.prix }} FCFA</td>
                        <td>{{ formule_promo_affaire.nbrJour }} Jour(s)</td>
                        <td class="text-center">{{ formule_promo_affaire.referencement ? '<span class="badge bg-success">OUI</span>' : '<span class="badge bg-danger">NON</span>' }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div>
            <p class="fw-bolder h5">5- <a href="{{path('app_carte_visite_numerique')}}"> Carte de visite numérique </a></p>
            <p class="ps-md-4">Simplifiez l'échange de vos contacts en scannant un code QR. Plus besoin d'imprimer des cartes de visite. <span class="fw-bolder text-success">Ce service est GRATUIT</span>.</p>
        </div>

        <div>
            <p class="fw-bolder h5">6- <a href="{{path('app_promotion_reseaux_sociaux')}}"> Promotions Réseaux Sociaux </a></p>
            <p class="ps-md-4">Augmentez votre visibilité sur les réseaux sociaux avec Dressur. Les taris ci-dessous peuvent dimminuer ou augmnter en fonction du bon vouloir de chaque réseau social.</p>
            <div class="table-responsive">
                <table class="data-table table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Service</th>
                            <th>Prix pour 1000</th>
                            <th>Qte</th>
                            <th>Qte Min</th>
                            <th>Qte Max</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for formule_promo_reseau in formule_promo_reseaus %}
                        {% if formule_promo_reseau.prix > 0 and formule_promo_reseau.available == true %}
                            <tr>
                                <td>
                                    {% if formule_promo_reseau.parent %}{{formule_promo_reseau.parent.titre}} {% endif %}
                                    {{ formule_promo_reseau.titre }}
                                </td>
                                <td>{{ formule_promo_reseau.prix * 1.2 * 1.7 * 700 }} FCFA</td>
                                <td>{{ formule_promo_reseau.qte }}</td>
                                <td>{{ formule_promo_reseau.qteMin }}</td>
                                <td>{{ formule_promo_reseau.qteMax }}</td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}