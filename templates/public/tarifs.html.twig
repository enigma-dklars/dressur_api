{% extends 'base.html.twig' %}

{% set description = "Sur cette page sont regroupés les tarifs de chacun des services de Dressur : Dressur Bot, Boost Contact, Promotion Affaire, Promotion réseaux sociaux..." %}
{% set title = "Tarifs des services Dressur" %}
{% block referencement %}
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="{{title}} | Dressur Web" />
    <meta property="og:description" content="{{description}}" />
    <meta property="og:image" content="https://dressur.site/assets/img/og/og-tarifs.jpg" />
    <meta property="og:url" content="{{ url('app_tarifs') }}" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card Meta Tags (facultatif) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{title}} | Dressur Web" />
    <meta name="twitter:description" content="{{description}}" />
    <meta name="twitter:image" content="https://dressur.site/assets/img/og/og-tarifs.jpg" />

    <!-- Autres balises meta facultatives -->
    <meta name="description" content="{{description}}" />
    <meta name="keywords" content="tarif Dressur, prix kdo, prix cassé, prix gratuit, email Dressur, Facebook Dressur, application Dressur, support Dressur" />
{% endblock %}

{% block jsonld %}
{% set bot_prices = formule_dressur_bots|map(f => f.prix)|sort %}
{% set boost_prices = formule_boosts|map(f => f.prix)|sort %}
{% set promo_affaire_prices = formule_promo_affaires|map(f => f.prix)|sort %}
{% set reseau_prices = formule_promo_reseaus|filter(f => f.prix > 0 and f.available)|map(f => f.prix * 1.2 * 1.7 * 700)|sort %}
{% set bot_min = bot_prices is not empty ? bot_prices|first : 0 %}
{% set boost_min = boost_prices is not empty ? boost_prices|first : 0 %}
{% set promo_affaire_min = promo_affaire_prices is not empty ? promo_affaire_prices|first : 0 %}
{% set reseau_min = reseau_prices is not empty ? reseau_prices|first : 0 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Tarifs des services Dressur",
  "description": "{{ description }}",
  "url": "{{ url('app_tarifs') }}",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "item": {
        "@type": "Service",
        "name": "Dressur Bot",
        "description": "Automatisez l'envoi de messages WhatsApp en masse avec Dressur Bot.",
        "url": "{{ url('app_dressur_bot') }}",
        "offers": {
          "@type": "Offer",
          "price": "{{ bot_min }}",
          "priceCurrency": "XOF",
          "availability": "https://schema.org/InStock"
        }
      }
    },
    {
      "@type": "ListItem",
      "position": 2,
      "item": {
        "@type": "Service",
        "name": "Boost Contact",
        "description": "Optimisez vos contacts et augmentez votre visibilité avec Dressur.",
        "url": "{{ url('app_boost_contact') }}",
        "offers": {
          "@type": "Offer",
          "price": "{{ boost_min }}",
          "priceCurrency": "XOF",
          "availability": "https://schema.org/InStock"
        }
      }
    },
    {
      "@type": "ListItem",
      "position": 3,
      "item": {
        "@type": "Service",
        "name": "Promotion Affaire",
        "description": "Promouvez vos produits, services et événements auprès d'un public ciblé.",
        "url": "{{ url('app_promotion_affaire') }}",
        "offers": {
          "@type": "Offer",
          "price": "{{ promo_affaire_min }}",
          "priceCurrency": "XOF",
          "availability": "https://schema.org/InStock"
        }
      }
    },
    {
      "@type": "ListItem",
      "position": 4,
      "item": {
        "@type": "Service",
        "name": "Promotions Réseaux Sociaux",
        "description": "Achetez des abonnés, likes, vues sur Facebook, TikTok, Instagram, YouTube et plus.",
        "url": "{{ url('app_promotion_reseaux_sociaux') }}",
        "offers": {
          "@type": "Offer",
          "price": "{{ reseau_min }}",
          "priceCurrency": "XOF",
          "availability": "https://schema.org/InStock"
        }
      }
    }
  ]
}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://dressur.site/"},{"@type":"ListItem","position":2,"name":"Tarifs","item":"{{ url('app_tarifs') }}"}]}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Le service Boost Contact de Dressur est-il gratuit ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, le service Boost Contact est disponible en mode Gratuit et en mode Payant. La formule gratuite vous permet déjà de trouver de nouveaux contacts et d'augmenter votre visibilité."
      }
    },
    {
      "@type": "Question",
      "name": "Le service Promotion Affaire de Dressur est-il payant ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, le service Promotion Affaire est un service entièrement payant. Il vous permet de publier vos produits, services et offres d'emploi auprès d'un public ciblé. Plusieurs formules sont disponibles selon vos besoins."
      }
    },
    {
      "@type": "Question",
      "name": "Dressur Bot est-il gratuit ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Non, Dressur Bot est un service payant proposé sous forme d'abonnement en FCFA. Plusieurs formules sont disponibles selon la durée d'activation souhaitée."
      }
    },
    {
      "@type": "Question",
      "name": "Quels réseaux sociaux sont supportés par le service Promotions Réseaux Sociaux ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dressur prend en charge Facebook, TikTok, Instagram, YouTube, Twitter, Telegram, Twitch, Spotify et bien d'autres plateformes. Les tarifs peuvent varier en fonction des plateformes."
      }
    },
    {
      "@type": "Question",
      "name": "Comment contacter l'assistance Dressur pour des questions sur les tarifs ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vous pouvez contacter l'assistance Dressur via WhatsApp au +229 64 04 42 94 ou par email à dressur.ds@gmail.com. L'équipe vous répondra dans les meilleurs délais."
      }
    },
    {
      "@type": "Question",
      "name": "Les tarifs de Dressur sont-ils en FCFA ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, tous les tarifs des services Dressur sont exprimés en Francs CFA (FCFA), la monnaie utilisée en Afrique de l'Ouest."
      }
    }
  ]
}
</script>
{% endblock %}

{% block title %}{{title}}{% endblock %}

{% block body %}
    <div class="container mt-3">
        <div class="mb-3 h6">
            <span class="fw-bolder">Dressur</span> / <span class="text-primary">Tarifs</span>
        </div>

        <div class="row g-5">
            <div class="col-md-12">
                <p class="fw-bolder display-6">Tarifs des services Dressur</p>
                <p class="fs-5">
                    Ci-dessous vous verez les différents tarifs pour chacun des services Dressur. Pour tous besoin d'éclaircissement, veuillez <a href="{{path('app_contactez_nous')}}">contactez l'assistance Dressur</a> par WhatsApp. Cliquez sur le nom du service pour en savoir plus.
                </p>
            </div>
        </div>

        <div>
            <p class="fw-bolder h5">1- <a href="{{path('app_dressur_bot')}}"> Dressur Bot </a></p>
            <p class="ps-md-4">Avec Dressur Bot, simplifiez vos campagnes de communication en masse sur WhatsApp.</p>
            <table class="data-table table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Formule d'abonnement</th>
                        <th>Prix d'activation</th>
                        <th>Durée d'activation</th>
                        <th>Signature des messages envoyés</th>
                    </tr>
                </thead>
                <tbody>
                {% for formule_dressur_bot in formule_dressur_bots %}
                    <tr>
                        <td>{{ formule_dressur_bot.titre }}</td>
                        <td>{{ formule_dressur_bot.prix }} FCFA</td>
                        <td>{{ formule_dressur_bot.nbrJour }} Jour(s)</td>
                        <td>
                            {% if formule_dressur_bot.signature == "oui" %}
                                <span class="fw-bolder text-danger">Les messages envoyer sont signés par Dressur.</span>
                            {% else %}
                                <span class="fw-bolder text-success">Les messages envoyer ne serons pas signer par Dressur.</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            <p class="ps-md-4">Avec Dressur Bot, le nombre de message envoyer pendant votre durée d'activation n'est pas limité. Faite juste attention au nombre de message envoyer depuis un meme compte WhatsApp pour ne voir votre compte WhatsApp suspendu.</p>
        </div>

        <div>
            <p class="fw-bolder h5">2- <a href="{{path('app_boost_contact')}}"> Boost Contact </a></p>
            <p class="ps-md-4">
                Optimisez vos contacts et augmentez votre visibilité avec Dressur. 
                Ce service vous permet d'évoluer en mode <span class="fw-bolder text-success">GRATUIT</span> comme <span class="fw-bolder text-danger">PAYANT</span>. Ci-dessous les tarifs a titre payante.
            </p>
            <table class="data-table table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Formule d'abonnement</th>
                        <th>Prix de la formule</th>
                        <th>Durée d'activation</th>
                    </tr>
                </thead>
                <tbody>
                {% for formule_boost in formule_boosts %}
                    <tr>
                        <td>{{ formule_boost.titre }}</td>
                        <td>{{ formule_boost.prix }} FCFA</td>
                        <td>{{ formule_boost.nbrJour }} Jour(s)</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div>
            <p class="fw-bolder h5">3- <a href="{{path('app_promotion_affaire')}}"> Promotion Affaire </a></p>
            <p class="ps-md-4">
                Promouvez vos produits, services, événements, et plus encore auprès d'un public ciblé.
                Ce service est <span class="fw-bolder text-danger">PAYANT</span>. Ci-dessous les différentes formules disponibles.
            </p>
            <table class="data-table table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Formule d'abonnement</th>
                        <th>Prix de la formule</th>
                        <th>Durée</th>
                        <th>Référencement Naturel SEO</th>
                    </tr>
                </thead>
                <tbody>
                {% for formule_promo_affaire in formule_promo_affaires %}
                    <tr>
                        <td>{{ formule_promo_affaire.titre }}</td>
                        <td>{{ formule_promo_affaire.prix }} FCFA</td>
                        <td>{{ formule_promo_affaire.nbrJour }} Jour(s)</td>
                        <td class="text-center">{{ formule_promo_affaire.referencement ? '<span class="badge bg-success">OUI</span>' : '<span class="badge bg-danger">NON</span>' }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div>
            <p class="fw-bolder h5">4- <a href="{{path('app_promotion_reseaux_sociaux')}}"> Promotions Réseaux Sociaux </a></p>
            <p class="ps-md-4">Augmentez votre visibilité sur les réseaux sociaux avec Dressur. Les taris ci-dessous peuvent dimminuer ou augmnter en fonction du bon vouloir de chaque réseau social.</p>
            <div class="table-responsive">
                <table class="data-table table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Service</th>
                            <th>Prix pour 1000</th>
                            <th>Qte</th>
                            <th>Qte Min</th>
                            <th>Qte Max</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for formule_promo_reseau in formule_promo_reseaus %}
                        {% if formule_promo_reseau.prix > 0 and formule_promo_reseau.available == true %}
                            <tr>
                                <td>
                                    {% if formule_promo_reseau.parent %}{{formule_promo_reseau.parent.titre}} {% endif %}
                                    {{ formule_promo_reseau.titre }}
                                </td>
                                <td>{{ formule_promo_reseau.prix * 1.2 * 1.7 * 700 }} FCFA</td>
                                <td>{{ formule_promo_reseau.qte }}</td>
                                <td>{{ formule_promo_reseau.qteMin }}</td>
                                <td>{{ formule_promo_reseau.qteMax }}</td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}