{% extends 'base.html.twig' %}

{% set description = "Connectez-vous à votre compte Dressur pour accéder à vos compétences et gérer votre profil." %}
{% set title = "Se Connecter" %}
{% block referencement %}
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="{{title}} | Dressur Web" />
    <meta property="og:description" content="{{description}}" />
    <meta property="og:image" content="https://dressur.site/assets/img/hero.jpg" />
    <meta property="og:url" content="{{ url('app_connexion') }}" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card Meta Tags (facultatif) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{title}} | Dressur Web" />
    <meta name="twitter:description" content="{{description}}" />
    <meta name="twitter:image" content="https://dressur.site/assets/img/hero.jpg" />

    <!-- Autres balises meta facultatives -->
    <meta name="description" content="{{description}}" />
    <meta name="keywords" content="connexion à Dressur, se connecter à son compte, login Dressur, accès au profil Dressur, gestion de compte" />
{% endblock %}

{% block robots_meta %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block title %}{{title}}{% endblock %}

{% block body %}
<br>
    <div class="authentication-content">
        <div class="container">
            <div class="mt-5">
                <div class="card rounded-0 overflow-hidden shadow-none border">
                    <div class="row g-0">
                        <div class="col-12 order-1 col-md-7 d-flex align-items-center justify-content-center border-end">
                            <img src="/assets/images/placeholder.png" data-original="assets/images/error/auth-img-7.png" class="lazy img-fluid" alt="">
                        </div>
                        <div class="col-12 col-md-5 order-md-2">
                            <div class="card-body p-4 p-sm-5">
                            <h5 class="card-title fs-3">Connexion</h5>
                            <p class="card-text mb-4 text-center">Renseigner votre adresse email et mot de passe pour accéder à votre compte!</p>
                            <form class="form-body">
                                
                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="mt-0" id="msgError" style="display: none;"></div>
                                    </div>
                                    <div class="col-12">
                                    <label for="inputEmail" class="form-label">E-mail</label>
                                    <div class="ms-auto position-relative">
                                        <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-envelope-fill fs-6"></i></div>
                                        <input type="email" class="form-control getInfo radius-30 ps-5" id="inputEmail" placeholder="E-mail">
                                    </div>
                                    </div>
                                    <div class="col-12">
                                    <label for="inputMotPasse" class="form-label">Mot de passe</label>
                                    <div class="ms-auto position-relative">
                                        <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-lock-fill fs-6"></i></div>
                                        <input type="password" class="form-control getInfo radius-30 ps-5" id="inputMotPasse" placeholder="Mot de passe">
                                    </div>
                                    </div>
                                    <div class="col-12 text-end">       <a href="{{path('app_mot_de_passe_oublier')}}">Mot de passe oublié ?</a>
                                    </div>
                                    <div class="col-12">
                                    <div class="d-grid">
                                        <button type="button" class="btn btn-primary radius-30" id="connexion">CONNEXION</button>
                                    </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="d-flex align-items-center gap-2 my-2">
                                            <hr class="flex-grow-1">
                                            <span class="text-muted small">ou</span>
                                            <hr class="flex-grow-1">
                                        </div>
                                        <div class="d-grid">
                                            <a href="{{ path('auth_google_redirect') }}" class="btn btn-outline-secondary radius-30 d-flex align-items-center justify-content-center gap-2">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                                                    <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
                                                    <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.32-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
                                                    <path fill="#FBBC05" d="M11.68 28.18A13.94 13.94 0 0 1 10.8 24c0-1.45.25-2.85.88-4.18v-5.7H4.34A23.93 23.93 0 0 0 0 24c0 3.87.93 7.52 2.56 10.78l7.12-5.52.92-1.08z"/>
                                                    <path fill="#EA4335" d="M24 9.5c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 2.99 29.93.5 24 .5 15.4.5 7.96 5.43 4.34 13.12l7.34 5.7C13.42 13.37 18.27 9.5 24 9.5z"/>
                                                </svg>
                                                Continuer avec Google
                                            </a>
                                        </div>
                                    </div>
                                    <div class="col-12 text-center">
                                    <p class="mb-0">Vous n'avez pas encore de compte? <br> <a href="{{path('app_inscription')}}">Inscrivez-vous ici</a></p>
                                    </div>
                                </div>
                            </form>
                        </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}