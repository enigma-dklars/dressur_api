{% extends 'base.html.twig' %}

{% block title %}Hello PublicController!{% endblock %}

{% block body %}
    <div class="authentication-content">
        <div class="container">
            <div class="authentication-card-nabar-footer">
                <div class="card rounded-0 overflow-hidden shadow-none bg-white border">
                    <div class="row g-0">
                        <div class="col-12 order-1 col-xl-8 d-flex align-items-center justify-content-center border-end">
                            <img src="assets/images/error/auth-img-7.png" class="img-fluid" alt="">
                        </div>
                        <div class="col-12 col-xl-4 order-xl-2">
                            <div class="card-body p-4 p-sm-5">
                            <h5 class="card-title">Connexion</h5>
                            <p class="card-text mb-4 text-center">Renseigner votre adresse email et mot de passe pour accéder à votre compte!</p>
                            <form class="form-body">
                                
                                <div class="row g-3">
                                    <div class="col-12">
                                    <label for="inputEmail" class="form-label">E-mail</label>
                                    <div class="ms-auto position-relative">
                                        <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-envelope-fill fs-6"></i></div>
                                        <input type="email" class="form-control radius-30 ps-5" id="inputEmail" placeholder="Email">
                                    </div>
                                    </div>
                                    <div class="col-12">
                                    <label for="inputMotPasse" class="form-label">Mot de passe</label>
                                    <div class="ms-auto position-relative">
                                        <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-lock-fill fs-6"></i></div>
                                        <input type="password" class="form-control radius-30 ps-5" id="inputMotPasse" placeholder="Password">
                                    </div>
                                    </div>
                                    <div class="col-12 text-end">	<a href="{{path('app_mot_de_passe_oublier')}}">Mot de passe oublié ?</a>
                                    </div>
                                    <div class="col-12">
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary radius-30">CONNEXION</button>
                                    </div>
                                    </div>
                                    <div class="col-12 text-center">
                                    <p class="mb-0">Vous n'avez pas encore de compte? <a href="{{path('app_inscription')}}">Inscrivez-vous ici</a></p>
                                    </div>
                                </div>
                            </form>
                        </div>
                        </div>
                        </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}