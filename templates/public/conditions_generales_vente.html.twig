     <meta name="keywords" content="CGV Dress You, conditions générales de vente Dress You, tarifs Dress You, paiement Dress You, remboursement Dress You" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
