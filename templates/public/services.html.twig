{% extends 'base.html.twig' %}

{% set title = "Nos Services" %}
{% set description = "Découvrez tous les services proposés par Dressur : Boost Contact, Dressur Bot, Promotion Affaire, Promotion Réseaux Sociaux, Campagnes Mail et bien plus encore." %}

{% block referencement %}
    <meta property="og:title" content="{{title}} | Dressur Web" />
    <meta property="og:description" content="{{description}}" />
    <meta property="og:image" content="https://dressur.site/assets/img/og/og-dressur.jpg" />
    <meta property="og:url" content="{{ url('app_services') }}" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{title}} | Dressur Web" />
    <meta name="twitter:description" content="{{description}}" />
    <meta name="description" content="{{description}}" />
    <meta name="keywords" content="Dressur, services, Boost Contact, Dressur Bot, Promotion Affaire, Réseaux Sociaux, Campagne Mail, WhatsApp, marketing digital">
{% endblock %}

{% block jsonld %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://dressur.site/"},{"@type":"ListItem","position":2,"name":"Nos Services","item":"{{ url('app_services') }}"}]}
</script>
{% endblock %}

{% block title %}{{title}}{% endblock %}

{% block body %}
<div class="container mt-3">

    {# Breadcrumb #}
    <div class="mb-3 h6">
        <span class="fw-bolder">Dressur</span> / <span class="text-primary">Nos Services</span>
    </div>

    {# Hero #}
    <header class="text-white text-center py-5 rounded mb-5" style="background-color: #2a4b9a !important;">
        <div class="container">
            <h1 class="display-5 fw-bold">Tous nos Services</h1>
            <p class="lead mb-4">
                Découvrez l'ensemble des solutions Dressur pour développer votre réseau,<br>
                promouvoir vos activités et automatiser vos communications.
            </p>
            <a href="{{ path('app_tarifs') }}" class="btn btn-light btn-lg me-2">
                <i class="fas fa-tags me-1"></i> Voir les tarifs
            </a>
            <a href="{{ path('app_inscription') }}" class="btn btn-outline-light btn-lg">
                <i class="fas fa-user-plus me-1"></i> S'inscrire gratuitement
            </a>
        </div>
    </header>

    {# Grille des services #}
    <section class="mb-5">
        <h2 class="text-center fw-semibold mb-1">Ce que Dressur vous offre</h2>
        <p class="text-center text-muted mb-4">Cliquez sur un service pour en savoir plus.</p>

        <div class="row g-4">

            {# ── Boost Contact ── #}
            <div class="col-md-6 col-lg-4 d-flex align-items-stretch">
                <div class="card mb-0 shadow-sm w-100 h-100" style="border-top: 4px solid #2a4b9a;">
                    <div class="card-body d-flex flex-column text-center p-4">
                        <div class="mb-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
                                  style="width:64px;height:64px;background:#eef2ff;">
                                <i class="fas fa-users fs-2" style="color:#2a4b9a;"></i>
                            </span>
                        </div>
                        <h5 class="card-title fw-semibold" style="color:#2a4b9a;">Boost Contact</h5>
                        <p class="card-text text-muted flex-grow-1 mt-2">
                            Trouvez de nouveaux contacts qualifiés grâce à nos algorithmes intelligents. 
                            Vos contacts s'enregistrent mutuellement et automatiquement dans vos téléphones.
                        </p>
                        <div class="mt-3">
                            <span class="badge bg-success mb-3">Gratuit</span><br>
                            <a href="{{ path('app_boost_contact') }}" class="btn btn-primary">
                                Découvrir <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Dressur Bot ── #}
            <div class="col-md-6 col-lg-4 d-flex align-items-stretch">
                <div class="card mb-0 shadow-sm w-100 h-100" style="border-top: 4px solid #2a4b9a;">
                    <div class="card-body d-flex flex-column text-center p-4">
                        <div class="mb-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
                                  style="width:64px;height:64px;background:#eef2ff;">
                                <i class="fab fa-android fs-2" style="color:#2a4b9a;"></i>
                            </span>
                        </div>
                        <h5 class="card-title fw-semibold" style="color:#2a4b9a;">Dressur Bot</h5>
                        <p class="card-text text-muted flex-grow-1 mt-2">
                            Application Windows pour automatiser l'envoi de messages sur WhatsApp Web 
                            et WhatsApp Desktop. Envoyez à plus d'1 million de contacts sans bug.
                        </p>
                        <div class="mt-3">
                            <span class="badge bg-primary mb-3">Logiciel Windows</span><br>
                            <a href="{{ path('app_dressur_bot') }}" class="btn btn-primary">
                                Découvrir <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Promotion Affaire ── #}
            <div class="col-md-6 col-lg-4 d-flex align-items-stretch">
                <div class="card mb-0 shadow-sm w-100 h-100" style="border-top: 4px solid #2a4b9a;">
                    <div class="card-body d-flex flex-column text-center p-4">
                        <div class="mb-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
                                  style="width:64px;height:64px;background:#eef2ff;">
                                <i class="fas fa-bullhorn fs-2" style="color:#2a4b9a;"></i>
                            </span>
                        </div>
                        <h5 class="card-title fw-semibold" style="color:#2a4b9a;">Promotion Affaire</h5>
                        <p class="card-text text-muted flex-grow-1 mt-2">
                            Promouvez vos produits, services, offres d'emploi et événements auprès 
                            d'un public ciblé. Vos annonces sont aussi référencées sur Google.
                        </p>
                        <div class="mt-3">
                            <span class="badge bg-warning text-dark mb-3">À partir de {{ min_price_affaire|default('500') }} F CFA</span><br>
                            <a href="{{ path('app_promotion_affaire') }}" class="btn btn-primary">
                                Découvrir <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Promotion Réseaux Sociaux ── #}
            <div class="col-md-6 col-lg-4 d-flex align-items-stretch">
                <div class="card mb-0 shadow-sm w-100 h-100" style="border-top: 4px solid #2a4b9a;">
                    <div class="card-body d-flex flex-column text-center p-4">
                        <div class="mb-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
                                  style="width:64px;height:64px;background:#eef2ff;">
                                <i class="fas fa-thumbs-up fs-2" style="color:#2a4b9a;"></i>
                            </span>
                        </div>
                        <h5 class="card-title fw-semibold" style="color:#2a4b9a;">Promotion Réseaux Sociaux</h5>
                        <p class="card-text text-muted flex-grow-1 mt-2">
                            Achetez des abonnés, likes, commentaires et partages sur Facebook, 
                            TikTok, Instagram, YouTube, Telegram et bien d'autres plateformes.
                        </p>
                        <div class="mt-3">
                            <span class="badge bg-warning text-dark mb-3">À partir de {{ min_price_reseau|default('500') }} F CFA</span><br>
                            <a href="{{ path('app_promotion_reseaux_sociaux') }}" class="btn btn-primary">
                                Découvrir <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Campagne Mail ── #}
            <div class="col-md-6 col-lg-4 d-flex align-items-stretch">
                <div class="card mb-0 shadow-sm w-100 h-100" style="border-top: 4px solid #2a4b9a;">
                    <div class="card-body d-flex flex-column text-center p-4">
                        <div class="mb-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
                                  style="width:64px;height:64px;background:#eef2ff;">
                                <i class="fas fa-envelope-open-text fs-2" style="color:#2a4b9a;"></i>
                            </span>
                        </div>
                        <h5 class="card-title fw-semibold" style="color:#2a4b9a;">Campagne Mail</h5>
                        <p class="card-text text-muted flex-grow-1 mt-2">
                            Envoyez des campagnes d'e-mailing ciblées à des milliers de destinataires. 
                            Idéal pour les annonces, newsletters et communications professionnelles.
                        </p>
                        <div class="mt-3">
                            <span class="badge bg-info text-dark mb-3">Disponible sur l'app</span><br>
                            <a href="{{ path('app_inscription') }}" class="btn btn-primary">
                                Commencer <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Actualités / Marketplace ── #}
            <div class="col-md-6 col-lg-4 d-flex align-items-stretch">
                <div class="card mb-0 shadow-sm w-100 h-100" style="border-top: 4px solid #2a4b9a;">
                    <div class="card-body d-flex flex-column text-center p-4">
                        <div class="mb-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
                                  style="width:64px;height:64px;background:#eef2ff;">
                                <i class="fas fa-newspaper fs-2" style="color:#2a4b9a;"></i>
                            </span>
                        </div>
                        <h5 class="card-title fw-semibold" style="color:#2a4b9a;">Actualités & Marketplace</h5>
                        <p class="card-text text-muted flex-grow-1 mt-2">
                            Parcourez les dernières annonces, offres d'emploi, opportunités d'affaires 
                            et actualités publiées par la communauté Dressur.
                        </p>
                        <div class="mt-3">
                            <span class="badge bg-success mb-3">Gratuit</span><br>
                            <a href="{{ path('app_actualite') }}" class="btn btn-primary">
                                Parcourir <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    {# CTA bas de page #}
    <section class="pb-5">
        <div class="card mb-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h2 class="fw-bold mb-2">Prêt à développer votre activité ?</h2>
                <p class="lead text-muted mb-4">
                    Rejoignez des milliers d'utilisateurs qui font confiance à Dressur chaque jour.
                </p>
                <a href="https://play.google.com/store/apps/details?id=com.dressur.ds" target="_blank" class="btn btn-primary btn-lg me-2">
                    <i class="fab fa-google-play me-1"></i> Télécharger sur Google Play
                </a>
                <a href="{{ path('app_inscription') }}" class="btn btn-outline-primary btn-lg">
                    <i class="fas fa-user-plus me-1"></i> S'inscrire
                </a>
            </div>
        </div>
    </section>

</div>
{% endblock %}
