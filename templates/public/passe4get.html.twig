{% extends 'base.html.twig' %}

{% set description = "Réinitialisez votre mot de passe sur Dressur. Entrez votre e-mail pour recevoir les instructions de récupération." %}
{% set title = "Mot de passe oublié" %}

{% block referencement %}
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="{{title}} | Dressur Web" />
    <meta property="og:description" content="{{description}}" />
    <meta property="og:image" content="https://dressur.site/assets/img/hero.jpg" />
    <meta property="og:url" content="{{ url('app_mot_de_passe_oublier') }}" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{title}} | Dressur Web" />
    <meta name="twitter:description" content="{{description}}" />
    <meta name="twitter:image" content="https://dressur.site/assets/img/hero.jpg" />

    <!-- Autres balises meta facultatives -->
    <meta name="description" content="{{description}}" />
    <meta name="keywords" content="mot de passe oublié, réinitialisation mot de passe, récupération mot de passe, Dressur" />
{% endblock %}

{% block robots_meta %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block title %}{{title}}{% endblock %}

{% block body %}
    <div class="authentication-content">
        <div class="container">
            <div class="mt-5">
                <div class="card rounded-0 overflow-hidden shadow-none border">
                    <div class="row g-0">
                        <div class="col-lg-6 d-flex align-items-center justify-content-center border-end">
                            <img src="/assets/images/placeholder.png" data-original="assets/images/error/forgot-password-frent-img-removebg-preview.png" class="lazy img-fluid" alt="Forgot Password Image">
                        </div>
                        <div class="col-lg-6">
                            <div class="card-body p-4 p-sm-5">
                                <h5 class="card-title">Mot de passe oublié?</h5>
                                <p class="card-text mb-4">
                                    Un nouveau mot de passe sera envoyé à cette adresse.
                                    Utilisez votre adresse et ce nouveau mot de passe pour vous connecter.
                                </p>
                                <form class="form-body">
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <div class="mt-0" id="msgError" style="display: none;"></div>
                                        </div>
                                        <div class="col-12">
                                            <label for="inputEmail" class="form-label">Renseignez votre adresse email</label>
                                            <div class="ms-auto position-relative">
                                                <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-envelope-fill fs-5"></i></div>
                                                <input type="email" class="form-control getInfo form-control-lg radius-30 ps-5" id="inputEmail" placeholder="Email">
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="d-grid gap-3">
                                                <button type="button" class="btn btn-lg btn-primary radius-30" id="passe4get">CONFIRMER</button>
                                                <a href="{{ path('app_connexion') }}" class="btn btn-lg btn-light radius-30">Retour à la page de connexion</a>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}