{% extends 'base.html.twig' %}

{% block title %}Hello PublicController!{% endblock %}

{% block body %}
    <div class="authentication-content">
        <div class="container">
            <div class="authentication-card-nabar-footer">
                <div class="card rounded-0 overflow-hidden shadow-none bg-white border">
                    <div class="row g-0">
                        <div class="col-lg-6 d-flex align-items-center justify-content-center border-end">
                          <img src="assets/images/error/forgot-password-frent-img.jpg" class="img-fluid" alt="">
                        </div>
                        <div class="col-lg-6">
                          <div class="card-body p-4 p-sm-5">
                            <h5 class="card-title">Mot de passe oublié?</h5>
                            <p class="card-text mb-4">
                                Un nouveau mot de passe sera envoyer à cette adresse.
                                Utiliser votre adresse et ce nouveau mot de passe pour vous connecter.
                            </p>
                            <form class="form-body">
                                <div class="row g-3">
                                  <div class="col-12">
                                    <label for="inputEmail" class="form-label">Renseigner votre adresse email.</label>
                                    <input type="email" class="form-control form-control-lg radius-30" id="inputEmail" placeholder="E-mail">
                                  </div>
                                  <div class="col-12">
                                    <div class="d-grid gap-3">
                                        <button type="submit" class="btn btn-lg btn-primary radius-30">CONFIRMER</button>
                                        <a href="{{path('app_connexion')}}" class="btn btn-lg btn-light radius-30">Retour à la page de connexion</a>
                                    </div>
                                  </div>
                                </div>
                            </form>
                         </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}