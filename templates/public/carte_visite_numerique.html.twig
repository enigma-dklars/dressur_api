{% extends 'base.html.twig' %}

{% set description = "Avec le service Carte de Visite Numérique de Dressur, échangez vos contacts facilement en scannant un code QR. Plus besoin d'imprimer des cartes de visite. Disponible uniquement sur l'application mobile Dressur." %}

{% set title = "Carte de visite numérique" %}

{% block referencement %}
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="{{title}} | Dressur Web" />
    <meta property="og:description" content="{{description}}" />
    <meta property="og:image" content="https://dressur.site/assets/img/hero.jpg" />
    <meta property="og:url" content="{{ url('app_carte_visite_numerique') }}" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card Meta Tags (facultatif) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{title}} | Dressur Web" />
    <meta name="twitter:description" content="{{description}}" />
    <meta name="twitter:image" content="https://dressur.site/assets/img/hero.jpg" />

    <!-- Autres balises meta facultatives -->
    <meta name="description" content="{{description}}" />
    <meta name="keywords" content="Dressur, Carte de Visite Numérique, échange de contacts, code QR, application mobile, contacts professionnels">
{% endblock %}

{% block title %}{{title}}{% endblock %}

{% block body %}
    <div class="container mt-3">
        <div class="mb-3 h6">
            <span class="fw-bolder">Dressur</span> / <span class="text-primary">Carte de visite numérique</span>
        </div>
        <!-- Header -->
        <header class="text-white text-center py-5 rounded" style="background-color: #2a4b9a !important;">
            <div class="container">
                <h1 class="display-5">Échangez vos Contacts avec une Carte de Visite Numérique</h1>
                <p class="lead">Simplifiez l'échange de vos contacts en scannant un code QR. Plus besoin d'imprimer des cartes de visite.</p>
                <a href="https://play.google.com/store/apps/details?id=com.dressur.ds" class="btn btn-light btn-lg mb-3">Télécharger sur Google Play</a>
            </div>
        </header>

        <!-- Features Section -->
        <section id="features" class="py-5">
            <div class="container">
                <h2 class="text-center">Pourquoi utiliser la Carte de Visite Numérique de Dressur ?</h2>
                <p class="text-center lead mb-4">Découvrez comment notre service peut révolutionner l'échange de vos contacts professionnels.</p>
                <div class="row g-3">
                    <div class="col-md-4 d-flex align-items-stretch text-center">
                        <div class="card mb-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title" style="color: #2a4b9a !important; font-weight: 500;">Échange Facile</h5>
                                <p class="card-text mt-3">Scannez simplement le code QR d'un autre utilisateur pour échanger vos contacts instantanément.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch text-center">
                        <div class="card mb-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title" style="color: #2a4b9a !important; font-weight: 500;">Gain de Temps</h5>
                                <p class="card-text mt-3">Plus besoin d'imprimer et de distribuer des cartes de visite. Échangez vos informations de contact en quelques secondes.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch text-center">
                        <div class="card mb-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title" style="color: #2a4b9a !important; font-weight: 500;">Économie d'Argent</h5>
                                <p class="card-text mt-3">Réduisez vos coûts en supprimant la nécessité d'imprimer des cartes de visite.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-stretch text-center">
                        <div class="card mb-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title" style="color: #2a4b9a !important; font-weight: 500;">Accessibilité Mobile</h5>
                                <p class="card-text mt-3">Disponible uniquement sur l'application mobile Dressur, pour un accès rapide et facile où que vous soyez.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-stretch text-center">
                        <div class="card mb-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title" style="color: #2a4b9a !important; font-weight: 500;">Écologique</h5>
                                <p class="card-text mt-3">Contribuez à la protection de l'environnement en réduisant votre consommation de papier.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Download Section -->
        <section id="download" class="pb-5">
            <div class="container text-center">
                <div class="card mb-0">
                    <div class="card-body py-4">
                        <h2>Téléchargez l'Application Mobile Dressur</h2>
                        <p class="lead py-3">Commencez à utiliser notre service de Carte de Visite Numérique en téléchargeant l'application mobile Dressur.</p>
                        <a href="https://play.google.com/store/apps/details?id=com.dressur.ds" class="btn btn-primary btn-lg">Télécharger sur Google Play</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Availability Notice -->
        <section id="availability" class="pb-4">
            <div class="container text-center bg-danger text-white p-3 rounded">
                <p class="lead mb-0">
                    Note : Ce service est disponible uniquement sur l'application mobile, car les contacts sont enregistrés automatiquement dans les téléphones.
                </p>
            </div>
        </section>

        <section>
            <div class="container mb-3">
                <h1 class="fs-4 fw-semibold mb-3"><i class="fs-5 fas fa-play"></i> Autres Services sur Dressur Mobile et Web</h1>
                <div class="row g-3">
                    <div class="col-md-4 d-flex align-items-stretch">
                        <div class="card mb-0">
                            <div class="card-body">
                                <div class="feature-box rounded text-center d-flex flex-column">
                                    <i class="fas fa-users fs-1 mb-3 text-primary"></i>
                                    <h5>Trouvez de nouveaux contacts</h5>
                                    <p>Nos algorithmes intelligents vous affichent les contacts en fonction de vos préférences pays et centre d'intérêt.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch">
                        <div class="card mb-0">
                            <div class="card-body">
                                <div class="feature-box rounded text-center d-flex flex-column">
                                    <i class="fas fa-clock fs-1 mb-3 text-primary"></i>
                                    <h5>Gagnez du temps</h5>
                                    <p>Les contacts que vous enregistrez sont automatiquement ajoutés à votre téléphone et vos coordonnées sont ajoutées dans celui de votre contact.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card mb-0">
                            <div class="card-body">
                                <div class="feature-box rounded text-center d-flex flex-column">
                                    <i class="fa-brands fa-android fs-1 mb-3 text-primary"></i>
                                    <h5>Dressur Bot</h5>
                                    <p>
                                        Dressur Bot est une application Windows qui permet d'automatiser l'envoi de messages via WhatsApp Web ou WhatsApp Desktop.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch">
                        <div class="card mb-0">
                            <div class="card-body">
                                <div class="feature-box rounded text-center d-flex flex-column">
                                    <i class="fas fa-bullhorn fs-1 mb-3 text-primary"></i>
                                    <h5>Promouvez vos produits</h5>
                                    <p>Faites connaître vos produits, services, événements, etc. avec des promotions ciblées en fonction de vos préférences.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch">
                        <div class="card mb-0">
                            <div class="card-body">
                                <div class="feature-box rounded text-center d-flex flex-column">
                                    <i class="fas fa-envelope fs-1 mb-3 text-primary"></i>
                                    <h5>Campagnes Mail</h5>
                                    <p>Lancez des campagnes de mailing vers plus de 10 000 adresses e-mail. Faites la promotion de vos produits, envoyez des newsletters ou des invitations à des événements.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch">
                        <div class="card mb-0">
                            <div class="card-body">
                                <div class="feature-box rounded text-center d-flex flex-column">
                                    <i class="fas fa-thumbs-up fs-1 mb-3 text-primary"></i>
                                    <h5>Promotions Réseaux Sociaux</h5>
                                    <p>Achetez des abonnés, likes, commentaires, partages, etc. sur Facebook, TikTok, Instagram, YouTube et plus encore.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    {# <div class="col-md-4 d-flex align-items-stretch">
                        <div class="card mb-0">
                            <div class="card-body">
                                <div class="feature-box rounded text-center d-flex flex-column">
                                    <i class="fas fa-id-card-alt fs-1 mb-3 text-primary"></i>
                                    <h5>Carte de Visite Numérique</h5>
                                    <p>Partagez facilement vos informations de contact avec un QR code moderne et pratique. Plus besoin d'imprimer des centaines de cartes de visite.</p>
                                </div>
                            </div>
                        </div>
                    </div> #}
                </div>
            </div>
        </section>
    </div>
{% endblock %}
