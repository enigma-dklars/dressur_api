{% extends 'base.html.twig' %}

{% block title %}Hello PublicController!{% endblock %}

{% block body %}
    <div class="authentication-content">
        <div class="container">
            <div class="authentication-card-nabar-footer">
                <div class="card rounded-0 overflow-hidden shadow-none bg-white border">
                    <div class="row g-0">
                        <div class="col-12 order-1 col-xl-3 d-flex align-items-center justify-content-center border-end">
                        <img src="assets/images/error/auth-img-register3.png" class="img-fluid" alt="">
                        </div>
                        <div class="col-12 col-xl-9 order-xl-2">
                        <div class="card-body p-4 p-sm-5">
                            <h5 class="card-title">Inscription</h5>
                            <p class="card-text text-center mb-4">Entrer vos informations primordiales!</p>
                            <form class="form-body">
                            
                                <div class="row g-3">
                                <div class="col-12">
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label for="inputPseudo" class="form-label">Pseudo</label>
                                            <div class="ms-auto position-relative">
                                            <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-person-circle fs-6"></i></div>
                                            <input type="email" class="form-control radius-30 ps-5" id="inputPseudo" placeholder="Pseudo">
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="inputNumeroWhatsApp" class="form-label">Numéro WhatsApp</label>
                                            <div class="ms-auto position-relative">
                                            <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-person-circle fs-6"></i></div>
                                            <input type="email" class="form-control radius-30 ps-5" id="inputNumeroWhatsApp" placeholder="Numéro WhatsApp">
                                            </div>
                                        </div>
                                        <div class="col-md-5">
                                            <label for="inputEmail" class="form-label">E-mail</label>
                                            <div class="ms-auto position-relative">
                                            <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-envelope-fill fs-6"></i></div>
                                            <input type="email" class="form-control radius-30 ps-5" id="inputEmail" placeholder="E-mail">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label for="inputMotPasse" class="form-label">Mot de passe</label>
                                            <div class="ms-auto position-relative">
                                            <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-lock-fill fs-6"></i></div>
                                            <input type="password" class="form-control radius-30 ps-5" id="inputMotPasse" placeholder="Mot de passe">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="inputConfirmerMotPasse" class="form-label">Confirmer le mot de passe</label>
                                            <div class="ms-auto position-relative">
                                            <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-lock-fill fs-6"></i></div>
                                            <input type="password" class="form-control radius-30 ps-5" id="inputConfirmerMotPasse" placeholder="Mot de passe">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="row g-2">
                                        <div class="col-md-6 text-center order-1">
                                            <p></p>
                                            <p class="mb-0">Vous avez déjà un compte? <a href="{{path('app_connexion')}}">Se connecter ici</a></p>
                                        </div>
                                        <div class="col-md-6 order-xl-2">
                                            <div class="d-grid">
                                            <button type="submit" class="btn btn-primary radius-30">INSCRIPTION</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                </div>
                            </form>
                        </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}