══════════════════════════════════════ #}
<section class="promos-section">
    <div class="container">
        <div class="d-flex align-items-end justify-content-between flex-wrap gap-3 mb-5" data-aos="fade-up">
            <div>
                <span class="section-tag">Annonces récentes</span>
                <h2 class="section-title mb-0">Top 6 des Promotions Affaires</h2>
            </div>
            <a href="{{path('app_promotion_affaire')}}" class="btn btn-outline-primary rounded-pill px-4 fw-semibold">
                Voir tout <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>

        <div class="row g-4">
            {% for actu in actus %}
                {% set text %}Bonjour/Bonsoir *{{ actu.pseudoAnnonceur }}*, j'ai une question concernant la promotion ci-dessous: {% if actu.description|length >= 100 %}<<{{ actu.description[:100] }}...>>{% else %}<<{{ actu.description }}>>{% endif %} *Depuis Dressur.* {% endset %}
                {% set encodedText = text|url_encode %}
                {% set url = 'https://wa.me/' ~ actu.whatsappNumber ~ '?text=' ~ encodedText %}

                {% set altText %}{% if actu.typePromotionAffaire == "offre_emploi" %}Offre d'emploi{% if actu.annotherInfo.titre_demande_poste_rechercher is defined and actu.annotherInfo.titre_demande_poste_rechercher %} — {{ actu.annotherInfo.titre_demande_poste_rechercher }}{% endif %}{% if actu.annotherInfo.lieu_travail is defined and actu.annotherInfo.lieu_travail %} à {{ actu.annotherInfo.lieu_travail }}{% endif %} — {{ actu.pseudoAnnonceur }}{% elseif actu.typePromotionAffaire == "dmd_emploi" %}Demande d'emploi{% if actu.annotherInfo.titre_demande_poste_rechercher is defined and actu.annotherInfo.titre_demande_poste_rechercher %} — {{ actu.annotherInfo.titre_demande_poste_rechercher }}{% endif %}{% if actu.annotherInfo.localisation_souhaite is defined and actu.annotherInfo.localisation_souhaite %} à {{ actu.annotherInfo.localisation_souhaite }}{% endif %} — {{ actu.pseudoAnnonceur }}{% else %}Promotion produit / service — {{ actu.pseudoAnnonceur }}{% endif %}{% endset %}

                <div class="col-md-4" data-aos="fade-up" data-aos-delay="{{ loop.index * 50 }}">
                    <div class="card promo-card">
                        <img src="/assets/images/placeholder.png"
                             data-original="/promotion/{{actu.image}}"
                             class="lazy card-img-top image-actu"
                             alt="{{ altText|trim }}"
                             loading="lazy"
                             width="400" height="200"
                             data-bs-toggle="modal"
                             data-bs-target="#modal_actu_{{actu.id}}"
                             style="cursor:pointer;">
                        <div class="card-body p-3">
                            <p class="card-text actu-small-description mb-3" style="font-size:0.88rem; color:#374151; line-height:1.55; cursor:pointer;"
                               data-bs-toggle="modal" data-bs-target="#modal_actu_{{actu.id}}">
                                {% if actu.typePromotionAffaire == "produit_service" %}{{actu.description}}{% endif %}
                                {% if actu.typePromotionAffaire == "offre_emploi" %}{{actu.annotherInfo.description_poste}}{% endif %}
                                {% if actu.typePromotionAffaire == "dmd_emploi" %}{{actu.annotherInfo.description_profil_demandeur}}{% endif %}
                            </p>
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="promo-meta">
                                    <span><i class="fas fa-eye me-1"></i>{{actu.nombreImpression}}</span>
                                    <span><i class="fas fa-hand-pointer me-1"></i>{{actu.nombreDeVues}}</span>
                                </div>
                                <a href="{{ url }}" target="_blank" class="btn btn-success btn-sm rounded-pill px-3 py-1" style="font-size:0.8rem;">
                                    <i class="fab fa-whatsapp me-1"></i> Contacter
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="modal_actu_{{actu.id}}" tabindex="-1" style="display:none;" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-scrollable">
                            <div class="modal-content rounded-4 overflow-hidden">
                                <div class="modal-body p-0">
                                    <img src="/promotion/{{actu.image}}" class="card-img-top" alt="{{ altText|trim }}">
                                    <div class="p-3">
                                        <p class="text-end mb-2">
                                            <a href="{{ url }}" target="_blank" class="btn btn-success btn-sm rounded-pill">
                                                <i class="fab fa-whatsapp me-1"></i> Contacter l'annonceur
                                            </a>
                                        </p>
                                        <p>
                                            {% if actu.typePromotionAffaire == "produit_service" %}{{actu.description|nl2br}}{% endif %}
                                            {% if actu.typePromotionAffaire == "offre_emploi" %}{{actu.annotherInfo.description_poste|nl2br}}{% endif %}
                                            {% if actu.typePromotionAffaire == "dmd_emploi" %}{{actu.annotherInfo.description_profil_demandeur|nl2br}}{% endif %}
                                        </p>
                                        {% for key, value in actu.annotherInfo %}
                                            <div class="mb-2">
                                                <div class="fw-bold text-primary small">{{ key|replace({'_': ' '})|capitalize }} :</div>
                                                <div style="word-wrap:break-word; white-space:normal; font-size:0.9rem;">{{ value|nl2br }}</div>
                                                <hr class="my-2">
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                                <div class="modal-footer py-2">
                                    <button type="button" class="btn btn-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Fermer</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

