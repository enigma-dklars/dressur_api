{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <section id="hero">
        <div class="container">
            <div class="row justify-content-between">
                <div class="col-lg-7 pt-5 pt-lg-0 order-2 order-lg-1 d-flex align-items-center">
                    <div data-aos="zoom-out">
                        <h1>Dressur <span>Mobile & Web</span></h1>
                        <h2>Dressé votre mure de compétences et assurez-vous une grande visibilité.</h2>
                        <div class="d-md-flex text-center text-lg-start justify-content-between">
                            <a href="https://play.google.com/store/apps/details?id=com.dressur.ds" target="_blank" class="btn-get-started scrollto mb-2 mb-md-0"> <i class="fs-5 fab fa-google-play me-2"></i> Télécharger sur Google Play</a>
                            <a href="{{path('app_inscription')}}" class="btn-get-started scrollto">S'inscrire <i class="fs-5 fas fa-user-plus ms-2"></i> </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 order-1 order-lg-2 hero-img" data-aos="zoom-out" data-aos-delay="300">
                    <img src="/assets/img/hero.jpg" class="img-fluid animated" alt="">
                </div>
            </div>
        </div>
    </section>

    <div class="container mt-3">
        <h1 class="fs-4 fw-semibolder mb-3"><i class="fs-5 fas fa-play"></i> Top 6 des Promotions Affaires</h1>
        <div class="row g-3">
            {% for actu in actus %}
                {% set text %}Bonjour/Bonsoir *{{ actu.pseudoAnnonceur }}*, j'ai une question concernant la promotion ci-dessous: {% if actu.description|length >= 100 %}<<{{ actu.description[:100] }}...>>{% else %}<<{{ actu.description }}>>{% endif %} *Depuis Dressur.* {% endset %}
                {% set encodedText = text|url_encode %}
                {% set url = 'https://wa.me/' ~ actu.whatsappNumber ~ '?text=' ~ encodedText %}

                <div class="col-md-4">
                    <div class="card mb-0 shadow">
                        <img src="/promotion/{{actu.image}}" class="card-img-top image-actu" alt="..." data-bs-toggle="modal" data-bs-target="#modal_actu_{{actu.id}}">
                        <div class="card-body">
                            <p class="card-text actu-small-description" data-bs-toggle="modal" data-bs-target="#modal_actu_{{actu.id}}">
                                {{actu.description}}
                            </p>
                            <div class="row">
                                <div class="col-7">
                                    <div class="row g-3">
                                        <div class="col-auto"> <i class="fas fa-eye me-1"></i> {{actu.nombreImpression}}</div>
                                        <div class="col-auto"> <i class="fas fa-hand-pointer me-1"></i> {{actu.nombreDeVues}}</div>
                                    </div>
                                </div>
                                <div class="col-5 text-end">
                                    <a href="{{ url }}" target="_blank" class="btn btn-info btn-sm rounded-2 py-0">En savoir plus</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="modal_actu_{{actu.id}}" tabindex="-1" style="display: none;" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-scrollable">
                            <div class="modal-content">
                                <div class="modal-body p-0">
                                    <img src="/promotion/{{actu.image}}" class="card-img-top" alt="...">
                                    <p class="text-end px-3 pt-3 mb-0">
                                        <a href="{{ url }}" target="_blank" class="btn btn-success btn-sm mb-3 rounded-5">Contacter l'annonceur</a>
                                    </p>
                                    <p class="px-3">
                                        {{actu.description|nl2br}}
                                    </p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
