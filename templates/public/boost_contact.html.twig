{% extends 'base.html.twig' %}

{% set description = "Boost Contact est un service de Dressur qui vous permet de trouver facilement de nouveaux contacts selon vos préférences, gagner du temps et de l'énergie, économiser de l'argent, augmenter votre visibilité et booster le rendement de vos activités." %}

{% set title = "Boost Contact" %}

{% block referencement %}
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="{{title}} | Dressur Web" />
    <meta property="og:description" content="{{description}}" />
    <meta property="og:image" content="https://dressur.site/assets/img/og/og-boost-contact.jpg" />
    <meta property="og:url" content="{{ url('app_boost_contact') }}" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card Meta Tags (facultatif) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{title}} | Dressur Web" />
    <meta name="twitter:description" content="{{description}}" />
    <meta name="twitter:image" content="https://dressur.site/assets/img/og/og-boost-contact.jpg" />

    <!-- Autres balises meta facultatives -->
    <meta name="description" content="{{description}}" />
    <meta name="keywords" content="Boost Contact, Dressur, nouveaux contacts, communication, visibilité, marketing, réseau">
{% endblock %}

{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "{{ url('app_boost_contact') }}#service",
  "name": "Boost Contact",
  "alternateName": "Dressur Boost Contact",
  "description": "{{ description }}",
  "url": "{{ url('app_boost_contact') }}",
  "provider": {
    "@type": "Organization",
    "name": "Dressur",
    "url": "https://dressur.site",
    "@id": "https://dressur.site/#organization"
  },
  "serviceType": "Marketing numérique",
  "areaServed": "Afrique de l'Ouest",
  "availableChannel": {
    "@type": "ServiceChannel",
    "serviceUrl": "https://play.google.com/store/apps/details?id=com.dressur.ds",
    "servicePlatform": "Application mobile Android"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "XOF",
    "availability": "https://schema.org/InStock",
    "url": "{{ url('app_tarifs') }}"
  }
}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://dressur.site/"},{"@type":"ListItem","position":2,"name":"Boost Contact","item":"{{ url('app_boost_contact') }}"}]}
</script>
{% endblock %}

{% block title %}{{title}}{% endblock %}

{% block body %}
    <div class="container mt-3">
        <div class="mb-3 h6">
            <span class="fw-bolder">Dressur</span> / <span class="text-primary">Boost Contact</span>
        </div>
        <!-- Header -->
        <header class="text-center py-5 rounded" style="background-color: #2a4b9a !important; color: white;">
            <div class="container">
                <h1 class="display-5">Boost Contact</h1>
                <p class="lead">Optimisez vos contacts et augmentez votre visibilité avec Dressur.</p>
                <a href="https://play.google.com/store/apps/details?id=com.dressur.ds" class="btn btn-light btn-lg mb-3">Télécharger sur Google Play</a>
                <a href="{{path('app_inscription')}}" class="btn btn-light btn-lg mb-3">S'inscrire</a>
            </div>
        </header>

        <!-- Features Section -->
        <section id="features" class="py-5">
            <div class="container">
                <h2 class="text-center">Pourquoi choisir Boost Contact ?</h2>
                <p class="text-center lead mb-4">Découvrez comment Boost Contact peut transformer vos interactions professionnelles.</p>
                <div class="row g-3">
                    <div class="col-md-8 d-flex align-items-stretch text-center">
                        <div class="card mb-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title" style="color: #2a4b9a !important; font-weight: 500;">Trouver de nouveaux contacts</h5>
                                <p class="card-text mt-3">Nos algorithmes intelligents vous affichent les contacts en fonction de vos préférences pays et ceux des autres utilisateurs.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch text-center">
                        <div class="card mb-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title" style="color: #2a4b9a !important; font-weight: 500;">Gagner du temps et de l'énergie</h5>
                                <p class="card-text mt-3">Les contacts que vous enregistrez sont automatiquement ajoutés à votre téléphone et réciproquement dans celui de votre contact.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch text-center">
                        <div class="card mb-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title" style="color: #2a4b9a !important; font-weight: 500;">Économiser de l'argent</h5>
                                <p class="card-text mt-3">Plus besoin de payer pour être diffusé dans des listes de diffusion ou sur des statuts.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch text-center">
                        <div class="card mb-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title" style="color: #2a4b9a !important; font-weight: 500;">Augmenter votre visibilité</h5>
                                <p class="card-text mt-3">Atteignez les personnes qui comptent vraiment pour votre activité rapidement et efficacement.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch text-center">
                        <div class="card mb-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title" style="color: #2a4b9a !important; font-weight: 500;">Booster le rendement de vos activités</h5>
                                <p class="card-text mt-3">Plus de contacts pertinents = plus d'opportunités !</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Download Section -->
        <section id="download" class="pb-5">
            <div class="container text-center">
                <div class="card mb-0">
                    <div class="card-body py-4">
                        <h2>Télécharger Dressur</h2>
                        <p class="lead py-3">Commencez à utiliser Boost Contact dès aujourd'hui en téléchargeant l'application Dressur.</p>
                        <a href="https://play.google.com/store/apps/details?id=com.dressur.ds" class="btn btn-primary btn-lg">Télécharger sur Google Play</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Availability Notice -->
        <section id="availability" class="pb-4">
            <div class="container text-center bg-danger text-white p-3 rounded">
                <p class="lead mb-0">
                    Note : Ce service est plus efficace lorsqu'il est utilisé depuis l'application mobile, car les contacts sont enregistrés automatiquement dans les téléphones. Les utilisateurs d'iPhone peuvent utiliser la version web de Dressur.
                </p>
            </div>
        </section>

        <section>
            <div class="container mb-3">
                <h1 class="fs-4 fw-semibold mb-3"><i class="fs-5 fas fa-play"></i> Autres Services sur Dressur Mobile et Web</h1>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="card mb-0">
                            <div class="card-body">
                                <div class="feature-box rounded text-center d-flex flex-column">
                                    <i class="fa-brands fa-android fs-1 mb-3 text-primary"></i>
                                    <h5>Dressur Bot</h5>
                                    <p>
                                        Dressur Bot est une application Windows qui permet d'automatiser l'envoi de messages via WhatsApp Web ou WhatsApp Desktop.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch">
                        <div class="card mb-0">
                            <div class="card-body">
                                <div class="feature-box rounded text-center d-flex flex-column">
                                    <i class="fas fa-clock fs-1 mb-3 text-primary"></i>
                                    <h5>Gagnez du temps</h5>
                                    <p>Les contacts que vous enregistrez sont automatiquement ajoutés à votre téléphone et vos coordonnées sont ajoutées dans celui de votre contact.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch">
                        <div class="card mb-0">
                            <div class="card-body">
                                <div class="feature-box rounded text-center d-flex flex-column">
                                    <i class="fas fa-bullhorn fs-1 mb-3 text-primary"></i>
                                    <h5>Promouvez vos produits</h5>
                                    <p>Faites connaître vos produits, services, événements, etc. avec des promotions ciblées en fonction de vos préférences.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch">
                        <div class="card mb-0">
                            <div class="card-body">
                                <div class="feature-box rounded text-center d-flex flex-column">
                                    <i class="fas fa-envelope fs-1 mb-3 text-primary"></i>
                                    <h5>Campagnes Mail</h5>
                                    <p>Lancez des campagnes de mailing vers plus de 10 000 adresses e-mail. Faites la promotion de vos produits, envoyez des newsletters ou des invitations à des événements.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch">
                        <div class="card mb-0">
                            <div class="card-body">
                                <div class="feature-box rounded text-center d-flex flex-column">
                                    <i class="fas fa-thumbs-up fs-1 mb-3 text-primary"></i>
                                    <h5>Promotions Réseaux Sociaux</h5>
                                    <p>Achetez des abonnés, likes, commentaires, partages, etc. sur Facebook, TikTok, Instagram, YouTube et plus encore.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-stretch">
                        <div class="card mb-0">
                            <div class="card-body">
                                <div class="feature-box rounded text-center d-flex flex-column">
                                    <i class="fas fa-id-card-alt fs-1 mb-3 text-primary"></i>
                                    <h5>Carte de Visite Numérique</h5>
                                    <p>Partagez facilement vos informations de contact avec un QR code moderne et pratique. Plus besoin d'imprimer des centaines de cartes de visite.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
