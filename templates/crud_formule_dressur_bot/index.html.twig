{% extends 'basePrivate.html.twig' %}

{% block title %}FormuleDressurBot index{% endblock %}

{% block body %}
    <span class="h4 me-3">FormuleDressurBot index</span>
    <a class="btn btn-sm btn-primary h4" href="{{ path('app_crud_formule_dressur_bot_new') }}">Create new</a>

    <table class="data-table table table-bordered table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Prix</th>
                <th>NbrJour</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for formule_dressur_bot in formule_dressur_bots %}
            <tr>
                <td>{{ formule_dressur_bot.id }}</td>
                <td>{{ formule_dressur_bot.titre }}</td>
                <td>{{ formule_dressur_bot.prix }}</td>
                <td>{{ formule_dressur_bot.nbrJour }}</td>
                <td>
                    {% include "crud_formule_dressur_bot/_delete_form.html.twig" %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
